<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GTFO_GUIEditor.ViewModels;assembly=GTFO_GUIEditor"
             xmlns:models="clr-namespace:GTFO_GUIEditor.Models;assembly=GTFO_GUIEditor"
             xmlns:converters="clr-namespace:GTFO_GUIEditor.Converters;assembly=GTFO_GUIEditor"
             x:Class="GTFO_GUIEditor.App"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <converters:EventTypeColorConverter x:Key="EventTypeColorConverter"/>
        <DataTemplate x:Key="WardenEventTemplate" x:CompileBindings="False">
            <Border Background="#1A1A1A"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,10">
                <StackPanel Spacing="10">
                    <!-- Top row: Event Type, Trigger, Enabled, Remove Button -->
                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="Type:"
                                   ToolTip.Tip="The type of event."
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="#CCCCCC"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableEventTypes}"
                                  SelectedItem="{Binding Type, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:EventType">
                                    <TextBlock Text="{Binding}" Foreground="{Binding Converter={StaticResource EventTypeColorConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Column="2"
                                   Text="Trigger:"
                                   ToolTip.Tip="When this event should trigger in relation to the parent event."
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="#CCCCCC"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableEventTriggers}"
                                  SelectedItem="{Binding Trigger, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"/>

                        <CheckBox Grid.Column="4"
                                  Content="Enabled"
                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  ToolTip.Tip="True if this event should actually trigger."
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Foreground="#CCCCCC"/>

                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
                            <Button Content="Copy to Clipboard"
                                    ToolTip.Tip="Copy event configuration to clipboard as JSON"
                                    Command="{Binding $parent[Window].DataContext.LevelLayout.CopyWardenEventCommand}"
                                    CommandParameter="{Binding}"
                                    Background="#2E5B88"
                                    Foreground="White"
                                    Padding="10,4"/>
                            <Button Content="✕ Remove"
                                    Command="{Binding $parent[Window].DataContext.LevelLayout.RemoveWardenEventCommand}"
                                    CommandParameter="{Binding}"
                                    Background="#4A1C1C"
                                    Foreground="#FF6B6B"
                                    Padding="10,4"/>
                        </StackPanel>
                    </Grid>

                    <!-- Common Row 1: Delay, Layer (Sector) -->
                    <Grid ColumnDefinitions="Auto,*,Auto,*">
                        <TextBlock Grid.Column="0" Text="Delay (s):" ToolTip.Tip="A delay before the event will be triggered." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                        <TextBox Grid.Column="1" Text="{Binding Delay, Mode=TwoWay}" Margin="0,0,12,0"/>

                        <TextBlock Grid.Column="2" Text="Layer:" ToolTip.Tip="The sector the event should take place in. This value may or may not be relevant based on the event type." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableSectors}"
                                  SelectedItem="{Binding Layer, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                    </Grid>

                    <!-- Common Row 2: Dimension, Zone -->
                    <Grid ColumnDefinitions="Auto,*,Auto,*">
                        <TextBlock Grid.Column="0" Text="Dimension:" ToolTip.Tip="The dimension the event should take place in. This value may or may not be relevant based on the event type." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.AvailableDimensions}"
                                  SelectedValue="{Binding Dimension, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding DimensionIndex}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,12,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:DimensionOption">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Column="2" Text="Zone:" ToolTip.Tip="The zone the event should take place in. This value may or may not be relevant based on the event type." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding AvailableZones}"
                                  SelectedValue="{Binding Zone, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding ZoneIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ZoneOption">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- Common Row 3: WardenIntel -->
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="Warden Intel:" ToolTip.Tip="On-screen text to display" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                        <TextBox Grid.Column="1" Text="{Binding WardenIntel, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                    </Grid>

                    <!-- Common Row 4: SoundID & SoundSubtitle -->
                    <Grid ColumnDefinitions="Auto,*,Auto,*">
                        <TextBlock Grid.Column="0" Text="Sound:" ToolTip.Tip="Sound to play. This is a sound ID, use the sounds tab to view a list of all sounds and their IDs" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                        <TextBox Grid.Column="1" Text="{Binding SoundID, Mode=TwoWay}" Margin="0,0,12,0"/>

                        <TextBlock Grid.Column="2" Text="Sound Subtitle:" ToolTip.Tip="Subtitle for the sound" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                        <TextBox Grid.Column="3" Text="{Binding SoundSubtitle, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Conditional: DialogueID [DialogueOnClosest, ForcePlayPlayerDialogue] -->
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsDialogueIdVisible}">
                        <TextBlock Grid.Column="0" Text="Dialogue ID:" ToolTip.Tip="The ID of the dialogue to play, as a reference to the PlayerDialogDataBlock. Unfortunately this datablock is not currently supported by this editor, so you will need to find these manually." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#87CEEB"/>
                        <TextBox Grid.Column="1" Text="{Binding DialogueID, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Conditional: SpecialBool [All AWO Events] -->
                    <CheckBox Content="Special Bool"
                              IsChecked="{Binding SpecialBool, Mode=TwoWay}"
                              IsVisible="{Binding IsSpecialBoolVisible}"
                              ToolTip.Tip="When true, the warden intel for this event will be displayed regardless of any active ClearWardenIntelQueue event. If you are not using ClearWardenIntelQueue, you can ignore this field."
                              Foreground="#87CEEB"/>

                    <!-- Conditional: ActivateChainedPuzzle [ChainPuzzle & UseStaticBioscanPoints] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsChainPuzzleVisible}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="Alarm:" ToolTip.Tip="Alarm to start when the event is triggered" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.AvailableAlarms}"
                                      SelectedValue="{Binding ChainPuzzle, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding PersistentId}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,16,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:AlarmBlock">
                                        <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox Grid.Column="2"
                                      Content="Use Static Bioscan Points"
                                      IsChecked="{Binding UseStaticBioscanPoints, Mode=TwoWay}"
                                      ToolTip.Tip="Whether externally defined static bioscan points should be used instead of the normal random positions"
                                      VerticalAlignment="Center"
                                      Foreground="#CCCCCC"/>
                        </Grid>
                    </Border>

                    <!-- Conditional: Duration [AddToTimer, DimensionFlashTeam, LightsInZone] -->
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsDurationVisible}">
                        <TextBlock Grid.Column="0" Text="Duration (s):" ToolTip.Tip="The duration for this event. Does different things based on the event type" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                        <TextBox Grid.Column="1" Text="{Binding Duration, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Conditional: ClearDimension [DimensionWarpTeam] -->
                    <CheckBox Content="Clear Dimension"
                              IsChecked="{Binding ClearDimension, Mode=TwoWay}"
                              IsVisible="{Binding IsClearDimensionVisible}"
                              ToolTip.Tip="True if the dimension should be cleared on warp."
                              Foreground="#FFA200"/>

                    <!-- Conditional: CustomSubObjective [UpdateCustomSubObjective] -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsCustomSubObjectiveVisible}">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Custom Sub-Objective Header:" ToolTip.Tip="Header of the custom sub-objective" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                            <TextBox Grid.Column="1" Text="{Binding CustomSubObjectiveHeader, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Custom Sub-Objective:" ToolTip.Tip="Description text of the custom sub-objective" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                            <TextBox Grid.Column="1" Text="{Binding CustomSubObjective, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Conditional: FogSetting & FogTransitionDuration [SetFogSetting] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsFogSettingVisible}">
                        <Grid ColumnDefinitions="Auto,*,Auto,*">
                            <TextBlock Grid.Column="0" Text="Fog Setting:" ToolTip.Tip="The fog setting to switch to" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.AvailableFogSettings}"
                                      SelectedValue="{Binding FogSetting, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding PersistentId}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,12,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:FogSettingsBlock">
                                        <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="Transition Duration (s):" ToolTip.Tip="How long the transition to the new fog should take" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                            <TextBox Grid.Column="3" Text="{Binding FogTransitionDuration, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <!-- Conditional: EnemyID [SpawnEnemyOnPoint] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsEnemyIdVisible}">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Enemy:" ToolTip.Tip="The enemy to spawn" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                      SelectedValue="{Binding EnemyID, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding PersistentId}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:EnemyEntry">
                                        <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Conditional: Count [SpawnEnemyOnPoint, SpawnHibernateInZone, SpawnScoutInZone, StopEventLoop, ForceCompleteChainPuzzle, SpawnNavMarker] -->
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsCountVisible}">
                        <TextBlock Grid.Column="0" Text="Count:" ToolTip.Tip="A count variable. Does different things based on the event type, most uses are self explanatory. Check the AWO GitHub wiki if you need help for your event type." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                        <TextBox Grid.Column="1" Text="{Binding Count, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Conditional: WorldEventObjectFilter [SpawnEnemyOnPoint, SetNavMarker] -->
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsWorldEventObjectFilterVisible}">
                        <TextBlock Grid.Column="0" Text="World Event Object Filter:" ToolTip.Tip="String object filter that decides where this event is to be targeted towards. This is an advanced field, it is recommended to only use event types that require this if you know what you're doing." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                        <TextBox Grid.Column="1" Text="{Binding WorldEventObjectFilter, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Conditional: Position (Vector3) [LightsInZone] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsPositionVisible}">
                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                            <TextBlock Grid.Column="0" Text="Position X:" ToolTip.Tip="X position offset" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FFA200"/>
                            <TextBox Grid.Column="1" Text="{Binding Position.X, Mode=TwoWay}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="Y:" ToolTip.Tip="Y position offset" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FFA200"/>
                            <TextBox Grid.Column="3" Text="{Binding Position.Y, Mode=TwoWay}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="4" Text="Z:" ToolTip.Tip="Z position offset" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FFA200"/>
                            <TextBox Grid.Column="5" Text="{Binding Position.Z, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <!-- Conditional: EnemyWaveData [SpawnEnemyWave] -->
                    <Expander IsVisible="{Binding IsEnemyWaveDataVisible}"
                              Background="#252526"
                              BorderBrush="#3E3E42"
                              BorderThickness="1"
                              CornerRadius="4"
                              HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="Enemy Wave Configuration" FontWeight="SemiBold" ToolTip.Tip="Information for the wave to spawn" Foreground="#FFA200"/>
                        </Expander.Header>
                        <StackPanel Spacing="10" Margin="0,8,0,0">
                            <!-- Wave Roles -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Wave Roles (Enemy Selection)" FontWeight="Bold" ToolTip.Tip="Select which enemies will spawn for each wave role" Foreground="#FFFFFF" FontSize="12"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Weakling:" ToolTip.Tip="The 'weakling' type enemy for this alarm. This enemy will cost 0.75 points to spawn, with a total points soft cap of 25. Many vanilla alarms opt to filter this out by excluding it in the population filter, instead using the standard and special slots for their small enemies as they cost 1 point instead of 0.75." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                                  SelectedValue="{Binding EnemyWaveData.WaveRoleWeakling, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding PersistentId}"
                                                  HorizontalAlignment="Stretch" Margin="0,0,10,6">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:EnemyEntry">
                                                    <TextBlock Text="{Binding DisplayText}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Standard:" ToolTip.Tip="The 'standard' type enemy for this alarm. This enemy will cost 1 point to spawn, with a total points soft cap of 25. Generally, this is going to be your strikers/shooters." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <ComboBox Grid.Row="0" Grid.Column="3"
                                                  ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                                  SelectedValue="{Binding EnemyWaveData.WaveRoleStandard, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding PersistentId}"
                                                  HorizontalAlignment="Stretch" Margin="0,0,0,6">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:EnemyEntry">
                                                    <TextBlock Text="{Binding DisplayText}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Special:" ToolTip.Tip="The 'special' type enemy for this alarm. This enemy will cost 1 point to spawn, with a total points soft cap of 25. Generally, this is going to be your strikers/shooters." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1"
                                                  ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                                  SelectedValue="{Binding EnemyWaveData.WaveRoleSpecial, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding PersistentId}"
                                                  HorizontalAlignment="Stretch" Margin="0,0,10,6">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:EnemyEntry">
                                                    <TextBlock Text="{Binding DisplayText}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Mini-Boss:" ToolTip.Tip="The 'miniboss' type enemy for this alarm. This enemy will cost 2 points to spawn, with a total points soft cap of 25. Generally, this is going to be your hybrids/giants. Do not put something like a Tank in here; lest you fight an army." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <ComboBox Grid.Row="1" Grid.Column="3"
                                                  ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                                  SelectedValue="{Binding EnemyWaveData.WaveRoleMiniBoss, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding PersistentId}"
                                                  HorizontalAlignment="Stretch" Margin="0,0,0,6">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:EnemyEntry">
                                                    <TextBlock Text="{Binding DisplayText}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Boss:" ToolTip.Tip="The 'boss' type enemy for this alarm. This enemy will cost 2 points to spawn, with a total points soft cap of 25. Generally, this is going to be your hybrids/giants. Do not put something like a Tank in here; lest you fight an army. NOTE: THIS ENEMY TYPE IS BROKEN IN VANILLA." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1"
                                                  ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                                  SelectedValue="{Binding EnemyWaveData.WaveRoleBoss, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding PersistentId}"
                                                  HorizontalAlignment="Stretch" Margin="0,0,10,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:EnemyEntry">
                                                    <TextBlock Text="{Binding DisplayText}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Wave Timing & Pauses -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Wave Timing &amp; Pauses" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Pause Before Start (s):" ToolTip.Tip="Pause in seconds before the wave begins." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EnemyWaveData.PauseBeforeStart, Mode=TwoWay}" Margin="0,0,10,6"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Pause Between Groups (s):" ToolTip.Tip="Pause in seconds between enemy group spawns." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EnemyWaveData.PauseBetweenGroups, Mode=TwoWay}" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Wave Pause Min (at Cost):" ToolTip.Tip="Minimum wave pause duration at max cost/ramp." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EnemyWaveData.WavePauseMin_AtCost, Mode=TwoWay}" Margin="0,0,10,6"/>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Wave Pause Max (at Cost):" ToolTip.Tip="Maximum wave pause duration at max cost/ramp." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding EnemyWaveData.WavePauseMax_AtCost, Mode=TwoWay}" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Wave Pause Min (s):" ToolTip.Tip="Minimum duration to pause between waves." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EnemyWaveData.WavePauseMin, Mode=TwoWay}" Margin="0,0,10,0"/>

                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Wave Pause Max (s):" ToolTip.Tip="Maximum duration to pause between waves." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding EnemyWaveData.WavePauseMax, Mode=TwoWay}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Population Filter -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Population Filter" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" Margin="0,2,0,0">
                                        <TextBlock Grid.Column="0" Text="Filter Type:" ToolTip.Tip="Include: ONLY selected roles spawn. Exclude: Selected roles DO NOT spawn." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableFilterTypes}"
                                                  SelectedItem="{Binding EnemyWaveData.FilterType, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"/>
                                    </Grid>

                                    <TextBlock Text="Filter Roles:" Margin="0,4,0,2" Foreground="#CCCCCC" FontSize="11"/>
                                    <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <CheckBox Content="Weakling" IsChecked="{Binding EnemyWaveData.FilterWeakling, Mode=TwoWay}" Margin="0,0,10,4"/>
                                        <CheckBox Content="Standard" IsChecked="{Binding EnemyWaveData.FilterStandard, Mode=TwoWay}" Margin="0,0,10,4"/>
                                        <CheckBox Content="Special" IsChecked="{Binding EnemyWaveData.FilterSpecial, Mode=TwoWay}" Margin="0,0,10,4"/>
                                        <CheckBox Content="Mini-Boss" IsChecked="{Binding EnemyWaveData.FilterMiniBoss, Mode=TwoWay}" Margin="0,0,10,4"/>
                                        <CheckBox Content="Boss" IsChecked="{Binding EnemyWaveData.FilterBoss, Mode=TwoWay}" Margin="0,0,10,4"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Spawn Direction & Type -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Spawn Direction &amp; Type" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Randomize Direction / Wave:" ToolTip.Tip="0-1 chance for the spawn direction to change between waves." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EnemyWaveData.ChanceToRandomizeSpawnDirectionPerWave, Mode=TwoWay}" Margin="0,0,10,6"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Randomize Direction / Group:" ToolTip.Tip="0-1 chance for the spawn direction to change between groups." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EnemyWaveData.ChanceToRandomizeSpawnDirectionPerGroup, Mode=TwoWay}" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Override Spawn Type:" ToolTip.Tip="True if the spawn type should be overridden." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                        <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding EnemyWaveData.OverrideWaveSpawnType, Mode=TwoWay}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Wave Spawn Type:" ToolTip.Tip="Affects how the enemies spawn. Only does anything if Override Spawn Type is true." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                        <ComboBox Grid.Row="1" Grid.Column="3"
                                                  ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableWaveSpawnTypes}"
                                                  SelectedItem="{Binding EnemyWaveData.SurvivalWaveSpawnType, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Population Points & Ramp -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Population Points &amp; Ramp" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,2,0,0">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Population Points Total:" ToolTip.Tip="The total population points for waves. -1 is infinite." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EnemyWaveData.PopulationPointsTotal, Mode=TwoWay}" Margin="0,0,10,6"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Population Ramp Over Time (s):" ToolTip.Tip="Lerp over time for start-end population point settings." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EnemyWaveData.PopulationRampOverTime, Mode=TwoWay}" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Points Per Wave (Start):" ToolTip.Tip="Population points for a wave at start ramp." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EnemyWaveData.PopulationPointsPerWaveStart, Mode=TwoWay}" Margin="0,0,10,6"/>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Points Per Wave (End):" ToolTip.Tip="Population points for a wave at end ramp." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding EnemyWaveData.PopulationPointsPerWaveEnd, Mode=TwoWay}" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Points Per Group (Start):" ToolTip.Tip="Population points for a group at start ramp." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EnemyWaveData.PopulationPointsPerGroupStart, Mode=TwoWay}" Margin="0,0,10,6"/>

                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Points Per Group (End):" ToolTip.Tip="Population points for a group at end ramp." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding EnemyWaveData.PopulationPointsPerGroupEnd, Mode=TwoWay}" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Min Points Per Group:" ToolTip.Tip="Minimum required cost for a group to spawn." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EnemyWaveData.PopulationPointsMinPerGroup, Mode=TwoWay}" Margin="0,0,10,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- AWO Conditional: CleanUpEnemiesBehind [CloseSecurityDoor] -->
                    <CheckBox Content="Clean Up Enemies Behind"
                              IsChecked="{Binding CleanUpEnemiesBehind, Mode=TwoWay}"
                              IsVisible="{Binding IsCleanUpEnemiesBehindVisible}"
                              ToolTip.Tip="Despawns any enemies remaining on the opposite side of the door from where the host is."
                              Foreground="#87CEEB"/>

                    <!-- AWO Conditional: SpecialText [LockSecurityDoor, SetDoorInteraction] -->
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsSpecialTextVisible}">
                        <TextBlock Grid.Column="0" Text="Special Text:" ToolTip.Tip="Custom text to be applied to the door." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#87CEEB"/>
                        <TextBox Grid.Column="1" Text="{Binding SpecialText, Mode=TwoWay}"/>
                    </Grid>

                    <!-- AWO Conditional: Reactor [ModifyReactorWaveState] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsReactorVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Reactor Wave State" FontWeight="Bold" Foreground="#87CEEB" FontSize="12" ToolTip.Tip="Define the reactor wave state to jump to."/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="State:" ToolTip.Tip="The state of the new wave." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableReactorStates}"
                                          SelectedItem="{Binding Reactor.State, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Wave:" ToolTip.Tip="The 1-based index of the new wave. 1 means the first wave, 2 means the second wave, etc." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding Reactor.Wave, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="4" Text="Progress:" ToolTip.Tip="0-1 value for how far into the new state to jump to. 0 means the start, 1 means the end." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="5" Text="{Binding Reactor.Progress, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: Countdown [Countdown] -->
                    <Expander IsVisible="{Binding IsCountdownVisible}"
                              Background="#252526"
                              BorderBrush="#3E3E42"
                              BorderThickness="1"
                              CornerRadius="4"
                              HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="Countdown Configuration" FontWeight="SemiBold" ToolTip.Tip="The config settings of the countdown" Foreground="#87CEEB"/>
                        </Expander.Header>
                        <StackPanel Spacing="10" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,*">
                                <CheckBox Grid.Column="0" Content="Can Show Hours" IsChecked="{Binding Countdown.CanShowHours, Mode=TwoWay}" ToolTip.Tip="Show the time in H:MM:SS if the duration is more than 60 minutes." Foreground="#CCCCCC" Margin="0,0,12,0"/>

                                <TextBlock Grid.Column="2" Text="Title Text:" ToolTip.Tip="Custom text for the title/header. Can be empty." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding Countdown.TitleText, Mode=TwoWay}" Margin="0,0,12,0"/>

                                <TextBlock Grid.Column="4" Text="Timer Color:" ToolTip.Tip="Accepts most HTML colors or hex values. Defaults to &quot;red&quot;" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="5" Text="{Binding Countdown.TimerColor, Mode=TwoWay}"/>
                            </Grid>

                            <!-- EventsOnProgress -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Events On Progress" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" ToolTip.Tip="Events to trigger at the given progression durations."/>
                                        <Button Grid.Column="1" Content="+ Add Progress Event" Command="{Binding Countdown.AddProgressEvent}" Background="#2E5B88" Foreground="White" Padding="8,3"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Countdown.EventsOnProgress}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E1E1E" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                            <TextBlock Grid.Column="0" Text="Progress (0.0 - 1.0):" ToolTip.Tip="0-1 value for the progress through the timer for when this event should happen. 0 is the start (full duration remaining), 1 is the end." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                                            <TextBox Grid.Column="1" Text="{Binding Progress, Mode=TwoWay}" Margin="0,0,10,0"/>
                                                            <Button Grid.Column="2" Content="+ Add Event" Command="{Binding AddEvent}" Background="#2E5B88" Foreground="White" Padding="8,3" Margin="0,0,6,0"/>
                                                            <Button Grid.Column="3" Content="✕ Remove" Command="{Binding $parent[ItemsControl].DataContext.Countdown.RemoveProgressEventCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="8,3"/>
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding Events}" ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- EventsOnDone -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Events On Done" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" ToolTip.Tip="Events to trigger when the countdown finishes."/>
                                        <Button Grid.Column="1" Content="+ Add Done Event" Command="{Binding Countdown.AddDoneEvent}" Background="#2E5B88" Foreground="White" Padding="8,3"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Countdown.EventsOnDone}" ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- AWO Conditional: SetZoneLight [SetLightDataInZone] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsSetZoneLightVisible}">
                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*">
                            <TextBlock Grid.Column="0" Text="Type:" ToolTip.Tip="" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableZoneLightTypes}"
                                      SelectedItem="{Binding SetZoneLight.Type, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                            <TextBlock Grid.Column="2" Text="Light Data:" ToolTip.Tip="The new light setting" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                            <ComboBox Grid.Column="3"
                                      ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.AvailableLightingConfigs}"
                                      SelectedValue="{Binding SetZoneLight.LightDataID, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding PersistentId}"
                                      HorizontalAlignment="Stretch" Margin="0,0,10,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:LightSettingsBlock">
                                        <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Column="4" Text="Duration (s):" ToolTip.Tip="Time to transition to the new light settings" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                            <TextBox Grid.Column="5" Text="{Binding SetZoneLight.TransitionDuration, Mode=TwoWay}" Margin="0,0,10,0"/>

                            <TextBlock Grid.Column="6" Text="Seed:" ToolTip.Tip="Seed for the new light settings. 0 for random." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                            <TextBox Grid.Column="7" Text="{Binding SetZoneLight.Seed, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <!-- AWO Conditional: SpecialNumber [AlertEnemiesInZone] -->
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsSpecialNumberVisible}">
                        <TextBlock Grid.Column="0" Text="Special Number:" ToolTip.Tip="The room to wake up. -1 for all, 0 is A, 1 is B, etc." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#87CEEB"/>
                        <TextBox Grid.Column="1" Text="{Binding SpecialNumber, Mode=TwoWay}"/>
                    </Grid>

                    <!-- AWO Conditional: CleanupEnemies [CleanUpEnemiesInZone] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsCleanupEnemiesVisible}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Cleanup Enemies Configuration" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Type:" ToolTip.Tip="Whether the enemies should be killed or despawned." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableCleanupTypes}"
                                          SelectedItem="{Binding CleanupEnemies.Type, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Area:" ToolTip.Tip="The room to clean up." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="3"
                                          ItemsSource="{Binding AvailableAreas}"
                                          SelectedValue="{Binding CleanupEnemies.AreaIndex, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding AreaIndex}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AreaOption">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <CheckBox Content="Include Hibernate" IsChecked="{Binding CleanupEnemies.IncludeHibernate, Mode=TwoWay}" ToolTip.Tip="True if hibernating enemies should be cleaned up" Margin="0,0,12,4"/>
                                <CheckBox Content="Include Aggressive" IsChecked="{Binding CleanupEnemies.IncludeAggressive, Mode=TwoWay}" ToolTip.Tip="True if aggressive enemies should be cleaned up" Margin="0,0,12,4"/>
                                <CheckBox Content="Include Scout" IsChecked="{Binding CleanupEnemies.IncludeScout, Mode=TwoWay}" ToolTip.Tip="True if scouts should be cleaned up" Margin="0,0,12,4"/>
                            </WrapPanel>

                            <!-- Area Blacklist -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="6">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Area Blacklist" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="11" ToolTip.Tip="Rooms that should be excluded from this event"/>
                                        <Button Grid.Column="1" Content="+ Add Blacklist Area" Command="{Binding CleanupEnemies.AddAreaBlacklist}" Background="#2E5B88" Foreground="White" Padding="6,2" FontSize="11"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CleanupEnemies.AreaBlacklist}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <ComboBox Grid.Column="0"
                                                              ItemsSource="{Binding $parent[ItemsControl].DataContext.AvailableAreasOnly}"
                                                              SelectedValue="{Binding AreaIndex, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding AreaIndex}"
                                                              HorizontalAlignment="Stretch" Margin="0,0,6,0">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:AreaOption">
                                                                <TextBlock Text="{Binding DisplayName}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Button Grid.Column="1" Content="✕" Command="{Binding $parent[ItemsControl].DataContext.CleanupEnemies.RemoveAreaBlacklistCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="6,2"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Exclude Enemy IDs -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="6">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Exclude Enemy IDs" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="11" ToolTip.Tip="Specific enemies to be excluded from this event"/>
                                        <Button Grid.Column="1" Content="+ Add Exclude Enemy" Command="{Binding CleanupEnemies.AddExcludeEnemy}" Background="#2E5B88" Foreground="White" Padding="6,2" FontSize="11"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CleanupEnemies.ExcludeEnemyIDs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <ComboBox Grid.Column="0"
                                                              ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                                              SelectedValue="{Binding EnemyID, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding PersistentId}"
                                                              HorizontalAlignment="Stretch" Margin="0,0,6,0">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:EnemyEntry">
                                                                <TextBlock Text="{Binding DisplayText}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Button Grid.Column="1" Content="✕" Command="{Binding $parent[ItemsControl].DataContext.CleanupEnemies.RemoveExcludeEnemyCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="6,2"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Include Only IDs -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="6">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Include Only IDs" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="11" ToolTip.Tip="Specific enemies to exclusively be used for this event"/>
                                        <Button Grid.Column="1" Content="+ Add Include Enemy" Command="{Binding CleanupEnemies.AddIncludeOnlyEnemy}" Background="#2E5B88" Foreground="White" Padding="6,2" FontSize="11"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CleanupEnemies.IncludeOnlyIDs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <ComboBox Grid.Column="0"
                                                              ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                                              SelectedValue="{Binding EnemyID, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding PersistentId}"
                                                              HorizontalAlignment="Stretch" Margin="0,0,6,0">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:EnemyEntry">
                                                                <TextBlock Text="{Binding DisplayText}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Button Grid.Column="1" Content="✕" Command="{Binding $parent[ItemsControl].DataContext.CleanupEnemies.RemoveIncludeOnlyEnemyCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="6,2"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: SpawnHibernates [SpawnHibernateInZone] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsSpawnHibernatesVisible}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Spawn Hibernates Configuration" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Area:" ToolTip.Tip="The room to spawn the enemies in" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableAreas}"
                                          SelectedValue="{Binding SpawnHibernates.AreaIndex, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding AreaIndex}"
                                          HorizontalAlignment="Stretch" Margin="0,0,10,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AreaOption">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Column="2" Text="Enemy:" ToolTip.Tip="The enemy to spawn" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="3"
                                          ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                          SelectedValue="{Binding SpawnHibernates.EnemyID, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding PersistentId}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:EnemyEntry">
                                            <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="Random Weight:" ToolTip.Tip="Determines how much randomness contributes to the &quot;available room&quot; an area has when finding a spawn area. At 0, it prioritises the most &quot;empty&quot; area. At 1, it picks among areas with equal chance." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding SpawnHibernates.PlacementRandomWeight, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Placement Score:" ToolTip.Tip="Determines how much of the room's enemy score the enemies should take up in the area they are placed in" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding SpawnHibernates.PlacementScore, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <CheckBox Grid.Column="4" Content="Reset Placement Info" IsChecked="{Binding SpawnHibernates.ResetPlacementInfo, Mode=TwoWay}" ToolTip.Tip="Resets the internal position back to  the start. Should be used if you are replacing previous spawns and duplicates with them don't matter, such as when the players have not reached the target area." Margin="0,0,10,0" Foreground="#87CEEB"/>
                                <CheckBox Grid.Column="5" Content="Randomize Rotation" IsChecked="{Binding SpawnHibernates.RandomizeRotation, Mode=TwoWay}" ToolTip.Tip="Ignore the Rotation field and make the enemy's rotation random. Only used if count = 0" Foreground="#87CEEB"/>
                            </Grid>

                            <!-- Position & Rotation for SpawnHibernates -->
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Pos X:" ToolTip.Tip="X position of where the enemy should spawn" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding SpawnHibernates.Position.X, Mode=TwoWay}" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="Y:" ToolTip.Tip="Y position of where the enemy should spawn" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding SpawnHibernates.Position.Y, Mode=TwoWay}" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="4" Text="Z:" ToolTip.Tip="Z position of where the enemy should spawn" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="5" Text="{Binding SpawnHibernates.Position.Z, Mode=TwoWay}"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Rot X:" ToolTip.Tip="X rotation of the enemy" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding SpawnHibernates.Rotation.X, Mode=TwoWay}" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="Y:" ToolTip.Tip="Y rotation of the enemy" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding SpawnHibernates.Rotation.Y, Mode=TwoWay}" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="4" Text="Z:" ToolTip.Tip="Z rotation of the enemy" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="5" Text="{Binding SpawnHibernates.Rotation.Z, Mode=TwoWay}"/>
                            </Grid>

                            <!-- Area Blacklist -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="6">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Area Blacklist" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="11" ToolTip.Tip="Areas where enemies should not be able to spawn"/>
                                        <Button Grid.Column="1" Content="+ Add Blacklist Area" Command="{Binding SpawnHibernates.AddAreaBlacklist}" Background="#2E5B88" Foreground="White" Padding="6,2" FontSize="11"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SpawnHibernates.AreaBlacklist}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <ComboBox Grid.Column="0"
                                                              ItemsSource="{Binding $parent[ItemsControl].DataContext.AvailableAreasOnly}"
                                                              SelectedValue="{Binding AreaIndex, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding AreaIndex}"
                                                              HorizontalAlignment="Stretch" Margin="0,0,6,0">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:AreaOption">
                                                                <TextBlock Text="{Binding DisplayName}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Button Grid.Column="1" Content="✕" Command="{Binding $parent[ItemsControl].DataContext.SpawnHibernates.RemoveAreaBlacklistCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="6,2"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: SpawnScouts [SpawnScoutInZone] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsSpawnScoutsVisible}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Spawn Scouts Configuration" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Area:" ToolTip.Tip="The area where the scout should be spawned" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableAreas}"
                                          SelectedValue="{Binding SpawnScouts.AreaIndex, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding AreaIndex}"
                                          HorizontalAlignment="Stretch" Margin="0,0,10,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AreaOption">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Column="2" Text="Scout Type:" ToolTip.Tip="The scout to spawn" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="3"
                                          ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableScoutTypes}"
                                          SelectedValue="{Binding SpawnScouts.ScoutType, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding Type}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ScoutTypeOption">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!-- Area Blacklist -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="6">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Area Blacklist" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="11" ToolTip.Tip="Areas that this scout cannot spawn in"/>
                                        <Button Grid.Column="1" Content="+ Add Blacklist Area" Command="{Binding SpawnScouts.AddAreaBlacklist}" Background="#2E5B88" Foreground="White" Padding="6,2" FontSize="11"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SpawnScouts.AreaBlacklist}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <ComboBox Grid.Column="0"
                                                              ItemsSource="{Binding $parent[ItemsControl].DataContext.AvailableAreasOnly}"
                                                              SelectedValue="{Binding AreaIndex, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding AreaIndex}"
                                                              HorizontalAlignment="Stretch" Margin="0,0,6,0">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:AreaOption">
                                                                <TextBlock Text="{Binding DisplayName}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Button Grid.Column="1" Content="✕" Command="{Binding $parent[ItemsControl].DataContext.SpawnScouts.RemoveAreaBlacklistCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="6,2"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: AddTerminalCommand [AddTerminalCommand] -->
                    <Expander IsVisible="{Binding IsAddTerminalCommandVisible}"
                              Background="#252526"
                              BorderBrush="#3E3E42"
                              BorderThickness="1"
                              CornerRadius="4"
                              HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="Add Terminal Command Configuration" FontWeight="SemiBold" Foreground="#87CEEB"/>
                        </Expander.Header>
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Terminal:" ToolTip.Tip="The terminal to add the command to" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableTerminals}"
                                          SelectedValue="{Binding AddTerminalCommand.TerminalIndex, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding TerminalIndex}"
                                          HorizontalAlignment="Stretch" Margin="0,0,10,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:TerminalOption">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Column="2" Text="Command Number:" ToolTip.Tip="A value for the command, representing what type of command it is. This gets internally incremented by 50, and is only one byte so the input cannot be greater than 205." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding AddTerminalCommand.CommandNumber, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="4" Text="Special Rule:" ToolTip.Tip="Rule for repeatability of the terminal command" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="5"
                                          ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableSpecialCommandRulesList}"
                                          SelectedItem="{Binding AddTerminalCommand.SpecialCommandRule, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Command:" ToolTip.Tip="The name of the command. This is what users will need to type to execute the command" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding AddTerminalCommand.Command, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Command Desc:" ToolTip.Tip="The description of the command" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding AddTerminalCommand.CommandDesc, Mode=TwoWay}"/>
                            </Grid>

                            <WrapPanel Orientation="Horizontal">
                                <CheckBox Content="Auto Indent Command Desc" IsChecked="{Binding AddTerminalCommand.AutoIndentCommandDesc, Mode=TwoWay}" ToolTip.Tip="Indent the command description" Margin="0,0,12,0" Foreground="#87CEEB"/>
                                <CheckBox Content="Progress Wait Before Events" IsChecked="{Binding AddTerminalCommand.ProgressWaitBeforeEvents, Mode=TwoWay}" ToolTip.Tip="True if the intended three-second delay before the events are run should be used." Foreground="#87CEEB"/>
                            </WrapPanel>

                            <!-- PostCommandOutputs -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="6">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Post Command Outputs" FontWeight="SemiBold" Foreground="#87CEEB" FontSize="11" ToolTip.Tip="Outputs after executing the command"/>
                                        <Button Grid.Column="1" Content="+ Add Output" Command="{Binding AddTerminalCommand.AddPostCommandOutput}" Background="#2E5B88" Foreground="White" Padding="6,2" FontSize="11"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding AddTerminalCommand.PostCommandOutputs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto" Margin="0,2">
                                                    <TextBlock Grid.Column="0" Text="Line Type:" ToolTip.Tip="The style of line" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#CCCCCC" FontSize="11"/>
                                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableTerminalLineTypes}" SelectedItem="{Binding LineType, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,6,0"/>
                                                    <TextBlock Grid.Column="2" Text="Time:" ToolTip.Tip="The delay when outputting this line. 0 for instant" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#CCCCCC" FontSize="11"/>
                                                    <TextBox Grid.Column="3" Text="{Binding Time, Mode=TwoWay}" Margin="0,0,6,0"/>
                                                    <TextBlock Grid.Column="4" Text="Output:" ToolTip.Tip="The text to be output on this line" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#CCCCCC" FontSize="11"/>
                                                    <TextBox Grid.Column="5" Text="{Binding Output, Mode=TwoWay}" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="6" Content="✕" Command="{Binding $parent[ItemsControl].DataContext.AddTerminalCommand.RemovePostCommandOutputCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="6,2"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- CommandEvents -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="6">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Command Events" FontWeight="SemiBold" Foreground="#87CEEB" FontSize="11" ToolTip.Tip="Events to be executed after the command is run"/>
                                        <Button Grid.Column="1" Content="+ Add Command Event" Command="{Binding AddTerminalCommand.AddCommandEvent}" Background="#2E5B88" Foreground="White" Padding="6,2" FontSize="11"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding AddTerminalCommand.CommandEvents}" ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- AWO Conditional: HideTerminalCommand [HideTerminalCommand] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsHideTerminalCommandVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Hide Terminal Command" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="Terminal:" ToolTip.Tip="The terminal to hide a command in" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableTerminals}"
                                          SelectedValue="{Binding HideTerminalCommand.TerminalIndex, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding TerminalIndex}"
                                          HorizontalAlignment="Stretch" Margin="0,0,10,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:TerminalOption">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <CheckBox Grid.Column="2" Content="Is AWO Command" IsChecked="{Binding HideTerminalCommand.IsAwoCommand, Mode=TwoWay}" ToolTip.Tip="Set this to true if the command you are trying to manage was created with the AddTerminalCommand event" Margin="0,0,10,0" Foreground="#87CEEB"/>

                                <TextBlock Grid.Column="3" Text="Command:" ToolTip.Tip="The command to hide. If IsAwoCommand is true, then the value here should be the same identifier from when the command you are trying to hide was created" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="4" Text="{Binding HideTerminalCommand.CommandNumber, Mode=TwoWay}" IsVisible="{Binding HideTerminalCommand.IsAwoCommand}" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="4" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableTERMCommands}" SelectedItem="{Binding HideTerminalCommand.CommandEnum, Mode=TwoWay}" IsVisible="{Binding !HideTerminalCommand.IsAwoCommand}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                <CheckBox Grid.Column="5" Content="Delete Command" IsChecked="{Binding HideTerminalCommand.DeleteCommand, Mode=TwoWay}" ToolTip.Tip="True if the command should be deleted on removal instead of just hidden" Foreground="#87CEEB"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: UnhideTerminalCommand [UnhideTerminalCommand] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsUnhideTerminalCommandVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Unhide Terminal Command" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,*">
                                <TextBlock Grid.Column="0" Text="Terminal:" ToolTip.Tip="The terminal to unhide a command on" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableTerminals}"
                                          SelectedValue="{Binding UnhideTerminalCommand.TerminalIndex, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding TerminalIndex}"
                                          HorizontalAlignment="Stretch" Margin="0,0,10,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:TerminalOption">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <CheckBox Grid.Column="2" Content="Is AWO Command" IsChecked="{Binding UnhideTerminalCommand.IsAwoCommand, Mode=TwoWay}" ToolTip.Tip="" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="3" Text="Command:" ToolTip.Tip="The command to unhide. If IsAwoCommand is true, then the value here should be the same identifier from when the command you are trying to unhide was created" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="4" Text="{Binding UnhideTerminalCommand.CommandNumber, Mode=TwoWay}" IsVisible="{Binding UnhideTerminalCommand.IsAwoCommand}"/>
                                <ComboBox Grid.Column="4" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableTERMCommands}" SelectedItem="{Binding UnhideTerminalCommand.CommandEnum, Mode=TwoWay}" IsVisible="{Binding !UnhideTerminalCommand.IsAwoCommand}" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: ActiveEnemyWave [SetActiveEnemyWave] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsActiveEnemyWaveVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Active Enemy Wave" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <CheckBox Content="Has Active Enemy Wave" IsChecked="{Binding ActiveEnemyWave.HasActiveEnemyWave, Mode=TwoWay}" ToolTip.Tip="Whether this door should be a blood door" Margin="0,0,0,6"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Group Infront Of Door:" ToolTip.Tip="The enemy group to spawn in front of the door" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding ActiveEnemyWave.EnemyGroupInfrontOfDoor, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Group In Area:" ToolTip.Tip="The enemy group to spawn inside the room" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding ActiveEnemyWave.EnemyGroupInArea, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="4" Text="Groups In Area:" ToolTip.Tip="Determines how many times the EnemyGroupInArea should be spawned" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="5" Text="{Binding ActiveEnemyWave.EnemyGroupsInArea, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: GiveResource [GiveResource] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsGiveResourceVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Give Resource" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Health:" ToolTip.Tip="Gives health, where 1.0 = 100% health" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding GiveResource.Health, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Main Ammo:" ToolTip.Tip="Gives ammo, where 1.0 = 5 ammo pack uses" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding GiveResource.MainAmmo, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="4" Text="Special Ammo:" ToolTip.Tip="Gives special ammo, where 1.0 = 5 ammo pack uses" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="5" Text="{Binding GiveResource.SpecialAmmo, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="6" Text="Tool Ammo:" ToolTip.Tip="Gives tool ammo, where 1.0 = 5 tool pack uses" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="7" Text="{Binding GiveResource.ToolAmmo, Mode=TwoWay}"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                <TextBlock Text="Target Players:" ToolTip.Tip="The players who should be targeted by this event" VerticalAlignment="Center" Foreground="#87CEEB"/>
                                <CheckBox Content="Woods" IsChecked="{Binding GiveResource.PlayerWoods, Mode=TwoWay}" ToolTip.Tip="Player 1"/>
                                <CheckBox Content="Dauda" IsChecked="{Binding GiveResource.PlayerDauda, Mode=TwoWay}" ToolTip.Tip="Player 2"/>
                                <CheckBox Content="Hackett" IsChecked="{Binding GiveResource.PlayerHackett, Mode=TwoWay}" ToolTip.Tip="Player 3"/>
                                <CheckBox Content="Bishop" IsChecked="{Binding GiveResource.PlayerBishop, Mode=TwoWay}" ToolTip.Tip="Player 4"/>
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <CheckBox Content="Full Team Overflow" IsChecked="{Binding GiveResource.FullTeamOverflow, Mode=TwoWay}" ToolTip.Tip="Used if you are trying to support extended players from the LobbyExpansion mod. Only works if the number of players is at least 5." Margin="0,0,12,0" Foreground="#87CEEB"/>
                                <CheckBox Content="Use Location" IsChecked="{Binding GiveResource.UseLocation, Mode=TwoWay}" ToolTip.Tip="If true, then only players in the specified location will be affected" Margin="0,0,12,0" Foreground="#87CEEB"/>
                                <CheckBox Content="Include Supply Efficiency" IsChecked="{Binding GiveResource.IncludeSupplyEfficiency, Mode=TwoWay}" ToolTip.Tip="If true, supply efficiency boosters will affect the amount of resources given" Foreground="#87CEEB"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: NestedEvent [NestedEvent] -->
                    <Expander IsVisible="{Binding IsNestedEventVisible}"
                              Background="#252526"
                              BorderBrush="#3E3E42"
                              BorderThickness="1"
                              CornerRadius="4"
                              HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="Nested Event Configuration" FontWeight="SemiBold" ToolTip.Tip="Events within this event" Foreground="#87CEEB"/>
                        </Expander.Header>
                        <StackPanel Spacing="10" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="Type:" ToolTip.Tip="Type of the event to execute" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableNestedEventTypes}" SelectedItem="{Binding NestedEvent.Type, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Max Random Events:" ToolTip.Tip="The maximum number of events from the given list to be executed" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding NestedEvent.MaxRandomEvents, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <CheckBox Grid.Column="4" Content="Allow Repeats In Random" IsChecked="{Binding NestedEvent.AllowRepeatsInRandom, Mode=TwoWay}" ToolTip.Tip="If true, the same event can be executed multiple times from the list (execute with replacement as opposed to execute without replacement)." Foreground="#CCCCCC"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                <TextBlock Text="Target Players:" ToolTip.Tip="Players to be affected by this event" VerticalAlignment="Center" Foreground="#87CEEB"/>
                                <CheckBox Content="Woods" IsChecked="{Binding NestedEvent.PlayerWoods, Mode=TwoWay}" ToolTip.Tip="Player 1"/>
                                <CheckBox Content="Dauda" IsChecked="{Binding NestedEvent.PlayerDauda, Mode=TwoWay}" ToolTip.Tip="Player 2"/>
                                <CheckBox Content="Hackett" IsChecked="{Binding NestedEvent.PlayerHackett, Mode=TwoWay}" ToolTip.Tip="Player 3"/>
                                <CheckBox Content="Bishop" IsChecked="{Binding NestedEvent.PlayerBishop, Mode=TwoWay}" ToolTip.Tip="Player 4"/>
                            </StackPanel>

                            <!-- EventsToActivate -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Events To Activate" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" ToolTip.Tip="The events to activate"/>
                                        <Button Grid.Column="1" Content="+ Add Event" Command="{Binding NestedEvent.AddEventToActivate}" Background="#2E5B88" Foreground="White" Padding="8,3"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding NestedEvent.EventsToActivate}" ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                </StackPanel>
                            </Border>

                            <!-- WheelOfEvents -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Wheel Of Events (RandomWeighted)" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" ToolTip.Tip="Groups of events to activate at random"/>
                                        <Button Grid.Column="1" Content="+ Add Wheel Item" Command="{Binding NestedEvent.AddWheelItem}" Background="#2E5B88" Foreground="White" Padding="8,3"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding NestedEvent.WheelOfEvents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E1E1E" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,Auto,Auto">
                                                            <TextBlock Grid.Column="0" Text="Debug Name:" ToolTip.Tip="Debug name for this option on the wheel" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB" FontSize="11"/>
                                                            <TextBox Grid.Column="1" Text="{Binding DebugName, Mode=TwoWay}" Margin="0,0,6,0"/>

                                                            <TextBlock Grid.Column="2" Text="Weight:" ToolTip.Tip="The weighted probability of this item being chosen" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB" FontSize="11"/>
                                                            <TextBox Grid.Column="3" Text="{Binding Weight, Mode=TwoWay}" Margin="0,0,6,0"/>

                                                            <TextBlock Grid.Column="4" Text="Repeat Count:" ToolTip.Tip="The number of times this group can be selected if both AllowRepeatsInRandom and IsInfinite are false." VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB" FontSize="11"/>
                                                            <TextBox Grid.Column="5" Text="{Binding RepeatCount, Mode=TwoWay}" Margin="0,0,6,0"/>

                                                            <CheckBox Grid.Column="6" Content="Is Infinite" IsChecked="{Binding IsInfinite, Mode=TwoWay}" ToolTip.Tip="If true, this group can be rerolled indefinitely." Margin="0,0,6,0"/>

                                                            <Button Grid.Column="7" Content="+ Add Event" Command="{Binding AddEvent}" Background="#2E5B88" Foreground="White" Padding="6,2" Margin="0,0,4,0"/>
                                                            <Button Grid.Column="8" Content="✕ Remove" Command="{Binding $parent[ItemsControl].DataContext.NestedEvent.RemoveWheelItemCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="6,2"/>
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding Events}" ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- AWO Conditional: EventLoop [StartEventLoop] -->
                    <Expander IsVisible="{Binding IsEventLoopVisible}"
                              Background="#252526"
                              BorderBrush="#3E3E42"
                              BorderThickness="1"
                              CornerRadius="4"
                              HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="Event Loop Configuration" FontWeight="SemiBold" Foreground="#87CEEB"/>
                        </Expander.Header>
                        <StackPanel Spacing="10" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Loop Index:" ToolTip.Tip="An identifier value used to keep track of active loops." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding EventLoop.LoopIndex, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Loop Delay (s):" ToolTip.Tip="How long to wait between executions of these events" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding EventLoop.LoopDelay, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="4" Text="Loop Count (-1 for inf):" ToolTip.Tip="Number of times to execute these events" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="5" Text="{Binding EventLoop.LoopCount, Mode=TwoWay}"/>
                            </Grid>

                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Events To Activate" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" ToolTip.Tip="Events to activate every loop"/>
                                        <Button Grid.Column="1" Content="+ Add Event" Command="{Binding EventLoop.AddEventToActivate}" Background="#2E5B88" Foreground="White" Padding="8,3"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding EventLoop.EventsToActivate}" ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- AWO Conditional: TeleportPlayer [TeleportPlayer] -->
                    <Expander IsVisible="{Binding IsTeleportPlayerVisible}"
                              Background="#252526"
                              BorderBrush="#3E3E42"
                              BorderThickness="1"
                              CornerRadius="4"
                              HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="Teleport Player Configuration" FontWeight="SemiBold" Foreground="#87CEEB"/>
                        </Expander.Header>
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox Content="Flash Teleport" IsChecked="{Binding TeleportPlayer.FlashTeleport, Mode=TwoWay}" ToolTip.Tip="Warp players back to their original dimension and position. This applies to all players listed in TPData." Margin="0,0,12,4"/>
                                <CheckBox Content="Warp Sentries" IsChecked="{Binding TeleportPlayer.WarpSentries, Mode=TwoWay}" ToolTip.Tip="Toggle warping sentries. This applies to all players listed in TPData with sentries." Margin="0,0,12,4"/>
                                <CheckBox Content="Warp Big Pickups" IsChecked="{Binding TeleportPlayer.WarpBigPickups, Mode=TwoWay}" ToolTip.Tip="Big pickups held by players will be warped with the player holding it. Otherwise, each item is sent to a random player. BigPickups can only be warped if FlashTeleport is false, all players are being warped, the item has been picked up at least once, and the item is capable of being warped." Margin="0,0,12,4"/>
                                <CheckBox Content="Send Big Pickups To Host" IsChecked="{Binding TeleportPlayer.SendBigPickupsToHost, Mode=TwoWay}" ToolTip.Tip="Override for the default random behaviour with warping big pickups; instead sends all big pickups to the host upon teleport." Margin="0,0,12,4"/>
                                <CheckBox Content="Full Team Overflow" IsChecked="{Binding TeleportPlayer.FullTeamOverflow, Mode=TwoWay}" ToolTip.Tip="Used when wanting to support extended players from LobbyExpansion. Only works if the number of players in the lobby is at least 5, there are four TPDatas, and there are no TPDatas for extended player indices." Margin="0,0,12,4"/>
                            </WrapPanel>

                            <!-- FromLocation -->
                            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="4">
                                    <CheckBox Content="From Location Enabled" IsChecked="{Binding TeleportPlayer.FromLocation.Enabled, Mode=TwoWay}" ToolTip.Tip="Whether to enable or disable the FromLocation filter" Foreground="#87CEEB"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" IsVisible="{Binding TeleportPlayer.FromLocation.Enabled}">
                                        <TextBlock Grid.Column="0" Text="Dimension:" ToolTip.Tip="The dimension to teleport to" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                        <TextBox Grid.Column="1" Text="{Binding TeleportPlayer.FromLocation.DimensionIndex, Mode=TwoWay}" Margin="0,0,10,0"/>

                                        <TextBlock Grid.Column="2" Text="Layer:" ToolTip.Tip="The sector to teleport to" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                        <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableSectors}" SelectedItem="{Binding TeleportPlayer.FromLocation.Layer, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                        <TextBlock Grid.Column="4" Text="Zone:" ToolTip.Tip="The zone to teleport to" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                        <TextBox Grid.Column="5" Text="{Binding TeleportPlayer.FromLocation.LocalIndex, Mode=TwoWay}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- TPData -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Player Specific TP Data (Optional overrides per player)" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" ToolTip.Tip="List of warp data for specific players. Can be greater than 4."/>
                                        <Button Grid.Column="1" Content="+ Add Player TP Data" Command="{Binding TeleportPlayer.AddTPData}" Background="#2E5B88" Foreground="White" Padding="8,3"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding TeleportPlayer.TPData}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E1E1E" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto,Auto">
                                                            <TextBlock Grid.Column="0" Text="Player:" ToolTip.Tip="The Xth player to join the lobby. Can be greater than 4" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                            <TextBox Grid.Column="1" Text="{Binding PlayerIndex, Mode=TwoWay}" Margin="0,0,8,0"/>

                                                            <TextBlock Grid.Column="2" Text="Dimension:" ToolTip.Tip="The dimension to teleport the player to" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                            <TextBox Grid.Column="3" Text="{Binding DimensionIndex, Mode=TwoWay}" Margin="0,0,8,0"/>

                                                            <CheckBox Grid.Column="4" Content="Play Warp Animation" IsChecked="{Binding PlayWarpAnimation, Mode=TwoWay}" ToolTip.Tip="True if the warp animation should be played." Margin="0,0,8,0"/>
                                                            <Button Grid.Column="6" Content="✕ Remove" Command="{Binding $parent[ItemsControl].DataContext.TeleportPlayer.RemoveTPDataCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="6,2"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*">
                                                            <TextBlock Grid.Column="0" Text="Pos X:" ToolTip.Tip="Override X position for this player's warp" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                            <TextBox Grid.Column="1" Text="{Binding Position.X, Mode=TwoWay}" Margin="0,0,6,0"/>

                                                            <TextBlock Grid.Column="2" Text="Y:" ToolTip.Tip="Override Y position for this player's warp" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                            <TextBox Grid.Column="3" Text="{Binding Position.Y, Mode=TwoWay}" Margin="0,0,6,0"/>

                                                            <TextBlock Grid.Column="4" Text="Z:" ToolTip.Tip="Override Z position for this player's warp" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                            <TextBox Grid.Column="5" Text="{Binding Position.Z, Mode=TwoWay}" Margin="0,0,6,0"/>

                                                            <TextBlock Grid.Column="6" Text="Flash Duration:" ToolTip.Tip="How long players should be in the other dimension for when Flash Teleport is true" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                            <TextBox Grid.Column="7" Text="{Binding FlashDuration, Mode=TwoWay}"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="Auto,*,Auto,*">
                                                            <TextBlock Grid.Column="0" Text="Filter:" ToolTip.Tip="WorldEventObjectFilter" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                            <TextBox Grid.Column="1" Text="{Binding WorldEventObjectFilter, Mode=TwoWay}" Margin="0,0,8,0"/>

                                                            <CheckBox Grid.Column="2" Content="Use Look Vector (V3)" IsChecked="{Binding UseLookDirectionVector, Mode=TwoWay}" ToolTip.Tip="If true, allows users to set an actual X/Y/Z look direction instead of a simple cardinal direction" Margin="0,0,8,0"/>
                                                            <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableTeleportLookDirections}" SelectedItem="{Binding LookDirection, Mode=TwoWay}" IsVisible="{Binding !UseLookDirectionVector}" HorizontalAlignment="Stretch"/>
                                                            <Grid Grid.Column="3" ColumnDefinitions="Auto,*,Auto,*,Auto,*" IsVisible="{Binding UseLookDirectionVector}">
                                                                <TextBlock Grid.Column="0" Text="X:" ToolTip.Tip="X direction for the player to look" VerticalAlignment="Center" Margin="0,0,2,0" Foreground="#87CEEB"/>
                                                                <TextBox Grid.Column="1" Text="{Binding LookDirectionV3.X, Mode=TwoWay}" Margin="0,0,4,0"/>
                                                                <TextBlock Grid.Column="2" Text="Y:" ToolTip.Tip="Y direction for the player to look" VerticalAlignment="Center" Margin="0,0,2,0" Foreground="#87CEEB"/>
                                                                <TextBox Grid.Column="3" Text="{Binding LookDirectionV3.Y, Mode=TwoWay}" Margin="0,0,4,0"/>
                                                                <TextBlock Grid.Column="4" Text="Z:" ToolTip.Tip="Z direction for the player to look" VerticalAlignment="Center" Margin="0,0,2,0" Foreground="#87CEEB"/>
                                                                <TextBox Grid.Column="5" Text="{Binding LookDirectionV3.Z, Mode=TwoWay}"/>
                                                            </Grid>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- AWO Conditional: InfectPlayer [InfectPlayer] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsInfectPlayerVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Infect Player Configuration" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Target Players:" ToolTip.Tip="Players to infect" VerticalAlignment="Center" Foreground="#87CEEB"/>
                                <CheckBox Content="Woods" IsChecked="{Binding InfectPlayer.PlayerWoods, Mode=TwoWay}" ToolTip.Tip="Player 1"/>
                                <CheckBox Content="Dauda" IsChecked="{Binding InfectPlayer.PlayerDauda, Mode=TwoWay}" ToolTip.Tip="Player 2"/>
                                <CheckBox Content="Hackett" IsChecked="{Binding InfectPlayer.PlayerHackett, Mode=TwoWay}" ToolTip.Tip="Player 3"/>
                                <CheckBox Content="Bishop" IsChecked="{Binding InfectPlayer.PlayerBishop, Mode=TwoWay}" ToolTip.Tip="Player 4"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="Infection Amount:" ToolTip.Tip="The amount to add (or subtract) from the player's infection level" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding InfectPlayer.InfectionAmount, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Interval (s):" ToolTip.Tip="The duration of the InfectOverTime" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding InfectPlayer.Interval, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <CheckBox Grid.Column="4" Content="Infect Over Time" IsChecked="{Binding InfectPlayer.InfectOverTime, Mode=TwoWay}" ToolTip.Tip="If true, it will infect over time for the given interval" Margin="0,0,10,0"/>
                                <CheckBox Grid.Column="5" Content="Full Team Overflow" IsChecked="{Binding InfectPlayer.FullTeamOverflow, Mode=TwoWay}" ToolTip.Tip="Used if you are trying to support extended players from the LobbyExpansion mod. Only works if the number of players is at least 5." Margin="0,0,10,0"/>
                                <CheckBox Grid.Column="6" Content="Use Zone" IsChecked="{Binding InfectPlayer.UseZone, Mode=TwoWay}" ToolTip.Tip="Apply infection only to players in this zone"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: DamagePlayer [DamagePlayer] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsDamagePlayerVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Damage Player Configuration" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Target Players:" ToolTip.Tip="The players to apply damage to" VerticalAlignment="Center" Foreground="#87CEEB"/>
                                <CheckBox Content="Woods" IsChecked="{Binding DamagePlayer.PlayerWoods, Mode=TwoWay}" ToolTip.Tip="Player 1"/>
                                <CheckBox Content="Dauda" IsChecked="{Binding DamagePlayer.PlayerDauda, Mode=TwoWay}" ToolTip.Tip="Player 2"/>
                                <CheckBox Content="Hackett" IsChecked="{Binding DamagePlayer.PlayerHackett, Mode=TwoWay}" ToolTip.Tip="Player 3"/>
                                <CheckBox Content="Bishop" IsChecked="{Binding DamagePlayer.PlayerBishop, Mode=TwoWay}" ToolTip.Tip="Player 4"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Damage Amount:" ToolTip.Tip="The amount to damage players. This can kill and heal players. Note that players actually have 25 health, not 100, so 3 damage is actually 12%" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding DamagePlayer.DamageAmount, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Interval (s):" ToolTip.Tip="The interval of the DamageOverTime" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding DamagePlayer.Interval, Mode=TwoWay}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <CheckBox Content="Deal % Damage" IsChecked="{Binding DamagePlayer.DealPercentageDamage, Mode=TwoWay}" ToolTip.Tip="This can be useful for rundowns which change the value for player health"/>
                                <CheckBox Content="Damage Over Time" IsChecked="{Binding DamagePlayer.DamageOverTime, Mode=TwoWay}" ToolTip.Tip="Toggle applying a fraction of the DamageAmount per interval"/>
                                <CheckBox Content="Full Team Overflow" IsChecked="{Binding DamagePlayer.FullTeamOverflow, Mode=TwoWay}" ToolTip.Tip="Used if you are trying to support extended players from the LobbyExpansion mod. Only works if the number of players is at least 5."/>
                                <CheckBox Content="Use Zone" IsChecked="{Binding DamagePlayer.UseZone, Mode=TwoWay}" ToolTip.Tip="Apply damage only if players are in the specified zone"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: RevivePlayer [RevivePlayer] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsRevivePlayerVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Revive Player Configuration" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Target Players:" ToolTip.Tip="Players to revive" VerticalAlignment="Center" Foreground="#87CEEB"/>
                                <CheckBox Content="Woods" IsChecked="{Binding RevivePlayer.PlayerWoods, Mode=TwoWay}" ToolTip.Tip="Player 1"/>
                                <CheckBox Content="Dauda" IsChecked="{Binding RevivePlayer.PlayerDauda, Mode=TwoWay}" ToolTip.Tip="Player 2"/>
                                <CheckBox Content="Hackett" IsChecked="{Binding RevivePlayer.PlayerHackett, Mode=TwoWay}" ToolTip.Tip="Player 3"/>
                                <CheckBox Content="Bishop" IsChecked="{Binding RevivePlayer.PlayerBishop, Mode=TwoWay}" ToolTip.Tip="Player 4"/>
                                <CheckBox Content="Full Team Overflow" IsChecked="{Binding RevivePlayer.FullTeamOverflow, Mode=TwoWay}" ToolTip.Tip="Used if you are trying to support extended players from the LobbyExpansion mod. Only works if the number of players is at least 5." Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: AdjustTimer [AdjustAWOTimer] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsAdjustTimerVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Adjust AWO Timer Configuration" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Duration:" ToolTip.Tip="Time/amount to modify by. Does nothing for a value of 0. For countdowns, positive values increase the time remaining, for countups, positive values adds to the counter." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding AdjustTimer.Duration, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Speed:" ToolTip.Tip="Only works for countup. Can be positive or negative, normal speed is 1.0" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding AdjustTimer.Speed, Mode=TwoWay}"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                <CheckBox Grid.Column="0" Content="Update Title" IsChecked="{Binding AdjustTimer.UpdateTitleText, Mode=TwoWay}" ToolTip.Tip="True if you are trying to edit the title" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" Text="{Binding AdjustTimer.TitleText, Mode=TwoWay}" IsVisible="{Binding AdjustTimer.UpdateTitleText}" Margin="0,0,10,0"/>

                                <CheckBox Grid.Column="2" Content="Update Body" IsChecked="{Binding AdjustTimer.UpdateBodyText, Mode=TwoWay}" ToolTip.Tip="True if you are trying to edit the body" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="3" Text="{Binding AdjustTimer.BodyText, Mode=TwoWay}" IsVisible="{Binding AdjustTimer.UpdateBodyText}" Margin="0,0,10,0"/>

                                <CheckBox Grid.Column="4" Content="Update Color" IsChecked="{Binding AdjustTimer.UpdateColor, Mode=TwoWay}" ToolTip.Tip="True if you are trying to edit the color" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="5" Text="{Binding AdjustTimer.TimerColor, Mode=TwoWay}" IsVisible="{Binding AdjustTimer.UpdateColor}"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,*">
                                <CheckBox Grid.Column="0" Content="Update Special HUD" IsChecked="{Binding AdjustTimer.UpdateSpecialHud, Mode=TwoWay}" ToolTip.Tip="If there is an active, timed, indexed SpecialHud (StartIndexTimer), toggle to change its time" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="HUD Index:" ToolTip.Tip="The index of the HUD item, as defined when it was created" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB" IsVisible="{Binding AdjustTimer.UpdateSpecialHud}"/>
                                <TextBox Grid.Column="2" Text="{Binding AdjustTimer.SpecialHudIndex, Mode=TwoWay}" IsVisible="{Binding AdjustTimer.UpdateSpecialHud}" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="3" Text="Time Modifier:" ToolTip.Tip="Time / amount to modify the SpecialHud by. A positive value increases the time remaining. FOr InvertProgress true, a negative value increases the time remaining." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB" IsVisible="{Binding AdjustTimer.UpdateSpecialHud}"/>
                                <TextBox Grid.Column="4" Text="{Binding AdjustTimer.SpecialHudTimeModifier, Mode=TwoWay}" IsVisible="{Binding AdjustTimer.UpdateSpecialHud}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: Countup [Countup] -->
                    <Expander IsVisible="{Binding IsCountupVisible}"
                              Background="#252526"
                              BorderBrush="#3E3E42"
                              BorderThickness="1"
                              CornerRadius="4"
                              HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="Countup Configuration" FontWeight="SemiBold" Foreground="#87CEEB"/>
                        </Expander.Header>
                        <StackPanel Spacing="10" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Start Value:" ToolTip.Tip="The initial value of the counter. Can be negative, but cannot be greater than Duration" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding Countup.StartValue, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Speed:" ToolTip.Tip="The speed modifier for the counter. 1.0 speed = 1.0 per second. Positive increments, negative decrements." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding Countup.Speed, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="4" Text="Decimals:" ToolTip.Tip="The number of decimal points to show" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="5" Text="{Binding Countup.DecimalPoints, Mode=TwoWay}"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Title Text:" ToolTip.Tip="Custom text for the title/header. Can be empty" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding Countup.TitleText, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Body Text:" ToolTip.Tip="MUST include [COUNTUP] somewhere to add the counter element. Additionally, [CMAX] can be used to show the duration." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding Countup.BodyText, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="4" Text="Timer Color:" ToolTip.Tip="The color of the timer. Accepts most html colors or hex values" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="5" Text="{Binding Countup.TimerColor, Mode=TwoWay}"/>
                            </Grid>

                            <!-- EventsOnProgress -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Events On Progress" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" ToolTip.Tip="Events to trigger at specific progression intervals"/>
                                        <Button Grid.Column="1" Content="+ Add Progress Event" Command="{Binding Countup.AddProgressEvent}" Background="#2E5B88" Foreground="White" Padding="8,3"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Countup.EventsOnProgress}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E1E1E" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                            <TextBlock Grid.Column="0" Text="Progress (0.0 - 1.0):" ToolTip.Tip="The progress through the countup for this event to trigger. 0 is the start, 1 is the end" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                                            <TextBox Grid.Column="1" Text="{Binding Progress, Mode=TwoWay}" Margin="0,0,10,0"/>
                                                            <Button Grid.Column="2" Content="+ Add Event" Command="{Binding AddEvent}" Background="#2E5B88" Foreground="White" Padding="8,3" Margin="0,0,6,0"/>
                                                            <Button Grid.Column="3" Content="✕ Remove" Command="{Binding $parent[ItemsControl].DataContext.Countup.RemoveProgressEventCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="8,3"/>
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding Events}" ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- EventsOnDone -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Events On Done" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" ToolTip.Tip="Events to trigger when the countup finishes"/>
                                        <Button Grid.Column="1" Content="+ Add Done Event" Command="{Binding Countup.AddDoneEvent}" Background="#2E5B88" Foreground="White" Padding="8,3"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Countup.EventsOnDone}" ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- AWO Conditional: NavMarker [SpawnNavMarker] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsNavMarkerVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Nav Marker Configuration" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="Index:" ToolTip.Tip="An integer identifier for the marker." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding NavMarker.Index, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Style:" ToolTip.Tip="The marker style." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="3"
                                          ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableMarkerStyles}"
                                          SelectedItem="{Binding NavMarker.Style, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="4" Text="Title:" ToolTip.Tip="The custom text on the nav marker" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="5" Text="{Binding NavMarker.Title, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="6" Text="Color:" ToolTip.Tip="The hex colour of the nav marker" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="7" Text="{Binding NavMarker.Color, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <CheckBox Grid.Column="8" Content="Use Pin" IsChecked="{Binding NavMarker.UsePin, Mode=TwoWay}" ToolTip.Tip="If true, there will be a little white dot at the bottom of the nav marker"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: CameraShake [ShakeScreen] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsCameraShakeVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Camera Shake Configuration" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="Radius:" ToolTip.Tip="The distance from the local player position that the camera will shake for" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding CameraShake.Radius, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Amplitude:" ToolTip.Tip="The intensity of the shake. This is affected by the in-game setting." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding CameraShake.Amplitude, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="4" Text="Frequency:" ToolTip.Tip="How often the shake will occur throughout the duration" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="5" Text="{Binding CameraShake.Frequency, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <CheckBox Grid.Column="6" Content="Directional" IsChecked="{Binding CameraShake.Directional, Mode=TwoWay}" ToolTip.Tip="Relates to the direction in which someone is situated. Not even the AWO devs know what this does."/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: Portal [StartPortalMachine] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsPortalVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Portal Configuration" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="Target Dimension:" ToolTip.Tip="The dimension to teleport to" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding Portal.TargetDimension, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Teleport Delay (s):" ToolTip.Tip="The delay before teleportation" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding Portal.TeleportDelay, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <CheckBox Grid.Column="4" Content="Prevent Portal Warp Team Event" IsChecked="{Binding Portal.PreventPortalWarpTeamEvent, Mode=TwoWay}" ToolTip.Tip="If true, change the internal Type 8 to a Type 0 to do nothing. Use this field if you want more complex warping than the Type 8"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: SuccessScreen [SetSuccessScreen] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsSuccessScreenVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Success Screen Configuration" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <CheckBox Content="Override Success Screen Object" IsChecked="{Binding SuccessScreen.HasSuccessScreen, Mode=TwoWay}" ToolTip.Tip="Set to true to override the success screen" Foreground="#87CEEB"/>
                            <StackPanel Spacing="6" IsVisible="{Binding SuccessScreen.HasSuccessScreen}">
                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                    <TextBlock Grid.Column="0" Text="Type:" ToolTip.Tip="Is this screen real or fake" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableSuccessScreenTypes}" SelectedItem="{Binding SuccessScreen.Type, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                    <TextBlock Grid.Column="2" Text="Success Screen:" ToolTip.Tip="The success screen to display" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableSuccessScreens}" SelectedItem="{Binding SuccessScreen.Screen, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                    <TextBlock Grid.Column="4" Text="Override Music:" ToolTip.Tip="Audio event or music ID to play" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                    <TextBox Grid.Column="5" Text="{Binding SuccessScreen.OverrideMusic, Mode=TwoWay}"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding SuccessScreen.IsCustom}">
                                    <TextBlock Grid.Column="0" Text="Custom Path:" ToolTip.Tip="Custom path to the success screen" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                    <TextBox Grid.Column="1" Text="{Binding SuccessScreen.CustomPath, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: MultiProgression [MultiProgression] -->
                    <Expander IsVisible="{Binding IsMultiProgressionVisible}"
                              Background="#252526"
                              BorderBrush="#3E3E42"
                              BorderThickness="1"
                              CornerRadius="4"
                              HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="Multi-Progression Configuration" FontWeight="SemiBold" Foreground="#87CEEB"/>
                        </Expander.Header>
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Multi-Progression Items" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                <Button Grid.Column="1" Content="+ Add Item" Command="{Binding MultiProgression.AddItem}" Background="#2E5B88" Foreground="White" Padding="8,3"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding MultiProgression.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E1E" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="Auto,*,Auto,*">
                                                    <TextBlock Grid.Column="0" Text="Header:" ToolTip.Tip="The header for the new custom sub objective" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                    <TextBox Grid.Column="1" Text="{Binding CustomSubObjectiveHeader, Mode=TwoWay}" Margin="0,0,8,0"/>

                                                    <TextBlock Grid.Column="2" Text="SubObjective:" ToolTip.Tip="The text for the new custom sub objective" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                    <TextBox Grid.Column="3" Text="{Binding CustomSubObjective, Mode=TwoWay}"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                                    <TextBlock Grid.Column="0" Text="Index:" ToolTip.Tip="Internal identifier for this custom sub objective. This is how you will keep track of your objectives" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Index, Mode=TwoWay}" Margin="0,0,8,0"/>

                                                    <TextBlock Grid.Column="2" Text="Priority:" ToolTip.Tip="Determines the order of the elements in the objective view on the hud. Primary objectives are int.MaxValue, progression objectives are 0, and a normal custom sub objective is int.MinValue" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                    <TextBox Grid.Column="3" Text="{Binding Priority, Mode=TwoWay}" Margin="0,0,8,0"/>

                                                    <TextBlock Grid.Column="4" Text="Layer:" ToolTip.Tip="The layer this objective belongs to" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                    <ComboBox Grid.Column="5" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableSectors}" SelectedItem="{Binding Layer, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                    <TextBlock Grid.Column="0" Text="Override Tag:" ToolTip.Tip="If Progression, the tag will be PROGRESSION (localized). For localization purposes, the TextDB IDs for the different layer tags are: PROGRESSION 0, MAIN 1729980802, SECONDARY 3356421220, OVERLOAD 192007757, or Custom to specify a custom tag." VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableMultiProgressionOverrideTags}" SelectedItem="{Binding OverrideTag, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                                    <CheckBox Grid.Column="2" Content="Layer Independent" IsChecked="{Binding IsLayerIndependent, Mode=TwoWay}" ToolTip.Tip="If true, this will be visible in all layers" Margin="0,0,10,0"/>
                                                    <Button Grid.Column="3" Content="✕ Remove" Command="{Binding $parent[ItemsControl].DataContext.MultiProgression.RemoveItemCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="8,3"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsCustom}">
                                                    <TextBlock Grid.Column="0" Text="Custom Tag:" ToolTip.Tip="Custom string for the override tag (will be compiled to a TextDB item during export)" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                    <TextBox Grid.Column="1" Text="{Binding CustomOverrideTag, Mode=TwoWay}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <!-- AWO Conditional: WaveRoarSound [PlayWaveRoarSound] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsWaveRoarSoundVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Wave Roar Sound Configuration" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="Roar Sound:" ToolTip.Tip="The roar sound to play" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableRoarSounds}" SelectedItem="{Binding WaveRoarSound.RoarSound, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Roar Size:" ToolTip.Tip="The size of the roar sound to play" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableRoarSizes}" SelectedItem="{Binding WaveRoarSound.RoarSize, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                <CheckBox Grid.Column="4" Content="Is Outside" IsChecked="{Binding WaveRoarSound.IsOutside, Mode=TwoWay}" ToolTip.Tip="If true, an audio filter is applied to the sound"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: CustomHud [CustomHudText] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsCustomHudVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Custom HUD Configuration" FontWeight="Bold" Foreground="#87CEEB" FontSize="12" ToolTip.Tip="Note: this is NOT an intel popup, it is effectively the &amp;disable error on terminal&amp; popup but with custom text"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Title Text:" ToolTip.Tip="The title for the display text." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding CustomHud.TitleText, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Body Text:" ToolTip.Tip="The body of the display text" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding CustomHud.BodyText, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: SpecialHud [SpecialHudTimer] -->
                    <Expander IsVisible="{Binding IsSpecialHudVisible}"
                              Background="#252526"
                              BorderBrush="#3E3E42"
                              BorderThickness="1"
                              CornerRadius="4"
                              HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="Special HUD Configuration" FontWeight="SemiBold" Foreground="#87CEEB"/>
                        </Expander.Header>
                        <StackPanel Spacing="10" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Type:" ToolTip.Tip="The mode of the SpecialHud" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableSpecialHudTypes}" SelectedItem="{Binding SpecialHud.Type, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Index:" ToolTip.Tip="Required for every mode except StartTimer. This is a unique identifier for your timer which you will need to keep track of." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding SpecialHud.Index, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="4" Text="Message:" ToolTip.Tip="The custom text for the SpecialHud" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="5" Text="{Binding SpecialHud.Message, Mode=TwoWay}"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="Style:" ToolTip.Tip="The style of the popup" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableSpecialHudStyles}" SelectedItem="{Binding SpecialHud.Style, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Priority:" ToolTip.Tip="Multiple special huds can be active at one time, and they are shown based on this priority value. Reactors are -1, downed and alarms are 0, and uplinks are 10." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding SpecialHud.Priority, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <CheckBox Grid.Column="4" Content="Show Time In Progress Bar" IsChecked="{Binding SpecialHud.ShowTimeInProgressBar, Mode=TwoWay}" ToolTip.Tip="For timed special huds, show the progress remaining" Margin="0,0,10,0"/>
                                <CheckBox Grid.Column="5" Content="Invert Progress" IsChecked="{Binding SpecialHud.InvertProgress, Mode=TwoWay}" ToolTip.Tip="For timed special huds, the time and progress are inverted"/>
                            </Grid>

                            <!-- EventsOnProgress -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Events On Progress" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" ToolTip.Tip="Events to execute at certain points in progression"/>
                                        <Button Grid.Column="1" Content="+ Add Progress Event" Command="{Binding SpecialHud.AddProgressEvent}" Background="#2E5B88" Foreground="White" Padding="8,3"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SpecialHud.EventsOnProgress}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E1E1E" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                            <TextBlock Grid.Column="0" Text="Progress (0.0 - 1.0):" ToolTip.Tip="0-1 value for the progress through the timer for when this event should happen. 0 is the start (full duration remaining), 1 is the end." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                                            <TextBox Grid.Column="1" Text="{Binding Progress, Mode=TwoWay}" Margin="0,0,10,0"/>
                                                            <Button Grid.Column="2" Content="+ Add Event" Command="{Binding AddEvent}" Background="#2E5B88" Foreground="White" Padding="8,3" Margin="0,0,6,0"/>
                                                            <Button Grid.Column="3" Content="✕ Remove" Command="{Binding $parent[ItemsControl].DataContext.SpecialHud.RemoveProgressEventCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="8,3"/>
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding Events}" ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- EventsOnDone -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Events On Done" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" ToolTip.Tip="Events to execute when the timer is finished"/>
                                        <Button Grid.Column="1" Content="+ Add Done Event" Command="{Binding SpecialHud.AddDoneEvent}" Background="#2E5B88" Foreground="White" Padding="8,3"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SpecialHud.EventsOnDone}" ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- AWO Conditional: PlayerDialogue [ForcePlayPlayerDialogue] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsPlayerDialogueVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Player Dialogue Configuration" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Type:" ToolTip.Tip="Determines who should say the voiceline" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailablePlayerDialogueTypes}" SelectedItem="{Binding PlayerDialogue.Type, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Character:" ToolTip.Tip="The character to say the voiceline if the type is Specific" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailablePlayerCharacters}" SelectedItem="{Binding PlayerDialogue.Character, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="4" Text="Intensity State:" ToolTip.Tip="Sometimes, the same voicelines can be said differently based on the combat mode." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="5" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableDialogueIntensityStates}" SelectedItem="{Binding PlayerDialogue.IntensityState, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: SetTerminalLog [SetTerminalLog] -->
                    <Expander IsVisible="{Binding IsSetTerminalLogVisible}"
                              Background="#252526"
                              BorderBrush="#3E3E42"
                              BorderThickness="1"
                              CornerRadius="4"
                              HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="Set Terminal Log Configuration" FontWeight="SemiBold" Foreground="#87CEEB"/>
                        </Expander.Header>
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Terminal:" ToolTip.Tip="The terminal to edit" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableTerminals}"
                                          SelectedValue="{Binding SetTerminalLog.TerminalIndex, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding TerminalIndex}"
                                          HorizontalAlignment="Stretch" Margin="0,0,10,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:TerminalOption">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Column="2" Text="Type:" ToolTip.Tip="What you are trying to change in the logs" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableTerminalLogTypes}" SelectedItem="{Binding SetTerminalLog.Type, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="4" Text="File Name:" ToolTip.Tip="The name of the log file" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="5" Text="{Binding SetTerminalLog.FileName, Mode=TwoWay}"/>
                            </Grid>

                            <!-- If Add: file content & audio & events -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="File Content:" ToolTip.Tip="The content of the log file" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                    <TextBox Grid.Column="1" Text="{Binding SetTerminalLog.FileContent, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*">
                                    <TextBlock Grid.Column="0" Text="Audio File ID:" ToolTip.Tip="The ID of the audio file to be played with the log" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                    <TextBox Grid.Column="1" Text="{Binding SetTerminalLog.AttachedAudioFile, Mode=TwoWay}" Margin="0,0,6,0"/>

                                    <TextBlock Grid.Column="2" Text="Audio Size:" ToolTip.Tip="The size of the audio file. Purely visual" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                    <TextBox Grid.Column="3" Text="{Binding SetTerminalLog.AttachedAudioByteSize, Mode=TwoWay}" Margin="0,0,6,0"/>

                                    <TextBlock Grid.Column="4" Text="Dialog After Audio:" ToolTip.Tip="Dialog to play after the audio has finished" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                    <TextBox Grid.Column="5" Text="{Binding SetTerminalLog.PlayerDialogToTriggerAfterAudio, Mode=TwoWay}" Margin="0,0,6,0"/>

                                    <TextBlock Grid.Column="6" Text="Original Lang:" ToolTip.Tip="The original language of the audio. English is 1" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                    <TextBox Grid.Column="7" Text="{Binding SetTerminalLog.FileContentOriginalLanguage, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>

                            <!-- If Move: target coords -->
                            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="6"
                                    IsVisible="{Binding SetTerminalLog.IsMoveType}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Target Location (For Move Type)" FontWeight="SemiBold" Foreground="#87CEEB" FontSize="11"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*">
                                        <TextBlock Grid.Column="0" Text="Target Dim:" ToolTip.Tip="The dimension of the terminal to move the log to" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.AvailableDimensions}"
                                                  SelectedValue="{Binding SetTerminalLog.TargetDimensionIndex, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding DimensionIndex}"
                                                  HorizontalAlignment="Stretch" Margin="0,0,6,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:DimensionOption">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Column="2" Text="Target Layer:" ToolTip.Tip="The layer of the terminal to move the log to" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                        <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableSectors}" SelectedItem="{Binding SetTerminalLog.TargetLayer, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,6,0"/>

                                        <TextBlock Grid.Column="4" Text="Target Zone:" ToolTip.Tip="The zone of the terminal to move the log to" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                        <ComboBox Grid.Column="5"
                                                  ItemsSource="{Binding SetTerminalLog.AvailableTargetZones}"
                                                  SelectedValue="{Binding SetTerminalLog.TargetLocalIndex, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding ZoneIndex}"
                                                  HorizontalAlignment="Stretch" Margin="0,0,6,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:ZoneOption">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Column="6" Text="Target Terminal:" ToolTip.Tip="The terminal to move the log to" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                        <ComboBox Grid.Column="7"
                                                  ItemsSource="{Binding SetTerminalLog.AvailableTargetTerminals}"
                                                  SelectedValue="{Binding SetTerminalLog.TargetTerminalIndex, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding TerminalIndex}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:TerminalOption">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- EventsOnFileRead -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="6">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Events On File Read" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="11" ToolTip.Tip="Events to be executed when the file is read"/>
                                        <Button Grid.Column="1" Content="+ Add Event" Command="{Binding SetTerminalLog.AddEventOnFileRead}" Background="#2E5B88" Foreground="White" Padding="6,2" FontSize="11"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SetTerminalLog.EventsOnFileRead}" ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- AWO Conditional: ObjectiveItems [SetPocketItem] -->
                    <Expander IsVisible="{Binding IsObjectiveItemsVisible}"
                              Background="#252526"
                              BorderBrush="#3E3E42"
                              BorderThickness="1"
                              CornerRadius="4"
                              HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="Pocket Items Configuration" FontWeight="SemiBold" Foreground="#87CEEB"/>
                        </Expander.Header>
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Objective Pocket Items" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                <Button Grid.Column="1" Content="+ Add Pocket Item" Command="{Binding ObjectiveItems.AddItem}" Background="#2E5B88" Foreground="White" Padding="8,3"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ObjectiveItems.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E1E" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,Auto">
                                                    <TextBlock Grid.Column="0" Text="Index:" ToolTip.Tip="Identifier used to keep track of this pocket item" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Index, Mode=TwoWay}" Margin="0,0,6,0"/>

                                                    <TextBlock Grid.Column="2" Text="Count:" ToolTip.Tip="The number of items the player will now have. 0 for removal" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                    <TextBox Grid.Column="3" Text="{Binding Count, Mode=TwoWay}" Margin="0,0,6,0"/>

                                                    <TextBlock Grid.Column="4" Text="Item Name:" ToolTip.Tip="The name of the item" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                    <TextBox Grid.Column="5" Text="{Binding ItemName, Mode=TwoWay}" Margin="0,0,6,0"/>

                                                    <CheckBox Grid.Column="6" Content="Is On Top" IsChecked="{Binding IsOnTop, Mode=TwoWay}" ToolTip.Tip="Whether this item should be put at the top of the pocket items list" Margin="0,0,6,0"/>
                                                    <Button Grid.Column="7" Content="✕ Remove" Command="{Binding $parent[ItemsControl].DataContext.ObjectiveItems.RemoveItemCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="6,2"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                                    <TextBlock Grid.Column="0" Text="Tag Type:" ToolTip.Tip="Determines how the owner of the item is determined" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailablePocketItemTagTypes}" SelectedItem="{Binding TagType, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,6,0"/>

                                                    <TextBlock Grid.Column="2" Text="Player:" ToolTip.Tip="If the tag type is Specific, this is who the item belongs to" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                    <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailablePlayerCharacters}" SelectedItem="{Binding Player, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,6,0"/>

                                                    <TextBlock Grid.Column="4" Text="Custom Tag:" ToolTip.Tip="Field to use a custom name for the owner when tag type is Custom" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                                    <TextBox Grid.Column="5" Text="{Binding CustomTag, Mode=TwoWay}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <!-- AWO Conditional: EnvironmentData [SetExpeditionEnvironment] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsEnvironmentDataVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Expedition Environment Configuration" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,*">
                                <TextBlock Grid.Column="0" Text="Wetness:" ToolTip.Tip="Wetness factor of the environment. Can be a number, or &amp;Unchanged&amp;" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding EnvironmentData.EnvironmentWetness, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <CheckBox Grid.Column="2" Content="Update Color" IsChecked="{Binding EnvironmentData.UpdateColor, Mode=TwoWay}" ToolTip.Tip="If true, lets the user update the color of the dust. Can be a number, or &amp;Unchanged&amp;" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="3" Text="Dust Color:" ToolTip.Tip="Color of the dust" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB" IsVisible="{Binding EnvironmentData.UpdateColor}"/>
                                <TextBox Grid.Column="4" Text="{Binding EnvironmentData.DustColor, Mode=TwoWay}" IsVisible="{Binding EnvironmentData.UpdateColor}"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Alpha Boost:" ToolTip.Tip="Alpha boost for the environment. Can be a number, or &amp;Unchanged&amp;" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding EnvironmentData.DustAlphaBoost, Mode=TwoWay}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="Turbulence:" ToolTip.Tip="Turbulence of the environment. Can be a number, or &amp;Unchanged&amp;" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding EnvironmentData.DustTurbulence, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AWO Conditional: FadeScreen [FadeScreenInOut] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsFadeScreenVisible}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Fade Screen Configuration" FontWeight="Bold" Foreground="#87CEEB" FontSize="12"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto,*,Auto,*">
                                <TextBlock Grid.Column="0" Text="Color:" ToolTip.Tip="The colour of the fade" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="1" Text="{Binding FadeScreen.FadeColor, Mode=TwoWay}" Margin="0,0,6,0"/>

                                <TextBlock Grid.Column="2" Text="Time Start:" ToolTip.Tip="The start time for the curve" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="3" Text="{Binding FadeScreen.CurveTimeStart, Mode=TwoWay}" Margin="0,0,6,0"/>

                                <TextBlock Grid.Column="4" Text="Val Start:" ToolTip.Tip="The start value for the curve (0-1)" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="5" Text="{Binding FadeScreen.CurveValueStart, Mode=TwoWay}" Margin="0,0,6,0"/>

                                <TextBlock Grid.Column="6" Text="Time End:" ToolTip.Tip="The end time for the curve" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="7" Text="{Binding FadeScreen.CurveTimeEnd, Mode=TwoWay}" Margin="0,0,6,0"/>

                                <TextBlock Grid.Column="8" Text="Val End:" ToolTip.Tip="The end value of the curve (0-1)" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="9" Text="{Binding FadeScreen.CurveValueEnd, Mode=TwoWay}" Margin="0,0,6,0"/>

                                <TextBlock Grid.Column="10" Text="Speed:" ToolTip.Tip="How fast the effect will animate along the curve" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#87CEEB"/>
                                <TextBox Grid.Column="11" Text="{Binding FadeScreen.FadeSpeed, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>
        <Style Selector="ToolTip">
            <Setter Property="MaxWidth" Value="1200"/>
            <Setter Property="MaxHeight" Value="800"/>
        </Style>
    </Application.Styles>
</Application>