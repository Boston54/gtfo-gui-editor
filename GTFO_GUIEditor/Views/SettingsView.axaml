<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GTFO_GUIEditor.ViewModels;assembly=GTFO_GUIEditor"
             xmlns:models="clr-namespace:GTFO_GUIEditor.Models;assembly=GTFO_GUIEditor"
             xmlns:controls="clr-namespace:GTFO_GUIEditor.Controls;assembly=GTFO_GUIEditor"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="GTFO_GUIEditor.Views.SettingsView"
             x:Name="SettingsDialogRoot"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <Style Selector="ColorPicker">
            <Setter Property="IsAlphaEnabled" Value="False"/>
            <Setter Property="IsAlphaVisible" Value="False"/>
            <Setter Property="IsColorPaletteVisible" Value="False"/>
            <Setter Property="IsColorComponentsVisible" Value="False"/>
            <Setter Property="IsAccentColorsVisible" Value="False"/>
        </Style>
    </UserControl.Styles>
    <Border Background="#80000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Border Background="#252526"
                BorderBrush="#444444"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BoxShadow="0 4 20 #80000000">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock Grid.Column="0"
                               Text="Settings"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Command="{Binding CloseSettings}"
                            Padding="8,4"
                            Background="Transparent"
                            Foreground="#888888"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Tabbed Settings Content -->
                <TabControl Grid.Row="1" Margin="0,0,0,12">
                    <TabItem Header="General" Foreground="#E0E0E0" FontSize="14" FontWeight="SemiBold">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0" Margin="0,10,0,0">
                            <StackPanel Spacing="18">
                                <TextBlock Text="Startup Project" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <StackPanel Spacing="8">
                                    <RadioButton Content="New project" IsChecked="{Binding Settings.General.IsNewProjectStartup, Mode=TwoWay}" Foreground="#E0E0E0"/>
                                    <RadioButton Content="Previous opened project" IsChecked="{Binding Settings.General.IsPreviousOpenedProjectStartup, Mode=TwoWay}" Foreground="#E0E0E0"/>
                                    <RadioButton Content="Set project" IsChecked="{Binding Settings.General.IsSetProjectStartup, Mode=TwoWay}" Foreground="#E0E0E0"/>
                                    <Border IsVisible="{Binding Settings.General.IsSetProjectStartup}" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel Spacing="8">
                                            <TextBox Text="{Binding Settings.General.StartupProjectPath, Mode=TwoWay}" IsReadOnly="True" Watermark="Choose a file or folder"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Open File..."
                                                        Command="{Binding ChooseStartupProjectFile}"
                                                        IsVisible="{Binding Settings.General.IsRundownDataFlow}"
                                                        Padding="10,5"/>
                                                <Button Content="Open Folder..."
                                                        Command="{Binding ChooseStartupProjectFolder}"
                                                        IsVisible="{Binding Settings.General.IsDatablocksDataFlow}"
                                                        Padding="10,5"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="Data Flow" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <StackPanel Spacing="8">
                                    <RadioButton Content=".rundown file" IsChecked="{Binding Settings.General.IsRundownDataFlow, Mode=TwoWay}" Foreground="#E0E0E0"/>
                                    <RadioButton Content="Datablocks" IsChecked="{Binding Settings.General.IsDatablocksDataFlow, Mode=TwoWay}" Foreground="#E0E0E0"/>
                                </StackPanel>

                                <TextBlock Text="Window Mode" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <StackPanel Spacing="8">
                                    <RadioButton Content="Windowed" IsChecked="{Binding Settings.General.IsWindowed, Mode=TwoWay}" Foreground="#E0E0E0"/>
                                    <RadioButton Content="Windowed Fullscreen" IsChecked="{Binding Settings.General.IsWindowedFullscreen, Mode=TwoWay}" Foreground="#E0E0E0"/>
                                    <RadioButton Content="Fullscreen" IsChecked="{Binding Settings.General.IsFullscreen, Mode=TwoWay}" Foreground="#E0E0E0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Appearance" Foreground="#E0E0E0" FontSize="14" FontWeight="SemiBold">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0" Margin="0,10,0,0">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Door Colors"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"/>

                                <TextBlock Text="Customize the color of each door type used on the Level Layout canvas and legend."
                                           FontSize="12"
                                           Foreground="#AAAAAA"
                                           TextWrapping="Wrap"/>

                                <Border Background="#1E1E1E"
                                        BorderBrush="#333333"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                          ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                                        <!-- Unexpanded -->
                                        <Border Grid.Row="0" Grid.Column="0" Width="20" Height="10" Background="{Binding Settings.Appearance.UnexpandedDoorColor}" BorderBrush="#FFFFFF" BorderThickness="0.5" CornerRadius="1" VerticalAlignment="Center" Margin="0,6,12,6"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Unexpanded" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="13" Margin="0,6,12,6"/>
                                        <ColorPicker Grid.Row="0" Grid.Column="2" Color="{Binding Settings.Appearance.UnexpandedColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaVisible="False" IsColorPaletteVisible="False" IsColorComponentsVisible="False" IsAccentColorsVisible="False" VerticalAlignment="Center" Margin="0,6,8,6"/>
                                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Settings.Appearance.UnexpandedDoorColor, Mode=TwoWay}" Width="85" VerticalAlignment="Center" FontFamily="Consolas,Monospace" Margin="0,6,8,6"/>
                                        <Button Grid.Row="0" Grid.Column="4" Content="Reset" Command="{Binding ResetUnexpandedDoorColor}" FontSize="11" Padding="8,4" ToolTip.Tip="Reset to default color" VerticalAlignment="Center" Margin="0,6,0,6"/>

                                        <!-- Connected -->
                                        <Border Grid.Row="1" Grid.Column="0" Width="20" Height="10" Background="{Binding Settings.Appearance.ConnectedDoorColor}" BorderBrush="#FFFFFF" BorderThickness="0.5" CornerRadius="1" VerticalAlignment="Center" Margin="0,6,12,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Connected" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="13" Margin="0,6,12,6"/>
                                        <ColorPicker Grid.Row="1" Grid.Column="2" Color="{Binding Settings.Appearance.ConnectedColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaVisible="False" IsColorPaletteVisible="False" IsColorComponentsVisible="False" IsAccentColorsVisible="False" VerticalAlignment="Center" Margin="0,6,8,6"/>
                                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Settings.Appearance.ConnectedDoorColor, Mode=TwoWay}" Width="85" VerticalAlignment="Center" FontFamily="Consolas,Monospace" Margin="0,6,8,6"/>
                                        <Button Grid.Row="1" Grid.Column="4" Content="Reset" Command="{Binding ResetConnectedDoorColor}" FontSize="11" Padding="8,4" ToolTip.Tip="Reset to default color" VerticalAlignment="Center" Margin="0,6,0,6"/>

                                        <!-- Security -->
                                        <Border Grid.Row="2" Grid.Column="0" Width="20" Height="10" Background="{Binding Settings.Appearance.SecurityDoorColor}" BorderBrush="#FFFFFF" BorderThickness="0.5" CornerRadius="1" VerticalAlignment="Center" Margin="0,6,12,6"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Security" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="13" Margin="0,6,12,6"/>
                                        <ColorPicker Grid.Row="2" Grid.Column="2" Color="{Binding Settings.Appearance.SecurityColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaVisible="False" IsColorPaletteVisible="False" IsColorComponentsVisible="False" IsAccentColorsVisible="False" VerticalAlignment="Center" Margin="0,6,8,6"/>
                                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Settings.Appearance.SecurityDoorColor, Mode=TwoWay}" Width="85" VerticalAlignment="Center" FontFamily="Consolas,Monospace" Margin="0,6,8,6"/>
                                        <Button Grid.Row="2" Grid.Column="4" Content="Reset" Command="{Binding ResetSecurityDoorColor}" FontSize="11" Padding="8,4" ToolTip.Tip="Reset to default color" VerticalAlignment="Center" Margin="0,6,0,6"/>

                                        <!-- Main -->
                                        <Border Grid.Row="3" Grid.Column="0" Width="20" Height="10" Background="{Binding Settings.Appearance.MainDoorColor}" BorderBrush="#FFFFFF" BorderThickness="0.5" CornerRadius="1" VerticalAlignment="Center" Margin="0,6,12,6"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Main" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="13" Margin="0,6,12,6"/>
                                        <ColorPicker Grid.Row="3" Grid.Column="2" Color="{Binding Settings.Appearance.MainColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaVisible="False" IsColorPaletteVisible="False" IsColorComponentsVisible="False" IsAccentColorsVisible="False" VerticalAlignment="Center" Margin="0,6,8,6"/>
                                        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Settings.Appearance.MainDoorColor, Mode=TwoWay}" Width="85" VerticalAlignment="Center" FontFamily="Consolas,Monospace" Margin="0,6,8,6"/>
                                        <Button Grid.Row="3" Grid.Column="4" Content="Reset" Command="{Binding ResetMainDoorColor}" FontSize="11" Padding="8,4" ToolTip.Tip="Reset to default color" VerticalAlignment="Center" Margin="0,6,0,6"/>

                                        <!-- Secondary -->
                                        <Border Grid.Row="4" Grid.Column="0" Width="20" Height="10" Background="{Binding Settings.Appearance.SecondaryDoorColor}" BorderBrush="#FFFFFF" BorderThickness="0.5" CornerRadius="1" VerticalAlignment="Center" Margin="0,6,12,6"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Secondary" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="13" Margin="0,6,12,6"/>
                                        <ColorPicker Grid.Row="4" Grid.Column="2" Color="{Binding Settings.Appearance.SecondaryColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaVisible="False" IsColorPaletteVisible="False" IsColorComponentsVisible="False" IsAccentColorsVisible="False" VerticalAlignment="Center" Margin="0,6,8,6"/>
                                        <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Settings.Appearance.SecondaryDoorColor, Mode=TwoWay}" Width="85" VerticalAlignment="Center" FontFamily="Consolas,Monospace" Margin="0,6,8,6"/>
                                        <Button Grid.Row="4" Grid.Column="4" Content="Reset" Command="{Binding ResetSecondaryDoorColor}" FontSize="11" Padding="8,4" ToolTip.Tip="Reset to default color" VerticalAlignment="Center" Margin="0,6,0,6"/>

                                        <!-- Overload -->
                                        <Border Grid.Row="5" Grid.Column="0" Width="20" Height="10" Background="{Binding Settings.Appearance.OverloadDoorColor}" BorderBrush="#FFFFFF" BorderThickness="0.5" CornerRadius="1" VerticalAlignment="Center" Margin="0,6,12,6"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Overload" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="13" Margin="0,6,12,6"/>
                                        <ColorPicker Grid.Row="5" Grid.Column="2" Color="{Binding Settings.Appearance.OverloadColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaVisible="False" IsColorPaletteVisible="False" IsColorComponentsVisible="False" IsAccentColorsVisible="False" VerticalAlignment="Center" Margin="0,6,8,6"/>
                                        <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding Settings.Appearance.OverloadDoorColor, Mode=TwoWay}" Width="85" VerticalAlignment="Center" FontFamily="Consolas,Monospace" Margin="0,6,8,6"/>
                                        <Button Grid.Row="5" Grid.Column="4" Content="Reset" Command="{Binding ResetOverloadDoorColor}" FontSize="11" Padding="8,4" ToolTip.Tip="Reset to default color" VerticalAlignment="Center" Margin="0,6,0,6"/>

                                        <!-- Blocked -->
                                        <Border Grid.Row="6" Grid.Column="0" Width="20" Height="10" Background="{Binding Settings.Appearance.BlockedDoorColor}" BorderBrush="#FFFFFF" BorderThickness="0.5" CornerRadius="1" VerticalAlignment="Center" Margin="0,6,12,6"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Blocked" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="13" Margin="0,6,12,6"/>
                                        <ColorPicker Grid.Row="6" Grid.Column="2" Color="{Binding Settings.Appearance.BlockedColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaVisible="False" IsColorPaletteVisible="False" IsColorComponentsVisible="False" IsAccentColorsVisible="False" VerticalAlignment="Center" Margin="0,6,8,6"/>
                                        <TextBox Grid.Row="6" Grid.Column="3" Text="{Binding Settings.Appearance.BlockedDoorColor, Mode=TwoWay}" Width="85" VerticalAlignment="Center" FontFamily="Consolas,Monospace" Margin="0,6,8,6"/>
                                        <Button Grid.Row="6" Grid.Column="4" Content="Reset" Command="{Binding ResetBlockedDoorColor}" FontSize="11" Padding="8,4" ToolTip.Tip="Reset to default color" VerticalAlignment="Center" Margin="0,6,0,6"/>
                                    </Grid>
                                </Border>

                                <Separator Height="1" Background="#333333" Margin="0,4"/>

                                <!-- Heightmap Gradient -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,0">
                                    <TextBlock Grid.Column="0"
                                               Text="Heightmap Gradient"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="Reset"
                                                Command="{Binding ResetHeightmapGradient}"
                                                Padding="8,4"
                                                FontSize="11"
                                                ToolTip.Tip="Reset gradient to default"
                                                VerticalAlignment="Center"/>
                                        <Button Content="+ Add Keyframe"
                                                Command="{Binding AddHeightmapGradientKeyframe}"
                                                Padding="10,4"
                                                FontSize="12"
                                                Background="#2E5B88"
                                                Foreground="White"
                                                VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Customize the linear color gradient used to represent room heights on the Level Layout canvas. Drag the rectangle handles along the gradient bar to adjust positions, and click a handle to edit its color."
                                           FontSize="12"
                                           Foreground="#AAAAAA"
                                           TextWrapping="Wrap"/>

                                <!-- Interactive Draggable Gradient Bar -->
                                <controls:GradientBarControl Height="34"
                                                             Appearance="{Binding Settings.Appearance}"
                                                             Margin="0,4,0,0"/>

                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,-4,0,2">
                                    <TextBlock Grid.Column="0" Text="Low Altitude (0.00)" FontSize="10" Foreground="#888888"/>
                                    <TextBlock Grid.Column="2" Text="High Altitude (1.00)" FontSize="10" Foreground="#888888" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Selected Keyframe Editor -->
                                <Border Background="#1E1E1E"
                                        BorderBrush="#333333"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14"
                                        IsVisible="{Binding Settings.Appearance.HasSelectedKeyframe}">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                                        <!-- Color Swatch Preview -->
                                        <Border Grid.Column="0"
                                                Width="20"
                                                Height="20"
                                                Background="{Binding Settings.Appearance.SelectedKeyframe.ColorHex}"
                                                BorderBrush="#FFFFFF"
                                                BorderThickness="0.5"
                                                CornerRadius="2"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"/>

                                        <!-- Selected Keyframe Label -->
                                        <TextBlock Grid.Column="1"
                                                   Text="Keyframe Color:"
                                                   Foreground="#E0E0E0"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>

                                        <!-- Color Picker -->
                                        <ColorPicker Grid.Column="2"
                                                     Color="{Binding Settings.Appearance.SelectedKeyframe.Color, Mode=TwoWay}"
                                                     IsAlphaEnabled="False"
                                                     IsAlphaVisible="False"
                                                     IsColorPaletteVisible="False"
                                                     IsColorComponentsVisible="False"
                                                     IsAccentColorsVisible="False"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Left"
                                                     Margin="0,0,8,0"/>

                                        <!-- Hex Code TextBox -->
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding Settings.Appearance.SelectedKeyframe.ColorHex, Mode=TwoWay}"
                                                 Width="85"
                                                 VerticalAlignment="Center"
                                                 FontFamily="Consolas,Monospace"
                                                 Margin="0,0,12,0"/>

                                        <!-- Delete Selected Keyframe Button -->
                                        <Button Grid.Column="4"
                                                Content="Remove Keyframe"
                                                Command="{Binding RemoveSelectedHeightmapGradientKeyframe}"
                                                IsEnabled="{Binding Settings.Appearance.CanRemoveKeyframes}"
                                                ToolTip.Tip="Remove selected keyframe (minimum 2 required)"
                                                Padding="10,5"
                                                FontSize="12"
                                                Background="#3A2222"
                                                Foreground="#FF6B6B"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- Actions Footer -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                    <Button Grid.Column="0"
                            Content="Reset to Defaults"
                            Command="{Binding ResetAppearanceSettingsToDefaults}"
                            Padding="14,8"/>
                    <Button Grid.Column="1"
                            Content="Close"
                            Command="{Binding CloseSettings}"
                            Background="#007ACC"
                            Foreground="White"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Right"
                            Padding="20,8"/>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
