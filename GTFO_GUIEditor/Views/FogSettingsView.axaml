<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:GTFO_GUIEditor.ViewModels;assembly=GTFO_GUIEditor" xmlns:models="clr-namespace:GTFO_GUIEditor.Models;assembly=GTFO_GUIEditor" mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600" x:Class="GTFO_GUIEditor.Views.FogSettingsView" x:DataType="vm:FogSettingsViewModel">
  <Grid RowDefinitions="Auto,*" Margin="10">
    <!-- Top Bar: Search and Creation -->
    <Border Grid.Row="0" Background="#252526" Padding="10" Margin="0,0,0,10" CornerRadius="4">
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}" Watermark="Search fog configs..." VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="+ Create New Config" Command="{Binding OpenCreateBlockDialog}" Margin="10,0,0,0" Padding="12,6" FontWeight="SemiBold" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1"  VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
      <ItemsControl ItemsSource="{Binding FilteredBlocks}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:FogSettingsBlock">
            <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
              <StackPanel Spacing="0">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <Button Grid.Column="0" Content="{Binding DisplayText}" Command="{Binding $parent[UserControl].((vm:FogSettingsViewModel)DataContext).ToggleBlockCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="#3E3E42" Foreground="#F0F0F0" CornerRadius="4" Padding="10,8" />
                  <Button Grid.Column="1" Content="Duplicate" Command="{Binding $parent[UserControl].((vm:FogSettingsViewModel)DataContext).OpenDuplicateBlockDialog}" CommandParameter="{Binding}" Margin="8,0,0,0" />
                  <Button Grid.Column="2" Content="Delete" Command="{Binding $parent[UserControl].((vm:FogSettingsViewModel)DataContext).RequestDeleteBlock}" CommandParameter="{Binding}" Margin="6,0,0,0" IsVisible="{Binding CanDelete}" />
                </Grid>
                <Grid IsVisible="{Binding IsExpanded}">
                  <ScrollViewer Margin="0" Padding="0,0,16,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14">
                      <!-- Group 1: General Identification -->
                      <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                        <StackPanel Spacing="10">
                          <TextBlock Text="General Identification" FontWeight="Bold" FontSize="14" />
                          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" Margin="0,5,0,0">
                            <TextBlock Grid.Column="0" Text="Name:" ToolTip.Tip="Internal name for the fog setting. This is not visible to the player, but is used for identifying the fog setting within the editor." VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" IsReadOnly="{Binding IsElevatorFogConfig}" Margin="0,0,16,0" />
                          </Grid>
                        </StackPanel>
                      </Border>
                      <!-- Group 2: Fog Properties -->
                      <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                        <StackPanel Spacing="10">
                          <TextBlock Text="Fog Properties" FontWeight="Bold" FontSize="14" />
                          <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto" Margin="0,5,0,0">
                            <TextBlock Grid.Column="0" Text="Fog Density:" ToolTip.Tip="The base fog density in the entire level. To create inversed fog as in R5E1, you have to set FogDensity and DensityHeightMaxBoost such that FogDensity &lt; DensityHeightMaxBoost. This value is normally very low - most vanilla settings have less than 0.001." VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding FogDensity, Mode=TwoWay}" Margin="0,0,16,0" />
                            <TextBlock Grid.Column="2" Text="Infection:" ToolTip.Tip="The maximum value for how fast infection accumulates in fog. For example, 0.1 would make you 10% infected per second. 0.03 is a common value this is set to. Note that the infection speed is based on how deep you are in the fog with linear scaling. The lowest infection gain rate is at DensityHeightAltitude + DensityHeightRange, and the lowest point is at DensityHeightRange." VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="3" Text="{Binding Infection, Mode=TwoWay}" />
                          </Grid>
                          <!-- Color Section (RGBA Sliders and Hex) -->
                          <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,0">
                            <StackPanel Spacing="8">
                              <TextBlock Text="Fog Color (RGBA)" ToolTip.Tip="RGBA colour of the fog. Non-white fog may not block sight very well, and colours may be affected by other factors in the environment." FontWeight="SemiBold" FontSize="13" Foreground="#E0E0E0" />
                              <!-- Swatch and Hex -->
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Background="{Binding FogColor.HexColor}" Width="50" Height="28" CornerRadius="3" BorderBrush="#555555" BorderThickness="1" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" Text="{Binding FogColor.HexCode, Mode=TwoWay}" Watermark="#AARRGGBB" VerticalAlignment="Center" Margin="0,0,8,0" />
                              </Grid>
                              <!-- RGBA Sliders -->
                              <Grid ColumnDefinitions="30,*,50" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,2,0,0">
                                <!-- Red -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="R:" ToolTip.Tip="Red for the fog color." VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding FogColor.R, Mode=TwoWay}" Margin="0,0,8,0" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding FogColor.R, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" />
                                <!-- Green -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="G:" ToolTip.Tip="Green for the fog color." VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding FogColor.G, Mode=TwoWay}" Margin="0,0,8,0" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding FogColor.G, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" />
                                <!-- Blue -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="B:" ToolTip.Tip="Blue for the fog color." VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding FogColor.B, Mode=TwoWay}" Margin="0,0,8,0" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding FogColor.B, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" />
                                <!-- Alpha -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="A:" ToolTip.Tip="Alpha for the fog color." VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding FogColor.A, Mode=TwoWay}" Margin="0,0,8,0" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding FogColor.A, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" />
                              </Grid>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>
                      <!-- Group 3: Density Noise Settings -->
                      <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                        <StackPanel Spacing="10">
                          <TextBlock Text="Noise Settings" FontWeight="Bold" FontSize="14" />
                          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,5,0,0">
                            <!-- Row 0: Merged Noise Direction (X, Y, Z) -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Direction (X, Y, Z):" ToolTip.Tip="Noise are the floating particles right above the fog plane. This field is a vector that controls the floating direction of those particles." VerticalAlignment="Center" Margin="0,0,12,8" />
                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,*,*" Margin="0,0,0,8">
                              <TextBox Grid.Column="0" Text="{Binding DensityNoiseDirection.X, Mode=TwoWay}" Watermark="X" ToolTip.Tip="X direction" Margin="0,0,8,0" />
                              <TextBox Grid.Column="1" Text="{Binding DensityNoiseDirection.Y, Mode=TwoWay}" Watermark="Y" ToolTip.Tip="Y direction" Margin="0,0,8,0" />
                              <TextBox Grid.Column="2" Text="{Binding DensityNoiseDirection.Z, Mode=TwoWay}" Watermark="Z" ToolTip.Tip="Z direction" />
                            </Grid>
                            <!-- Row 1: Speed, Scale -->
                            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,*">
                              <TextBlock Grid.Column="0" Text="Noise Speed:" ToolTip.Tip="Speed of the fog particles" VerticalAlignment="Center" Margin="0,0,8,0" />
                              <TextBox Grid.Column="1" Text="{Binding DensityNoiseSpeed, Mode=TwoWay}" Margin="0,0,16,0" />
                              <TextBlock Grid.Column="2" Text="Noise Scale:" ToolTip.Tip="Size of the noise particles. Most vanilla settings use a value around 0.1." VerticalAlignment="Center" Margin="0,0,8,0" />
                              <TextBox Grid.Column="3" Text="{Binding DensityNoiseScale, Mode=TwoWay}" />
                            </Grid>
                          </Grid>
                        </StackPanel>
                      </Border>
                      <!-- Group 4: Height Gradient Settings -->
                      <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                        <StackPanel Spacing="10">
                          <TextBlock Text="Density Height Settings" FontWeight="Bold" FontSize="14" />
                          <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto" Margin="0,5,0,0">
                            <TextBlock Grid.Column="0" Text="Altitude:" ToolTip.Tip="The lowest point for the fog height. For non-inversed fog (R5E1), everything with altitude lower than this value will be fully submerged by the fog. Normal zone altitudes - Low: -4.0, Mid: 0.0, High: 4.0." VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding DensityHeightAltitude, Mode=TwoWay}" Margin="0,0,16,0" />
                            <TextBlock Grid.Column="2" Text="Range:" ToolTip.Tip="Distance above the lowest point for fog height. The surface of the fog is at the Altitude + Range." VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="3" Text="{Binding DensityHeightRange, Mode=TwoWay}" Margin="0,0,16,0" />
                            <TextBlock Grid.Column="4" Text="Max Boost:" ToolTip.Tip="Actual field for controlling the density of non-inversed fog (R5E1). The larger, the more occluding. R5D2, a level with very dense fog, uses a value of 0.2." VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="5" Text="{Binding DensityHeightMaxBoost, Mode=TwoWay}" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <!-- Main Editor Area (when a config is selected) -->
    <!-- Create Config Modal Dialog Overlay -->
    <Border Grid.Row="0" Grid.RowSpan="2" Background="#80000000" IsVisible="{Binding IsCreatingBlock}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border Background="#1E1E1E" BorderBrush="#444444" BorderThickness="1" CornerRadius="6" Padding="20" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 4 16 0 #000000">
        <StackPanel Spacing="14">
          <TextBlock Text="Create New Fog Config" FontWeight="Bold" FontSize="16" Foreground="#E0E0E0" />
          <TextBlock Text="Choose how you want to create the new fog config:" Foreground="LightGray" FontSize="12" />
          <!-- Option: Blank, Existing Config, or Vanilla Import -->
          <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
            <StackPanel Spacing="10">
              <RadioButton Content="Create a new fresh (default) config" IsChecked="{Binding IsCreatingFresh, Mode=TwoWay}" />
              <RadioButton Content="Use an existing config as a template" IsChecked="{Binding IsCreatingFromExisting, Mode=TwoWay}" IsEnabled="{Binding HasExistingConfigs}" />
              <!-- Existing Config Selector -->
              <StackPanel Spacing="6" IsVisible="{Binding IsCreatingFromExisting}" Margin="20,4,0,0">
                <TextBlock Text="Select Existing Config:" ToolTip.Tip="Select an existing fog config from this project to copy properties from." FontSize="12" Foreground="LightGray" />
                <ComboBox ItemsSource="{Binding Blocks}" SelectedItem="{Binding SelectedExistingBlock, Mode=TwoWay}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:FogSettingsBlock">
                      <TextBlock Text="{Binding DisplayText}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <RadioButton Content="Import a config from vanilla" IsChecked="{Binding IsCreatingFromVanilla, Mode=TwoWay}" />
              <!-- Vanilla Template Selector -->
              <StackPanel Spacing="6" IsVisible="{Binding IsCreatingFromVanilla}" Margin="20,4,0,0">
                <TextBlock Text="Select Vanilla Config:" ToolTip.Tip="Select a vanilla fog config to import properties from." FontSize="12" Foreground="LightGray" />
                <ComboBox ItemsSource="{Binding AvailableTemplates}" SelectedItem="{Binding SelectedVanillaTemplate, Mode=TwoWay}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:FogSettingsBlock">
                      <TextBlock Text="{Binding DisplayText}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" Margin="0,4,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Config Name:" ToolTip.Tip="Internal name for the fog setting." VerticalAlignment="Center" Margin="0,0,10,8" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewBlockName, Mode=TwoWay}" Margin="0,0,0,8" Watermark="Enter config name..." />
          </Grid>
          <!-- Error Banner -->
          <Border Background="#3A1C1C" BorderBrush="#FF6B6B" BorderThickness="1" CornerRadius="4" Padding="10,8" IsVisible="{Binding HasCreationErrorMessage}">
            <TextBlock Text="{Binding CreationErrorMessage}" Foreground="#FF6B6B" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
          </Border>
          <!-- Action Buttons -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding CancelCreateBlock}" Padding="14,6" />
            <Button Content="Create Config" Command="{Binding ConfirmCreateBlock}" Classes="accent" Padding="14,6" FontWeight="SemiBold" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <!-- Delete Config Modal Confirmation Overlay -->
    <Border Grid.Row="0" Grid.RowSpan="2" Background="#80000000" IsVisible="{Binding IsConfirmingDelete}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border Background="#1E1E1E" BorderBrush="#444444" BorderThickness="1" CornerRadius="6" Padding="20" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 4 16 0 #000000">
        <StackPanel Spacing="14">
          <TextBlock Text="Confirm Delete Fog Config" FontWeight="Bold" FontSize="16" Foreground="#FF6B6B" />
          <TextBlock Text="{Binding DeleteConfirmationMessage}" TextWrapping="Wrap" FontSize="13" />
          <TextBlock Text="This action will remove the fog config from the configuration. This cannot be undone." Foreground="Gray" TextWrapping="Wrap" FontSize="12" />
          <!-- Action Buttons -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding CancelDeleteBlock}" Padding="14,6" />
            <Button Content="Delete" Command="{Binding ConfirmDeleteBlock}" Background="#D32F2F" Foreground="White" Padding="14,6" FontWeight="SemiBold" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>