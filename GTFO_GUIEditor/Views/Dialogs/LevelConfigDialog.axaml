<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GTFO_GUIEditor.ViewModels;assembly=GTFO_GUIEditor"
             xmlns:models="clr-namespace:GTFO_GUIEditor.Models;assembly=GTFO_GUIEditor"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="GTFO_GUIEditor.Views.Dialogs.LevelConfigDialog"
             x:Name="LevelConfigRoot"
             x:DataType="vm:LevelLayoutViewModel">
    <Border Background="#80000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Border Background="#252526"
                BorderBrush="#444444"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Width="920"
                MaxHeight="800"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 4 20 #80000000">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Text="{Binding LevelDialogTitle}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           Margin="0,0,0,14"/>

                <!-- Scrollable Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
                    <StackPanel Spacing="16">
                        <!-- General Level Settings -->
                        <Expander Header="General Settings" IsExpanded="False" Padding="14"
                                  Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1"
                                  CornerRadius="6" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch" x:CompileBindings="False">
                            <StackPanel Spacing="10">
                                <TextBlock Text="General Settings"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"/>

                                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <!-- Level Name -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Level Name:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewLevelName, Mode=TwoWay}" Watermark="Enter level name..." Margin="0,4"/>

                                    <!-- Tileset -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tileset:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding AvailableComplexTypes}"
                                              SelectedItem="{Binding SelectedComplexType, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Margin="0,4"/>

                                    <!-- Starting Elevator Tile -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Starting Elevator Tile:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1"
                                              ItemsSource="{Binding AvailableElevatorTiles}"
                                              SelectedItem="{Binding SelectedElevatorTile, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Margin="0,4">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ElevatorTileOption">
                                                <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- Fog Setting -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Fog Setting:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1"
                                              ItemsSource="{Binding AvailableFogSettings}"
                                              SelectedItem="{Binding SelectedFogSetting, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Margin="0,4">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:FogSettingsBlock">
                                                <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- Snatcher Boxes -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Snatcher Boxes:" ToolTip.Tip="If a level contains snatchers, this adds the 'Snatcher Boxes' dimension required to make snatchers function properly." FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding NewLevelSnatcherBoxes, Mode=TwoWay}" Margin="0,4"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Level-owned rundown reference data -->
                        <Expander Header="Level Information" IsExpanded="False" Padding="14"
                                  Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1"
                                  CornerRadius="6" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch" x:CompileBindings="False">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Infection:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditingLevelRef.PlayerStartingState.InfectionLevelAtExpeditionStart, Mode=TwoWay}" Margin="0,0,16,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Health:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EditingLevelRef.PlayerStartingState.HealthLevelAtExpeditionStart, Mode=TwoWay}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Primary Ammo:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditingLevelRef.PlayerStartingState.StandardAmmoAtExpeditionStart, Mode=TwoWay}" Margin="0,0,16,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Special Ammo:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding EditingLevelRef.PlayerStartingState.SpecialAmmoAtExpeditionStart, Mode=TwoWay}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Tool Ammo:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditingLevelRef.PlayerStartingState.ToolAmmoAtExpeditionStart, Mode=TwoWay}" Margin="0,0,16,0"/>
                                </Grid>
                                <TextBlock Text="Description:" Margin="0,4,0,0"/>
                                <TextBox Text="{Binding EditingLevelRef.Description, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="65"/>
                                <TextBlock Text="Warden Intel:" Margin="0,4,0,0"/>
                                <TextBox Text="{Binding EditingLevelRef.WardenIntel, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="65"/>
                            </StackPanel>
                        </Expander>

                        <!-- Level-owned objectives -->
                        <Expander Header="Objective" IsExpanded="False" Padding="14"
                                  Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1"
                                  CornerRadius="6" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch" x:CompileBindings="False">
                            <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                                <TextBlock Text="Objective Layer" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TabControl SelectedIndex="{Binding ObjectiveTabIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <TabItem Header="Main">
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <TextBlock Text="Persistent ID"/><TextBox Text="{Binding EditingLevelRef.MainObjectiveId, Mode=TwoWay}" IsEnabled="False"/>
                                            <TextBlock Text="Type"/><ComboBox ItemsSource="{Binding AvailableObjectiveTypes}" SelectedItem="{Binding SelectedSectorObjectiveType, Mode=TwoWay}"/>
                                            <TextBlock Text="Win Condition"/><ComboBox ItemsSource="{Binding AvailableLevelWinConditions}" SelectedItem="{Binding SelectedLevelWinCondition, Mode=TwoWay}" DisplayMemberBinding="{Binding DisplayName}"/>
                                            <StackPanel Spacing="6" Margin="0,6,0,0">
                                                    <TextBlock Text="No additional fields for this type." IsVisible="{Binding IsEmptyObjective}"/>
                                                    <TextBlock Text="Placement Zone" IsVisible="{Binding IsHsuObjective}"/><TextBox Text="{Binding EditingLevelObjective.HsuPlacementZone, Mode=TwoWay}" IsVisible="{Binding IsHsuObjective}"/>
                                                    <TextBlock Text="Placement Zone" IsVisible="{Binding IsReactorObjective}"/><TextBox Text="{Binding EditingLevelObjective.ReactorPlacementZone, Mode=TwoWay}" IsVisible="{Binding IsReactorObjective}"/>
                                                    <TextBlock Text="Gather Item" IsVisible="{Binding IsGatherSmallItemsObjective}"/><ComboBox ItemsSource="{Binding Items}" SelectedValue="{Binding EditingLevelObjective.GatherItemId, Mode=TwoWay}" SelectedValueBinding="{Binding PersistentId}" IsVisible="{Binding IsGatherSmallItemsObjective}" DisplayMemberBinding="{Binding DisplayName}"/>
                                                    <TextBlock Text="Gather Spawn Count" IsVisible="{Binding IsGatherSmallItemsObjective}"/><TextBox Text="{Binding EditingLevelObjective.GatherSpawnCount, Mode=TwoWay}" IsVisible="{Binding IsGatherSmallItemsObjective}"/>
                                                    <TextBlock Text="Gather Max Per Zone" IsVisible="{Binding IsGatherSmallItemsObjective}"/><TextBox Text="{Binding EditingLevelObjective.GatherMaxPerZone, Mode=TwoWay}" IsVisible="{Binding IsGatherSmallItemsObjective}"/>
                                                    <TextBlock Text="Gather Required Count" IsVisible="{Binding IsGatherSmallItemsObjective}"/><TextBox Text="{Binding EditingLevelObjective.GatherRequiredCount, Mode=TwoWay}" IsVisible="{Binding IsGatherSmallItemsObjective}"/>
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8" IsVisible="{Binding IsGatherSmallItemsObjective}">
                                                        <StackPanel Spacing="6">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="Zone Placement Datas" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                <Button Grid.Column="1" Content="+ Add Placement" Command="{Binding #LevelConfigRoot.DataContext.AddLevelObjectiveZonePlacementCommand}" Background="#3E3E42" Foreground="White" Padding="8,3"/>
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding EditingGatherZonePlacements}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:ZonePlacementData" x:CompileBindings="False">
                                                                        <Border BorderBrush="#444444" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,3">
                                                                            <Grid ColumnDefinitions="*,*,*,*,Auto" RowDefinitions="Auto,Auto">
                                                                                <ComboBox Grid.Column="0" ItemsSource="{Binding #LevelConfigRoot.DataContext.AvailableObjectiveDimensions}" SelectedValue="{Binding DimensionIndex, Mode=TwoWay}" SelectedValueBinding="{Binding DimensionIndex}" DisplayMemberBinding="{Binding DisplayName}"/>
                                                                                <ComboBox Grid.Column="1" ItemsSource="{Binding #LevelConfigRoot.DataContext.AvailableLevelObjectiveZones}" SelectedValue="{Binding LocalIndex, Mode=TwoWay}" SelectedValueBinding="{Binding ZoneIndex}" DisplayMemberBinding="{Binding DisplayName}" Margin="6,0,0,0"/>
                                                                                <TextBox Grid.Column="2" Text="{Binding Weights.Start, Mode=TwoWay}" Watermark="Start" Margin="6,0,0,0"/>
                                                                                <TextBox Grid.Column="3" Text="{Binding Weights.Middle, Mode=TwoWay}" Watermark="Middle" Margin="6,0,0,0"/>
                                                                                <TextBox Grid.Column="4" Text="{Binding Weights.End, Mode=TwoWay}" Watermark="End" Margin="6,0,0,0"/>
                                                                                <Button Grid.Row="1" Grid.Column="4" Content="Remove" Command="{Binding #LevelConfigRoot.DataContext.RemoveLevelObjectiveZonePlacementCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="6,2" Margin="6,5,0,0"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="Command Zone" IsVisible="{Binding IsSpecialTerminalCommandObjective}"/><TextBox Text="{Binding EditingLevelObjective.SpecialTerminalCommandZone, Mode=TwoWay}" IsVisible="{Binding IsSpecialTerminalCommandObjective}"/>
                                                    <TextBlock Text="Command" IsVisible="{Binding IsSpecialTerminalCommandObjective}"/><TextBox Text="{Binding EditingLevelObjective.SpecialTerminalCommand, Mode=TwoWay}" IsVisible="{Binding IsSpecialTerminalCommandObjective}"/>
                                                    <TextBlock Text="Retrieve Item" IsVisible="{Binding IsRetrieveBigItemsObjective}"/><TextBox Text="{Binding EditingLevelObjective.RetrieveItem, Mode=TwoWay}" IsVisible="{Binding IsRetrieveBigItemsObjective}"/>
                                                    <TextBlock Text="Retrieve Spawn Count" IsVisible="{Binding IsRetrieveBigItemsObjective}"/><TextBox Text="{Binding EditingLevelObjective.RetrieveSpawnCount, Mode=TwoWay}" IsVisible="{Binding IsRetrieveBigItemsObjective}"/>
                                                    <TextBlock Text="Retrieve Max Per Zone" IsVisible="{Binding IsRetrieveBigItemsObjective}"/><TextBox Text="{Binding EditingLevelObjective.RetrieveMaxPerZone, Mode=TwoWay}" IsVisible="{Binding IsRetrieveBigItemsObjective}"/>
                                                    <TextBlock Text="Generator Count" IsVisible="{Binding IsDistributePowerCellsObjective}"/><TextBox Text="{Binding EditingLevelObjective.DistributeGeneratorCount, Mode=TwoWay}" IsVisible="{Binding IsDistributePowerCellsObjective}"/>
                                                    <TextBlock Text="Verification Rounds" IsVisible="{Binding IsTerminalUplinkObjective}"/><TextBox Text="{Binding EditingLevelObjective.UplinkNumberOfVerificationRounds, Mode=TwoWay}" IsVisible="{Binding IsTerminalUplinkObjective}"/>
                                                    <TextBlock Text="Terminal Count" IsVisible="{Binding IsTerminalUplinkObjective}"/><TextBox Text="{Binding EditingLevelObjective.UplinkNumberOfTerminals, Mode=TwoWay}" IsVisible="{Binding IsTerminalUplinkObjective}"/>
                                                    <TextBlock Text="Generator Cluster Zone" IsVisible="{Binding IsCentralGeneratorClusterObjective}"/><TextBox Text="{Binding EditingLevelObjective.CentralGeneratorClusterZone, Mode=TwoWay}" IsVisible="{Binding IsCentralGeneratorClusterObjective}"/>
                                                    <TextBlock Text="Generator Count" IsVisible="{Binding IsCentralGeneratorClusterObjective}"/><TextBox Text="{Binding EditingLevelObjective.CentralGeneratorClusterGeneratorCount, Mode=TwoWay}" IsVisible="{Binding IsCentralGeneratorClusterObjective}"/>
                                                    <TextBlock Text="Power Cell Count" IsVisible="{Binding IsCentralGeneratorClusterObjective}"/><TextBox Text="{Binding EditingLevelObjective.CentralGeneratorClusterPowerCellCount, Mode=TwoWay}" IsVisible="{Binding IsCentralGeneratorClusterObjective}"/>
                                                    <TextBlock Text="HSU Zone" IsVisible="{Binding IsActivateSmallHsuObjective}"/><TextBox Text="{Binding EditingLevelObjective.ActivateSmallHsuZone, Mode=TwoWay}" IsVisible="{Binding IsActivateSmallHsuObjective}"/>
                                                    <TextBlock Text="Time To Activate" IsVisible="{Binding IsSurvivalObjective}"/><TextBox Text="{Binding EditingLevelObjective.TimeToActivate, Mode=TwoWay}" IsVisible="{Binding IsSurvivalObjective}"/>
                                                    <TextBlock Text="Time To Survive" IsVisible="{Binding IsSurvivalObjective}"/><TextBox Text="{Binding EditingLevelObjective.TimeToSurvive, Mode=TwoWay}" IsVisible="{Binding IsSurvivalObjective}"/>
                                                    <TextBlock Text="Gather Terminal Required Count" IsVisible="{Binding IsGatherTerminalObjective}"/><TextBox Text="{Binding EditingLevelObjective.GatherTerminalRequiredCount, Mode=TwoWay}" IsVisible="{Binding IsGatherTerminalObjective}"/>
                                                    <TextBlock Text="Gather Terminal Download Time" IsVisible="{Binding IsGatherTerminalObjective}"/><TextBox Text="{Binding EditingLevelObjective.GatherTerminalDownloadTime, Mode=TwoWay}" IsVisible="{Binding IsGatherTerminalObjective}"/>
                                                    <TextBlock Text="Rounds" IsVisible="{Binding IsTimedTerminalSequenceObjective}"/><TextBox Text="{Binding EditingLevelObjective.TimedTerminalSequenceNumberOfRounds, Mode=TwoWay}" IsVisible="{Binding IsTimedTerminalSequenceObjective}"/>
                                                    <TextBlock Text="Terminals" IsVisible="{Binding IsTimedTerminalSequenceObjective}"/><TextBox Text="{Binding EditingLevelObjective.TimedTerminalSequenceNumberOfTerminals, Mode=TwoWay}" IsVisible="{Binding IsTimedTerminalSequenceObjective}"/>
                                                    <TextBlock Text="Time Per Round" IsVisible="{Binding IsTimedTerminalSequenceObjective}"/><TextBox Text="{Binding EditingLevelObjective.TimedTerminalSequenceTimePerRound, Mode=TwoWay}" IsVisible="{Binding IsTimedTerminalSequenceObjective}"/>
                                            </StackPanel>
                                            <Border Height="1" Background="#555555" HorizontalAlignment="Stretch" Margin="0,8"/>
                                            <StackPanel Spacing="6" Margin="0,6,0,0">
                                                <Expander Header="Flavor text" IsExpanded="False" HorizontalContentAlignment="Stretch">
                                                    <StackPanel Spacing="6" Margin="0,6,0,0">
                                                    <TabControl SelectedIndex="{Binding FlavorTextTabIndex, Mode=TwoWay}">
                                                        <TabItem Header="Header"><TextBox Text="{Binding EditingLevelObjective.Header, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="70"/></TabItem>
                                                        <TabItem Header="MainObjective"><TextBox Text="{Binding EditingLevelObjective.MainObjective, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="70"/></TabItem>
                                                    </TabControl>
                                                    <TextBlock Text="FindLocationInfo"/><TextBox Text="{Binding EditingLevelObjective.FindLocationInfo, Mode=TwoWay}"/>
                                                    <TextBlock Text="FindLocationInfoHelp"/><TextBox Text="{Binding EditingLevelObjective.FindLocationInfoHelp, Mode=TwoWay}"/>
                                                    <TextBlock Text="GoToZone"/><TextBox Text="{Binding EditingLevelObjective.GoToZone, Mode=TwoWay}"/>
                                                    <TextBlock Text="GoToZoneHelp"/><TextBox Text="{Binding EditingLevelObjective.GoToZoneHelp, Mode=TwoWay}"/>
                                                    <TextBlock Text="InZoneFindItem"/><TextBox Text="{Binding EditingLevelObjective.InZoneFindItem, Mode=TwoWay}"/>
                                                    <TextBlock Text="InZoneFindItemHelp"/><TextBox Text="{Binding EditingLevelObjective.InZoneFindItemHelp, Mode=TwoWay}"/>
                                                    <TextBlock Text="SolveItem"/><TextBox Text="{Binding EditingLevelObjective.SolveItem, Mode=TwoWay}"/>
                                                    <TextBlock Text="SolveItemHelp"/><TextBox Text="{Binding EditingLevelObjective.SolveItemHelp, Mode=TwoWay}"/>
                                                    <TextBlock Text="GoToWinCondition_Elevator"/><TextBox Text="{Binding EditingLevelObjective.GoToWinCondition_Elevator, Mode=TwoWay}"/>
                                                    <TextBlock Text="GoToWinConditionHelp_Elevator"/><TextBox Text="{Binding EditingLevelObjective.GoToWinConditionHelp_Elevator, Mode=TwoWay}"/>
                                                    <TextBlock Text="GoToWinCondition_CustomGeo"/><TextBox Text="{Binding EditingLevelObjective.GoToWinCondition_CustomGeo, Mode=TwoWay}"/>
                                                    <TextBlock Text="GoToWinConditionHelp_CustomGeo"/><TextBox Text="{Binding EditingLevelObjective.GoToWinConditionHelp_CustomGeo, Mode=TwoWay}"/>
                                                    <TextBlock Text="GoToWinCondition_ToMainLayer"/><TextBox Text="{Binding EditingLevelObjective.GoToWinCondition_ToMainLayer, Mode=TwoWay}"/>
                                                    <TextBlock Text="GoToWinConditionHelp_ToMainLayer"/><TextBox Text="{Binding EditingLevelObjective.GoToWinConditionHelp_ToMainLayer, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                </Expander>
                                                <TextBlock Text="ShowHelpDelay"/><TextBox Text="{Binding EditingLevelObjective.ShowHelpDelay, Mode=TwoWay}"/>
                                                    <TextBlock Text="Chained Puzzle At Exit"/><ComboBox ItemsSource="{Binding AvailableAlarms}" SelectedValue="{Binding EditingLevelObjective.ChainedPuzzleAtExit, Mode=TwoWay}" SelectedValueBinding="{Binding PersistentId}" DisplayMemberBinding="{Binding DisplayText}"/>
                                                    <TextBlock Text="ChainedPuzzleAtExitScanSpeedMultiplier"/><TextBox Text="{Binding EditingLevelObjective.ChainedPuzzleAtExitScanSpeedMultiplier, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="Secondary" IsEnabled="{Binding HasSecondarySector}">
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <TextBlock Text="Persistent ID"/><TextBox Text="{Binding EditingLevelRef.SecondaryObjectiveId, Mode=TwoWay}" IsEnabled="False"/>
                                            <TextBlock Text="Type"/><ComboBox ItemsSource="{Binding AvailableObjectiveTypes}" SelectedItem="{Binding SelectedSectorObjectiveType, Mode=TwoWay}"/>
                                            <TextBlock Text="Win Condition"/><ComboBox ItemsSource="{Binding AvailableLevelWinConditions}" SelectedItem="{Binding SelectedLevelWinCondition, Mode=TwoWay}" DisplayMemberBinding="{Binding DisplayName}"/>
                                            <TextBlock Text="Gather Item" IsVisible="{Binding IsGatherSmallItemsObjective}"/><ComboBox ItemsSource="{Binding Items}" SelectedValue="{Binding EditingLevelObjective.GatherItemId, Mode=TwoWay}" SelectedValueBinding="{Binding PersistentId}" DisplayMemberBinding="{Binding DisplayName}" IsVisible="{Binding IsGatherSmallItemsObjective}"/>
                                            <StackPanel IsVisible="{Binding IsGatherSmallItemsObjective}" Spacing="5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Zone Placement Datas" FontWeight="Bold"/><Button Grid.Column="1" Content="+ Add" Command="{Binding #LevelConfigRoot.DataContext.AddLevelObjectiveZonePlacement}" Padding="6,2"/></Grid><ItemsControl ItemsSource="{Binding EditingGatherZonePlacements}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ZonePlacementData" x:CompileBindings="False"><Grid ColumnDefinitions="*,*,*,*,Auto" Margin="0,2"><ComboBox Grid.Column="0" ItemsSource="{Binding #LevelConfigRoot.DataContext.AvailableObjectiveDimensions}" SelectedValue="{Binding DimensionIndex, Mode=TwoWay}" SelectedValueBinding="{Binding DimensionIndex}" DisplayMemberBinding="{Binding DisplayName}"/><ComboBox Grid.Column="1" ItemsSource="{Binding #LevelConfigRoot.DataContext.AvailableLevelObjectiveZones}" SelectedValue="{Binding LocalIndex, Mode=TwoWay}" SelectedValueBinding="{Binding ZoneIndex}" DisplayMemberBinding="{Binding DisplayName}" Margin="4,0,0,0"/><TextBox Grid.Column="2" Text="{Binding Weights.Start, Mode=TwoWay}" Watermark="Start" Margin="4,0,0,0"/><TextBox Grid.Column="3" Text="{Binding Weights.Middle, Mode=TwoWay}" Watermark="Middle" Margin="4,0,0,0"/><TextBox Grid.Column="4" Text="{Binding Weights.End, Mode=TwoWay}" Watermark="End" Margin="4,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="Overload" IsEnabled="{Binding HasOverloadSector}">
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <TextBlock Text="Persistent ID"/><TextBox Text="{Binding EditingLevelRef.OverloadObjectiveId, Mode=TwoWay}" IsEnabled="False"/>
                                            <TextBlock Text="Type"/><ComboBox ItemsSource="{Binding AvailableObjectiveTypes}" SelectedItem="{Binding SelectedSectorObjectiveType, Mode=TwoWay}"/>
                                            <TextBlock Text="Win Condition"/><ComboBox ItemsSource="{Binding AvailableLevelWinConditions}" SelectedItem="{Binding SelectedLevelWinCondition, Mode=TwoWay}" DisplayMemberBinding="{Binding DisplayName}"/>
                                            <TextBlock Text="Gather Item" IsVisible="{Binding IsGatherSmallItemsObjective}"/><ComboBox ItemsSource="{Binding Items}" SelectedValue="{Binding EditingLevelObjective.GatherItemId, Mode=TwoWay}" SelectedValueBinding="{Binding PersistentId}" DisplayMemberBinding="{Binding DisplayName}" IsVisible="{Binding IsGatherSmallItemsObjective}"/>
                                            <StackPanel IsVisible="{Binding IsGatherSmallItemsObjective}" Spacing="5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Zone Placement Datas" FontWeight="Bold"/><Button Grid.Column="1" Content="+ Add" Command="{Binding #LevelConfigRoot.DataContext.AddLevelObjectiveZonePlacement}" Padding="6,2"/></Grid><ItemsControl ItemsSource="{Binding EditingGatherZonePlacements}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ZonePlacementData" x:CompileBindings="False"><Grid ColumnDefinitions="*,*,*,*,Auto" Margin="0,2"><ComboBox Grid.Column="0" ItemsSource="{Binding #LevelConfigRoot.DataContext.AvailableObjectiveDimensions}" SelectedValue="{Binding DimensionIndex, Mode=TwoWay}" SelectedValueBinding="{Binding DimensionIndex}" DisplayMemberBinding="{Binding DisplayName}"/><ComboBox Grid.Column="1" ItemsSource="{Binding #LevelConfigRoot.DataContext.AvailableLevelObjectiveZones}" SelectedValue="{Binding LocalIndex, Mode=TwoWay}" SelectedValueBinding="{Binding ZoneIndex}" DisplayMemberBinding="{Binding DisplayName}" Margin="4,0,0,0"/><TextBox Grid.Column="2" Text="{Binding Weights.Start, Mode=TwoWay}" Watermark="Start" Margin="4,0,0,0"/><TextBox Grid.Column="3" Text="{Binding Weights.Middle, Mode=TwoWay}" Watermark="Middle" Margin="4,0,0,0"/><TextBox Grid.Column="4" Text="{Binding Weights.End, Mode=TwoWay}" Watermark="End" Margin="4,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Expander>

                        <!-- Level-specific survival wave and starting player state -->
                        <Expander Header="Scout Settings" IsExpanded="False" Padding="14" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:CompileBindings="False">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Wave Roles (Enemy Selection)" FontWeight="Bold" Foreground="#FFFFFF" />
                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Weakling:" ToolTip.Tip="The 'weakling' type enemy for this alarm. This enemy will cost 0.75 points to spawn, with a total points soft cap of 25. Many vanilla alarms opt to filter this out by excluding it in the population filter, instead using the standard and special slots for their small enemies as they cost 1 point instead of 0.75." Margin="0,0,8,8" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding #LevelConfigRoot.DataContext.Enemies}" SelectedValue="{Binding EditingLevelSurvivalWave.WaveRoleWeakling, Mode=TwoWay}" SelectedValueBinding="{Binding PersistentId}" Margin="0,0,16,8" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Standard:" ToolTip.Tip="The 'standard' type enemy for this alarm. This enemy will cost 1 point to spawn, with a total points soft cap of 25. Generally, this is going to be your strikers/shooters." Margin="0,0,8,8" />
                                    <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding #LevelConfigRoot.DataContext.Enemies}" SelectedValue="{Binding EditingLevelSurvivalWave.WaveRoleStandard, Mode=TwoWay}" SelectedValueBinding="{Binding PersistentId}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Special:" ToolTip.Tip="The 'special' type enemy for this alarm. This enemy will cost 1 point to spawn, with a total points soft cap of 25. Generally, this is going to be your strikers/shooters." Margin="0,0,8,8" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding #LevelConfigRoot.DataContext.Enemies}" SelectedValue="{Binding EditingLevelSurvivalWave.WaveRoleSpecial, Mode=TwoWay}" SelectedValueBinding="{Binding PersistentId}" Margin="0,0,16,8" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="MiniBoss:" ToolTip.Tip="The 'miniboss' type enemy for this alarm. This enemy will cost 2 points to spawn, with a total points soft cap of 25." Margin="0,0,8,8" />
                                    <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding #LevelConfigRoot.DataContext.Enemies}" SelectedValue="{Binding EditingLevelSurvivalWave.WaveRoleMiniBoss, Mode=TwoWay}" SelectedValueBinding="{Binding PersistentId}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Boss:" ToolTip.Tip="The 'boss' type enemy for this alarm. This enemy type is broken in vanilla." Margin="0,0,8,0" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding #LevelConfigRoot.DataContext.Enemies}" SelectedValue="{Binding EditingLevelSurvivalWave.WaveRoleBoss, Mode=TwoWay}" SelectedValueBinding="{Binding PersistentId}" Margin="0,0,16,0" />
                                </Grid>

                                <TextBlock Text="Wave Timing &amp; Pauses" FontWeight="Bold" Foreground="#FFFFFF" />
                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Pause Before Start (s):" ToolTip.Tip="How many seconds to wait between the alarm starting and the first wave spawning." Margin="0,0,8,8" /><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditingLevelSurvivalWave.PauseBeforeStart, Mode=TwoWay}" Margin="0,0,16,8" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Pause Between Groups (s):" ToolTip.Tip="Delay between spawning enemy groups." Margin="0,0,8,8" /><TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EditingLevelSurvivalWave.PauseBetweenGroups, Mode=TwoWay}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Wave Pause Min (s):" ToolTip.Tip="Delay between waves at or below the minimum score boundary." Margin="0,0,8,8" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditingLevelSurvivalWave.WavePauseMin, Mode=TwoWay}" Margin="0,0,16,8" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Wave Pause Max (s):" ToolTip.Tip="Delay between waves at the maximum score boundary." Margin="0,0,8,8" /><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding EditingLevelSurvivalWave.WavePauseMax, Mode=TwoWay}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Wave Pause Min at Cost:" ToolTip.Tip="Minimum score boundary for pauses between waves." Margin="0,0,8,0" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditingLevelSurvivalWave.WavePauseMin_AtCost, Mode=TwoWay}" Margin="0,0,16,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Wave Pause Max at Cost:" ToolTip.Tip="Maximum score boundary for pauses between waves." Margin="0,0,8,0" /><TextBox Grid.Row="2" Grid.Column="3" Text="{Binding EditingLevelSurvivalWave.WavePauseMax_AtCost, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock Text="Population Filter" FontWeight="Bold" Foreground="#FFFFFF" />
                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="Filter Type:" ToolTip.Tip="The selected types below will be either the only enemies spawned, or will be excluded entirely, based on this value." Margin="0,0,8,8" /><ComboBox Grid.Column="1" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableFilterTypes}" SelectedItem="{Binding EditingLevelSurvivalWave.FilterType, Mode=TwoWay}" Margin="0,0,16,8" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Filter Modes:" ToolTip.Tip="Select the types to include/exclude from spawning." Margin="0,0,8,0" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="12"><CheckBox Content="Weakling" ToolTip.Tip="True if the weakling type should be included in the filter." IsChecked="{Binding EditingLevelSurvivalWave.FilterWeakling, Mode=TwoWay}" /><CheckBox Content="Standard" ToolTip.Tip="True if the standard type should be included in the filter." IsChecked="{Binding EditingLevelSurvivalWave.FilterStandard, Mode=TwoWay}" /><CheckBox Content="Special" ToolTip.Tip="True if the special type should be included in the filter." IsChecked="{Binding EditingLevelSurvivalWave.FilterSpecial, Mode=TwoWay}" /><CheckBox Content="MiniBoss" ToolTip.Tip="True if the miniboss type should be included in the filter." IsChecked="{Binding EditingLevelSurvivalWave.FilterMiniBoss, Mode=TwoWay}" /><CheckBox Content="Boss" ToolTip.Tip="True if the boss type should be included in the filter." IsChecked="{Binding EditingLevelSurvivalWave.FilterBoss, Mode=TwoWay}" /></StackPanel>
                                </Grid>

                                <TextBlock Text="Spawn Direction &amp; Type" FontWeight="Bold" Foreground="#FFFFFF" />
                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Text="Randomize Direction / Wave:" ToolTip.Tip="0-1 chance for the spawn direction to change between waves." Margin="0,0,8,8" /><TextBox Grid.Column="1" Text="{Binding EditingLevelSurvivalWave.ChanceToRandomizeSpawnDirectionPerWave, Mode=TwoWay}" Margin="0,0,16,8" />
                                    <TextBlock Grid.Column="2" Text="Randomize Direction / Group:" ToolTip.Tip="0-1 chance for the spawn direction to change between groups." Margin="0,0,8,8" /><TextBox Grid.Column="3" Text="{Binding EditingLevelSurvivalWave.ChanceToRandomizeSpawnDirectionPerGroup, Mode=TwoWay}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="1" Text="Override Spawn Type:" ToolTip.Tip="True if the spawn type should be overriden. This must be true for the Wave Spawn Type value to be functional." Margin="0,0,8,0" /><CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding EditingLevelSurvivalWave.OverrideWaveSpawnType, Mode=TwoWay}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Wave Spawn Type:" ToolTip.Tip="Affects how the enemies spawn. Note that FromElevatorDirection only refers to the host in vanilla." Margin="0,0,8,0" /><ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableWaveSpawnTypes}" SelectedItem="{Binding EditingLevelSurvivalWave.SurvivalWaveSpawnType, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock Text="Population Points &amp; Ramp" FontWeight="Bold" Foreground="#FFFFFF" />
                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Text="Population Points Total:" ToolTip.Tip="The total population points for waves. The alarm automatically stops if this runs out. -1 is infinite." Margin="0,0,8,8" /><TextBox Grid.Column="1" Text="{Binding EditingLevelSurvivalWave.PopulationPointsTotal, Mode=TwoWay}" Margin="0,0,16,8" />
                                    <TextBlock Grid.Column="2" Text="Population Ramp Over Time (s):" ToolTip.Tip="Lerp over time for start-end population point settings." Margin="0,0,8,8" /><TextBox Grid.Column="3" Text="{Binding EditingLevelSurvivalWave.PopulationRampOverTime, Mode=TwoWay}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="1" Text="Points Per Wave (Start):" ToolTip.Tip="Population points for a wave at start ramp." Margin="0,0,8,8" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditingLevelSurvivalWave.PopulationPointsPerWaveStart, Mode=TwoWay}" Margin="0,0,16,8" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Points Per Wave (End):" ToolTip.Tip="Population points for a wave at end ramp." Margin="0,0,8,8" /><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding EditingLevelSurvivalWave.PopulationPointsPerWaveEnd, Mode=TwoWay}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="2" Text="Points Per Group (Start):" ToolTip.Tip="Population points for a group at start ramp." Margin="0,0,8,8" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditingLevelSurvivalWave.PopulationPointsPerGroupStart, Mode=TwoWay}" Margin="0,0,16,8" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Points Per Group (End):" ToolTip.Tip="Population points for a group at end ramp." Margin="0,0,8,8" /><TextBox Grid.Row="2" Grid.Column="3" Text="{Binding EditingLevelSurvivalWave.PopulationPointsPerGroupEnd, Mode=TwoWay}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="3" Text="Min Points Per Group:" ToolTip.Tip="Minimum required cost for a group to spawn." Margin="0,0,8,0" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditingLevelSurvivalWave.PopulationPointsMinPerGroup, Mode=TwoWay}" Margin="0,0,16,0" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                        <!-- Resource Containers Section -->
                        <Expander Header="Resource Containers" IsExpanded="False" Padding="14"
                                  Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1"
                                  CornerRadius="6" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch" x:CompileBindings="False">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" ToolTip.Tip="0-1 chance to put new loot spawns in existing resource containers instead of making a new one. Higher chances will cause thre to be less boxes/lockers, but each will have more loot on average." Text="Chance To Re-Use Resource Container:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditingExpeditionBalance.ChanceToReUseResourceContainer, Mode=TwoWay}" Margin="0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" ToolTip.Tip="The maximum number of packs that can spawn in a single resource container" Text="Max Packs Per Resource Container:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditingExpeditionBalance.MaxPacksPerResourceContainer, Mode=TwoWay}" Margin="0,4"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" ToolTip.Tip="The number of empty weak resource containers to spawn in each zone" Text="Empty Weak Resource Containers Per Zone:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditingExpeditionBalance.EmptyWeakResourceContainersPerZone, Mode=TwoWay}" Margin="0,4"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" ToolTip.Tip="The number of empty secure resource containers to spawn in each zone" Text="Empty Secure Resource Containers Per Zone:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditingExpeditionBalance.EmptySecureResourceContainersPerZone, Mode=TwoWay}" Margin="0,4"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" ToolTip.Tip="0-1 chance that a resource container with a pack inside it will be locked" Text="Weak Resource Container With Pack Chance For Locked:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EditingExpeditionBalance.WeakResourceContainerWithPackChanceForLocked, Mode=TwoWay}" Margin="0,4"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Weak Doors Section -->
                        <Expander Header="Room Doors" IsExpanded="False" Padding="14"
                                  Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1"
                                  CornerRadius="6" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch" x:CompileBindings="False">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" ToolTip.Tip="The health of small (4x4) room doors" Text="Small Door Health:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditingExpeditionBalance.WeakDoor4x4Health, Mode=TwoWay}" Margin="0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" ToolTip.Tip="The health of large (8x4) room doors" Text="Large Door Health:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditingExpeditionBalance.WeakDoor8x4Health, Mode=TwoWay}" Margin="0,4"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" ToolTip.Tip="The probability weight that a room door will have no lock on it" Text="No Lock Weight:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditingExpeditionBalance.WeakDoorChanceLockWeightNoLock, Mode=TwoWay}" Margin="0,4"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" ToolTip.Tip="The probability weight that a room door will have a melee lock on it" Text="Melee Lock Weight:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditingExpeditionBalance.WeakDoorChanceLockWeightMelee, Mode=TwoWay}" Margin="0,4"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" ToolTip.Tip="The probability weight that a room door will have a hack lock on it" Text="Hack Lock Weight:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EditingExpeditionBalance.WeakDoorChanceLockWeightHackableLock, Mode=TwoWay}" Margin="0,4"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" ToolTip.Tip="The health of the smack lock on a room door" Text="Room Door Lock Health:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding EditingExpeditionBalance.WeakDoorLockHealth, Mode=TwoWay}" Margin="0,4"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" ToolTip.Tip="The conversion factor for the volume of glue to the health of a door. E.g., if this value is 0.5 and there are 10 units of C-Foam on a door, then the door will have 5 extra health" Text="Glue Volume To Door Health Conversion:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding EditingExpeditionBalance.GlueVolumeToDoorHealthConversion, Mode=TwoWay}" Margin="0,4"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" ToolTip.Tip="The maximum amount of units of glue that a door can have (default is 27)" Text="Glue Volume For Door Glue Max State:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding EditingExpeditionBalance.GlueVolumeForDoorGlueMaxState, Mode=TwoWay}" Margin="0,4"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Artifacts Section -->
                        <Expander Header="Artifacts" IsExpanded="False" Padding="14"
                                  Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1"
                                  CornerRadius="6" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch" x:CompileBindings="False">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" ToolTip.Tip="The number of artifacts to spawn per segment" Text="Artifacts Per Segment:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditingExpeditionBalance.ArtifactsPerSegment, Mode=TwoWay}" Margin="0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" ToolTip.Tip="The number of artifacts to spawn in each sector (before sector-specific settings are accounted for)" Text="Artifacts Per Sector:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditingExpeditionBalance.ArtifactsPerLayer, Mode=TwoWay}" Margin="0,4"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" ToolTip.Tip="The 0-1 chance for an artifact to be spawned in a resource container" Text="Chance To Put Artifact In Resource Container:" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditingExpeditionBalance.ChanceToPutArtifactInResourceContainer, Mode=TwoWay}" Margin="0,4"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer with Errors and Action Buttons -->
                <StackPanel Grid.Row="2" Spacing="10" Margin="0,14,0,0">
                    <!-- Error message if any -->
                    <TextBlock Text="{Binding CreationErrorMessage}"
                               Foreground="#FF6B6B"
                               FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasCreationErrorMessage}"/>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="Cancel"
                                Command="{Binding CancelCreateLevel}"
                                Padding="16,8"/>
                        <Button Content="{Binding LevelDialogConfirmButtonText}"
                                Command="{Binding ConfirmCreateLevel}"
                                Background="#007ACC"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</UserControl>
