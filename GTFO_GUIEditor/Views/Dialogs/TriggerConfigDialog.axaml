<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GTFO_GUIEditor.ViewModels;assembly=GTFO_GUIEditor"
             xmlns:models="clr-namespace:GTFO_GUIEditor.Models;assembly=GTFO_GUIEditor"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="GTFO_GUIEditor.Views.Dialogs.TriggerConfigDialog"
             x:Name="TriggerConfigDialogRoot"
             x:DataType="vm:LevelLayoutViewModel">
    <Border Background="#80000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Border Background="#252526"
                BorderBrush="#444444"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Width="920"
                MaxHeight="800"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 4 20 #80000000">
            <StackPanel Spacing="14">
                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding EditingTriggerTitle}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1"
                            Content="✕"
                            Command="{Binding CloseTriggerConfigDialog}"
                            Padding="8,4"
                            Background="Transparent" />
                </Grid>

                <ScrollViewer MaxHeight="620" Padding="0,0,10,0" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <!-- BIG PICKUP SECTIONS (Visible when IsBigPickup == True) -->
                        <!-- Big Pickup General Settings -->
                        <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6"
                                Padding="14"
                                IsVisible="{Binding EditingTrigger.IsBigPickup}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="General Settings"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#00F2FF" />

                                <!-- Pickup Type Selection -->
                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0"
                                               Text="Pickup To Spawn:"
                                               ToolTip.Tip="The big pickup item to spawn here"
                                               FontWeight="SemiBold"
                                               Foreground="#E0E0E0"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableWorldEventObjectOptions}"
                                              SelectedItem="{Binding EditingTrigger.PickupToSpawn, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Big Pickup Transform (Position, Rotation, Scale) -->
                        <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6"
                                Padding="14"
                                IsVisible="{Binding EditingTrigger.IsBigPickup}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Transform"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#00F2FF" />

                                <!-- Position -->
                                <TextBlock Text="3D Position:"
                                           ToolTip.Tip="The position of the item. This can be modified manually here, or moved around by dragging it on the level layout view"
                                           FontWeight="SemiBold"
                                           Foreground="#E0E0E0" />
                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                    <TextBlock Grid.Column="0" Text="X:" ToolTip.Tip="#X position of the item" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding EditingTrigger.Center.X, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="1"
                                                   FormatString="F2"
                                                   Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="2" Text="Y:" ToolTip.Tip="Y position of the item" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="3"
                                                   Value="{Binding EditingTrigger.Center.Y, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="1"
                                                   FormatString="F2"
                                                   Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="4" Text="Z (Height):" ToolTip.Tip="Z position of the item. Note this automatically snaps to ground height when dragged on the level view."
                                               FontWeight="SemiBold" Foreground="#E0E0E0" VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="5"
                                                   Value="{Binding EditingTrigger.Center.Z, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="1"
                                                   FormatString="F2" />
                                </Grid>

                                <!-- Rotation -->
                                <TextBlock Text="3D Rotation:"
                                           ToolTip.Tip="Rotation of the item"
                                           FontWeight="SemiBold"
                                           Foreground="#E0E0E0"
                                           Margin="0,4,0,0" />
                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                    <TextBlock Grid.Column="0" Text="X:" ToolTip.Tip="X rotation of the item" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding EditingTrigger.Rotation.X, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="1"
                                                   FormatString="F2"
                                                   Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="2" Text="Y:" ToolTip.Tip="Y rotation of the item" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="3"
                                                   Value="{Binding EditingTrigger.Rotation.Y, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="1"
                                                   FormatString="F2"
                                                   Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="4" Text="Z:" ToolTip.Tip="Z position of the item" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="5"
                                                   Value="{Binding EditingTrigger.Rotation.Z, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="1"
                                                   FormatString="F2" />
                                </Grid>

                                <!-- Scale -->
                                <TextBlock Text="3D Scale:"
                                           ToolTip.Tip="Scale of the item"
                                           FontWeight="SemiBold"
                                           Foreground="#E0E0E0"
                                           Margin="0,4,0,0" />
                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                    <TextBlock Grid.Column="0" Text="X:" ToolTip.Tip="X scale of the item" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding EditingTrigger.Scale.X, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="0.1"
                                                   FormatString="F2"
                                                   Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="2" Text="Y:" ToolTip.Tip="Y scale of the item" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="3"
                                                   Value="{Binding EditingTrigger.Scale.Y, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="0.1"
                                                   FormatString="F2"
                                                   Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="4" Text="Z:" ToolTip.Tip="Z scale of the item" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="5"
                                                   Value="{Binding EditingTrigger.Scale.Z, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="0.1"
                                                   FormatString="F2" />
                                </Grid>

                                <!-- Use Random Position (Big Pickups) -->
                                <Grid ColumnDefinitions="160,*" IsVisible="{Binding EditingTrigger.IsBigPickup}" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" Text="Use Random Position:" ToolTip.Tip="If true, the position value is ignored and it will spawn randomly in this zone. You are better off using the Big Pickup settings in the Zone Config if you are wanting this behaviour, as then it will be supported by vanilla"
                                               FontWeight="SemiBold" Foreground="#E0E0E0" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding EditingTrigger.UseRandomPosition, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Big Pickup Events on Pickup -->
                        <Expander Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6"
                                  HorizontalAlignment="Stretch" IsExpanded="True"
                                  IsVisible="{Binding EditingTrigger.IsBigPickup}">
                            <Expander.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Events on Pickup" FontWeight="SemiBold"
                                               FontSize="13" ToolTip.Tip="Events to trigger when the item is picked up"
                                               Foreground="#03C700" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0">
                                        <Button Content="+ Add Event" Command="{Binding AddEditingTriggerEvent}"
                                                Background="#2D5A27" Foreground="White" Padding="10,4" />
                                        <Button Content="+ Add from Clipboard"
                                                Command="{Binding AddEditingTriggerEventFromClipboardCommand}"
                                                Foreground="White" Padding="10,4" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding EditingTrigger.Events}"
                                              ItemTemplate="{StaticResource WardenEventTemplate}" />
                            </StackPanel>
                        </Expander>

                        <!-- TRIGGER SECTIONS (Visible when IsBigPickup == False) -->
                        <!-- General Settings Section -->
                        <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6"
                                Padding="14"
                                IsVisible="{Binding !EditingTrigger.IsBigPickup}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="General Settings"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#00F2FF" />

                                <!-- Shape Selector -->
                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0"
                                               Text="Trigger Shape:"
                                               ToolTip.Tip="The shape of the trigger. This is limited to the Unity collider shapes"
                                               FontWeight="SemiBold"
                                               Foreground="#E0E0E0"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableTriggerShapes}"
                                              SelectedItem="{Binding EditingTrigger.Shape, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                                </Grid>

                                <!-- Trigger Type Selector -->
                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0"
                                               Text="Trigger Type:"
                                               ToolTip.Tip="How this trigger should be activated"
                                               FontWeight="SemiBold"
                                               Foreground="#E0E0E0"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableTriggerTypes}"
                                              SelectedItem="{Binding EditingTrigger.Type, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                                </Grid>

                                <!-- Is Toggle Checkbox -->
                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0"
                                               Text="Is Toggle:"
                                               ToolTip.Tip="If true, the trigger can be activated multiple times. This is typically undesirable for collision triggers"
                                               FontWeight="SemiBold"
                                               Foreground="#E0E0E0"
                                               VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding EditingTrigger.IsToggle, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Transform (Center 3D Coordinates) Section -->
                        <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6"
                                Padding="14"
                                IsVisible="{Binding !EditingTrigger.IsBigPickup}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="3D Center Position"
                                           ToolTip.Tip="The position of the centre of the trigger. This can be manually changed here, or by dragging the trigger around in the level layout view. The center of the elevator tile is (0, 0), and each grid cell is 64x64."
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#00F2FF" />

                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" Text="X:" ToolTip.Tip="X position of the trigger" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding EditingTrigger.Center.X, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="1"
                                                   FormatString="F2"
                                                   Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="2" Text="Y:" ToolTip.Tip="Y position of the trigger" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="3"
                                                   Value="{Binding EditingTrigger.Center.Y, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="1"
                                                   FormatString="F2"
                                                   Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="4" Text="Z (Height):" ToolTip.Tip="Z position of the trigger"
                                               FontWeight="SemiBold" Foreground="#E0E0E0" VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="5"
                                                   Value="{Binding EditingTrigger.Center.Z, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="1"
                                                   FormatString="F2" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Box Collider Dimensions (Visible when Shape == Box) -->
                        <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6"
                                Padding="14"
                                IsVisible="{Binding EditingTrigger.IsBox}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Box Collider Dimensions"
                                           ToolTip.Tip="Dimensions of the box collider"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#FFA726" />

                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" Text="Size X:" ToolTip.Tip="X size of the box" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding EditingTrigger.Size.X, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Minimum="0.1"
                                                   Increment="1"
                                                   FormatString="F2"
                                                   Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="2" Text="Size Y:" ToolTip.Tip="Y size of the box" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="3"
                                                   Value="{Binding EditingTrigger.Size.Y, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Minimum="0.1"
                                                   Increment="1"
                                                   FormatString="F2"
                                                   Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="4" Text="Size Z:" ToolTip.Tip="Z size of the box" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="5"
                                                   Value="{Binding EditingTrigger.Size.Z, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Minimum="0.1"
                                                   Increment="1"
                                                   FormatString="F2" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Sphere Collider Dimensions (Visible when Shape == Sphere) -->
                        <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6"
                                Padding="14"
                                IsVisible="{Binding EditingTrigger.IsSphere}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Sphere Collider Dimensions"
                                           ToolTip.Tip="Dimensions of the sphere collider"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#81C784" />

                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0"
                                               Text="Radius:"
                                               ToolTip.Tip="Radius of the sphere"
                                               FontWeight="SemiBold"
                                               Foreground="#E0E0E0"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding EditingTrigger.Radius, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Minimum="0.1"
                                                   Increment="1"
                                                   FormatString="F2" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Capsule Collider Dimensions (Visible when Shape == Capsule) -->
                        <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6"
                                Padding="14"
                                IsVisible="{Binding EditingTrigger.IsCapsule}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Capsule Collider Dimensions"
                                           ToolTip.Tip="Dimensions of the capsule trigger"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#BA68C8" />

                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="Radius:"
                                               ToolTip.Tip="Radius of the capsule"
                                               FontWeight="SemiBold"
                                               Foreground="#E0E0E0"
                                               VerticalAlignment="Center"
                                               Margin="0,0,0,10" />
                                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                                   Value="{Binding EditingTrigger.Radius, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Minimum="0.1"
                                                   Increment="1"
                                                   FormatString="F2"
                                                   Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="Height:"
                                               ToolTip.Tip="Height of the capsule"
                                               FontWeight="SemiBold"
                                               Foreground="#E0E0E0"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                                   Value="{Binding EditingTrigger.Height, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Minimum="0.1"
                                                   Increment="1"
                                                   FormatString="F2" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Interaction Settings Section (Visible when Type == Interaction) -->
                        <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6"
                                Padding="14"
                                IsVisible="{Binding EditingTrigger.IsInteraction}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Interaction Settings"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#4DD0E1" />

                                <!-- Interaction Text -->
                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0"
                                               Text="Interaction Text:"
                                               ToolTip.Tip="The popup text when interacting with this trigger"
                                               FontWeight="SemiBold"
                                               Foreground="#E0E0E0"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding EditingTrigger.InteractionText, Mode=TwoWay}"
                                             Watermark="e.g. Insert Cell" />
                                </Grid>

                                <!-- Carry Item Insert Type -->
                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0"
                                               Text="Carry Item Insert:"
                                               ToolTip.Tip="The item that needs to be inserted to this trigger"
                                               FontWeight="SemiBold"
                                               Foreground="#E0E0E0"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableCarryItemInsertTypes}"
                                              SelectedItem="{Binding EditingTrigger.CarryItemInsertType, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Carry Item Configuration Section (Visible when Type == Interaction AND CarryItemInsertType != None) -->
                        <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6"
                                Padding="14"
                                IsVisible="{Binding EditingTrigger.HasCarryItem}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Carry Item Configuration"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#80CBC4" />

                                <!-- Remove Item On Insert -->
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Grid.Column="0"
                                               Text="Remove Item On Insert:"
                                               ToolTip.Tip="If true, the item will be deleted on insert"
                                               FontWeight="SemiBold"
                                               Foreground="#E0E0E0"
                                               VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding EditingTrigger.RemoveItemOnInsert, Mode=TwoWay}" />
                                </Grid>

                                <!-- Item State After Insert -->
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Grid.Column="0"
                                               Text="Item State After Insert:"
                                               ToolTip.Tip="After the item has been inserted, it is now visible in the world. This defines the state of that item"
                                               FontWeight="SemiBold"
                                               Foreground="#E0E0E0"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableItemStatesAfterInsert}"
                                              SelectedItem="{Binding EditingTrigger.ItemStateAfterInsert, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                                </Grid>

                                <!-- Transform: Position -->
                                <TextBlock Text="Item Position Offset:"
                                           ToolTip.Tip="An offset for the position of the item when it is visible in the world after the interaction has been completed"
                                           FontWeight="SemiBold"
                                           Foreground="#E0E0E0"
                                           Margin="0,4,0,0" />
                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                    <TextBlock Grid.Column="0" Text="X:" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding EditingTrigger.CarryItemTransform.Position.X, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="1"
                                                   FormatString="F2"
                                                   Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="2" Text="Y:" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="3"
                                                   Value="{Binding EditingTrigger.CarryItemTransform.Position.Y, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="1"
                                                   FormatString="F2"
                                                   Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="4" Text="Z:" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="5"
                                                   Value="{Binding EditingTrigger.CarryItemTransform.Position.Z, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="1"
                                                   FormatString="F2" />
                                </Grid>

                                <!-- Transform: Rotation -->
                                <TextBlock Text="Item Rotation:"
                                           ToolTip.Tip="Rotation of the item when it is visible in the world after the interaction has been completed"
                                           FontWeight="SemiBold"
                                           Foreground="#E0E0E0"
                                           Margin="0,4,0,0" />
                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                    <TextBlock Grid.Column="0" Text="X:" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding EditingTrigger.CarryItemTransform.Rotation.X, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="1"
                                                   FormatString="F2"
                                                   Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="2" Text="Y:" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="3"
                                                   Value="{Binding EditingTrigger.CarryItemTransform.Rotation.Y, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="1"
                                                   FormatString="F2"
                                                   Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="4" Text="Z:" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="5"
                                                   Value="{Binding EditingTrigger.CarryItemTransform.Rotation.Z, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="1"
                                                   FormatString="F2" />
                                </Grid>

                                <!-- Transform: Scale -->
                                <TextBlock Text="Item Scale:"
                                           ToolTip.Tip="Scale of the item when it is visible in the world after the interaction has been completed"
                                           FontWeight="SemiBold"
                                           Foreground="#E0E0E0"
                                           Margin="0,4,0,0" />
                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                                    <TextBlock Grid.Column="0" Text="X:" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding EditingTrigger.CarryItemTransform.Scale.X, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="0.1"
                                                   FormatString="F2"
                                                   Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="2" Text="Y:" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="3"
                                                   Value="{Binding EditingTrigger.CarryItemTransform.Scale.Y, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="0.1"
                                                   FormatString="F2"
                                                   Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="4" Text="Z:" FontWeight="SemiBold"
                                               Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <NumericUpDown Grid.Column="5"
                                                   Value="{Binding EditingTrigger.CarryItemTransform.Scale.Z, Mode=TwoWay}"
                                                   ShowButtonSpinner="False"
                                                   Increment="0.1"
                                                   FormatString="F2" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Trigger Events Section (Warden Events) -->
                        <Expander Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6"
                                  HorizontalAlignment="Stretch" IsExpanded="True"
                                  IsVisible="{Binding !EditingTrigger.IsBigPickup}">
                            <Expander.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Trigger Events" FontWeight="SemiBold"
                                               FontSize="13" ToolTip.Tip="The events to be triggered when the trigger is activated"
                                               Foreground="#03C700" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0">
                                        <Button Content="+ Add Event" Command="{Binding AddEditingTriggerEvent}"
                                                Background="#2D5A27" Foreground="White" Padding="10,4" />
                                        <Button Content="+ Add from Clipboard"
                                                Command="{Binding AddEditingTriggerEventFromClipboardCommand}"
                                                Background="#2E5B88"
                                                Foreground="White" Padding="10,4" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding EditingTrigger.Events}"
                                              ItemTemplate="{StaticResource WardenEventTemplate}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Actions / Buttons Footer -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
                    <Button Grid.Column="0"
                            Content="Delete"
                            Command="{Binding RequestDeleteEditingTrigger}"
                            Background="#D9534F"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Padding="14,6" />

                    <Button Grid.Column="2"
                            Content="Done"
                            Command="{Binding CloseTriggerConfigDialog}"
                            Background="#2D5A27"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Padding="20,6" />
                </Grid>
            </StackPanel>
        </Border>
    </Border>
</UserControl>