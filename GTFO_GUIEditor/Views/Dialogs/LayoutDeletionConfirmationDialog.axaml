<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GTFO_GUIEditor.ViewModels;assembly=GTFO_GUIEditor"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="GTFO_GUIEditor.Views.Dialogs.LayoutDeletionConfirmationDialog"
             x:DataType="vm:LevelLayoutViewModel">
    <Border Background="#80000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Border Background="#252526"
                BorderBrush="#444444"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Width="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 4 20 #80000000">
            <StackPanel Spacing="16">
                <TextBlock Text="{Binding LayoutDeletionTitle}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF6B6B"/>

                <TextBlock Text="{Binding LayoutDeletionMessage}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="#CCCCCC"/>

                <Border Background="#331A1A"
                        BorderBrush="#882222"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10"
                        IsVisible="{Binding HasLayoutDeletionWarning}">
                    <TextBlock Text="{Binding LayoutDeletionWarning}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#FF9999"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                    <Button Content="Cancel"
                            Command="{Binding CancelLayoutDeletion}"
                            Padding="16,8"/>
                    <Button Content="Delete"
                            Command="{Binding ConfirmLayoutDeletion}"
                            Background="#D9534F"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Padding="16,8"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
