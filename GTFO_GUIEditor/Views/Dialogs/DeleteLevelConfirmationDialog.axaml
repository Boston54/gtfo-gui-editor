<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GTFO_GUIEditor.ViewModels;assembly=GTFO_GUIEditor"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="GTFO_GUIEditor.Views.Dialogs.DeleteLevelConfirmationDialog"
             x:DataType="vm:LevelLayoutViewModel">
    <Border Background="#80000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Border Background="#252526"
                BorderBrush="#444444"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 4 20 #80000000">
            <StackPanel Spacing="16">
                <TextBlock Text="Confirm Deletion"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF6B6B"/>

                <TextBlock Text="{Binding DeleteConfirmationMessage}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="#E0E0E0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                    <Button Content="Cancel"
                            Command="{Binding CancelDeleteLevel}"
                            Padding="16,8"/>
                    <Button Content="Delete"
                            Command="{Binding ConfirmDeleteLevel}"
                            Background="#D9534F"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Padding="16,8"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
