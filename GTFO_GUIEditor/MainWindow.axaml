<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GTFO_GUIEditor.ViewModels;assembly=GTFO_GUIEditor"
        xmlns:models="clr-namespace:GTFO_GUIEditor.Models;assembly=GTFO_GUIEditor"
        xmlns:views="clr-namespace:GTFO_GUIEditor.Views;assembly=GTFO_GUIEditor"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="GTFO_GUIEditor.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="GTFO Level Editor"
        Icon="/Assets/icon.png">
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewRundown}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveRundown}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenRundown}"/>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding QuickExportDatablocks}"/>
    </Window.KeyBindings>
    <Grid RowDefinitions="Auto,*">
        <!-- Top Taskbar / Menu Bar -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="2,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Menu Grid.Column="0" Background="Transparent" Foreground="#E0E0E0">
                    <MenuItem Header="File" Foreground="#E0E0E0" FontWeight="SemiBold" FontSize="13">
                        <MenuItem Header="New"
                                  Command="{Binding NewRundown}"
                                  InputGesture="Ctrl+N"/>
                        <Separator Background="#333333"/>
                        <MenuItem Header="Save"
                                  Command="{Binding SaveRundown}"
                                  InputGesture="Ctrl+S"/>
                        <MenuItem Header="Save As..."
                                  Command="{Binding SaveAsRundown}"/>
                        <Separator Background="#333333"/>
                        <MenuItem Header="Open..."
                                  Command="{Binding OpenRundown}"
                                  InputGesture="Ctrl+O"/>
                        <MenuItem Header="Open Recent"
                                  ItemsSource="{Binding RecentFiles}">
                            <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="models:RecentFileItem">
                                    <MenuItem Header="{Binding DisplayName}"
                                              ToolTip.Tip="{Binding FilePath}"
                                              IsEnabled="{Binding !IsPlaceholder}"
                                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenRecentFile}"
                                              CommandParameter="{Binding FilePath}"/>
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Export" Foreground="#E0E0E0" FontWeight="SemiBold" FontSize="13">
                        <MenuItem Header="Quick Export"
                                  Command="{Binding QuickExportDatablocks}"
                                  InputGesture="Ctrl+E"/>
                        <MenuItem Header="Export To..."
                                  Command="{Binding ExportDatablocksTo}"/>
                    </MenuItem>
                </Menu>

                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentFileTitle}"
                           Foreground="#888888"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding StatusMessage}"
                           Foreground="#AAAAAA"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
            <!-- Left Half -->
            <Border Grid.Column="0" Padding="10">
                <views:LevelLayoutView DataContext="{Binding LevelLayout}"/>
            </Border>

            <!-- Middle Margin Separator -->
            <GridSplitter Grid.Column="1" Width="4" Background="#333333" ResizeDirection="Columns"/>

            <!-- Right Half -->
            <TabControl Grid.Column="2" SelectedIndex="0" Margin="5">
                <TabItem Header="Home">
                    <views:DocumentationView DataContext="{Binding Documentation}"/>
                </TabItem>
                <TabItem Header="Alarms">
                    <views:AlarmsView DataContext="{Binding Alarms}"/>
                </TabItem>
                <TabItem Header="Consumables">
                    <views:ConsumablesView DataContext="{Binding Consumables}"/>
                </TabItem>
                <TabItem Header="Lighting">
                    <views:LightingView DataContext="{Binding Lighting}"/>
                </TabItem>
                <TabItem Header="Fog">
                    <views:FogSettingsView DataContext="{Binding FogSettings}"/>
                </TabItem>
                <TabItem Header="Geomorphs">
                    <views:GeomorphsView DataContext="{Binding Geomorphs}"/>
                </TabItem>
                <TabItem Header="Sounds">
                    <views:SoundsView DataContext="{Binding Sounds}"/>
                </TabItem>
                <TabItem Header="Rundown">
                    <views:RundownView DataContext="{Binding Rundown}"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
