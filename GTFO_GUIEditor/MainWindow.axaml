<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GTFO_GUIEditor.ViewModels;assembly=GTFO_GUIEditor"
        xmlns:models="clr-namespace:GTFO_GUIEditor.Models;assembly=GTFO_GUIEditor"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="GTFO_GUIEditor.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="GTFO Level Editor">
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewRundown}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveRundown}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenRundown}"/>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding QuickExportDatablocks}"/>
    </Window.KeyBindings>
    <Window.Resources>
        <DataTemplate x:Key="WardenEventTemplate" x:CompileBindings="False">
            <Border Background="#1A1A1A"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,10">
                <StackPanel Spacing="10">
                    <!-- Top row: Event Type, Trigger, Enabled, Remove Button -->
                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="Type:"
                                   ToolTip.Tip="The type of event."
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="#CCCCCC"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableEventTypes}"
                                  SelectedItem="{Binding Type, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"/>

                        <TextBlock Grid.Column="2"
                                   Text="Trigger:"
                                   ToolTip.Tip="When this event should trigger in relation to the parent event."
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="#CCCCCC"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableEventTriggers}"
                                  SelectedItem="{Binding Trigger, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"/>

                        <CheckBox Grid.Column="4"
                                  Content="Enabled"
                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  ToolTip.Tip="True if this event should actually trigger."
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Foreground="#CCCCCC"/>

                        <Button Grid.Column="5"
                                Content="✕ Remove"
                                Command="{Binding $parent[Window].DataContext.LevelLayout.RemoveWardenEventCommand}"
                                CommandParameter="{Binding}"
                                Background="#4A1C1C"
                                Foreground="#FF6B6B"
                                Padding="10,4"/>
                    </Grid>

                    <!-- Common Row 1: Delay, Layer (Sector) -->
                    <Grid ColumnDefinitions="Auto,*,Auto,*">
                        <TextBlock Grid.Column="0" Text="Delay (s):" ToolTip.Tip="A delay before the event will be triggered." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                        <TextBox Grid.Column="1" Text="{Binding Delay, Mode=TwoWay}" Margin="0,0,12,0"/>

                        <TextBlock Grid.Column="2" Text="Layer:" ToolTip.Tip="The sector the event should take place in. This value may or may not be relevant based on the event type." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableSectors}"
                                  SelectedItem="{Binding Layer, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                    </Grid>

                    <!-- Common Row 2: Dimension, Zone -->
                    <Grid ColumnDefinitions="Auto,*,Auto,*">
                        <TextBlock Grid.Column="0" Text="Dimension:" ToolTip.Tip="The dimension the event should take place in. This value may or may not be relevant based on the event type." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.AvailableDimensions}"
                                  SelectedValue="{Binding Dimension, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding DimensionIndex}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,12,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:DimensionOption">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Column="2" Text="Zone:" ToolTip.Tip="The zone the event should take place in. This value may or may not be relevant based on the event type." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding AvailableZones}"
                                  SelectedValue="{Binding Zone, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding ZoneIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ZoneOption">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- Common Row 3: WardenIntel -->
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="Warden Intel:" ToolTip.Tip="On-screen text to display" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                        <TextBox Grid.Column="1" Text="{Binding WardenIntel, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                    </Grid>

                    <!-- Common Row 4: SoundID & SoundSubtitle -->
                    <Grid ColumnDefinitions="Auto,*,Auto,*">
                        <TextBlock Grid.Column="0" Text="Sound:" ToolTip.Tip="Sound to play. This is a sound ID, use the sounds tab to view a list of all sounds and their IDs" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                        <TextBox Grid.Column="1" Text="{Binding SoundID, Mode=TwoWay}" Margin="0,0,12,0"/>

                        <TextBlock Grid.Column="2" Text="Sound Subtitle:" ToolTip.Tip="Subtitle for the sound" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                        <TextBox Grid.Column="3" Text="{Binding SoundSubtitle, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Conditional: ActivateChainedPuzzle [ChainPuzzle & UseStaticBioscanPoints] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsChainPuzzleVisible}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="Alarm:" ToolTip.Tip="Alarm to start when the event is triggered" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.AvailableAlarms}"
                                      SelectedValue="{Binding ChainPuzzle, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding PersistentId}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,16,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:AlarmBlock">
                                        <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox Grid.Column="2"
                                      Content="Use Static Bioscan Points"
                                      IsChecked="{Binding UseStaticBioscanPoints, Mode=TwoWay}"
                                      ToolTip.Tip="Whether externally defined static bioscan points should be used instead of the normal random positions"
                                      VerticalAlignment="Center"
                                      Foreground="#CCCCCC"/>
                        </Grid>
                    </Border>

                    <!-- Conditional: Duration [AddToTimer, DimensionFlashTeam, LightsInZone] -->
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsDurationVisible}">
                        <TextBlock Grid.Column="0" Text="Duration (s):" ToolTip.Tip="The duration for this event. Does different things based on the event type" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                        <TextBox Grid.Column="1" Text="{Binding Duration, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Conditional: ClearDimension [DimensionWarpTeam] -->
                    <CheckBox Content="Clear Dimension"
                              IsChecked="{Binding ClearDimension, Mode=TwoWay}"
                              IsVisible="{Binding IsClearDimensionVisible}"
                              ToolTip.Tip="True if the dimension should be cleared on warp."
                              Foreground="#FFA200"/>

                    <!-- Conditional: CustomSubObjective [UpdateCustomSubObjective] -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsCustomSubObjectiveVisible}">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Custom Sub-Objective Header:" ToolTip.Tip="Header of the custom sub-objective" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                            <TextBox Grid.Column="1" Text="{Binding CustomSubObjectiveHeader, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Custom Sub-Objective:" ToolTip.Tip="Description text of the custom sub-objective" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                            <TextBox Grid.Column="1" Text="{Binding CustomSubObjective, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Conditional: FogSetting & FogTransitionDuration [SetFogSetting] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsFogSettingVisible}">
                        <Grid ColumnDefinitions="Auto,*,Auto,*">
                            <TextBlock Grid.Column="0" Text="Fog Setting:" ToolTip.Tip="The fog setting to switch to" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.AvailableFogSettings}"
                                      SelectedValue="{Binding FogSetting, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding PersistentId}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,12,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:FogSettingsBlock">
                                        <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="Transition Duration (s):" ToolTip.Tip="How long the transition to the new fog should take" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                            <TextBox Grid.Column="3" Text="{Binding FogTransitionDuration, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <!-- Conditional: SpawnEnemyOnPoint [EnemyID & Count] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsEnemyIdVisible}">
                        <Grid ColumnDefinitions="Auto,*,Auto,*">
                            <TextBlock Grid.Column="0" Text="Enemy:" ToolTip.Tip="The enemy to spawn" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                      SelectedValue="{Binding EnemyID, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding PersistentId}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,12,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:EnemyEntry">
                                        <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="Count:" ToolTip.Tip="The number of this enemy to spawn (these will spawn on top of each other, typically used to spawn groups of flyers)" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                            <TextBox Grid.Column="3" Text="{Binding Count, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <!-- Conditional: Position (Vector3) [LightsInZone] -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsPositionVisible}">
                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                            <TextBlock Grid.Column="0" Text="Position X:" ToolTip.Tip="X position offset" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FFA200"/>
                            <TextBox Grid.Column="1" Text="{Binding Position.X, Mode=TwoWay}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="Y:" ToolTip.Tip="Y position offset" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FFA200"/>
                            <TextBox Grid.Column="3" Text="{Binding Position.Y, Mode=TwoWay}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="4" Text="Z:" ToolTip.Tip="Z position offset" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FFA200"/>
                            <TextBox Grid.Column="5" Text="{Binding Position.Z, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <!-- Conditional: EnemyWaveData [SpawnEnemyWave] -->
                    <Expander IsVisible="{Binding IsEnemyWaveDataVisible}"
                              Background="#252526"
                              BorderBrush="#3E3E42"
                              BorderThickness="1"
                              CornerRadius="4"
                              HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="Enemy Wave Configuration" FontWeight="SemiBold" ToolTip.Tip="Information for the wave to spawn" Foreground="#FFA200"/>
                        </Expander.Header>
                        <StackPanel Spacing="10" Margin="0,8,0,0">
                            <!-- Wave Roles -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Wave Roles (Enemy Selection)" FontWeight="Bold" ToolTip.Tip="Select which enemies will spawn for each wave role" Foreground="#FFFFFF" FontSize="12"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Weakling:" ToolTip.Tip="The 'weakling' type enemy for this alarm. This enemy will cost 0.75 points to spawn, with a total points soft cap of 25. Many vanilla alarms opt to filter this out by excluding it in the population filter, instead using the standard and special slots for their small enemies as they cost 1 point instead of 0.75." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                                  SelectedValue="{Binding EnemyWaveData.WaveRoleWeakling, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding PersistentId}"
                                                  HorizontalAlignment="Stretch" Margin="0,0,10,6">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:EnemyEntry">
                                                    <TextBlock Text="{Binding DisplayText}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Standard:" ToolTip.Tip="The 'standard' type enemy for this alarm. This enemy will cost 1 point to spawn, with a total points soft cap of 25. Generally, this is going to be your strikers/shooters." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <ComboBox Grid.Row="0" Grid.Column="3"
                                                  ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                                  SelectedValue="{Binding EnemyWaveData.WaveRoleStandard, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding PersistentId}"
                                                  HorizontalAlignment="Stretch" Margin="0,0,0,6">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:EnemyEntry">
                                                    <TextBlock Text="{Binding DisplayText}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Special:" ToolTip.Tip="The 'special' type enemy for this alarm. This enemy will cost 1 point to spawn, with a total points soft cap of 25. Generally, this is going to be your strikers/shooters." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1"
                                                  ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                                  SelectedValue="{Binding EnemyWaveData.WaveRoleSpecial, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding PersistentId}"
                                                  HorizontalAlignment="Stretch" Margin="0,0,10,6">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:EnemyEntry">
                                                    <TextBlock Text="{Binding DisplayText}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Mini-Boss:" ToolTip.Tip="The 'miniboss' type enemy for this alarm. This enemy will cost 2 points to spawn, with a total points soft cap of 25. Generally, this is going to be your hybrids/giants. Do not put something like a Tank in here; lest you fight an army." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <ComboBox Grid.Row="1" Grid.Column="3"
                                                  ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                                  SelectedValue="{Binding EnemyWaveData.WaveRoleMiniBoss, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding PersistentId}"
                                                  HorizontalAlignment="Stretch" Margin="0,0,0,6">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:EnemyEntry">
                                                    <TextBlock Text="{Binding DisplayText}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Boss:" ToolTip.Tip="The 'boss' type enemy for this alarm. This enemy will cost 2 points to spawn, with a total points soft cap of 25. Generally, this is going to be your hybrids/giants. Do not put something like a Tank in here; lest you fight an army. NOTE: THIS ENEMY TYPE IS BROKEN IN VANILLA." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1"
                                                  ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                                  SelectedValue="{Binding EnemyWaveData.WaveRoleBoss, Mode=TwoWay}"
                                                  SelectedValueBinding="{Binding PersistentId}"
                                                  HorizontalAlignment="Stretch" Margin="0,0,10,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:EnemyEntry">
                                                    <TextBlock Text="{Binding DisplayText}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Wave Timing & Pauses -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Wave Timing &amp; Pauses" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Pause Before Start (s):" ToolTip.Tip="Pause in seconds before the wave begins." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EnemyWaveData.PauseBeforeStart, Mode=TwoWay}" Margin="0,0,10,6"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Pause Between Groups (s):" ToolTip.Tip="Pause in seconds between enemy group spawns." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EnemyWaveData.PauseBetweenGroups, Mode=TwoWay}" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Wave Pause Min (at Cost):" ToolTip.Tip="Minimum wave pause duration at max cost/ramp." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EnemyWaveData.WavePauseMin_AtCost, Mode=TwoWay}" Margin="0,0,10,6"/>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Wave Pause Max (at Cost):" ToolTip.Tip="Maximum wave pause duration at max cost/ramp." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding EnemyWaveData.WavePauseMax_AtCost, Mode=TwoWay}" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Wave Pause Min (s):" ToolTip.Tip="Minimum duration to pause between waves." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EnemyWaveData.WavePauseMin, Mode=TwoWay}" Margin="0,0,10,0"/>

                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Wave Pause Max (s):" ToolTip.Tip="Maximum duration to pause between waves." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding EnemyWaveData.WavePauseMax, Mode=TwoWay}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Population Filter -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Population Filter" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" Margin="0,2,0,0">
                                        <TextBlock Grid.Column="0" Text="Filter Type:" ToolTip.Tip="Include: ONLY selected roles spawn. Exclude: Selected roles DO NOT spawn." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableFilterTypes}"
                                                  SelectedItem="{Binding EnemyWaveData.FilterType, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"/>
                                    </Grid>

                                    <TextBlock Text="Filter Roles:" Margin="0,4,0,2" Foreground="#CCCCCC" FontSize="11"/>
                                    <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <CheckBox Content="Weakling" IsChecked="{Binding EnemyWaveData.FilterWeakling, Mode=TwoWay}" Margin="0,0,10,4"/>
                                        <CheckBox Content="Standard" IsChecked="{Binding EnemyWaveData.FilterStandard, Mode=TwoWay}" Margin="0,0,10,4"/>
                                        <CheckBox Content="Special" IsChecked="{Binding EnemyWaveData.FilterSpecial, Mode=TwoWay}" Margin="0,0,10,4"/>
                                        <CheckBox Content="Mini-Boss" IsChecked="{Binding EnemyWaveData.FilterMiniBoss, Mode=TwoWay}" Margin="0,0,10,4"/>
                                        <CheckBox Content="Boss" IsChecked="{Binding EnemyWaveData.FilterBoss, Mode=TwoWay}" Margin="0,0,10,4"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Spawn Direction & Type -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Spawn Direction &amp; Type" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Randomize Direction / Wave:" ToolTip.Tip="0-1 chance for the spawn direction to change between waves." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EnemyWaveData.ChanceToRandomizeSpawnDirectionPerWave, Mode=TwoWay}" Margin="0,0,10,6"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Randomize Direction / Group:" ToolTip.Tip="0-1 chance for the spawn direction to change between groups." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EnemyWaveData.ChanceToRandomizeSpawnDirectionPerGroup, Mode=TwoWay}" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Override Spawn Type:" ToolTip.Tip="True if the spawn type should be overridden." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                        <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding EnemyWaveData.OverrideWaveSpawnType, Mode=TwoWay}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Wave Spawn Type:" ToolTip.Tip="Affects how the enemies spawn. Only does anything if Override Spawn Type is true." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                        <ComboBox Grid.Row="1" Grid.Column="3"
                                                  ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableWaveSpawnTypes}"
                                                  SelectedItem="{Binding EnemyWaveData.SurvivalWaveSpawnType, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Population Points & Ramp -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Population Points &amp; Ramp" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,2,0,0">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Population Points Total:" ToolTip.Tip="The total population points for waves. -1 is infinite." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EnemyWaveData.PopulationPointsTotal, Mode=TwoWay}" Margin="0,0,10,6"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Population Ramp Over Time (s):" ToolTip.Tip="Lerp over time for start-end population point settings." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EnemyWaveData.PopulationRampOverTime, Mode=TwoWay}" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Points Per Wave (Start):" ToolTip.Tip="Population points for a wave at start ramp." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EnemyWaveData.PopulationPointsPerWaveStart, Mode=TwoWay}" Margin="0,0,10,6"/>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Points Per Wave (End):" ToolTip.Tip="Population points for a wave at end ramp." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding EnemyWaveData.PopulationPointsPerWaveEnd, Mode=TwoWay}" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Points Per Group (Start):" ToolTip.Tip="Population points for a group at start ramp." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EnemyWaveData.PopulationPointsPerGroupStart, Mode=TwoWay}" Margin="0,0,10,6"/>

                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Points Per Group (End):" ToolTip.Tip="Population points for a group at end ramp." VerticalAlignment="Center" Margin="0,0,6,6" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding EnemyWaveData.PopulationPointsPerGroupEnd, Mode=TwoWay}" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Min Points Per Group:" ToolTip.Tip="Minimum required cost for a group to spawn." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EnemyWaveData.PopulationPointsMinPerGroup, Mode=TwoWay}" Margin="0,0,10,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid RowDefinitions="Auto,*">
        <!-- Top Taskbar / Menu Bar -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="2,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Menu Grid.Column="0" Background="Transparent" Foreground="#E0E0E0">
                    <MenuItem Header="File" Foreground="#E0E0E0" FontWeight="SemiBold" FontSize="13">
                        <MenuItem Header="New"
                                  Command="{Binding NewRundown}"
                                  InputGesture="Ctrl+N"/>
                        <Separator Background="#333333"/>
                        <MenuItem Header="Save"
                                  Command="{Binding SaveRundown}"
                                  InputGesture="Ctrl+S"/>
                        <MenuItem Header="Save As..."
                                  Command="{Binding SaveAsRundown}"/>
                        <Separator Background="#333333"/>
                        <MenuItem Header="Open..."
                                  Command="{Binding OpenRundown}"
                                  InputGesture="Ctrl+O"/>
                        <MenuItem Header="Open Recent"
                                  ItemsSource="{Binding RecentFiles}">
                            <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="models:RecentFileItem">
                                    <MenuItem Header="{Binding DisplayName}"
                                              ToolTip.Tip="{Binding FilePath}"
                                              IsEnabled="{Binding !IsPlaceholder}"
                                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenRecentFile}"
                                              CommandParameter="{Binding FilePath}"/>
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Export" Foreground="#E0E0E0" FontWeight="SemiBold" FontSize="13">
                        <MenuItem Header="Quick Export"
                                  Command="{Binding QuickExportDatablocks}"
                                  InputGesture="Ctrl+E"/>
                        <MenuItem Header="Export To..."
                                  Command="{Binding ExportDatablocksTo}"/>
                    </MenuItem>
                </Menu>

                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentFileTitle}"
                           Foreground="#888888"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding StatusMessage}"
                           Foreground="#AAAAAA"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
        <!-- Left Half -->
        <Border Grid.Column="0" Padding="10">
            <Panel DataContext="{Binding LevelLayout}" x:DataType="vm:LevelLayoutViewModel">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="0">
                    <TextBlock Grid.Row="0" Text="Level Layout" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    
                    <!-- Top Bar 1: Level Selection, Level Name, Level Add/Delete -->
                    <Border Grid.Row="1" Background="#252526" Padding="10" Margin="0,0,0,6" CornerRadius="4">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                                <TextBlock Text="Level:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#E0E0E0"/>
                                <ComboBox ItemsSource="{Binding Levels}"
                                          SelectedItem="{Binding SelectedLevel, Mode=TwoWay}"
                                          MinWidth="160"
                                          VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:LevelLayoutBlock">
                                            <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                                <TextBlock Text="Level Name:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#E0E0E0"/>
                                <TextBox Text="{Binding SelectedLevel.Name, Mode=TwoWay}"
                                         IsEnabled="{Binding HasSelectedLevel}"
                                         Width="160"
                                         VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Content="+ Add Level"
                                    Command="{Binding OpenCreateLevelDialog}"
                                    Margin="0,2,6,2"
                                    Padding="10,6"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>

                            <Button Content="Edit Level"
                                    Command="{Binding OpenEditLevelDialog}"
                                    IsEnabled="{Binding HasSelectedLevel}"
                                    Margin="0,2,6,2"
                                    Padding="10,6"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>

                            <Button Content="- Delete Level"
                                    Command="{Binding RequestDeleteSelectedLevel}"
                                    IsEnabled="{Binding HasSelectedLevel}"
                                    Margin="0,2,6,2"
                                    Padding="10,6"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>
                        </WrapPanel>
                    </Border>

                    <!-- Top Bar 2: Dimension Selection, Dimension Name, Dimension Add/Edit/Delete -->
                    <Border Grid.Row="2" Background="#252526" Padding="10" Margin="0,0,0,6" CornerRadius="4">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                                <TextBlock Text="Dimension:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#E0E0E0"/>
                                <ComboBox ItemsSource="{Binding AvailableDimensions}"
                                          SelectedItem="{Binding SelectedDimension, Mode=TwoWay}"
                                          IsEnabled="{Binding HasSelectedLevel}"
                                          MinWidth="160"
                                          VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:DimensionOption">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                                <TextBlock Text="Dimension Name:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#E0E0E0"/>
                                <TextBox Text="{Binding ActiveDimensionName, Mode=TwoWay}"
                                         IsEnabled="{Binding CanEditActiveDimensionName}"
                                         Width="160"
                                         VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Content="+ Add Dimension"
                                    Command="{Binding OpenAddDimensionDialog}"
                                    IsEnabled="{Binding CanAddDimension}"
                                    Margin="0,2,6,2"
                                    Padding="10,6"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>

                            <Button Content="Edit Dimension"
                                    Command="{Binding RequestEditActiveDimension}"
                                    IsEnabled="{Binding CanEditActiveDimension}"
                                    Margin="0,2,6,2"
                                    Padding="10,6"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>

                            <Button Content="- Delete Dimension"
                                    Command="{Binding RequestDeleteActiveDimension}"
                                    IsEnabled="{Binding CanDeleteActiveDimension}"
                                    Margin="0,2,6,2"
                                    Padding="10,6"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>
                        </WrapPanel>
                    </Border>

                    <!-- Top Bar 3: Sector Selection -->
                    <Border Grid.Row="3" Background="#252526" Padding="10" Margin="0,0,0,10" CornerRadius="4">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Sectors:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,2,12,2" Foreground="#E0E0E0"/>

                            <Button Content="Main"
                                    Command="{Binding OpenMainSectorSettings}"
                                    IsEnabled="{Binding HasMainSector}"
                                    ToolTip.Tip="Configure settings for the Main Sector."
                                    Margin="0,2,8,2"
                                    Padding="16,6"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>

                            <Button Content="Secondary"
                                    Command="{Binding OpenSecondarySectorSettings}"
                                    IsEnabled="{Binding HasSecondarySector}"
                                    ToolTip.Tip="Configure settings for the Secondary Sector (requires Secondary Door in the level)."
                                    Margin="0,2,8,2"
                                    Padding="16,6"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>

                            <Button Content="Overload"
                                    Command="{Binding OpenOverloadSectorSettings}"
                                    IsEnabled="{Binding HasOverloadSector}"
                                    ToolTip.Tip="Configure settings for the Overload Sector (requires Overload Door in the level)."
                                    Margin="0,2,8,2"
                                    Padding="16,6"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>
                        </WrapPanel>
                    </Border>

                    <!-- Main Level Layout View Content Area -->
                    <Grid Grid.Row="4">
                        <!-- When a level is selected -->
                        <Grid IsVisible="{Binding HasSelectedLevel}" RowDefinitions="Auto,*">
                            <!-- Warnings StackPanel -->
                            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,10">
                                <!-- Duplicate ID Warning Banner (if any) -->
                                <Border Background="#3A1C1C"
                                        BorderBrush="#FF6B6B"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,8"
                                        IsVisible="{Binding HasDuplicatePersistentId}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="⚠" Foreground="#FF6B6B" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DuplicatePersistentIdWarning}"
                                                   Foreground="#FF6B6B"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Grid Size Warning Banner (if layout exceeds grid size) -->
                                <Border Background="#3A281C"
                                        BorderBrush="#FFA726"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,8"
                                        IsVisible="{Binding HasGridSizeWarning}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="⚠" Foreground="#FFA726" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding GridSizeWarningMessage}"
                                                   Foreground="#FFA726"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Level Layout Canvas / Visual View Panel -->
                            <Border Grid.Row="1" Background="#141414" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                                <Grid RowDefinitions="Auto,*">
                                    <!-- Canvas Toolbar -->
                                    <Border Grid.Row="0" Background="#1F1F1F" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1" Padding="10,6">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                                                <Button Content="+" Command="{Binding ZoomIn}" ToolTip.Tip="Zoom In" Width="30" Height="28" Margin="0,0,4,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="Bold"/>
                                                <Button Content="−" Command="{Binding ZoomOut}" ToolTip.Tip="Zoom Out" Width="30" Height="28" Margin="0,0,8,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding GridState.ZoomPercentage}" VerticalAlignment="Center" Foreground="#B0BEC5" Margin="0,0,12,0" FontWeight="SemiBold" FontSize="12"/>
                                                <Button Content="Reset View" Click="OnResetViewClicked" ToolTip.Tip="Center view on Starting Elevator" Padding="8,4" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Legend / Status info -->
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,10,2" IsVisible="{Binding GridState.HasUnexpandedDoors}">
                                                    <Border Width="10" Height="5" Background="#FFFF00" BorderBrush="#FFFFFF" BorderThickness="0.5" CornerRadius="0.5" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Unexpanded" FontSize="11" Foreground="#FFFF00" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,10,2" IsVisible="{Binding GridState.HasConnectedDoors}">
                                                    <Border Width="10" Height="5" Background="#9D00FF" BorderBrush="#FFFFFF" BorderThickness="0.5" CornerRadius="0.5" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Connected" FontSize="11" Foreground="#9D00FF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,10,2" IsVisible="{Binding GridState.HasSecurityDoors}">
                                                    <Border Width="10" Height="5" Background="#FF0000" BorderBrush="#FFFFFF" BorderThickness="0.5" CornerRadius="0.5" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Security Door" FontSize="11" Foreground="#FF0000" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,10,2" IsVisible="{Binding GridState.HasMainDoors}">
                                                    <Border Width="10" Height="5" Background="#CCCCCC" BorderBrush="#FFFFFF" BorderThickness="0.5" CornerRadius="0.5" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Main Door" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,10,2" IsVisible="{Binding GridState.HasSecondaryDoors}">
                                                    <Border Width="10" Height="5" Background="#FFA200" BorderBrush="#FFFFFF" BorderThickness="0.5" CornerRadius="0.5" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Secondary Door" FontSize="11" Foreground="#FFA200" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,10,2" IsVisible="{Binding GridState.HasOverloadDoors}">
                                                    <Border Width="10" Height="5" Background="#00F2FF" BorderBrush="#FFFFFF" BorderThickness="0.5" CornerRadius="0.5" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Overload Door" FontSize="11" Foreground="#00F2FF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,10,2" IsVisible="{Binding GridState.HasBlockedDoors}">
                                                    <Border Width="10" Height="5" Background="#757575" BorderBrush="#FFFFFF" BorderThickness="0.5" CornerRadius="0.5" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Blocked" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </WrapPanel>
                                        </WrapPanel>
                                    </Border>

                                    <!-- Interactive Pannable &amp; Zoomable Canvas Area -->
                                    <Border x:Name="LevelLayoutCanvasBorder"
                                            Grid.Row="1"
                                            Background="#121212"
                                            ClipToBounds="True"
                                            PointerPressed="OnLevelLayoutPointerPressed"
                                            PointerMoved="OnLevelLayoutPointerMoved"
                                            PointerReleased="OnLevelLayoutPointerReleased"
                                            PointerCaptureLost="OnLevelLayoutPointerCaptureLost"
                                            PointerExited="OnLevelLayoutPointerExited"
                                            PointerWheelChanged="OnLevelLayoutPointerWheelChanged">
                                        <Canvas Background="#121212"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                RenderTransformOrigin="0,0"
                                                ClipToBounds="False">
                                            <Canvas.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="{Binding GridState.Zoom}" ScaleY="{Binding GridState.Zoom}"/>
                                                    <TranslateTransform X="{Binding GridState.PanX}" Y="{Binding GridState.PanY}"/>
                                                </TransformGroup>
                                            </Canvas.RenderTransform>

                                            <!-- Dynamic Grid Background -->
                                            <Rectangle Canvas.Left="{Binding GridState.WorldGridLeft}" Canvas.Top="{Binding GridState.WorldGridTop}"
                                                       Width="{Binding GridState.WorldGridWidth}" Height="{Binding GridState.WorldGridHeight}">
                                                <Rectangle.Fill>
                                                    <VisualBrush DestinationRect="0,0,64,64" TileMode="Tile" SourceRect="0,0,64,64">
                                                        <VisualBrush.Visual>
                                                            <Border Width="64" Height="64" BorderBrush="#252525" BorderThickness="0,0,1,1" Background="#141414"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>

                                            <!-- Grid Outer Boundary -->
                                            <Rectangle Canvas.Left="{Binding GridState.WorldGridLeft}" Canvas.Top="{Binding GridState.WorldGridTop}"
                                                       Width="{Binding GridState.WorldGridWidth}" Height="{Binding GridState.WorldGridHeight}"
                                                       Stroke="#37474F" StrokeThickness="2" Fill="Transparent"/>

                                            <!-- Placed Rooms / Geomorph Meshes -->
                                            <ItemsControl ItemsSource="{Binding GridState.PlacedRooms}"
                                                          Canvas.Left="0" Canvas.Top="0"
                                                          ClipToBounds="False">
                                                <ItemsControl.Template>
                                                    <ControlTemplate>
                                                        <ItemsPresenter Name="PART_ItemsPresenter"
                                                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                                                        ClipToBounds="False"/>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas ClipToBounds="False"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerTheme>
                                                    <ControlTheme TargetType="ContentPresenter" x:DataType="models:PlacedRoomNode">
                                                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                                                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                                                        <Setter Property="Canvas.ZIndex" Value="{Binding ZIndex}"/>
                                                        <Setter Property="ClipToBounds" Value="False"/>
                                                    </ControlTheme>
                                                </ItemsControl.ItemContainerTheme>
                                                <ItemsControl.Styles>
                                                    <Style Selector="ItemsControl > ContentPresenter" x:DataType="models:PlacedRoomNode">
                                                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                                                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                                                        <Setter Property="Canvas.ZIndex" Value="{Binding ZIndex}"/>
                                                        <Setter Property="ClipToBounds" Value="False"/>
                                                    </Style>
                                                </ItemsControl.Styles>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:PlacedRoomNode">
                                                        <Path Data="{Binding Geometry}"
                                                              Fill="{Binding FillBrush}"
                                                              Stroke="{Binding StrokeBrush}"
                                                              StrokeThickness="{Binding StrokeThickness}"
                                                              IsVisible="{Binding HasGeometry}"
                                                              ToolTip.Tip="{Binding DisplayName}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Placed Doors / Connectors -->
                                            <ItemsControl ItemsSource="{Binding GridState.PlacedDoors}"
                                                          Canvas.Left="0" Canvas.Top="0"
                                                          ClipToBounds="False">
                                                <ItemsControl.Template>
                                                    <ControlTemplate>
                                                        <ItemsPresenter Name="PART_ItemsPresenter"
                                                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                                                        ClipToBounds="False"/>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas ClipToBounds="False"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerTheme>
                                                    <ControlTheme TargetType="ContentPresenter" x:DataType="models:PlacedDoorNode">
                                                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                                                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                                                        <Setter Property="Canvas.ZIndex" Value="10"/>
                                                        <Setter Property="ClipToBounds" Value="False"/>
                                                    </ControlTheme>
                                                </ItemsControl.ItemContainerTheme>
                                                <ItemsControl.Styles>
                                                    <Style Selector="ItemsControl > ContentPresenter" x:DataType="models:PlacedDoorNode">
                                                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                                                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                                                        <Setter Property="Canvas.ZIndex" Value="10"/>
                                                        <Setter Property="ClipToBounds" Value="False"/>
                                                    </Style>
                                                </ItemsControl.Styles>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:PlacedDoorNode">
                                                        <Button Width="{Binding DoorWidth}"
                                                                Height="{Binding DoorHeight}"
                                                                Background="{Binding DoorBrush}"
                                                                BorderBrush="#FFFFFF"
                                                                BorderThickness="0.5"
                                                                CornerRadius="0.5"
                                                                Padding="0"
                                                                Margin="0"
                                                                Cursor="Hand"
                                                                RenderTransformOrigin="50%,50%"
                                                                ToolTip.Tip="{Binding TooltipText}"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LevelLayout.OnDoorClicked}"
                                                                CommandParameter="{Binding}"
                                                                PointerPressed="OnDoorPointerPressed">
                                                            <Button.RenderTransform>
                                                                <RotateTransform Angle="{Binding RotationAngle}"/>
                                                            </Button.RenderTransform>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- When no level is selected -->
                        <Panel IsVisible="{Binding !HasSelectedLevel}" Background="#1E1E1E">
                            <TextBlock Text="No level selected. Create a new level to begin."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"/>
                        </Panel>
                    </Grid>

                    <!-- Create Level Modal Overlay -->
                    <Border Grid.Row="0" Grid.RowSpan="5"
                            Background="#80000000"
                            IsVisible="{Binding IsCreatingLevel}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Border Background="#252526"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Width="500"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BoxShadow="0 4 20 #80000000">
                            <StackPanel Spacing="14">
                                <TextBlock Text="{Binding LevelDialogTitle}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"/>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Level Name:" FontSize="13" Foreground="LightGray"/>
                                    <TextBox Text="{Binding NewLevelName, Mode=TwoWay}" Watermark="Enter level name..."/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Persistent ID:" FontSize="13" Foreground="LightGray"/>
                                    <TextBox Text="{Binding NewLevelPersistentId, Mode=TwoWay}" Watermark="Enter persistent ID..."/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Tileset:" FontSize="13" Foreground="LightGray"/>
                                    <ComboBox ItemsSource="{Binding AvailableComplexTypes}"
                                              SelectedItem="{Binding SelectedComplexType, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Starting Elevator Tile:" FontSize="13" Foreground="LightGray"/>
                                    <ComboBox ItemsSource="{Binding AvailableElevatorTiles}"
                                              SelectedItem="{Binding SelectedElevatorTile, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ElevatorTileOption">
                                                <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Fog Setting:" FontSize="13" Foreground="LightGray"/>
                                    <ComboBox ItemsSource="{Binding AvailableFogSettings}"
                                              SelectedItem="{Binding SelectedFogSetting, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:FogSettingsBlock">
                                                <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Error message if any -->
                                <TextBlock Text="{Binding CreationErrorMessage}"
                                           Foreground="#FF6B6B"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasCreationErrorMessage}"/>

                                <!-- Action buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                                    <Button Content="Cancel"
                                            Command="{Binding CancelCreateLevel}"
                                            Padding="16,8"/>
                                    <Button Content="{Binding LevelDialogConfirmButtonText}"
                                            Command="{Binding ConfirmCreateLevel}"
                                            Background="#007ACC"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            Padding="16,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Delete Level Confirmation Modal Overlay -->
                    <Border Grid.Row="0" Grid.RowSpan="5"
                            Background="#80000000"
                            IsVisible="{Binding IsConfirmingDelete}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Border Background="#252526"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Width="440"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BoxShadow="0 4 20 #80000000">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Confirm Deletion"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FF6B6B"/>

                                <TextBlock Text="{Binding DeleteConfirmationMessage}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="#E0E0E0"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                                    <Button Content="Cancel"
                                            Command="{Binding CancelDeleteLevel}"
                                            Padding="16,8"/>
                                    <Button Content="Delete"
                                            Command="{Binding ConfirmDeleteLevel}"
                                            Background="#D9534F"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            Padding="16,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Delete Dimension Confirmation Modal Overlay -->
                    <Border Grid.Row="0" Grid.RowSpan="5"
                            Background="#80000000"
                            IsVisible="{Binding IsConfirmingDeleteDimension}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Border Background="#252526"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Width="440"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BoxShadow="0 4 20 #80000000">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Confirm Deletion"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FF6B6B"/>

                                <TextBlock Text="{Binding DimensionDeleteConfirmationMessage}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="#E0E0E0"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                                    <Button Content="Cancel"
                                            Command="{Binding CancelDeleteDimension}"
                                            Padding="16,8"/>
                                    <Button Content="Delete"
                                            Command="{Binding ConfirmDeleteDimension}"
                                            Background="#D9534F"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            Padding="16,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Configure / Prompt Dimension Modal Overlay -->
                    <Border Grid.Row="0" Grid.RowSpan="5"
                            Background="#80000000"
                            IsVisible="{Binding IsConfiguringDimension}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Border Background="#252526"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Width="520"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BoxShadow="0 4 20 #80000000">
                            <StackPanel Spacing="14">
                                <TextBlock Text="{Binding PromptDimensionTitle}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"/>

                                <TextBlock Text="Select the Tileset and starting geomorph for this dimension."
                                           Foreground="#AAAAAA"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>

                                <StackPanel Spacing="6" IsVisible="{Binding !IsPromptingReality}">
                                    <TextBlock Text="Dimension Name:" FontSize="13" Foreground="LightGray"/>
                                    <TextBox Text="{Binding DimensionCustomName, Mode=TwoWay}" Watermark="Enter dimension name..."/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Tileset:" FontSize="13" Foreground="LightGray"/>
                                    <ComboBox ItemsSource="{Binding AvailableComplexTypes}"
                                              SelectedItem="{Binding DimensionSelectedComplexType, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <StackPanel Spacing="6" IsVisible="{Binding !IsPromptingReality}">
                                    <TextBlock Text="Starting Tile Source:" FontSize="13" Foreground="LightGray"/>
                                    <ComboBox ItemsSource="{Binding AvailableTileSources}"
                                              SelectedItem="{Binding SelectedTileSource, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding PromptStartingTileLabel}" FontSize="13" Foreground="LightGray"/>
                                    <ComboBox ItemsSource="{Binding AvailableDimensionTiles}"
                                              SelectedItem="{Binding SelectedDimensionTile, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ElevatorTileOption">
                                                <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Error message if any -->
                                <TextBlock Text="{Binding DimensionPromptErrorMessage}"
                                           Foreground="#FF6B6B"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasDimensionPromptErrorMessage}"/>

                                <!-- Action buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                                    <Button Content="Cancel"
                                            Command="{Binding CancelPromptDimension}"
                                            Padding="16,8"/>
                                    <Button Content="Confirm"
                                            Command="{Binding ConfirmPromptDimension}"
                                            Background="#007ACC"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            Padding="16,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Pick Geomorph for Door Expansion Modal Overlay -->
                    <Border Grid.Row="0" Grid.RowSpan="5"
                            Background="#80000000"
                            IsVisible="{Binding IsPickingGeomorphForDoor}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Border Background="#252526"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Width="840"
                                MaxHeight="720"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BoxShadow="0 4 20 #80000000">
                            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                                <TextBlock Grid.Row="0"
                                           Text="Expand Level - Pick Geomorph"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           Margin="0,0,0,12"/>

                                <!-- Expansion Target Info Card -->
                                <Border Grid.Row="1" Background="#1A2026" BorderBrush="#334455" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Direction:" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ExpansionDirectionText}" FontWeight="Bold" Foreground="#9D00FF" Margin="0,0,16,4"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Target Cell:" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ExpansionTargetCellText}" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,4"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="From Geo:" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ExpansionSourceGeoText}" Foreground="#D0D0D0" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>

                                <!-- Main 2-Column Content Area -->
                                <Grid Grid.Row="2" ColumnDefinitions="*,290">
                                    <!-- Left Column: Geomorph Grid Selector -->
                                    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
                                        <TextBlock Grid.Row="0" Text="Select Geomorph:" FontSize="13" Foreground="LightGray" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Grid.Row="1" Text="{Binding GeomorphFilterText, Mode=TwoWay}" Watermark="Filter geomorphs by name..." Margin="0,0,0,6"/>
                                        <Border Grid.Row="2" Background="#1A1A1C" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                                            <ListBox ItemsSource="{Binding FilteredExpansionGeomorphs}"
                                                     SelectedItem="{Binding SelectedExpansionGeomorph, Mode=TwoWay}"
                                                     Background="Transparent"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     Height="340">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:GeomorphOption">
                                                        <Border Width="110" Height="115"
                                                                Background="#252528"
                                                                BorderBrush="#3C3C40"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="4"
                                                                Margin="2">
                                                            <ToolTip.Tip>
                                                                <Border Background="#1E1E1E" BorderBrush="#555555" BorderThickness="1" CornerRadius="4" Padding="6">
                                                                    <StackPanel Spacing="6">
                                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                                                        <TextBlock Text="{Binding Category}" Foreground="#AAAAAA" FontSize="11"/>
                                                                        <Panel Width="320" Height="180" IsVisible="{Binding HasImage}">
                                                                            <Image Source="{Binding ImageBitmap}" Stretch="Uniform" IsVisible="{Binding HasImageBitmap}"/>
                                                                            <TextBlock Text="Image preview not found on disk" Foreground="#888888" FontStyle="Italic" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasImageBitmap}"/>
                                                                        </Panel>
                                                                        <TextBlock Text="No screenshot available" Foreground="#777777" FontStyle="Italic" FontSize="11" IsVisible="{Binding !HasImage}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ToolTip.Tip>
                                                            <Grid RowDefinitions="*,Auto">
                                                                <Panel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Viewbox Width="75" Height="75" IsVisible="{Binding HasSvgGeometry}">
                                                                        <Path Data="{Binding SvgGeometry}"
                                                                              Fill="#3A80D2"
                                                                              Stroke="Transparent"
                                                                              StrokeThickness="0"
                                                                              Stretch="Uniform"/>
                                                                    </Viewbox>
                                                                    <TextBlock Text="No Image"
                                                                               Foreground="#666666"
                                                                               FontSize="11"
                                                                               FontStyle="Italic"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               IsVisible="{Binding !HasSvgGeometry}"/>
                                                                </Panel>
                                                                <TextBlock Grid.Row="1"
                                                                           Text="{Binding DisplayName}"
                                                                           FontSize="10"
                                                                           Foreground="#CCCCCC"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           HorizontalAlignment="Center"
                                                                           TextAlignment="Center"
                                                                           Margin="0,2,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Grid>

                                    <!-- Right Column: Selected Preview & Parameters -->
                                    <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="10">
                                            <!-- Preview Box -->
                                            <Border Background="#1A2026" BorderBrush="#334455" BorderThickness="1" CornerRadius="4" Padding="8">
                                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                    <TextBlock Text="Selected Preview:" FontSize="12" Foreground="#AAAAAA" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                    <Border Background="#101418" BorderBrush="#25303D" BorderThickness="1" CornerRadius="4" Width="170" Height="170">
                                                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Viewbox Width="150" Height="150" IsVisible="{Binding HasSelectedExpansionGeomorphPreview}">
                                                                <Path Data="{Binding SelectedExpansionGeomorphPreviewGeometry}"
                                                                      Fill="#3A80D2"
                                                                      Stroke="Transparent"
                                                                      StrokeThickness="0"
                                                                      Stretch="Uniform"/>
                                                            </Viewbox>
                                                            <TextBlock Text="No preview available"
                                                                       Foreground="#666666"
                                                                       FontSize="11"
                                                                       FontStyle="Italic"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding !HasSelectedExpansionGeomorphPreview}"/>
                                                        </Panel>
                                                    </Border>
                                                    <TextBlock Text="{Binding SelectedExpansionGeomorph.DisplayName}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FFFFFF"
                                                               HorizontalAlignment="Center"
                                                               TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="240"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Tile Rotation Selector -->
                                            <StackPanel Spacing="4" IsVisible="{Binding HasAvailableRotations}">
                                                <TextBlock Text="Tile Rotation:" FontSize="12" Foreground="LightGray" FontWeight="SemiBold"/>
                                                <ComboBox ItemsSource="{Binding AvailableExpansionRotations}"
                                                          SelectedItem="{Binding SelectedExpansionRotation, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:RotationOption">
                                                            <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Tile Altitude Selector -->
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Tile Altitude:" FontSize="12" Foreground="LightGray" FontWeight="SemiBold"/>
                                                <ComboBox ItemsSource="{Binding AvailableExpansionAltitudes}"
                                                          SelectedItem="{Binding SelectedExpansionAltitude, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:AltitudeOption">
                                                            <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Tile Lighting Selector (only when expanding to a new zone) -->
                                            <StackPanel Spacing="4" IsVisible="{Binding IsExpansionToNewZone}">
                                                <TextBlock Text="Zone Lighting:" FontSize="12" Foreground="LightGray" FontWeight="SemiBold"/>
                                                <ComboBox ItemsSource="{Binding AvailableLightingConfigs}"
                                                          SelectedItem="{Binding SelectedExpansionLighting, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:LightSettingsBlock">
                                                            <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Door Type Option -->
                                            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="Door Type:" FontSize="12" Foreground="LightGray" FontWeight="SemiBold"/>
                                                    <StackPanel Spacing="4" Margin="2,0,0,0">
                                                        <RadioButton Content="Room Door"
                                                                     GroupName="ExpansionDoorTypeGroup"
                                                                     IsChecked="{Binding IsExpansionRoomDoor, Mode=TwoWay}"
                                                                     Foreground="#9D00FF"/>
                                                        <RadioButton Content="Security Door"
                                                                     GroupName="ExpansionDoorTypeGroup"
                                                                     IsChecked="{Binding IsExpansionSecurityDoor, Mode=TwoWay}"
                                                                     Foreground="#FF0000"/>
                                                        <RadioButton Content="Main Door"
                                                                     GroupName="ExpansionDoorTypeGroup"
                                                                     IsChecked="{Binding IsExpansionMainDoor, Mode=TwoWay}"
                                                                     Foreground="#CCCCCC"/>
                                                        <RadioButton Content="Secondary Door"
                                                                     GroupName="ExpansionDoorTypeGroup"
                                                                     IsChecked="{Binding IsExpansionSecondaryDoor, Mode=TwoWay}"
                                                                     IsEnabled="{Binding CanAddSecondaryDoor}"
                                                                     Foreground="#FFA200"/>
                                                        <RadioButton Content="Overload Door"
                                                                     GroupName="ExpansionDoorTypeGroup"
                                                                     IsChecked="{Binding IsExpansionOverloadDoor, Mode=TwoWay}"
                                                                     IsEnabled="{Binding CanAddOverloadDoor}"
                                                                     Foreground="#00F2FF"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>

                                <!-- Error message if any -->
                                <TextBlock Grid.Row="3"
                                           Text="{Binding ExpansionErrorMessage}"
                                           Foreground="#FF6B6B"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           IsVisible="{Binding HasExpansionErrorMessage}"/>

                                <!-- Action buttons -->
                                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
                                    <Button Content="Cancel"
                                            Command="{Binding CancelDoorExpansion}"
                                            Padding="16,8"/>
                                    <Button Content="Generate"
                                            Command="{Binding ConfirmDoorExpansion}"
                                            Background="#007ACC"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            Padding="16,8"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Expand Room in Geomorph Modal Overlay -->
                    <Border Grid.Row="0" Grid.RowSpan="5"
                            Background="#80000000"
                            IsVisible="{Binding IsExpandingRoom}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Border Background="#252526"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Width="480"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BoxShadow="0 4 20 #80000000">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Expand Room in Geomorph"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"/>

                                <!-- Room Expansion Target Info Card -->
                                <Border Background="#1A2026" BorderBrush="#334455" BorderThickness="1" CornerRadius="4" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding RoomExpansionGeomorphName}" FontWeight="Bold" Foreground="#9D00FF" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <Grid ColumnDefinitions="Auto,*,Auto,*" Margin="0,4,0,0">
                                            <TextBlock Grid.Column="0" Text="From Room:" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RoomExpansionFromArea, StringFormat='Area {0}'}" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,16,0"/>

                                            <TextBlock Grid.Column="2" Text="Generating:" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding RoomExpansionTargetArea, StringFormat='Area {0}'}" FontWeight="Bold" Foreground="#FFA200"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Choose the connection type for this doorway. Once generated, this door type is permanent."
                                           Foreground="#AAAAAA"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>

                                <!-- Door Type Option -->
                                <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Door Type:" FontSize="13" Foreground="LightGray" FontWeight="SemiBold"/>
                                        <StackPanel Spacing="6" Margin="4,0,0,0">
                                            <RadioButton Content="Room Door"
                                                         GroupName="RoomExpansionDoorTypeGroup"
                                                         IsChecked="{Binding IsRoomExpansionRoomDoor, Mode=TwoWay}"
                                                         Foreground="#9D00FF"/>
                                            <RadioButton Content="Security Door"
                                                         GroupName="RoomExpansionDoorTypeGroup"
                                                         IsChecked="{Binding IsRoomExpansionSecurityDoor, Mode=TwoWay}"
                                                         Foreground="#FF0000"/>
                                            <RadioButton Content="Main Door"
                                                         GroupName="RoomExpansionDoorTypeGroup"
                                                         IsChecked="{Binding IsRoomExpansionMainDoor, Mode=TwoWay}"
                                                         Foreground="#CCCCCC"/>
                                            <RadioButton Content="Secondary Door"
                                                         GroupName="RoomExpansionDoorTypeGroup"
                                                         IsChecked="{Binding IsRoomExpansionSecondaryDoor, Mode=TwoWay}"
                                                         IsEnabled="{Binding CanAddSecondaryDoor}"
                                                         Foreground="#FFA200"/>
                                            <RadioButton Content="Overload Door"
                                                         GroupName="RoomExpansionDoorTypeGroup"
                                                         IsChecked="{Binding IsRoomExpansionOverloadDoor, Mode=TwoWay}"
                                                         IsEnabled="{Binding CanAddOverloadDoor}"
                                                         Foreground="#00F2FF"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Zone Lighting Selector (only when expanding to a new zone with a zone door) -->
                                <StackPanel Spacing="6" IsVisible="{Binding IsRoomExpansionToNewZone}">
                                    <TextBlock Text="Zone Lighting:" FontSize="13" Foreground="LightGray" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding AvailableLightingConfigs}"
                                              SelectedItem="{Binding SelectedRoomExpansionLighting, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:LightSettingsBlock">
                                                <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Error message if any -->
                                <TextBlock Text="{Binding RoomExpansionErrorMessage}"
                                           Foreground="#FF6B6B"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasRoomExpansionErrorMessage}"/>

                                <!-- Action buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                                    <Button Content="Cancel"
                                            Command="{Binding CancelRoomExpansion}"
                                            Padding="16,8"/>
                                    <Button Content="Generate Room"
                                            Command="{Binding ConfirmRoomExpansion}"
                                            Background="#007ACC"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            Padding="16,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Edit Room Modal Overlay -->
                    <Border Grid.Row="0" Grid.RowSpan="5"
                            Background="#80000000"
                            IsVisible="{Binding IsEditingRoom}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Border Background="#252526"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Width="720"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BoxShadow="0 4 20 #80000000">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding EditingRoomTitle}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Command="{Binding CloseEditRoomDialog}"
                                            Padding="8,4"
                                            Background="Transparent"/>
                                </Grid>

                                <!-- Three Tabs: Room, Zone, Geomorph -->
                                <TabControl SelectedIndex="0" Margin="0,2,0,0">
                                    <!-- TAB 1: Room -->
                                    <TabItem Header="Room" FontSize="13" FontWeight="SemiBold">
                                        <ScrollViewer MaxHeight="540" Margin="0,10,0,0">
                                            <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Padding="14">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Room Settings"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               Foreground="#00F2FF"/>

                                                    <!-- Room Info Details -->
                                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Room:" FontWeight="SemiBold" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,10"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EditingRoomRoomName}" FontWeight="Bold" Foreground="#00F2FF" VerticalAlignment="Center" Margin="0,0,16,10"/>

                                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Area:" FontWeight="SemiBold" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,10"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding EditingRoomAreaIndex, StringFormat='Area {0}'}" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,16,10"/>

                                                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Zone:" FontWeight="SemiBold" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,10"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="5" Text="{Binding EditingRoomZoneDisplayName}" FontWeight="Bold" Foreground="#00F2FF" VerticalAlignment="Center" Margin="0,0,0,10"/>

                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Room Size:" FontWeight="SemiBold" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EditingRoomAreaSize, StringFormat='{}{0} m²'}" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <!-- Delete Room Button -->
                                                    <Button Content="Delete Room"
                                                            Command="{Binding RequestDeleteRoom}"
                                                            Background="#D9534F"
                                                            Foreground="White"
                                                            FontWeight="SemiBold"
                                                            HorizontalAlignment="Right"
                                                            Padding="14,6"
                                                            Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </ScrollViewer>
                                    </TabItem>

                                    <!-- TAB 2: Zone -->
                                    <TabItem Header="Zone" FontSize="13" FontWeight="SemiBold">
                                        <ScrollViewer MaxHeight="540" Margin="0,10,0,0">
                                            <StackPanel Spacing="12">
                                                <!-- Seeds & Lighting Section -->
                                                <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Padding="12">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="Zone Settings"
                                                                       FontWeight="Bold"
                                                                       FontSize="14"
                                                                       Foreground="#00F2FF"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding EditingRoomZoneDisplayName}"
                                                                       FontWeight="Bold"
                                                                       Foreground="#FFA200"/>
                                                        </Grid>

                                                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sub Seed:" ToolTip.Tip="Subseed for the zone." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#AAAAAA"/>
                                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ActiveZoneSettings.SubSeed, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Marker Sub Seed:" ToolTip.Tip="Subseed for markers. Affects which markers spawn and where (room objects, lockers, terminals, etc)" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#AAAAAA"/>
                                                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ActiveZoneSettings.MarkerSubSeed, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Lighting Sub Seed:" ToolTip.Tip="Subseed for the lighting" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#AAAAAA"/>
                                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ActiveZoneSettings.LightingSubSeed, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Lighting:" FontWeight="SemiBold" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,8" ToolTip.Tip="Lighting settings for this zone."/>
                                                            <ComboBox Grid.Row="1" Grid.Column="3"
                                                                      ItemsSource="{Binding AvailableLightingConfigs}"
                                                                      SelectedItem="{Binding SelectedZoneLightingOption, Mode=TwoWay}"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,0,8">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:LightSettingsBlock">
                                                                        <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>

                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Consumables:" FontWeight="SemiBold" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="consumable distribution in this zone."/>
                                                            <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                                                      ItemsSource="{Binding AvailableConsumableDistributions}"
                                                                      SelectedItem="{Binding SelectedZoneConsumableDistributionOption, Mode=TwoWay}"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Center">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:ConsumableDistributionBlock">
                                                                        <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Enemy Respawning Section -->
                                                <Border BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="4" Padding="10">
                                                    <StackPanel Spacing="8">
                                                        <CheckBox Content="Enemy Respawning"
                                                                  ToolTip.Tip="True if enemies should respawn in this zone (Respawn Zone). Note that if too many respawn sacs exist in the level there can be significant audio issues, so do not overuse this."
                                                                  IsChecked="{Binding ActiveZoneSettings.EnemyRespawning, Mode=TwoWay}"
                                                                  FontWeight="SemiBold"
                                                                  Foreground="#E0E0E0"/>

                                                        <StackPanel Spacing="8" IsVisible="{Binding ActiveZoneSettings.EnemyRespawning}" Margin="20,2,0,0">
                                                            <CheckBox Content="Require Other Zone"
                                                                      ToolTip.Tip="True if respawning requires all players to be outside of this zone in addition to the room distance requirement"
                                                                      IsChecked="{Binding ActiveZoneSettings.RequireOtherZone, Mode=TwoWay}"
                                                                      Foreground="#CCCCCC"/>

                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Room Distance:" ToolTip.Tip="How many rooms away the players must be for the respawn to trigger. Default in vanilla is 2. If set to 0, enemies will just respawn on top of themselves" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#AAAAAA"/>
                                                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ActiveZoneSettings.RoomDistance, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Time Interval (s):" ToolTip.Tip="How often the respawn check is run. Note this does NOT simply mean how long the players have left the area for" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#AAAAAA"/>
                                                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ActiveZoneSettings.TimeInterval, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Count Multiplier:" ToolTip.Tip="0-1 multiplier for the proportion of enemies that will respawn. When the proportion of enemies falls below this, enemies will respawn back up to this value." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AAAAAA"/>
                                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ActiveZoneSettings.CountMultiplier, Mode=TwoWay}" Margin="0,0,14,0"/>
                                                            </Grid>

                                                            <!-- Exclude List -->
                                                            <Expander Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch">
                                                                <Expander.Header>
                                                                    <Grid ColumnDefinitions="*,Auto">
                                                                        <TextBlock Grid.Column="0" Text="Exclude List" ToolTip.Tip="Select enemies to not be respawned. Many levels opt to exclude scouts." FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                        <Button Grid.Column="1" Content="+ Add Excluded Enemy" Command="{Binding AddEnemyExcludeItem}" Background="#2D5A27" Foreground="White" Padding="8,3"/>
                                                                    </Grid>
                                                                </Expander.Header>
                                                                <ItemsControl ItemsSource="{Binding ActiveZoneSettings.ExcludeList}" Margin="0,8,0,0">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:EnemyExcludeItem" x:CompileBindings="False">
                                                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,2">
                                                                                <TextBlock Grid.Column="0" Text="Enemy:" ToolTip.Tip="The enemy to NOT respawn" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                                <ComboBox Grid.Column="1"
                                                                                          ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                                                                          SelectedValue="{Binding EnemyId, Mode=TwoWay}"
                                                                                          SelectedValueBinding="{Binding PersistentId}"
                                                                                          HorizontalAlignment="Stretch"
                                                                                          Margin="0,0,8,0">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:EnemyEntry">
                                                                                            <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                                <Button Grid.Column="2" Content="✕" Command="{Binding $parent[Window].DataContext.LevelLayout.RemoveEnemyExcludeItemCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="8,3"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Expander>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Resource Kit Uses (Med, Ammo, Tool, Disinfect) -->
                                                <Border BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="4" Padding="10">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="Resource Kit Uses" FontWeight="SemiBold" FontSize="13" Foreground="#E0E0E0" ToolTip.Tip="Number of resource kit uses in the zone."/>
                                                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Med Uses:" ToolTip.Tip="Number of medical kit uses in this zone." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#AAAAAA"/>
                                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ActiveZoneSettings.MedKitUses, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Ammo Uses:" ToolTip.Tip="Number of ammo pack uses in this zone." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#AAAAAA"/>
                                                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ActiveZoneSettings.AmmoKitUses, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tool Uses:" ToolTip.Tip="Number of tool refill uses in this zone." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AAAAAA"/>
                                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ActiveZoneSettings.ToolKitUses, Mode=TwoWay}" Margin="0,0,14,0"/>

                                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Disinfect Uses:" ToolTip.Tip="Number of disinfection pack uses in this zone." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AAAAAA"/>
                                                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ActiveZoneSettings.DisinfectKitUses, Mode=TwoWay}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Power Cells, Fog Turbines -->
                                                <Border BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="4" Padding="10">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Power Cells:" ToolTip.Tip="Number of power cells in the zone." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AAAAAA"/>
                                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ActiveZoneSettings.PowerCells, Mode=TwoWay}" Margin="0,0,14,0"/>

                                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Fog Turbines:" ToolTip.Tip="Number of fog turbines in the zone." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AAAAAA"/>
                                                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ActiveZoneSettings.FogTurbines, Mode=TwoWay}"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Clusters & Spawners Section -->
                                                <Border BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="4" Padding="10">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="Clusters &amp; Spawners" FontWeight="SemiBold" FontSize="13" Foreground="#E0E0E0"/>

                                                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="HSU Clusters:" ToolTip.Tip="Number of HSU clusters in this zone" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#AAAAAA"/>
                                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ActiveZoneSettings.HSUClusters, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Corpse Clusters:" ToolTip.Tip="Number of corpse clusters in this zone" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#AAAAAA"/>
                                                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ActiveZoneSettings.CorpseClusters, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Container Clusters:" ToolTip.Tip="Number of resource container clusters in this zone. This is not required for resources to spawn" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#AAAAAA"/>
                                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ActiveZoneSettings.ResourceContainerClusters, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Corpses In Zone:" ToolTip.Tip="Number of corpses in this zone" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#AAAAAA"/>
                                                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ActiveZoneSettings.CorpsesInZone, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ground Spawners:" ToolTip.Tip="Number of ground spawners in this zone, which are spots for consumables to spawn on the ground, shelves, etc" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#AAAAAA"/>
                                                            <ComboBox Grid.Row="2" Grid.Column="1"
                                                                      ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableZoneDistributionAmounts}"
                                                                      SelectedItem="{Binding ActiveZoneSettings.GroundSpawnersInZone, Mode=TwoWay}"
                                                                      HorizontalAlignment="Stretch" Margin="0,0,14,8"/>

                                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="HSUs In Zone:" ToolTip.Tip="Number of HSUs in this zone" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#AAAAAA"/>
                                                            <ComboBox Grid.Row="2" Grid.Column="3"
                                                                      ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableZoneDistributionAmounts}"
                                                                      SelectedItem="{Binding ActiveZoneSettings.HSUsInZone, Mode=TwoWay}"
                                                                      HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Decon Units:" ToolTip.Tip="Number of decon units in this zone" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AAAAAA"/>
                                                            <ComboBox Grid.Row="3" Grid.Column="1"
                                                                      ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableZoneDistributionAmounts}"
                                                                      SelectedItem="{Binding ActiveZoneSettings.DeconUnitsInZone, Mode=TwoWay}"
                                                                      HorizontalAlignment="Stretch" Margin="0,0,14,0"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Big Pickup Distribution In Zone -->
                                                <Expander Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch">
                                                    <Expander.Header>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="Big Pickup Distribution" ToolTip.Tip="Add big pickups to this zone (cells, turbines, etc)" FontWeight="SemiBold" FontSize="13" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="+ Add Big Pickup" Command="{Binding AddBigPickupDistributionItem}" Background="#2D5A27" Foreground="White" Padding="8,3"/>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding ActiveZoneSettings.BigPickupDistributionInZone}" Margin="0,8,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:BigPickupDistributionItem" x:CompileBindings="False">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,2">
                                                                    <TextBlock Grid.Column="0" Text="Big Pickup Item:" ToolTip.Tip="Item to place in the zone" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                    <ComboBox Grid.Column="1"
                                                                              ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableRetrieveBigItemOptionsList}"
                                                                              SelectedValue="{Binding ItemType, Mode=TwoWay}"
                                                                              SelectedValueBinding="{Binding Type}"
                                                                              HorizontalAlignment="Stretch"
                                                                              Margin="0,0,8,0">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:RetrieveBigItemOption">
                                                                                <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <Button Grid.Column="2" Content="✕" Command="{Binding $parent[Window].DataContext.LevelLayout.RemoveBigPickupDistributionItemCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="8,3"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>

                                                <!-- Disinfection Station Placements -->
                                                <Expander Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch">
                                                    <Expander.Header>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="Disinfection Station Placements" ToolTip.Tip="Placements for disinfection stations" FontWeight="SemiBold" FontSize="13" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="+ Add Station Placement" Command="{Binding AddDisinfectionStationPlacement}" Background="#2D5A27" Foreground="White" Padding="8,3"/>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding ActiveZoneSettings.DisinfectionStationPlacements}" Margin="0,8,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:DisinfectionStationPlacement" x:CompileBindings="False">
                                                                <Border Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto" RowDefinitions="Auto">
                                                                        <TextBlock Grid.Column="0" Text="Start:" ToolTip.Tip="Weight for the start of the zone." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAAAAA"/>
                                                                        <TextBox Grid.Column="1" Text="{Binding PlacementStartWeight, Mode=TwoWay}" Margin="0,0,10,0"/>

                                                                        <TextBlock Grid.Column="2" Text="Middle:" ToolTip.Tip="Weight for the middle of the zone." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAAAAA"/>
                                                                        <TextBox Grid.Column="3" Text="{Binding PlacementMiddleWeight, Mode=TwoWay}" Margin="0,0,10,0"/>

                                                                        <TextBlock Grid.Column="4" Text="End:" ToolTip.Tip="Weight for the end of the zone." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAAAAA"/>
                                                                        <TextBox Grid.Column="5" Text="{Binding PlacementEndWeight, Mode=TwoWay}" Margin="0,0,10,0"/>

                                                                        <Button Grid.Column="6" Content="✕" Command="{Binding $parent[Window].DataContext.LevelLayout.RemoveDisinfectionStationPlacementCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="8,3"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>

                                                <!-- Terminal Placements -->
                                                <Expander Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch">
                                                    <Expander.Header>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="Terminal Placements" ToolTip.Tip="Placements and configs for terminals in the zone" FontWeight="SemiBold" FontSize="13" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="+ Add Terminal" Command="{Binding AddTerminalPlacement}" Background="#2D5A27" Foreground="White" Padding="8,3"/>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding ActiveZoneSettings.TerminalPlacements}" Margin="0,8,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:TerminalPlacement" x:CompileBindings="False">
                                                                <Expander Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                                                    <Expander.Header>
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock Grid.Column="0" Text="Terminal Configuration" ToolTip.Tip="Custom configuration for this terminal" FontWeight="SemiBold" FontSize="12" Foreground="#FFA200" VerticalAlignment="Center"/>
                                                                            <Button Grid.Column="1" Content="✕ Remove Terminal" Command="{Binding $parent[Window].DataContext.LevelLayout.RemoveTerminalPlacementCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="8,3"/>
                                                                        </Grid>
                                                                    </Expander.Header>
                                                                    <StackPanel Spacing="8" Margin="0,8,0,0">
                                                                        <!-- Placement Weights & Seed Offsets -->
                                                                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Start:" ToolTip.Tip="Weight for the start of the zone." VerticalAlignment="Center" Margin="0,0,6,8" Foreground="#AAAAAA"/>
                                                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PlacementStartWeight, Mode=TwoWay}" Margin="0,0,10,8"/>

                                                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Middle:" ToolTip.Tip="Weight for the middle of the zone." VerticalAlignment="Center" Margin="0,0,6,8" Foreground="#AAAAAA"/>
                                                                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding PlacementMiddleWeight, Mode=TwoWay}" Margin="0,0,10,8"/>

                                                                            <TextBlock Grid.Row="0" Grid.Column="4" Text="End:" ToolTip.Tip="Weight for the end of the zone." VerticalAlignment="Center" Margin="0,0,6,8" Foreground="#AAAAAA"/>
                                                                            <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding PlacementEndWeight, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Area Seed:" ToolTip.Tip="Seed offset for where this terminal is placed." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAAAAA"/>
                                                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AreaSeedOffset, Mode=TwoWay}" Margin="0,0,10,0"/>

                                                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Marker Seed:" ToolTip.Tip="Seed offset for where markers will be placed." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAAAAA"/>
                                                                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MarkerSeedOffset, Mode=TwoWay}" Margin="0,0,10,0"/>
                                                                        </Grid>

                                                                        <!-- Starting State & State Options -->
                                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Starting State:" ToolTip.Tip="Initial state of the terminal. Almost every terminal in the base game uses 'Sleeping'." VerticalAlignment="Center" Margin="0,0,6,8" Foreground="#CCCCCC"/>
                                                                            <ComboBox Grid.Row="0" Grid.Column="1"
                                                                                      ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableTerminalStartingStates}"
                                                                                      SelectedItem="{Binding StartingState, Mode=TwoWay}"
                                                                                      HorizontalAlignment="Stretch"
                                                                                      Margin="0,0,12,8"/>

                                                                            <CheckBox Grid.Row="0" Grid.Column="2"
                                                                                      Content="Show Log Count"
                                                                                      ToolTip.Tip="Whether this terminal should display the log count."
                                                                                      IsChecked="{Binding KeepShowingLocalLogCount, Mode=TwoWay}"
                                                                                      VerticalAlignment="Center"
                                                                                      Margin="0,0,12,8"
                                                                                      Foreground="#CCCCCC"/>

                                                                            <CheckBox Grid.Row="0" Grid.Column="3"
                                                                                      Content="Use Custom Info Text"
                                                                                      ToolTip.Tip="Whether this terminal should contain custom Info text."
                                                                                      IsChecked="{Binding UseCustomInfoText, Mode=TwoWay}"
                                                                                      VerticalAlignment="Center"
                                                                                      Margin="0,0,0,8"
                                                                                      Foreground="#CCCCCC"/>

                                                                            <!-- Custom Info Text [only visible when UseCustomInfoText is true] -->
                                                                            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                                                                  ColumnDefinitions="Auto,*"
                                                                                  IsVisible="{Binding UseCustomInfoText}"
                                                                                  Margin="0,0,0,8">
                                                                                <TextBlock Grid.Column="0" Text="Custom Info Text:" ToolTip.Tip="The custom info text to be displayed" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                                                                <TextBox Grid.Column="1" Text="{Binding CustomInfoText, Mode=TwoWay}"/>
                                                                            </Grid>
                                                                        </Grid>

                                                                        <!-- Password Protection -->
                                                                        <Border Background="#141414" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="4" Padding="8">
                                                                            <StackPanel Spacing="8">
                                                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <CheckBox Content="Password Protected"
                                                                                              ToolTip.Tip="True if this terminal should be password protected"
                                                                                              IsChecked="{Binding PasswordProtected, Mode=TwoWay}"
                                                                                              VerticalAlignment="Center"
                                                                                              Margin="0,0,16,0"
                                                                                              Foreground="#CCCCCC"/>

                                                                                    <CheckBox Content="Generate Password"
                                                                                              ToolTip.Tip="True if a password should be generated (this is only *not* used on the hidden R8A2 terminal)"
                                                                                              IsChecked="{Binding GeneratePassword, Mode=TwoWay}"
                                                                                              IsVisible="{Binding PasswordProtected}"
                                                                                              VerticalAlignment="Center"
                                                                                              Margin="0,0,16,0"
                                                                                              Foreground="#CCCCCC"/>

                                                                                    <CheckBox Content="Show Password Length"
                                                                                              ToolTip.Tip="True if the password length should be shown to the player"
                                                                                              IsChecked="{Binding ShowPasswordLength, Mode=TwoWay}"
                                                                                              IsVisible="{Binding IsPasswordGenerationVisible}"
                                                                                              VerticalAlignment="Center"
                                                                                              Margin="0,0,16,0"
                                                                                              Foreground="#CCCCCC"/>

                                                                                    <CheckBox Content="Show Password Part Positions"
                                                                                              ToolTip.Tip="True if the parts of the password given to players should include their position"
                                                                                              IsChecked="{Binding ShowPasswordPartPositions, Mode=TwoWay}"
                                                                                              IsVisible="{Binding IsPasswordGenerationVisible}"
                                                                                              VerticalAlignment="Center"
                                                                                              Foreground="#CCCCCC"/>
                                                                                </WrapPanel>

                                                                                <!-- Password Hint Text [only visible when PasswordProtected is true] -->
                                                                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding PasswordProtected}">
                                                                                    <TextBlock Grid.Column="0" Text="Password Hint Text:" ToolTip.Tip="The text shown to players where they need to type the password into" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                                                                    <TextBox Grid.Column="1" Text="{Binding PasswordHintText, Mode=TwoWay}"/>
                                                                                </Grid>

                                                                                <!-- Password Part Count [only visible when PasswordProtected and GeneratePassword is true] -->
                                                                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsPasswordGenerationVisible}">
                                                                                    <TextBlock Grid.Column="0" Text="Password Part Count:" ToolTip.Tip="How many logs this password is split between" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                                                                    <TextBox Grid.Column="1" Text="{Binding PasswordPartCount, Mode=TwoWay}"/>
                                                                                </Grid>

                                                                                <!-- TerminalZoneSelectionDatas [only visible when PasswordProtected and GeneratePassword is true] -->
                                                                                <Expander Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch"
                                                                                          IsVisible="{Binding IsPasswordGenerationVisible}">
                                                                                    <Expander.Header>
                                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                                            <TextBlock Grid.Column="0" Text="Terminal Zone Selection Datas" FontWeight="SemiBold" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                                                                            <Button Grid.Column="1" Content="+ Add Terminal Zone" Command="{Binding AddTerminalZoneSelectionData}" Background="#2D5A27" Foreground="White" Padding="6,2" FontSize="11"/>
                                                                                        </Grid>
                                                                                    </Expander.Header>
                                                                                    <ItemsControl ItemsSource="{Binding TerminalZoneSelectionDatas}" Margin="0,6,0,0">
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate x:DataType="models:TerminalZoneSelectionData" x:CompileBindings="False">
                                                                                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" Margin="0,2,0,4">
                                                                                                    <TextBlock Grid.Column="0" Text="Zone:" ToolTip.Tip="The zone a password segment can spawn in" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAAAAA"/>
                                                                                                    <ComboBox Grid.Column="1"
                                                                                                              ItemsSource="{Binding AvailableZones}"
                                                                                                              SelectedValue="{Binding Zone, Mode=TwoWay}"
                                                                                                              SelectedValueBinding="{Binding ZoneIndex}"
                                                                                                              HorizontalAlignment="Stretch"
                                                                                                              VerticalAlignment="Center"
                                                                                                              Margin="0,0,12,0">
                                                                                                        <ComboBox.ItemTemplate>
                                                                                                            <DataTemplate x:DataType="models:ZoneOption">
                                                                                                                <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                                                            </DataTemplate>
                                                                                                        </ComboBox.ItemTemplate>
                                                                                                    </ComboBox>

                                                                                                    <TextBlock Grid.Column="2" Text="Terminal:" ToolTip.Tip="The terminal within this zone to spawn the password segment on" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAAAAA"/>
                                                                                                    <ComboBox Grid.Column="3"
                                                                                                              ItemsSource="{Binding AvailableTerminals}"
                                                                                                              SelectedValue="{Binding Terminal, Mode=TwoWay}"
                                                                                                              SelectedValueBinding="{Binding TerminalIndex}"
                                                                                                              HorizontalAlignment="Stretch"
                                                                                                              VerticalAlignment="Center"
                                                                                                              Margin="0,0,8,0">
                                                                                                        <ComboBox.ItemTemplate>
                                                                                                            <DataTemplate x:DataType="models:TerminalOption">
                                                                                                                <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                                                            </DataTemplate>
                                                                                                        </ComboBox.ItemTemplate>
                                                                                                    </ComboBox>

                                                                                                    <Button Grid.Column="4" Content="✕" Command="{Binding $parent[Window].DataContext.LevelLayout.RemoveTerminalZoneSelectionDataCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="6,2"/>
                                                                                                </Grid>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </Expander>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!-- Unique Commands -->
                                                                        <Expander Background="#181818" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch">
                                                                            <Expander.Header>
                                                                                <Grid ColumnDefinitions="*,Auto">
                                                                                    <TextBlock Grid.Column="0" Text="Unique Commands" ToolTip.Tip="Custom commands for this terminal" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                                    <Button Grid.Column="1" Content="+ Add Unique Command" Command="{Binding AddUniqueCommand}" Background="#2D5A27" Foreground="White" Padding="8,3"/>
                                                                                </Grid>
                                                                            </Expander.Header>
                                                                            <ItemsControl ItemsSource="{Binding UniqueCommands}" Margin="0,8,0,0">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:TerminalUniqueCommand" x:CompileBindings="False">
                                                                                        <Expander Background="#141414" BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                                                                            <Expander.Header>
                                                                                                <Grid ColumnDefinitions="*,Auto">
                                                                                                    <TextBlock Grid.Column="0" Text="Unique Command Details" FontWeight="SemiBold" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                                                                                    <Button Grid.Column="1" Content="✕ Remove Command" Command="{Binding $parent[Window].DataContext.LevelLayout.RemoveTerminalUniqueCommandCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="8,3"/>
                                                                                                </Grid>
                                                                                            </Expander.Header>
                                                                                            <StackPanel Spacing="6" Margin="0,6,0,0">
                                                                                                <Grid ColumnDefinitions="Auto,*">
                                                                                                    <TextBlock Grid.Column="0" Text="Command:" ToolTip.Tip="The name of the command. This is what players must type" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                                                                                    <TextBox Grid.Column="1" Text="{Binding Command, Mode=TwoWay}"/>
                                                                                                </Grid>
                                                                                                <Grid ColumnDefinitions="Auto,*">
                                                                                                    <TextBlock Grid.Column="0" Text="Command Description:" ToolTip.Tip="The description of the command. This will be visible via the 'commands' command." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC"/>
                                                                                                    <TextBox Grid.Column="1" Text="{Binding CommandDesc, Mode=TwoWay}"/>
                                                                                                </Grid>

                                                                                                <!-- Post Command Outputs -->
                                                                                                <Expander Background="#1E1E1E" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch">
                                                                                                    <Expander.Header>
                                                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                                                            <TextBlock Grid.Column="0" Text="Post Command Outputs" ToolTip.Tip="The messages that will be displayed in the terminal after the command is run" FontWeight="SemiBold" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                                                                                            <Button Grid.Column="1" Content="+ Add Output" Command="{Binding AddPostCommandOutput}" Background="#2D5A27" Foreground="White" Padding="6,2" FontSize="11"/>
                                                                                                        </Grid>
                                                                                                    </Expander.Header>
                                                                                                    <ItemsControl ItemsSource="{Binding PostCommandOutputs}" Margin="0,6,0,0">
                                                                                                        <ItemsControl.ItemTemplate>
                                                                                                            <DataTemplate x:DataType="models:TerminalPostCommandOutput" x:CompileBindings="False">
                                                                                                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="0,2,0,2">
                                                                                                                    <TextBlock Grid.Column="0" Text="Line Type:" ToolTip.Tip="The style of line" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAAAAA"/>
                                                                                                                    <ComboBox Grid.Column="1"
                                                                                                                              ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableTerminalLineTypes}"
                                                                                                                              SelectedItem="{Binding LineType, Mode=TwoWay}"
                                                                                                                              Margin="0,0,8,0"/>
                                                                                                                    <TextBlock Grid.Column="2" Text="Time:" ToolTip.Tip="The delay when outputting this line. 0 for instant" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAAAAA"/>
                                                                                                                    <TextBox Grid.Column="3" Text="{Binding Time, Mode=TwoWay}" Width="60" Margin="0,0,8,0"/>
                                                                                                                    <TextBlock Grid.Column="4" Text="Output:" ToolTip.Tip="The text to be output on this line" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAAAAA"/>
                                                                                                                    <TextBox Grid.Column="5" Text="{Binding Output, Mode=TwoWay}" Margin="0,0,6,0"/>
                                                                                                                    <Button Grid.Column="6" Content="✕" Command="{Binding $parent[Window].DataContext.LevelLayout.RemoveTerminalPostCommandOutputCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="6,2"/>
                                                                                                                </Grid>
                                                                                                            </DataTemplate>
                                                                                                        </ItemsControl.ItemTemplate>
                                                                                                    </ItemsControl>
                                                                                                </Expander>

                                                                                                <!-- Command Events -->
                                                                                                <Expander Background="#1E1E1E" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch">
                                                                                                    <Expander.Header>
                                                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                                                            <TextBlock Grid.Column="0" Text="Command Events" ToolTip.Tip="Events to trigger when the command is run" FontWeight="SemiBold" FontSize="11" Foreground="#03C700" VerticalAlignment="Center"/>
                                                                                                            <Button Grid.Column="1" Content="+ Add Event" Command="{Binding AddCommandEvent}" Background="#2D5A27" Foreground="White" Padding="6,2" FontSize="11"/>
                                                                                                        </Grid>
                                                                                                    </Expander.Header>
                                                                                                    <StackPanel Spacing="6" Margin="0,6,0,0">
                                                                                                        <ItemsControl ItemsSource="{Binding CommandEvents}"
                                                                                                                      ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                                                                                    </StackPanel>
                                                                                                </Expander>
                                                                                            </StackPanel>
                                                                                        </Expander>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </Expander>
                                                                    </StackPanel>
                                                                </Expander>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>

                                                <!-- Generator Cluster (Gen Cluster) Section -->
                                                <Border BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,2,0,0" IsVisible="{Binding ActiveZoneHasGenClusterTile}">
                                                    <CheckBox Content="Zone Contains Gen Cluster"
                                                              ToolTip.Tip="Whether this zone contains a generator cluster."
                                                              IsChecked="{Binding ActiveZoneSettings.ContainsGenCluster, Mode=TwoWay}"
                                                              FontWeight="SemiBold"
                                                              Foreground="#E0E0E0"/>
                                                </Border>

                                                <!-- Door Controller (DC) Section -->
                                                <Border BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,2,0,0">
                                                    <StackPanel Spacing="8">
                                                        <CheckBox Content="Zone Contains DC (Door Controller)"
                                                                  ToolTip.Tip="Whether the zone contains a DC"
                                                                  IsChecked="{Binding ActiveZoneSettings.ContainsDC, Mode=TwoWay}"
                                                                  FontWeight="SemiBold"
                                                                  Foreground="#E0E0E0"/>

                                                        <!-- DC Scan Seed (only visible if DC is in the zone) -->
                                                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding ActiveZoneSettings.ContainsDC}" Margin="20,2,0,0">
                                                            <TextBlock Grid.Column="0" Text="DC Scan Seed:" ToolTip.Tip="Seed that affects where the scans will go to" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA200"/>
                                                            <TextBox Grid.Column="1" Text="{Binding ActiveZoneSettings.DcScanSeed, Mode=TwoWay}"/>
                                                        </Grid>

                                                        <!-- List of doors opened by this DC -->
                                                        <StackPanel Spacing="6" IsVisible="{Binding ActiveZoneSettings.ContainsDC}" Margin="20,2,0,0">
                                                            <TextBlock Text="Doors Opened by this DC:"
                                                                       ToolTip.Tip="The list of doors that can be opened via this DC."
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#FFA200"/>

                                                            <ItemsControl ItemsSource="{Binding DoorsOpenedByThisDc}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <TextBlock Text="{Binding}"
                                                                                   Margin="0,0,0,2"
                                                                                   Foreground="#CCCCCC"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="(No doors originating from this zone)"
                                                                       FontSize="11"
                                                                       FontStyle="Italic"
                                                                       Foreground="#666666"
                                                                       IsVisible="{Binding !HasDoorsOpenedByThisDc}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <!-- TAB 3: Geomorph -->
                                    <TabItem Header="Geomorph" FontSize="13" FontWeight="SemiBold">
                                        <ScrollViewer MaxHeight="540" Margin="0,10,0,0">
                                            <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Padding="14">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Geomorph Settings"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               Foreground="#00F2FF"/>

                                                    <!-- Geomorph Name -->
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <TextBlock Grid.Column="0" Text="Geomorph:" FontWeight="SemiBold" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding EditingRoomGeomorphName}" FontWeight="Bold" Foreground="#9D00FF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>

                                                    <!-- Altitude Selection -->
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <TextBlock Grid.Column="0" Text="Altitude:" FontWeight="SemiBold" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="Elevation of the geomorph."/>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding AvailableGeomorphAltitudes}"
                                                                  SelectedItem="{Binding SelectedGeomorphAltitudeOption, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:AltitudeOption">
                                                                    <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>

                                                    <!-- Delete Geomorph Button -->
                                                    <Button Content="Delete Geomorph"
                                                            Command="{Binding RequestDeleteGeomorph}"
                                                            Background="#D9534F"
                                                            Foreground="White"
                                                            FontWeight="SemiBold"
                                                            HorizontalAlignment="Right"
                                                            Padding="14,6"
                                                            Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>

                                <!-- Action buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
                                    <Button Content="Close"
                                            Command="{Binding CloseEditRoomDialog}"
                                            Background="#007ACC"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            Padding="20,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Edit Door Modal Overlay -->
                    <Border Grid.Row="0" Grid.RowSpan="5"
                            Background="#80000000"
                            IsVisible="{Binding IsEditingDoor}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Border Background="#252526"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Width="920"
                                MaxHeight="800"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BoxShadow="0 4 20 #80000000">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="{Binding EditingDoorTitle}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"/>

                                    <!-- Door Settings Section -->
                                    <Border Background="#1E1E1E"
                                            BorderBrush="#3E3E42"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Security Door Configuration"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF"/>

                                            <!-- Alarm / Chained Puzzle Selection -->
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Alarm:"
                                                           ToolTip.Tip="The alarm attached to this door."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableAlarms}"
                                                          SelectedItem="{Binding SelectedDoorAlarmOption, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:AlarmBlock">
                                                            <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>

                                            <!-- Alias Override (int) -->
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Alias Override:"
                                                           ToolTip.Tip="Override for this zone's number. -1 for no override (will use default value based on the zone index)"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding EditingDoorAliasOverride, Mode=TwoWay}"
                                                         VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Alias Prefix Short Override (string) -->
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Alias Prefix Short Override:"
                                                           ToolTip.Tip="The prefix before the zone number. A common use case is to name this something like &quot;Resource Room, ZONE&quot;."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding EditingDoorAliasPrefixShortOverride, Mode=TwoWay}"
                                                         VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- TurnOffAlarmOnTerminal (bool) -->
                                            <CheckBox Content="Turn Off Alarm On Terminal"
                                                      IsChecked="{Binding EditingDoor.TurnOffAlarmOnTerminal, Mode=TwoWay}"
                                                      ToolTip.Tip="True if this door's alarm (typically, an error) should be stopped via a terminal"
                                                      Foreground="#CCCCCC"/>

                                            <!-- TerminalZone & Terminal [only visible if TurnOffAlarmOnTerminal is true] -->
                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto"
                                                  IsVisible="{Binding EditingDoor.TurnOffAlarmOnTerminal}"
                                                  Margin="0,2,0,0">
                                                <TextBlock Grid.Column="0"
                                                           Text="Terminal Zone:"
                                                           ToolTip.Tip="The zone that contains the terminal used to deactivate alarms"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableDoorTerminalZones}"
                                                          SelectedItem="{Binding SelectedDoorTerminalZoneOption, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ZoneOption">
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <TextBlock Grid.Column="2"
                                                           Text="Terminal:"
                                                           ToolTip.Tip="The specific terminal that should be used for the deactivation"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <ComboBox Grid.Column="3"
                                                          ItemsSource="{Binding AvailableDoorTerminals}"
                                                          SelectedItem="{Binding SelectedDoorTerminalOption, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:TerminalOption">
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>

                                            <!-- Apex Door (bool) [only visible if EditingDoor.IsSecurityDoor is true] -->
                                            <CheckBox Content="Apex Door"
                                                      IsChecked="{Binding EditingDoor.IsApexDoor, Mode=TwoWay}"
                                                      IsVisible="{Binding EditingDoor.IsSecurityDoor}"
                                                      ToolTip.Tip="Whether this security door is an apex door"
                                                      Foreground="#CCCCCC"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Blood Doors Section -->
                                    <Border Background="#1E1E1E"
                                            BorderBrush="#3E3E42"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Blood Doors"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF"/>

                                            <!-- Blood Door Toggle -->
                                            <CheckBox Content="Blood Door"
                                                      ToolTip.Tip="True if this door is a blood door"
                                                      IsChecked="{Binding EditingDoor.HasBloodDoor, Mode=TwoWay}"
                                                      Foreground="#CCCCCC"/>

                                            <!-- Blood Door Settings (Visible when Blood Door toggle is enabled) -->
                                            <StackPanel Spacing="12" IsVisible="{Binding EditingDoor.HasBloodDoor}">
                                                <!-- EnemyGroupInArea -->
                                                <Expander Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch">
                                                    <Expander.Header>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="EnemyGroupInArea" ToolTip.Tip="The enemy group that will spawn in the room behind the door when it is opened." FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="+ Add Enemy" Command="{Binding AddEnemyGroupInAreaItem}" Background="#2D5A27" Foreground="White" Padding="8,3"/>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding EditingDoor.EnemyGroupInArea}" Margin="0,8,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:EnemyGroupItem" x:CompileBindings="False">
                                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,2,0,2">
                                                                    <TextBlock Grid.Column="0" Text="Enemy:" ToolTip.Tip="The enemy to spawn" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                    <ComboBox Grid.Column="1"
                                                                              ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                                                              SelectedValue="{Binding EnemyId, Mode=TwoWay}"
                                                                              SelectedValueBinding="{Binding PersistentId}"
                                                                              HorizontalAlignment="Stretch"
                                                                              Margin="0,0,8,0">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:EnemyEntry">
                                                                                <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <TextBlock Grid.Column="2" Text="Count:" ToolTip.Tip="The number of this enemy to spawn" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                    <TextBox Grid.Column="3" Text="{Binding Count, Mode=TwoWay}" Width="60" Margin="0,0,8,0"/>
                                                                    <Button Grid.Column="4" Content="✕" Command="{Binding $parent[Window].DataContext.LevelLayout.RemoveEnemyGroupInAreaItemCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="8,3"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>

                                                <!-- EnemyGroupInFrontOfDoor -->
                                                <Expander Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch">
                                                    <Expander.Header>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="EnemyGroupInFrontOfDoor" ToolTip.Tip="The enemy group that will spawn directly behind the door when it is opened." FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="+ Add Enemy" Command="{Binding AddEnemyGroupInFrontOfDoorItem}" Background="#2D5A27" Foreground="White" Padding="8,3"/>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding EditingDoor.EnemyGroupInFrontOfDoor}" Margin="0,8,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:EnemyGroupItem" x:CompileBindings="False">
                                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,2,0,2">
                                                                    <TextBlock Grid.Column="0" Text="Enemy:" ToolTip.Tip="The enemy to spawn" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                    <ComboBox Grid.Column="1"
                                                                              ItemsSource="{Binding $parent[Window].DataContext.LevelLayout.Enemies}"
                                                                              SelectedValue="{Binding EnemyId, Mode=TwoWay}"
                                                                              SelectedValueBinding="{Binding PersistentId}"
                                                                              HorizontalAlignment="Stretch"
                                                                              Margin="0,0,8,0">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:EnemyEntry">
                                                                                <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <TextBlock Grid.Column="2" Text="Count:" ToolTip.Tip="The number of this enemy to spawn" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                    <TextBox Grid.Column="3" Text="{Binding Count, Mode=TwoWay}" Width="60" Margin="0,0,8,0"/>
                                                                    <Button Grid.Column="4" Content="✕" Command="{Binding $parent[Window].DataContext.LevelLayout.RemoveEnemyGroupInFrontOfDoorItemCommand}" CommandParameter="{Binding}" Background="#4A1C1C" Foreground="#FF6B6B" Padding="8,3"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Locked Door Section -->
                                    <Border Background="#1E1E1E"
                                            BorderBrush="#3E3E42"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Locked Door"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF"/>

                                            <!-- Locked Door / Progression Puzzle Type -->
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Grid.Column="0"
                                                           Text="Locked Door:"
                                                           ToolTip.Tip="The type of lock that should be applied to this door. 'None' for unlocked."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="#CCCCCC"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableProgressionPuzzleTypes}"
                                                          SelectedItem="{Binding EditingDoor.ProgressionPuzzleToEnter, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"/>
                                            </Grid>

                                            <!-- Custom Text (string) -->
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Grid.Column="0"
                                                           Text="Custom Text:"
                                                           ToolTip.Tip="The custom text that should be visible on this door while it is locked."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="#CCCCCC"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding EditingDoor.ProgressionPuzzleCustomText, Mode=TwoWay}"
                                                         HorizontalAlignment="Stretch"/>
                                            </Grid>

                                            <!-- PowerGenerator_And_PowerCell Count -->
                                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding EditingDoor.IsGeneratorPuzzle}">
                                                <TextBlock Grid.Column="0"
                                                           Text="Count:"
                                                           ToolTip.Tip="How many power cells to spawn"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="#CCCCCC"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding EditingDoor.ProgressionPuzzlePlacementCount, Mode=TwoWay}"
                                                         HorizontalAlignment="Stretch"/>
                                            </Grid>

                                            <!-- Candidate Zones for Keycard_SecurityBox or PowerGenerator_And_PowerCell -->
                                            <StackPanel Spacing="10" IsVisible="{Binding EditingDoor.IsKeycardOrGeneratorPuzzle}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="Candidate Zones"
                                                               ToolTip.Tip="Candidate zones for this power cell"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               Foreground="#FFFFFF"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                        <Button Content="+ Add Candidate Zone"
                                                                Command="{Binding AddDoorCandidateZone}"
                                                                Background="#3E3E42"
                                                                Foreground="White"
                                                                Padding="6,3"
                                                                FontSize="11"/>
                                                        <Button Content="- Remove Zone"
                                                                Command="{Binding RemoveDoorCandidateZoneCommand}"
                                                                CommandParameter="{Binding SelectedDoorCandidateZonePlacement}"
                                                                IsEnabled="{Binding HasSelectedDoorCandidateZonePlacement}"
                                                                Background="#3E3E42"
                                                                Foreground="White"
                                                                Padding="6,3"
                                                                FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Candidate Zones List -->
                                                <ListBox ItemsSource="{Binding EditingDoor.ProgressionPuzzleCandidateZones}"
                                                         SelectedItem="{Binding SelectedDoorCandidateZonePlacement, Mode=TwoWay}"
                                                         Height="75"
                                                         Background="#141414"
                                                         BorderBrush="#2A2A2A"
                                                         BorderThickness="1"
                                                         CornerRadius="4">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:CandidateZonePlacement">
                                                            <TextBlock Text="{Binding DisplayTitle}"
                                                                       Foreground="#E0E0E0"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"/>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <!-- Selected Candidate Zone Details -->
                                                <StackPanel Spacing="8" IsVisible="{Binding HasSelectedDoorCandidateZonePlacement}">
                                                    <!-- Dimension & Zone Selection -->
                                                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Dimension:"
                                                                   ToolTip.Tip="The dimension of this candidate zone"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding AvailableDimensions}"
                                                                  SelectedItem="{Binding SelectedDoorCandidateDimensionOption, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,14,0">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:DimensionOption">
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="Zone:"
                                                                   ToolTip.Tip="The candidate zone"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <ComboBox Grid.Column="3"
                                                                  ItemsSource="{Binding AvailableDoorCandidateZones}"
                                                                  SelectedItem="{Binding SelectedDoorCandidateZoneOption, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:ZoneOption">
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>

                                                    <!-- Placement Weights -->
                                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Start:"
                                                                   ToolTip.Tip="Weight for the start of the zone."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0"
                                                                   Foreground="#AAAAAA"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding SelectedDoorCandidateZonePlacement.PlacementStartWeight, Mode=TwoWay}"
                                                                 Margin="0,0,10,0"/>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="Middle:"
                                                                   ToolTip.Tip="Weight for the middle of the zone."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0"
                                                                   Foreground="#AAAAAA"/>
                                                        <TextBox Grid.Column="3"
                                                                 Text="{Binding SelectedDoorCandidateZonePlacement.PlacementMiddleWeight, Mode=TwoWay}"
                                                                 Margin="0,0,10,0"/>

                                                        <TextBlock Grid.Column="4"
                                                                   Text="End:"
                                                                   ToolTip.Tip="Weight for the end of the zone."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0"
                                                                   Foreground="#AAAAAA"/>
                                                        <TextBox Grid.Column="5"
                                                                 Text="{Binding SelectedDoorCandidateZonePlacement.PlacementEndWeight, Mode=TwoWay}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Events Section Header -->
                                    <TextBlock Text="Door Events"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               Margin="0,4,0,0"/>

                                    <!-- EventsOnPortalWarp -->
                                    <Expander Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Events On Portal Warp" FontWeight="SemiBold" FontSize="13" ToolTip.Tip="Events to trigger when the portal scan is completed (this is for source zone, not destination zone). Hardcoded to be used with the portal geomorph (R6B1 and R6D1)" Foreground="#03C700" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="+ Add Event" Command="{Binding AddEventOnPortalWarp}" Background="#2D5A27" Foreground="White" Padding="10,4" Margin="0,0,10,0"/>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding EditingDoor.EventsOnPortalWarp}"
                                                          ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- EventsOnApproachDoor -->
                                    <Expander Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Events On Approach Door" FontWeight="SemiBold" FontSize="13" ToolTip.Tip="Events to trigger when a player gets close to the door" Foreground="#03C700" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="+ Add Event" Command="{Binding AddEventOnApproachDoor}" Background="#2D5A27" Foreground="White" Padding="10,4" Margin="0,0,10,0"/>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding EditingDoor.EventsOnApproachDoor}"
                                                          ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- EventsOnUnlockDoor -->
                                    <Expander Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Events On Unlock Door" FontWeight="SemiBold" FontSize="13" ToolTip.Tip="Events to trigger when the door is unlocked" Foreground="#03C700" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="+ Add Event" Command="{Binding AddEventOnUnlockDoor}" Background="#2D5A27" Foreground="White" Padding="10,4" Margin="0,0,10,0"/>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding EditingDoor.EventsOnUnlockDoor}"
                                                          ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- EventsOnOpenDoor -->
                                    <Expander Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Events On Open Door" FontWeight="SemiBold" FontSize="13" ToolTip.Tip="Events to trigger when this door is opened" Foreground="#03C700" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="+ Add Event" Command="{Binding AddEventOnOpenDoor}" Background="#2D5A27" Foreground="White" Padding="10,4" Margin="0,0,10,0"/>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding EditingDoor.EventsOnOpenDoor}"
                                                          ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- EventsOnDoorScanStart -->
                                    <Expander Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Events On Door Scan Start" FontWeight="SemiBold" FontSize="13" ToolTip.Tip="Events to trigger when the scan for this door starts" Foreground="#03C700" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="+ Add Event" Command="{Binding AddEventOnDoorScanStart}" Background="#2D5A27" Foreground="White" Padding="10,4" Margin="0,0,10,0"/>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding EditingDoor.EventsOnDoorScanStart}"
                                                          ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- EventsOnDoorScanDone -->
                                    <Expander Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Events On Door Scan Done" FontWeight="SemiBold" FontSize="13" ToolTip.Tip="Events to trigger when the scan of this zone is finished" Foreground="#03C700" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="+ Add Event" Command="{Binding AddEventOnDoorScanDone}" Background="#2D5A27" Foreground="White" Padding="10,4" Margin="0,0,10,0"/>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding EditingDoor.EventsOnDoorScanDone}"
                                                          ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- EventsOnBossDeath -->
                                    <Expander Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Events On Boss Death" FontWeight="SemiBold" FontSize="13" ToolTip.Tip="Events to trigger when an enemy considered to be a 'boss' dies. In vanilla, this is specific to the R6D1 kraken, making it unusable" Foreground="#03C700" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="+ Add Event" Command="{Binding AddEventOnBossDeath}" Background="#2D5A27" Foreground="White" Padding="10,4" Margin="0,0,10,0"/>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding EditingDoor.EventsOnBossDeath}"
                                                          ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- EventsOnTrigger -->
                                    <Expander Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Events On Trigger" FontWeight="SemiBold" FontSize="13" ToolTip.Tip="Used to trigger events when a player approaches an object using the triggers that are defined in the prefabs" Foreground="#03C700" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="+ Add Event" Command="{Binding AddEventOnTrigger}" Background="#2D5A27" Foreground="White" Padding="10,4" Margin="0,0,10,0"/>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding EditingDoor.EventsOnTrigger}"
                                                          ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Action buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
                                        <Button Content="Close"
                                                Command="{Binding CloseEditDoorDialog}"
                                                Background="#007ACC"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                Padding="20,8"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Border>

                    <!-- Layout Deletion Confirmation Modal Overlay -->
                    <Border Grid.Row="0" Grid.RowSpan="5"
                            Background="#80000000"
                            IsVisible="{Binding IsConfirmingLayoutDeletion}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Border Background="#252526"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Width="480"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BoxShadow="0 4 20 #80000000">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{Binding LayoutDeletionTitle}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FF6B6B"/>

                                <TextBlock Text="{Binding LayoutDeletionMessage}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="#CCCCCC"/>

                                <Border Background="#331A1A"
                                        BorderBrush="#882222"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        IsVisible="{Binding HasLayoutDeletionWarning}">
                                    <TextBlock Text="{Binding LayoutDeletionWarning}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="#FF9999"/>
                                </Border>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                                    <Button Content="Cancel"
                                            Command="{Binding CancelLayoutDeletion}"
                                            Padding="16,8"/>
                                    <Button Content="Delete"
                                            Command="{Binding ConfirmLayoutDeletion}"
                                            Background="#D9534F"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            Padding="16,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Edit Sector Modal Overlay -->
                    <Border Grid.Row="0" Grid.RowSpan="5"
                            Background="#80000000"
                            IsVisible="{Binding IsEditingSector}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Border Background="#252526"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Width="780"
                                MaxHeight="850"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BoxShadow="0 4 20 #80000000">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="{Binding EditingSectorTitle}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"/>

                                    <!-- General Settings Section -->
                                    <Border Background="#1E1E1E"
                                            BorderBrush="#3E3E42"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="General"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF"/>

                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="Artifact Amount Multiplier:"
                                                           ToolTip.Tip="Multiplier for the number of artifacts to spawn in this sector. If your sector is very small, this value should be low."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,8"
                                                           Foreground="#CCCCCC"/>
                                                <TextBox Grid.Row="0" Grid.Column="1"
                                                         Text="{Binding EditingSectorSettings.ArtifactAmountMultiplier, Mode=TwoWay}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,0,8"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0"
                                                           Text="Zone Alias Start:"
                                                           ToolTip.Tip="The starting zone number of this sector."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <TextBox Grid.Row="1" Grid.Column="1"
                                                         Text="{Binding EditingSectorSettings.ZoneAliasStart, Mode=TwoWay}"
                                                         VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Bulkhead Keys Section -->
                                    <Border Background="#1E1E1E"
                                            BorderBrush="#3E3E42"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Bulkhead Keys"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="#FFFFFF"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                    <Button Content="+ Add Bulkhead Key"
                                                            Command="{Binding AddBulkheadKey}"
                                                            Background="#3E3E42"
                                                            Foreground="White"
                                                            Padding="8,4"
                                                            FontSize="12"/>
                                                    <Button Content="- Remove Key"
                                                            Command="{Binding RemoveBulkheadKey}"
                                                            IsEnabled="{Binding HasSelectedBulkheadKeyPlacement}"
                                                            Background="#3E3E42"
                                                            Foreground="White"
                                                            Padding="8,4"
                                                            FontSize="12"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Bulkhead Key Placements List -->
                                            <ListBox ItemsSource="{Binding EditingSectorSettings.BulkheadKeyPlacements}"
                                                     SelectedItem="{Binding SelectedBulkheadKeyPlacement, Mode=TwoWay}"
                                                     Height="90"
                                                     Background="#181818"
                                                     BorderBrush="#333333"
                                                     BorderThickness="1"
                                                     CornerRadius="4">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:GatherItemPlacement">
                                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <!-- Selected Bulkhead Key Placement Details -->
                                            <StackPanel Spacing="10" IsVisible="{Binding HasSelectedBulkheadKeyPlacement}">
                                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                    <StackPanel Spacing="10">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="Candidate Zones (Key will spawn in a random zone from this list)"
                                                                       FontWeight="Bold"
                                                                       FontSize="12"
                                                                       Foreground="#FFFFFF"
                                                                       VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                <Button Content="+ Add Candidate Zone"
                                                                        Command="{Binding AddBulkheadKeyCandidateZone}"
                                                                        Background="#3E3E42"
                                                                        Foreground="White"
                                                                        Padding="6,3"
                                                                        FontSize="11"/>
                                                                <Button Content="- Remove Zone"
                                                                        Command="{Binding RemoveBulkheadKeyCandidateZone}"
                                                                        IsEnabled="{Binding HasSelectedBulkheadKeyCandidateZonePlacement}"
                                                                        Background="#3E3E42"
                                                                        Foreground="White"
                                                                        Padding="6,3"
                                                                        FontSize="11"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Candidate Zones List -->
                                                        <ListBox ItemsSource="{Binding SelectedBulkheadKeyPlacement.CandidateZones}"
                                                                 SelectedItem="{Binding SelectedBulkheadKeyCandidateZonePlacement, Mode=TwoWay}"
                                                                 Height="75"
                                                                 Background="#141414"
                                                                 BorderBrush="#2A2A2A"
                                                                 BorderThickness="1"
                                                                 CornerRadius="4">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:CandidateZonePlacement">
                                                                    <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center" FontSize="12"/>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>

                                                        <!-- Selected Candidate Zone Details -->
                                                        <StackPanel Spacing="8" IsVisible="{Binding HasSelectedBulkheadKeyCandidateZonePlacement}">
                                                            <!-- Dimension & Zone Selection -->
                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="Dimension:"
                                                                           ToolTip.Tip="The dimension of this candidate zone"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,8,0"
                                                                           Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Column="1"
                                                                          ItemsSource="{Binding AvailableDimensions}"
                                                                          SelectedItem="{Binding SelectedBulkheadKeyCandidateDimensionOption, Mode=TwoWay}"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,14,0">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:DimensionOption">
                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="Zone:"
                                                                           ToolTip.Tip="The candidate zone"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,8,0"
                                                                           Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Column="3"
                                                                          ItemsSource="{Binding AvailableObjectiveZones}"
                                                                          SelectedItem="{Binding SelectedBulkheadKeyCandidateZoneOption, Mode=TwoWay}"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:ZoneOption">
                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </Grid>

                                                            <!-- Placement Weights -->
                                                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="Start:"
                                                                           ToolTip.Tip="Weight for start of zone."
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"
                                                                           Foreground="#AAAAAA"/>
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding SelectedBulkheadKeyCandidateZonePlacement.PlacementStartWeight, Mode=TwoWay}"
                                                                         Margin="0,0,10,0"/>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="Middle:"
                                                                           ToolTip.Tip="Weight for middle of zone."
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"
                                                                           Foreground="#AAAAAA"/>
                                                                <TextBox Grid.Column="3"
                                                                         Text="{Binding SelectedBulkheadKeyCandidateZonePlacement.PlacementMiddleWeight, Mode=TwoWay}"
                                                                         Margin="0,0,10,0"/>

                                                                <TextBlock Grid.Column="4"
                                                                           Text="End:"
                                                                           ToolTip.Tip="Weight for end of zone."
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"
                                                                           Foreground="#AAAAAA"/>
                                                                <TextBox Grid.Column="5"
                                                                         Text="{Binding SelectedBulkheadKeyCandidateZonePlacement.PlacementEndWeight, Mode=TwoWay}"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Objective Settings Section -->
                                    <Border Background="#1E1E1E"
                                            BorderBrush="#3E3E42"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Objective"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF"/>

                                            <!-- Main Sector Objectives List (Chained Objectives) -->
                                            <StackPanel Spacing="8" IsVisible="{Binding IsMainSector}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="Objectives"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FFFFFF"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                        <Button Content="+ Add Objective"
                                                                Command="{Binding AddObjective}"
                                                                Background="#3E3E42"
                                                                Foreground="White"
                                                                Padding="8,4"
                                                                FontSize="12"/>
                                                        <Button Content="- Remove Objective"
                                                                Command="{Binding RemoveObjective}"
                                                                IsEnabled="{Binding CanRemoveObjective}"
                                                                Background="#3E3E42"
                                                                Foreground="White"
                                                                Padding="8,4"
                                                                FontSize="12"/>
                                                    </StackPanel>
                                                </Grid>

                                                <ListBox ItemsSource="{Binding EditingSectorSettings.Objectives}"
                                                         SelectedItem="{Binding ActiveEditingObjective, Mode=TwoWay}"
                                                         Height="90"
                                                         Background="#181818"
                                                         BorderBrush="#333333"
                                                         BorderThickness="1"
                                                         CornerRadius="4">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:WardenObjective">
                                                            <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>

                                            <!-- Win Condition -->
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Win Condition:"
                                                           ToolTip.Tip="After the objective is completed, determines where the players must exit from."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableWinConditions}"
                                                          SelectedItem="{Binding SelectedSectorWinCondition, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Exit Zone Selector (Visible when WinCondition is GoToExitGeo) -->
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto"
                                                  IsVisible="{Binding IsExitGeoWinCondition}">
                                                <TextBlock Grid.Column="0"
                                                           Text="Exit Zone (Main Sector):"
                                                           ToolTip.Tip="Select the zone that has your exit elevator shaft."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableMainExitZones}"
                                                          SelectedItem="{Binding SelectedExitZoneOption, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ZoneOption">
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>

                                            <!-- Waves on Go To Win (Collapsible) -->
                                            <Expander Background="#252526"
                                                      BorderBrush="#3E3E42"
                                                      BorderThickness="1"
                                                      CornerRadius="4"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch">
                                                <Expander.Header>
                                                    <TextBlock Text="Waves on Go To Win"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="#FFA200"/>
                                                </Expander.Header>
                                                <StackPanel Spacing="10" Margin="0,10,0,0">
                                                    <!-- Wave Roles (Enemy Selection) -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="Wave Roles (Enemy Selection)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                            <TextBlock Text="Select which enemies will spawn for each wave role." Foreground="Gray" FontSize="11"/>

                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Weakling:" ToolTip.Tip="The 'weakling' type enemy for this alarm. This enemy will cost 0.75 points to spawn, with a total points soft cap of 25. Many vanilla alarms opt to filter this out by excluding it in the population filter, instead using the standard and special slots for their small enemies as they cost 1 point instead of 0.75." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Row="0" Grid.Column="1"
                                                                          ItemsSource="{Binding Enemies}"
                                                                          SelectedValue="{Binding ActiveEditingObjective.WavesOnGotoWin.WaveRoleWeakling, Mode=TwoWay}"
                                                                          SelectedValueBinding="{Binding PersistentId}"
                                                                          HorizontalAlignment="Stretch"
                                                                          Margin="0,0,14,8">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:EnemyEntry">
                                                                            <TextBlock Text="{Binding DisplayText}"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>

                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Standard:" ToolTip.Tip="The 'standard' type enemy for this alarm. This enemy will cost 1 point to spawn, with a total points soft cap of 25. Generally, this is going to be your strikers/shooters." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Row="0" Grid.Column="3"
                                                                          ItemsSource="{Binding Enemies}"
                                                                          SelectedValue="{Binding ActiveEditingObjective.WavesOnGotoWin.WaveRoleStandard, Mode=TwoWay}"
                                                                          SelectedValueBinding="{Binding PersistentId}"
                                                                          HorizontalAlignment="Stretch"
                                                                          Margin="0,0,0,8">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:EnemyEntry">
                                                                            <TextBlock Text="{Binding DisplayText}"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>

                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Special:" ToolTip.Tip="The 'special' type enemy for this alarm. This enemy will cost 1 point to spawn, with a total points soft cap of 25. Generally, this is going to be your strikers/shooters." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Row="1" Grid.Column="1"
                                                                          ItemsSource="{Binding Enemies}"
                                                                          SelectedValue="{Binding ActiveEditingObjective.WavesOnGotoWin.WaveRoleSpecial, Mode=TwoWay}"
                                                                          SelectedValueBinding="{Binding PersistentId}"
                                                                          HorizontalAlignment="Stretch"
                                                                          Margin="0,0,14,8">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:EnemyEntry">
                                                                            <TextBlock Text="{Binding DisplayText}"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>

                                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Mini-Boss:" ToolTip.Tip="The 'miniboss' type enemy for this alarm. This enemy will cost 2 points to spawn, with a total points soft cap of 25. Generally, this is going to be your hybrids/giants. Do not put something like a Tank in here; lest you fight an army." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Row="1" Grid.Column="3"
                                                                          ItemsSource="{Binding Enemies}"
                                                                          SelectedValue="{Binding ActiveEditingObjective.WavesOnGotoWin.WaveRoleMiniBoss, Mode=TwoWay}"
                                                                          SelectedValueBinding="{Binding PersistentId}"
                                                                          HorizontalAlignment="Stretch"
                                                                          Margin="0,0,0,8">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:EnemyEntry">
                                                                            <TextBlock Text="{Binding DisplayText}"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>

                                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Boss:" ToolTip.Tip="The 'boss' type enemy for this alarm. This enemy will cost 2 points to spawn, with a total points soft cap of 25. Generally, this is going to be your hybrids/giants. Do not put something like a Tank in here; lest you fight an army. NOTE: THIS ENEMY TYPE IS BROKEN IN VANILLA." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Row="2" Grid.Column="1"
                                                                          ItemsSource="{Binding Enemies}"
                                                                          SelectedValue="{Binding ActiveEditingObjective.WavesOnGotoWin.WaveRoleBoss, Mode=TwoWay}"
                                                                          SelectedValueBinding="{Binding PersistentId}"
                                                                          HorizontalAlignment="Stretch"
                                                                          Margin="0,0,14,0">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:EnemyEntry">
                                                                            <TextBlock Text="{Binding DisplayText}"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Wave Timing & Pauses -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="Wave Timing &amp; Pauses" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Pause Before Start (s):" ToolTip.Tip="Pause in seconds before the wave begins." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ActiveEditingObjective.WavesOnGotoWin.PauseBeforeStart, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Pause Between Groups (s):" ToolTip.Tip="Pause in seconds between enemy group spawns." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ActiveEditingObjective.WavesOnGotoWin.PauseBetweenGroups, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Wave Pause Min (at Cost):" ToolTip.Tip="Minimum wave pause duration at max cost/ramp." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ActiveEditingObjective.WavesOnGotoWin.WavePauseMin_AtCost, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Wave Pause Max (at Cost):" ToolTip.Tip="Maximum wave pause duration at max cost/ramp." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ActiveEditingObjective.WavesOnGotoWin.WavePauseMax_AtCost, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Wave Pause Min (s):" ToolTip.Tip="Minimum duration to pause between waves." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ActiveEditingObjective.WavesOnGotoWin.WavePauseMin, Mode=TwoWay}" Margin="0,0,14,0"/>

                                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Wave Pause Max (s):" ToolTip.Tip="Maximum duration to pause between waves." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ActiveEditingObjective.WavesOnGotoWin.WavePauseMax, Mode=TwoWay}" Margin="0,0,0,0"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Population Filter -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="Population Filter" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" Margin="0,4,0,0">
                                                                <TextBlock Grid.Column="0" Text="Filter Type:" ToolTip.Tip="Include: ONLY selected roles spawn. Exclude: Selected roles DO NOT spawn." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Column="1"
                                                                          ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableFilterTypes}"
                                                                          SelectedItem="{Binding ActiveEditingObjective.WavesOnGotoWin.FilterType, Mode=TwoWay}"
                                                                          HorizontalAlignment="Stretch"/>
                                                            </Grid>

                                                            <TextBlock Text="Filter Roles:" Margin="0,6,0,2" Foreground="#CCCCCC" FontSize="12"/>
                                                            <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <CheckBox Content="Weakling" IsChecked="{Binding ActiveEditingObjective.WavesOnGotoWin.FilterWeakling, Mode=TwoWay}" Margin="0,0,12,4"/>
                                                                <CheckBox Content="Standard" IsChecked="{Binding ActiveEditingObjective.WavesOnGotoWin.FilterStandard, Mode=TwoWay}" Margin="0,0,12,4"/>
                                                                <CheckBox Content="Special" IsChecked="{Binding ActiveEditingObjective.WavesOnGotoWin.FilterSpecial, Mode=TwoWay}" Margin="0,0,12,4"/>
                                                                <CheckBox Content="Mini-Boss" IsChecked="{Binding ActiveEditingObjective.WavesOnGotoWin.FilterMiniBoss, Mode=TwoWay}" Margin="0,0,12,4"/>
                                                                <CheckBox Content="Boss" IsChecked="{Binding ActiveEditingObjective.WavesOnGotoWin.FilterBoss, Mode=TwoWay}" Margin="0,0,12,4"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Spawn Direction & Type -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="Spawn Direction &amp; Type" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Randomize Direction / Wave:" ToolTip.Tip="0-1 chance for the spawn direction to change between waves." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ActiveEditingObjective.WavesOnGotoWin.ChanceToRandomizeSpawnDirectionPerWave, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Randomize Direction / Group:" ToolTip.Tip="0-1 chance for the spawn direction to change between groups." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ActiveEditingObjective.WavesOnGotoWin.ChanceToRandomizeSpawnDirectionPerGroup, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Override Spawn Type:" ToolTip.Tip="True if the spawn type should be overridden." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding ActiveEditingObjective.WavesOnGotoWin.OverrideWaveSpawnType, Mode=TwoWay}" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Wave Spawn Type:" ToolTip.Tip="Affects how the enemies spawn. Only does anything if Override Spawn Type is true." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Row="1" Grid.Column="3"
                                                                          ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableWaveSpawnTypes}"
                                                                          SelectedItem="{Binding ActiveEditingObjective.WavesOnGotoWin.SurvivalWaveSpawnType, Mode=TwoWay}"
                                                                          HorizontalAlignment="Stretch"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Population Points & Ramp -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="Population Points &amp; Ramp" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Population Points Total:" ToolTip.Tip="The total population points for waves. -1 is infinite." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ActiveEditingObjective.WavesOnGotoWin.PopulationPointsTotal, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Population Ramp Over Time (s):" ToolTip.Tip="Lerp over time for start-end population point settings." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ActiveEditingObjective.WavesOnGotoWin.PopulationRampOverTime, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Points Per Wave (Start):" ToolTip.Tip="Population points for a wave at start ramp." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ActiveEditingObjective.WavesOnGotoWin.PopulationPointsPerWaveStart, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Points Per Wave (End):" ToolTip.Tip="Population points for a wave at end ramp." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ActiveEditingObjective.WavesOnGotoWin.PopulationPointsPerWaveEnd, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Points Per Group (Start):" ToolTip.Tip="Population points for a group at start ramp." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ActiveEditingObjective.WavesOnGotoWin.PopulationPointsPerGroupStart, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Points Per Group (End):" ToolTip.Tip="Population points for a group at end ramp." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ActiveEditingObjective.WavesOnGotoWin.PopulationPointsPerGroupEnd, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Min Points Per Group:" ToolTip.Tip="Minimum required cost for a group to spawn." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ActiveEditingObjective.WavesOnGotoWin.PopulationPointsMinPerGroup, Mode=TwoWay}" Margin="0,0,14,0"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Expander>

                                            <!-- WaveOnGoToWinTrigger -->
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Wave On Go To Win Trigger:"
                                                           ToolTip.Tip="Trigger condition for when go to win waves begin."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableWaveOnGotoWinTriggers}"
                                                          SelectedItem="{Binding ActiveEditingObjective.WaveOnGotoWinTrigger, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- StopAllWavesBeforeGoToWin -->
                                            <CheckBox Content="Stop All Waves Before Go To Win"
                                                      ToolTip.Tip="Stop all active waves when Go To Win phase begins."
                                                      IsChecked="{Binding ActiveEditingObjective.StopAllWavesBeforeGotoWin, Mode=TwoWay}"
                                                      Foreground="#CCCCCC"/>

                                            <!-- Waves on Elevator Land (Collapsible, ONLY AVAILABLE FOR MAIN OBJECTIVE) -->
                                            <Expander Background="#252526"
                                                      BorderBrush="#3E3E42"
                                                      BorderThickness="1"
                                                      CornerRadius="4"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch"
                                                      IsVisible="{Binding IsMainSector}">
                                                <Expander.Header>
                                                    <TextBlock Text="Waves on Elevator Land"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="#FFA200"/>
                                                </Expander.Header>
                                                <StackPanel Spacing="10" Margin="0,10,0,0">
                                                    <!-- Wave Roles (Enemy Selection) -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="Wave Roles (Enemy Selection)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                            <TextBlock Text="Select which enemies will spawn for each wave role." Foreground="Gray" FontSize="11"/>

                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Weakling:" ToolTip.Tip="The 'weakling' type enemy for this alarm. This enemy will cost 0.75 points to spawn, with a total points soft cap of 25. Many vanilla alarms opt to filter this out by excluding it in the population filter, instead using the standard and special slots for their small enemies as they cost 1 point instead of 0.75." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Row="0" Grid.Column="1"
                                                                          ItemsSource="{Binding Enemies}"
                                                                          SelectedValue="{Binding ActiveEditingObjective.WavesOnElevatorLand.WaveRoleWeakling, Mode=TwoWay}"
                                                                          SelectedValueBinding="{Binding PersistentId}"
                                                                          HorizontalAlignment="Stretch"
                                                                          Margin="0,0,14,8">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:EnemyEntry">
                                                                            <TextBlock Text="{Binding DisplayText}"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>

                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Standard:" ToolTip.Tip="The 'standard' type enemy for this alarm. This enemy will cost 1 point to spawn, with a total points soft cap of 25. Generally, this is going to be your strikers/shooters." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Row="0" Grid.Column="3"
                                                                          ItemsSource="{Binding Enemies}"
                                                                          SelectedValue="{Binding ActiveEditingObjective.WavesOnElevatorLand.WaveRoleStandard, Mode=TwoWay}"
                                                                          SelectedValueBinding="{Binding PersistentId}"
                                                                          HorizontalAlignment="Stretch"
                                                                          Margin="0,0,0,8">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:EnemyEntry">
                                                                            <TextBlock Text="{Binding DisplayText}"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>

                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Special:" ToolTip.Tip="The 'special' type enemy for this alarm. This enemy will cost 1 point to spawn, with a total points soft cap of 25. Generally, this is going to be your strikers/shooters." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Row="1" Grid.Column="1"
                                                                          ItemsSource="{Binding Enemies}"
                                                                          SelectedValue="{Binding ActiveEditingObjective.WavesOnElevatorLand.WaveRoleSpecial, Mode=TwoWay}"
                                                                          SelectedValueBinding="{Binding PersistentId}"
                                                                          HorizontalAlignment="Stretch"
                                                                          Margin="0,0,14,8">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:EnemyEntry">
                                                                            <TextBlock Text="{Binding DisplayText}"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>

                                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Mini-Boss:" ToolTip.Tip="The 'miniboss' type enemy for this alarm. This enemy will cost 2 points to spawn, with a total points soft cap of 25. Generally, this is going to be your hybrids/giants. Do not put something like a Tank in here; lest you fight an army." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Row="1" Grid.Column="3"
                                                                          ItemsSource="{Binding Enemies}"
                                                                          SelectedValue="{Binding ActiveEditingObjective.WavesOnElevatorLand.WaveRoleMiniBoss, Mode=TwoWay}"
                                                                          SelectedValueBinding="{Binding PersistentId}"
                                                                          HorizontalAlignment="Stretch"
                                                                          Margin="0,0,0,8">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:EnemyEntry">
                                                                            <TextBlock Text="{Binding DisplayText}"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>

                                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Boss:" ToolTip.Tip="The 'boss' type enemy for this alarm. This enemy will cost 2 points to spawn, with a total points soft cap of 25. Generally, this is going to be your hybrids/giants. Do not put something like a Tank in here; lest you fight an army. NOTE: THIS ENEMY TYPE IS BROKEN IN VANILLA." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Row="2" Grid.Column="1"
                                                                          ItemsSource="{Binding Enemies}"
                                                                          SelectedValue="{Binding ActiveEditingObjective.WavesOnElevatorLand.WaveRoleBoss, Mode=TwoWay}"
                                                                          SelectedValueBinding="{Binding PersistentId}"
                                                                          HorizontalAlignment="Stretch"
                                                                          Margin="0,0,14,0">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:EnemyEntry">
                                                                            <TextBlock Text="{Binding DisplayText}"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Wave Timing & Pauses -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="Wave Timing &amp; Pauses" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Pause Before Start (s):" ToolTip.Tip="Pause in seconds before the wave begins." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ActiveEditingObjective.WavesOnElevatorLand.PauseBeforeStart, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Pause Between Groups (s):" ToolTip.Tip="Pause in seconds between enemy group spawns." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ActiveEditingObjective.WavesOnElevatorLand.PauseBetweenGroups, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Wave Pause Min (at Cost):" ToolTip.Tip="Minimum wave pause duration at max cost/ramp." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ActiveEditingObjective.WavesOnElevatorLand.WavePauseMin_AtCost, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Wave Pause Max (at Cost):" ToolTip.Tip="Maximum wave pause duration at max cost/ramp." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ActiveEditingObjective.WavesOnElevatorLand.WavePauseMax_AtCost, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Wave Pause Min (s):" ToolTip.Tip="Minimum duration to pause between waves." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ActiveEditingObjective.WavesOnElevatorLand.WavePauseMin, Mode=TwoWay}" Margin="0,0,14,0"/>

                                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Wave Pause Max (s):" ToolTip.Tip="Maximum duration to pause between waves." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ActiveEditingObjective.WavesOnElevatorLand.WavePauseMax, Mode=TwoWay}" Margin="0,0,0,0"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Population Filter -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="Population Filter" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" Margin="0,4,0,0">
                                                                <TextBlock Grid.Column="0" Text="Filter Type:" ToolTip.Tip="Include: ONLY selected roles spawn. Exclude: Selected roles DO NOT spawn." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Column="1"
                                                                          ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableFilterTypes}"
                                                                          SelectedItem="{Binding ActiveEditingObjective.WavesOnElevatorLand.FilterType, Mode=TwoWay}"
                                                                          HorizontalAlignment="Stretch"/>
                                                            </Grid>

                                                            <TextBlock Text="Filter Roles:" Margin="0,6,0,2" Foreground="#CCCCCC" FontSize="12"/>
                                                            <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <CheckBox Content="Weakling" IsChecked="{Binding ActiveEditingObjective.WavesOnElevatorLand.FilterWeakling, Mode=TwoWay}" Margin="0,0,12,4"/>
                                                                <CheckBox Content="Standard" IsChecked="{Binding ActiveEditingObjective.WavesOnElevatorLand.FilterStandard, Mode=TwoWay}" Margin="0,0,12,4"/>
                                                                <CheckBox Content="Special" IsChecked="{Binding ActiveEditingObjective.WavesOnElevatorLand.FilterSpecial, Mode=TwoWay}" Margin="0,0,12,4"/>
                                                                <CheckBox Content="Mini-Boss" IsChecked="{Binding ActiveEditingObjective.WavesOnElevatorLand.FilterMiniBoss, Mode=TwoWay}" Margin="0,0,12,4"/>
                                                                <CheckBox Content="Boss" IsChecked="{Binding ActiveEditingObjective.WavesOnElevatorLand.FilterBoss, Mode=TwoWay}" Margin="0,0,12,4"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Spawn Direction & Type -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="Spawn Direction &amp; Type" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Randomize Direction / Wave:" ToolTip.Tip="0-1 chance for the spawn direction to change between waves." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ActiveEditingObjective.WavesOnElevatorLand.ChanceToRandomizeSpawnDirectionPerWave, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Randomize Direction / Group:" ToolTip.Tip="0-1 chance for the spawn direction to change between groups." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ActiveEditingObjective.WavesOnElevatorLand.ChanceToRandomizeSpawnDirectionPerGroup, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Override Spawn Type:" ToolTip.Tip="True if the spawn type should be overridden." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding ActiveEditingObjective.WavesOnElevatorLand.OverrideWaveSpawnType, Mode=TwoWay}" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Wave Spawn Type:" ToolTip.Tip="Affects how the enemies spawn." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Row="1" Grid.Column="3"
                                                                          ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableWaveSpawnTypes}"
                                                                          SelectedItem="{Binding ActiveEditingObjective.WavesOnElevatorLand.SurvivalWaveSpawnType, Mode=TwoWay}"
                                                                          HorizontalAlignment="Stretch"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Population Points & Ramp -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="Population Points &amp; Ramp" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Population Points Total:" ToolTip.Tip="The total population points for waves. -1 is infinite." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ActiveEditingObjective.WavesOnElevatorLand.PopulationPointsTotal, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Population Ramp Over Time (s):" ToolTip.Tip="Lerp over time for start-end population point settings." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ActiveEditingObjective.WavesOnElevatorLand.PopulationRampOverTime, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Points Per Wave (Start):" ToolTip.Tip="Population points for a wave at start ramp." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ActiveEditingObjective.WavesOnElevatorLand.PopulationPointsPerWaveStart, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Points Per Wave (End):" ToolTip.Tip="Population points for a wave at end ramp." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ActiveEditingObjective.WavesOnElevatorLand.PopulationPointsPerWaveEnd, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Points Per Group (Start):" ToolTip.Tip="Population points for a group at start ramp." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ActiveEditingObjective.WavesOnElevatorLand.PopulationPointsPerGroupStart, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Points Per Group (End):" ToolTip.Tip="Population points for a group at end ramp." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ActiveEditingObjective.WavesOnElevatorLand.PopulationPointsPerGroupEnd, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Min Points Per Group:" ToolTip.Tip="Minimum required cost for a group to spawn." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ActiveEditingObjective.WavesOnElevatorLand.PopulationPointsMinPerGroup, Mode=TwoWay}" Margin="0,0,14,0"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Expander>

                                            <!-- EventsOnElevatorLand (Collapsible, ONLY AVAILABLE FOR MAIN OBJECTIVE) -->
                                            <Expander Background="#1E1E1E"
                                                      BorderBrush="#3E3E42"
                                                      BorderThickness="1"
                                                      CornerRadius="6"
                                                      HorizontalAlignment="Stretch"
                                                      IsVisible="{Binding IsMainSector}">
                                                <Expander.Header>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="Events On Elevator Land" FontWeight="SemiBold" FontSize="13" ToolTip.Tip="Events to trigger as soon as the players are ejected from the elevator" Foreground="#03C700" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="+ Add Event" Command="{Binding AddEventOnElevatorLand}" Background="#2D5A27" Foreground="White" Padding="10,4" Margin="0,0,10,0"/>
                                                    </Grid>
                                                </Expander.Header>
                                                <StackPanel Spacing="8" Margin="0,8,0,0">
                                                    <ItemsControl ItemsSource="{Binding ActiveEditingObjective.EventsOnElevatorLand}"
                                                                  ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                                </StackPanel>
                                            </Expander>

                                            <!-- FogTransitionDataOnGotoWin -->
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Fog Transition On Go To Win:"
                                                           ToolTip.Tip="The fog setting to transition to when the Go To Win phase starts."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableFogTransitionOptions}"
                                                          SelectedValue="{Binding ActiveEditingObjective.FogTransitionDataOnGotoWin, Mode=TwoWay}"
                                                          SelectedValueBinding="{Binding PersistentId}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:FogTransitionOption">
                                                            <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>

                                            <!-- FogTransitionDataOnGotoWinDuration -->
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Fog Transition Duration On Go To Win:"
                                                           ToolTip.Tip="How long it will take for the fog to fully transition to the given fog setting."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding ActiveEditingObjective.FogTransitionDataOnGotoWinDuration, Mode=TwoWay}"
                                                         VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- EventsOnGotoWin -->
                                            <Expander Background="#1E1E1E"
                                                      BorderBrush="#3E3E42"
                                                      BorderThickness="1"
                                                      CornerRadius="6"
                                                      HorizontalAlignment="Stretch">
                                                <Expander.Header>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="Events On Goto Win" FontWeight="SemiBold" FontSize="13" ToolTip.Tip="Events to trigger as soon as the 'Goto Win' phase exists." Foreground="#03C700" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="+ Add Event" Command="{Binding AddEventOnGotoWin}" Background="#2D5A27" Foreground="White" Padding="10,4" Margin="0,0,10,0"/>
                                                    </Grid>
                                                </Expander.Header>
                                                <StackPanel Spacing="8" Margin="0,8,0,0">
                                                    <ItemsControl ItemsSource="{Binding ActiveEditingObjective.EventsOnGotoWin}"
                                                                  ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                                </StackPanel>
                                            </Expander>

                                            <!-- EventsOnActivate -->
                                            <Expander Background="#1E1E1E"
                                                      BorderBrush="#3E3E42"
                                                      BorderThickness="1"
                                                      CornerRadius="6"
                                                      HorizontalAlignment="Stretch">
                                                <Expander.Header>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="Events On Activate" FontWeight="SemiBold" FontSize="13" ToolTip.Tip="Events to trigger when the objective is 'activated'. This means different things based on the objective type" Foreground="#03C700" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="+ Add Event" Command="{Binding AddEventOnActivate}" Background="#2D5A27" Foreground="White" Padding="10,4" Margin="0,0,10,0"/>
                                                    </Grid>
                                                </Expander.Header>
                                                <StackPanel Spacing="8" Margin="0,8,0,0">
                                                    <ItemsControl ItemsSource="{Binding ActiveEditingObjective.EventsOnActivate}"
                                                                  ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>

                                    <!-- Objective Type Section -->
                                    <Border Background="#1E1E1E"
                                            BorderBrush="#3E3E42"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Objective Type"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF"/>

                                            <!-- Objective Type -->
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Objective Type:"
                                                           ToolTip.Tip="The type of objective this sector has."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableObjectiveTypes}"
                                                          SelectedItem="{Binding SelectedSectorObjectiveType, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- HSU Find Take Sample Objective Config -->
                                            <Border BorderBrush="#2D2D2D"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10"
                                                    IsVisible="{Binding IsHsuObjective}">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="HSU Placement Settings"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="#FFA200"/>

                                                    <!-- HSU Spawn Zone -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Spawn Zone:"
                                                                   ToolTip.Tip="The zone to spawn the HSU in."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding AvailableObjectiveZones}"
                                                                  SelectedItem="{Binding SelectedHsuPlacementZoneOption, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:ZoneOption">
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>

                                                    <!-- Weights: Start, Middle, End -->
                                                    <TextBlock Text="Placement Weights:"
                                                               ToolTip.Tip="Weights for where inside the zone the HSU should spawn. Leave as all 0s for random."
                                                               FontSize="11"
                                                               Foreground="#AAAAAA"
                                                               Margin="0,4,0,0"/>

                                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Start:"
                                                                   ToolTip.Tip="Weight for the start of the zone."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0"
                                                                   Foreground="#AAAAAA"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding ActiveEditingObjective.HsuPlacementStartWeight, Mode=TwoWay}"
                                                                 Margin="0,0,10,0"/>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="Middle:"
                                                                   ToolTip.Tip="Weight for the middle of the zone."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0"
                                                                   Foreground="#AAAAAA"/>
                                                        <TextBox Grid.Column="3"
                                                                 Text="{Binding ActiveEditingObjective.HsuPlacementMiddleWeight, Mode=TwoWay}"
                                                                 Margin="0,0,10,0"/>

                                                        <TextBlock Grid.Column="4"
                                                                   Text="End:"
                                                                   ToolTip.Tip="Weight for the end of the zone."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0"
                                                                   Foreground="#AAAAAA"/>
                                                        <TextBox Grid.Column="5"
                                                                 Text="{Binding ActiveEditingObjective.HsuPlacementEndWeight, Mode=TwoWay}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Reactor Startup Objective Config -->
                                            <Border BorderBrush="#2D2D2D"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10"
                                                    IsVisible="{Binding IsReactorObjective}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Reactor Startup Settings"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="#FFA200"/>

                                                    <!-- Reactor Zone -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Reactor Zone:"
                                                                   ToolTip.Tip="The zone that the reactor is located in."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding AvailableObjectiveZones}"
                                                                  SelectedItem="{Binding SelectedReactorPlacementZoneOption, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:ZoneOption">
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>

                                                    <!-- Do Not Solve Objective On Reactor Complete -->
                                                    <CheckBox Content="Do Not Solve Objective On Reactor Complete"
                                                              ToolTip.Tip="If true, completing the reactor sequence will not mark the objective as solved."
                                                              IsChecked="{Binding ActiveEditingObjective.DoNotSolveObjectiveOnReactorComplete, Mode=TwoWay}"
                                                              Margin="0,0,0,4"/>

                                                    <!-- Stages Header & Toolbar -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="10">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="Startup Sequence Stages" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                    <Button Content="+ Add Stage"
                                                                            Command="{Binding AddReactorStage}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                    <Button Content="- Remove"
                                                                            Command="{Binding RemoveReactorStage}"
                                                                            IsEnabled="{Binding HasSelectedReactorStage}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                    <Button Content="▲ Move Up"
                                                                            Command="{Binding MoveReactorStageUp}"
                                                                            IsEnabled="{Binding HasSelectedReactorStage}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                    <Button Content="▼ Move Down"
                                                                            Command="{Binding MoveReactorStageDown}"
                                                                            IsEnabled="{Binding HasSelectedReactorStage}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                    <Button Content="Copy"
                                                                            Command="{Binding CopyReactorStage}"
                                                                            IsEnabled="{Binding HasSelectedReactorStage}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                    <Button Content="Paste"
                                                                            Command="{Binding PasteReactorStage}"
                                                                            IsEnabled="{Binding HasCopiedReactorStage}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Stage Selector List -->
                                                            <ListBox ItemsSource="{Binding ActiveEditingObjective.ReactorStartupStages}"
                                                                     SelectedItem="{Binding SelectedReactorStage, Mode=TwoWay}"
                                                                     Height="110"
                                                                     Background="#181818"
                                                                     BorderBrush="#333333"
                                                                     BorderThickness="1"
                                                                     CornerRadius="4">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:ReactorStartupStage">
                                                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>

                                                            <!-- Selected Stage Details -->
                                                            <StackPanel Spacing="10" IsVisible="{Binding HasSelectedReactorStage}">
                                                                <!-- Stage Timing -->
                                                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                                    <StackPanel Spacing="8">
                                                                        <TextBlock Text="Stage Timing" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                                                            <!-- Row 0: Warmup, WarmupFail, Wave -->
                                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Warmup (s):" ToolTip.Tip="Warmup duration in seconds before waves begin." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedReactorStage.Warmup, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Warmup Fail (s):" ToolTip.Tip="Warmup duration after this stage has already been failed before." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SelectedReactorStage.WarmupFail, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Wave (s):" ToolTip.Tip="Wave defense duration in seconds. Note waves can still spawn after the timer if they have not all been killed." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding SelectedReactorStage.Wave, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                            <!-- Row 1: Verify, VerifyFail -->
                                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Verify (s):" ToolTip.Tip="Verification duration in seconds to enter code." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedReactorStage.Verify, Mode=TwoWay}" Margin="0,0,14,0"/>

                                                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Verify Fail (s):" ToolTip.Tip="Verify duration in seconds to enter code after this stage has already been failed before." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedReactorStage.VerifyFail, Mode=TwoWay}" Margin="0,0,14,0"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Verify in Other Zone -->
                                                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                                    <StackPanel Spacing="8">
                                                                        <TextBlock Text="Verification Zone" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                                                            <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                                                      Content="Verify In Other Zone"
                                                                                      ToolTip.Tip="Whether the verification code is found in a terminal in a different zone."
                                                                                      IsChecked="{Binding SelectedReactorStage.VerifyInOtherZone, Mode=TwoWay}"
                                                                                      Margin="0,0,0,8"/>

                                                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                                                       Text="Verification Zone:"
                                                                                       ToolTip.Tip="The zone where the verification terminal is located."
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="0,0,12,0"
                                                                                       Foreground="#CCCCCC"
                                                                                       IsVisible="{Binding SelectedReactorStage.VerifyInOtherZone}"/>
                                                                            <ComboBox Grid.Row="1" Grid.Column="1"
                                                                                      ItemsSource="{Binding AvailableObjectiveZones}"
                                                                                      SelectedItem="{Binding SelectedStageVerificationZoneOption, Mode=TwoWay}"
                                                                                      HorizontalAlignment="Stretch"
                                                                                      VerticalAlignment="Center"
                                                                                      IsVisible="{Binding SelectedReactorStage.VerifyInOtherZone}">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:ZoneOption">
                                                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Wave Roles (Enemy Selection) -->
                                                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                                    <StackPanel Spacing="8">
                                                                        <TextBlock Text="Wave Roles (Enemy Selection)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                                        <TextBlock Text="Select which enemies will spawn for each wave role." Foreground="Gray" FontSize="11"/>

                                                                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                                                            <!-- Row 0: Weakling & Standard -->
                                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Weakling:" ToolTip.Tip="The 'weakling' type enemy for this alarm. This enemy will cost 0.75 points to spawn, with a total points soft cap of 25. Many vanilla alarms opt to filter this out by excluding it in the population filter, instead using the standard and special slots for their small enemies as they cost 1 point instead of 0.75." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <ComboBox Grid.Row="0" Grid.Column="1"
                                                                                      ItemsSource="{Binding Enemies}"
                                                                                      SelectedValue="{Binding SelectedReactorStage.WaveRoleWeakling, Mode=TwoWay}"
                                                                                      SelectedValueBinding="{Binding PersistentId}"
                                                                                      HorizontalAlignment="Stretch"
                                                                                      Margin="0,0,14,8">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:EnemyEntry">
                                                                                        <TextBlock Text="{Binding DisplayText}"/>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>

                                                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Standard:" ToolTip.Tip="The 'standard' type enemy for this alarm. This enemy will cost 1 point to spawn, with a total points soft cap of 25. Generally, this is going to be your strikers/shooters." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <ComboBox Grid.Row="0" Grid.Column="3"
                                                                                      ItemsSource="{Binding Enemies}"
                                                                                      SelectedValue="{Binding SelectedReactorStage.WaveRoleStandard, Mode=TwoWay}"
                                                                                      SelectedValueBinding="{Binding PersistentId}"
                                                                                      HorizontalAlignment="Stretch"
                                                                                      Margin="0,0,0,8">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:EnemyEntry">
                                                                                        <TextBlock Text="{Binding DisplayText}"/>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>

                                                                            <!-- Row 1: Special & MiniBoss -->
                                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Special:" ToolTip.Tip="The 'special' type enemy for this alarm. This enemy will cost 1 point to spawn, with a total points soft cap of 25. Generally, this is going to be your strikers/shooters." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <ComboBox Grid.Row="1" Grid.Column="1"
                                                                                      ItemsSource="{Binding Enemies}"
                                                                                      SelectedValue="{Binding SelectedReactorStage.WaveRoleSpecial, Mode=TwoWay}"
                                                                                      SelectedValueBinding="{Binding PersistentId}"
                                                                                      HorizontalAlignment="Stretch"
                                                                                      Margin="0,0,14,8">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:EnemyEntry">
                                                                                        <TextBlock Text="{Binding DisplayText}"/>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>

                                                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="MiniBoss:" ToolTip.Tip="The 'miniboss' type enemy for this alarm. This enemy will cost 2 points to spawn, with a total points soft cap of 25. Generally, this is going to be your hybrids/giants. Do not put something like a Tank in here; lest you fight an army." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <ComboBox Grid.Row="1" Grid.Column="3"
                                                                                      ItemsSource="{Binding Enemies}"
                                                                                      SelectedValue="{Binding SelectedReactorStage.WaveRoleMiniBoss, Mode=TwoWay}"
                                                                                      SelectedValueBinding="{Binding PersistentId}"
                                                                                      HorizontalAlignment="Stretch"
                                                                                      Margin="0,0,0,8">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:EnemyEntry">
                                                                                        <TextBlock Text="{Binding DisplayText}"/>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>

                                                                            <!-- Row 2: Boss -->
                                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Boss:" ToolTip.Tip="The 'boss' type enemy for this alarm. This enemy will cost 2 points to spawn, with a total points soft cap of 25. Generally, this is going to be your hybrids/giants. Do not put something like a Tank in here; lest you fight an army. NOTE: THIS ENEMY TYPE IS BROKEN IN VANILLA." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                            <ComboBox Grid.Row="2" Grid.Column="1"
                                                                                      ItemsSource="{Binding Enemies}"
                                                                                      SelectedValue="{Binding SelectedReactorStage.WaveRoleBoss, Mode=TwoWay}"
                                                                                      SelectedValueBinding="{Binding PersistentId}"
                                                                                      HorizontalAlignment="Stretch"
                                                                                      Margin="0,0,14,0">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:EnemyEntry">
                                                                                        <TextBlock Text="{Binding DisplayText}"/>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Wave Timing & Pauses -->
                                                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                                    <StackPanel Spacing="8">
                                                                        <TextBlock Text="Wave Timing &amp; Pauses" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                                                            <!-- Row 0: Pause Before Start & Pause Between Groups -->
                                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pause Before Start (s):" ToolTip.Tip="How many seconds to wait between the alarm starting and the first wave spawning." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedReactorStage.PauseBeforeStart, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Pause Between Groups (s):" ToolTip.Tip="Delay between spawning enemy groups." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SelectedReactorStage.PauseBetweenGroups, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                            <!-- Row 1: Wave Pause Min & Max -->
                                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Wave Pause Min (s):" ToolTip.Tip="Delay between waves at or below the minimum score boundary." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedReactorStage.WavePauseMin, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Wave Pause Max (s):" ToolTip.Tip="Delay between waves at the maximum score boundary." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedReactorStage.WavePauseMax, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                            <!-- Row 2: Wave Pause Min at Cost & Wave Pause Max at Cost -->
                                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Wave Pause Min at Cost:" ToolTip.Tip="Minimum score boundary for pauses between waves. Below this threshold, the timer for a new wave will decrease at its maximum speed." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedReactorStage.WavePauseMin_AtCost, Mode=TwoWay}" Margin="0,0,14,0"/>

                                                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Wave Pause Max at Cost:" ToolTip.Tip="Maximum score boundary for pauses between waves. Above this threshold, the timer for a new wave does not move. Anywhere in-between min and max, the timer is lerped." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding SelectedReactorStage.WavePauseMax_AtCost, Mode=TwoWay}"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Population Filter -->
                                                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                                    <StackPanel Spacing="8">
                                                                        <TextBlock Text="Population Filter" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto" Margin="0,4,0,0">
                                                                            <TextBlock Grid.Column="0" Text="Filter Type:" ToolTip.Tip="The selected types below will be either the only enemies spawned, or will be excluded entirely, based on this value." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                            <ComboBox Grid.Column="1"
                                                                                      ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableFilterTypes}"
                                                                                      SelectedItem="{Binding SelectedReactorStage.FilterType, Mode=TwoWay}"
                                                                                      HorizontalAlignment="Stretch"
                                                                                      Margin="0,0,14,0"/>
                                                                        </Grid>

                                                                        <StackPanel Spacing="6" Margin="0,4,0,0">
                                                                            <TextBlock Text="Filter Modes:" ToolTip.Tip="Select the types to include/exclude from spawning." VerticalAlignment="Center" Foreground="#CCCCCC"/>
                                                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                                                <CheckBox Content="Weakling" ToolTip.Tip="True if the weakling type should be included in the filter." IsChecked="{Binding SelectedReactorStage.FilterWeakling, Mode=TwoWay}"/>
                                                                                <CheckBox Content="Standard" ToolTip.Tip="True if the standard type should be included in the filter." IsChecked="{Binding SelectedReactorStage.FilterStandard, Mode=TwoWay}"/>
                                                                                <CheckBox Content="Special" ToolTip.Tip="True if the special type should be included in the filter." IsChecked="{Binding SelectedReactorStage.FilterSpecial, Mode=TwoWay}"/>
                                                                                <CheckBox Content="MiniBoss" ToolTip.Tip="True if the miniboss type should be included in the filter." IsChecked="{Binding SelectedReactorStage.FilterMiniBoss, Mode=TwoWay}"/>
                                                                                <CheckBox Content="Boss" ToolTip.Tip="True if the boss type should be included in the filter." IsChecked="{Binding SelectedReactorStage.FilterBoss, Mode=TwoWay}"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Spawn Direction & Spawn Type -->
                                                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                                    <StackPanel Spacing="8">
                                                                        <TextBlock Text="Spawn Direction &amp; Type" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                                                            <!-- Row 0: Direction Randomization -->
                                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Randomize Direction / Wave:" ToolTip.Tip="0-1 chance for the spawn direction to change between waves." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedReactorStage.ChanceToRandomizeSpawnDirectionPerWave, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Randomize Direction / Group:" ToolTip.Tip="0-1 chance for the spawn direction to change between groups." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SelectedReactorStage.ChanceToRandomizeSpawnDirectionPerGroup, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                            <!-- Row 1: Override Spawn Type & Survival Wave Spawn Type -->
                                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Override Spawn Type:" ToolTip.Tip="True if the spawn type should be overriden. This must be true for the Wave Spawn Type value to be functional." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding SelectedReactorStage.OverrideWaveSpawnType, Mode=TwoWay}" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Wave Spawn Type:" ToolTip.Tip="Affects how the enemies spawn." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                            <ComboBox Grid.Row="1" Grid.Column="3"
                                                                                      ItemsSource="{x:Static vm:LevelLayoutViewModel.AvailableWaveSpawnTypes}"
                                                                                      SelectedItem="{Binding SelectedReactorStage.SurvivalWaveSpawnType, Mode=TwoWay}"
                                                                                      HorizontalAlignment="Stretch"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Population Points & Ramp -->
                                                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                                    <StackPanel Spacing="8">
                                                                        <TextBlock Text="Population Points &amp; Ramp" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                                                                            <!-- Row 0: Total Points & Ramp Time -->
                                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Population Points Total:" ToolTip.Tip="The total population points for waves. The alarm automatically stops if this runs out. -1 is infinite." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedReactorStage.PopulationPointsTotal, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Population Ramp Over Time (s):" ToolTip.Tip="Lerp over time for start-end population point settings." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SelectedReactorStage.PopulationRampOverTime, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                            <!-- Row 1: Wave Points Start & End -->
                                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Points Per Wave (Start):" ToolTip.Tip="Population points for a wave at start ramp." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedReactorStage.PopulationPointsPerWaveStart, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Points Per Wave (End):" ToolTip.Tip="Population points for a wave at end ramp." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedReactorStage.PopulationPointsPerWaveEnd, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                            <!-- Row 2: Group Points Start & End -->
                                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Points Per Group (Start):" ToolTip.Tip="Population points for a group at start ramp." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedReactorStage.PopulationPointsPerGroupStart, Mode=TwoWay}" Margin="0,0,14,8"/>

                                                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Points Per Group (End):" ToolTip.Tip="Population points for a group at end ramp." VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding SelectedReactorStage.PopulationPointsPerGroupEnd, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                            <!-- Row 3: Min Points Per Group -->
                                                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Min Points Per Group:" ToolTip.Tip="Minimum required cost for a group to spawn." VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CCCCCC"/>
                                                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedReactorStage.PopulationPointsMinPerGroup, Mode=TwoWay}" Margin="0,0,14,0"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Reactor Shutdown Objective Config -->
                                            <Border BorderBrush="#2D2D2D"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10"
                                                    IsVisible="{Binding IsReactorShutdownObjective}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Reactor Shutdown Settings"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="#FFA200"/>

                                                    <!-- Reactor Zone -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Reactor Zone:"
                                                                   ToolTip.Tip="The zone that the reactor is located in."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding AvailableObjectiveZones}"
                                                                  SelectedItem="{Binding SelectedReactorPlacementZoneOption, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:ZoneOption">
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>

                                                    <!-- Alarm Before Shutdown -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Alarm Before Shutdown:"
                                                                   ToolTip.Tip="Scan triggered when the shutdown command is entered. You'll likely want this to be a team scan with no enemies."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding AvailableAlarms}"
                                                                  SelectedItem="{Binding SelectedAlarmBeforeShutdownOption, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:AlarmBlock">
                                                                    <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>

                                                    <!-- Alarm After Shutdown -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Alarm After Shutdown:"
                                                                   ToolTip.Tip="Main alarm during the reactor shutdown sequence."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding AvailableAlarms}"
                                                                  SelectedItem="{Binding SelectedAlarmAfterShutdownOption, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:AlarmBlock">
                                                                    <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>

                                                    <!-- Do Not Solve Objective On Reactor Complete -->
                                                    <CheckBox Content="Do Not Solve Objective On Reactor Complete"
                                                              ToolTip.Tip="If true, completing the reactor sequence will not mark the objective as solved."
                                                              IsChecked="{Binding ActiveEditingObjective.DoNotSolveObjectiveOnReactorComplete, Mode=TwoWay}"
                                                              Margin="0,0,0,4"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Gather Small Items Objective Config -->
                                            <Border BorderBrush="#2D2D2D"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10"
                                                    IsVisible="{Binding IsGatherSmallItemsObjective}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Gather Small Items Settings"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="#FFA200"/>

                                                    <!-- Item to Gather Selection -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Item to Gather:"
                                                                   ToolTip.Tip="The item that needs to be picked up for this objective."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding AvailableGatherSmallItemOptions}"
                                                                  SelectedItem="{Binding SelectedGatherSmallItemOption, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:GatherSmallItemOption">
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>

                                                    <!-- Spawn Count & Placements Header & Toolbar -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="10">
                                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                                                                    <TextBlock Text="Items to Spawn:"
                                                                               ToolTip.Tip="The number of items to spawn for this objective."
                                                                               VerticalAlignment="Center"
                                                                               Foreground="#CCCCCC"/>
                                                                    <TextBox Text="{Binding GatherSpawnCount, Mode=TwoWay}"
                                                                             Width="55"
                                                                             VerticalAlignment="Center"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <TextBlock Text="Max Items Per Zone:"
                                                                               ToolTip.Tip="Maximum number of items that can exist in any single zone."
                                                                               VerticalAlignment="Center"
                                                                               Foreground="#CCCCCC"/>
                                                                    <TextBox Text="{Binding GatherMaxPerZone, Mode=TwoWay}"
                                                                             Width="55"
                                                                             VerticalAlignment="Center"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                                                    <Button Content="+ Add Item"
                                                                            Command="{Binding AddGatherItemPlacement}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                    <Button Content="- Remove"
                                                                            Command="{Binding RemoveGatherItemPlacement}"
                                                                            IsEnabled="{Binding HasSelectedGatherItemPlacement}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Item Placements List -->
                                                            <ListBox ItemsSource="{Binding ActiveEditingObjective.GatherItemPlacements}"
                                                                     SelectedItem="{Binding SelectedGatherItemPlacement, Mode=TwoWay}"
                                                                     Height="90"
                                                                     Background="#181818"
                                                                     BorderBrush="#333333"
                                                                     BorderThickness="1"
                                                                     CornerRadius="4">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:GatherItemPlacement">
                                                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>

                                                            <!-- Selected Item Placement Details -->
                                                            <StackPanel Spacing="10" IsVisible="{Binding HasSelectedGatherItemPlacement}">
                                                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                                    <StackPanel Spacing="10">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock Grid.Column="0" Text="Candidate Zones (Item will spawn in a random zone from this list)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                                <Button Content="+ Add Candidate Zone"
                                                                                        Command="{Binding AddGatherCandidateZone}"
                                                                                        Background="#3E3E42" Foreground="White" Padding="6,3" FontSize="11"/>
                                                                                <Button Content="- Remove Zone"
                                                                                        Command="{Binding RemoveGatherCandidateZone}"
                                                                                        IsEnabled="{Binding HasSelectedGatherCandidateZonePlacement}"
                                                                                        Background="#3E3E42" Foreground="White" Padding="6,3" FontSize="11"/>
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <!-- Candidate Zones List -->
                                                                        <ListBox ItemsSource="{Binding SelectedGatherItemPlacement.CandidateZones}"
                                                                                 SelectedItem="{Binding SelectedGatherCandidateZonePlacement, Mode=TwoWay}"
                                                                                 Height="75"
                                                                                 Background="#141414"
                                                                                 BorderBrush="#2A2A2A"
                                                                                 BorderThickness="1"
                                                                                 CornerRadius="4">
                                                                            <ListBox.ItemTemplate>
                                                                                <DataTemplate x:DataType="models:CandidateZonePlacement">
                                                                                    <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center" FontSize="12"/>
                                                                                </DataTemplate>
                                                                            </ListBox.ItemTemplate>
                                                                        </ListBox>

                                                                        <!-- Selected Candidate Zone Details -->
                                                                        <StackPanel Spacing="8" IsVisible="{Binding HasSelectedGatherCandidateZonePlacement}">
                                                                            <!-- Dimension & Zone Selection -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="Dimension:"
                                                                                           ToolTip.Tip="The dimension that this candidate zone is in."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0"
                                                                                           Foreground="#CCCCCC"/>
                                                                                <ComboBox Grid.Column="1"
                                                                                          ItemsSource="{Binding AvailableDimensions}"
                                                                                          SelectedItem="{Binding SelectedGatherCandidateDimensionOption, Mode=TwoWay}"
                                                                                          HorizontalAlignment="Stretch"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="0,0,14,0">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:DimensionOption">
                                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>

                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="Zone:"
                                                                                           ToolTip.Tip="The candidate zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0"
                                                                                           Foreground="#CCCCCC"/>
                                                                                <ComboBox Grid.Column="3"
                                                                                          ItemsSource="{Binding AvailableObjectiveZones}"
                                                                                          SelectedItem="{Binding SelectedGatherCandidateZoneOption, Mode=TwoWay}"
                                                                                          HorizontalAlignment="Stretch"
                                                                                          VerticalAlignment="Center">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:ZoneOption">
                                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                            </Grid>

                                                                            <!-- Placement Weights -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto">
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="Start:"
                                                                                           ToolTip.Tip="Placement weight for the start of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="1"
                                                                                         Text="{Binding SelectedGatherCandidateZonePlacement.PlacementStartWeight, Mode=TwoWay}"
                                                                                         Margin="0,0,10,0"/>

                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="Middle:"
                                                                                           ToolTip.Tip="Placement weight for the middle of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="3"
                                                                                         Text="{Binding SelectedGatherCandidateZonePlacement.PlacementMiddleWeight, Mode=TwoWay}"
                                                                                         Margin="0,0,10,0"/>

                                                                                <TextBlock Grid.Column="4"
                                                                                           Text="End:"
                                                                                           ToolTip.Tip="Placement weight for the end of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="5"
                                                                                         Text="{Binding SelectedGatherCandidateZonePlacement.PlacementEndWeight, Mode=TwoWay}"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Special Terminal Command Objective Config -->
                                            <Border BorderBrush="#2D2D2D"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10"
                                                    IsVisible="{Binding IsSpecialTerminalCommandObjective}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Special Terminal Command Settings"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="#FFA200"/>

                                                    <!-- Terminal Zone -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Terminal Zone:"
                                                                   ToolTip.Tip="The zone where the terminal is located."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding AvailableObjectiveZones}"
                                                                  SelectedItem="{Binding SelectedSpecialTerminalCommandZoneOption, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:ZoneOption">
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>

                                                    <!-- Command -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Command:"
                                                                   ToolTip.Tip="The special command to enter into the terminal."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding ActiveEditingObjective.SpecialTerminalCommand, Mode=TwoWay}"
                                                                 HorizontalAlignment="Stretch"
                                                                 VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <!-- Command Description -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Command Description:"
                                                                   ToolTip.Tip="Description of the special terminal command."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding ActiveEditingObjective.SpecialTerminalCommandDesc, Mode=TwoWay}"
                                                                 HorizontalAlignment="Stretch"
                                                                 VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <!-- Post-Command Output -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Post-Command Output:"
                                                                   ToolTip.Tip="Text displayed in the terminal after running the command."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding ActiveEditingObjective.PostCommandOutput, Mode=TwoWay}"
                                                                 HorizontalAlignment="Stretch"
                                                                 VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <!-- Special Command Rule -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Special Command Rule:"
                                                                   ToolTip.Tip="Execution rule for the special command (Normal, OnlyOnce, OnlyOnceDelete)."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding AvailableSpecialCommandRules}"
                                                                  SelectedItem="{Binding SelectedSpecialCommandRule, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Retrieve Big Items Objective Config -->
                                            <Border BorderBrush="#2D2D2D"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10"
                                                    IsVisible="{Binding IsRetrieveBigItemsObjective}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Retrieve Big Items Settings"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="#FFA200"/>

                                                    <!-- Item to Retrieve Selection -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Item to Retrieve:"
                                                                   ToolTip.Tip="The big item that needs to be retrieved for this objective."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding AvailableRetrieveBigItemOptions}"
                                                                  SelectedItem="{Binding SelectedRetrieveBigItemOption, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:RetrieveBigItemOption">
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>

                                                    <!-- Spawn Count & Placements Header & Toolbar -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="10">
                                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                                                                    <TextBlock Text="Items to Spawn:"
                                                                               ToolTip.Tip="The number of big items to spawn for this objective."
                                                                               VerticalAlignment="Center"
                                                                               Foreground="#CCCCCC"/>
                                                                    <TextBox Text="{Binding RetrieveSpawnCount, Mode=TwoWay}"
                                                                             Width="55"
                                                                             VerticalAlignment="Center"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <TextBlock Text="Max Items Per Zone:"
                                                                               ToolTip.Tip="Maximum number of items that can exist in any single zone."
                                                                               VerticalAlignment="Center"
                                                                               Foreground="#CCCCCC"/>
                                                                    <TextBox Text="{Binding RetrieveMaxPerZone, Mode=TwoWay}"
                                                                             Width="55"
                                                                             VerticalAlignment="Center"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                                                    <Button Content="+ Add Item"
                                                                            Command="{Binding AddRetrieveItemPlacement}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                    <Button Content="- Remove"
                                                                            Command="{Binding RemoveRetrieveItemPlacement}"
                                                                            IsEnabled="{Binding HasSelectedRetrieveItemPlacement}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Item Placements List -->
                                                            <ListBox ItemsSource="{Binding ActiveEditingObjective.RetrieveItemPlacements}"
                                                                     SelectedItem="{Binding SelectedRetrieveItemPlacement, Mode=TwoWay}"
                                                                     Height="90"
                                                                     Background="#181818"
                                                                     BorderBrush="#333333"
                                                                     BorderThickness="1"
                                                                     CornerRadius="4">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:GatherItemPlacement">
                                                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>

                                                            <!-- Selected Item Placement Details -->
                                                            <StackPanel Spacing="10" IsVisible="{Binding HasSelectedRetrieveItemPlacement}">
                                                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                                    <StackPanel Spacing="10">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock Grid.Column="0" Text="Candidate Zones (Item will spawn in a random zone from this list)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                                <Button Content="+ Add Candidate Zone"
                                                                                        Command="{Binding AddRetrieveCandidateZone}"
                                                                                        Background="#3E3E42" Foreground="White" Padding="6,3" FontSize="11"/>
                                                                                <Button Content="- Remove Zone"
                                                                                        Command="{Binding RemoveRetrieveCandidateZone}"
                                                                                        IsEnabled="{Binding HasSelectedRetrieveCandidateZonePlacement}"
                                                                                        Background="#3E3E42" Foreground="White" Padding="6,3" FontSize="11"/>
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <!-- Candidate Zones List -->
                                                                        <ListBox ItemsSource="{Binding SelectedRetrieveItemPlacement.CandidateZones}"
                                                                                 SelectedItem="{Binding SelectedRetrieveCandidateZonePlacement, Mode=TwoWay}"
                                                                                 Height="75"
                                                                                 Background="#141414"
                                                                                 BorderBrush="#2A2A2A"
                                                                                 BorderThickness="1"
                                                                                 CornerRadius="4">
                                                                            <ListBox.ItemTemplate>
                                                                                <DataTemplate x:DataType="models:CandidateZonePlacement">
                                                                                    <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center" FontSize="12"/>
                                                                                </DataTemplate>
                                                                            </ListBox.ItemTemplate>
                                                                        </ListBox>

                                                                        <!-- Selected Candidate Zone Details -->
                                                                        <StackPanel Spacing="8" IsVisible="{Binding HasSelectedRetrieveCandidateZonePlacement}">
                                                                            <!-- Dimension & Zone Selection -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="Dimension:"
                                                                                           ToolTip.Tip="The dimension that this candidate zone is in."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0"
                                                                                           Foreground="#CCCCCC"/>
                                                                                <ComboBox Grid.Column="1"
                                                                                          ItemsSource="{Binding AvailableDimensions}"
                                                                                          SelectedItem="{Binding SelectedRetrieveCandidateDimensionOption, Mode=TwoWay}"
                                                                                          HorizontalAlignment="Stretch"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="0,0,14,0">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:DimensionOption">
                                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>

                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="Zone:"
                                                                                           ToolTip.Tip="The candidate zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0"
                                                                                           Foreground="#CCCCCC"/>
                                                                                <ComboBox Grid.Column="3"
                                                                                          ItemsSource="{Binding AvailableObjectiveZones}"
                                                                                          SelectedItem="{Binding SelectedRetrieveCandidateZoneOption, Mode=TwoWay}"
                                                                                          HorizontalAlignment="Stretch"
                                                                                          VerticalAlignment="Center">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:ZoneOption">
                                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                            </Grid>

                                                                            <!-- Placement Weights -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto">
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="Start:"
                                                                                           ToolTip.Tip="Placement weight for the start of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="1"
                                                                                         Text="{Binding SelectedRetrieveCandidateZonePlacement.PlacementStartWeight, Mode=TwoWay}"
                                                                                         Margin="0,0,10,0"/>

                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="Middle:"
                                                                                           ToolTip.Tip="Placement weight for the middle of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="3"
                                                                                         Text="{Binding SelectedRetrieveCandidateZonePlacement.PlacementMiddleWeight, Mode=TwoWay}"
                                                                                         Margin="0,0,10,0"/>

                                                                                <TextBlock Grid.Column="4"
                                                                                           Text="End:"
                                                                                           ToolTip.Tip="Placement weight for the end of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="5"
                                                                                         Text="{Binding SelectedRetrieveCandidateZonePlacement.PlacementEndWeight, Mode=TwoWay}"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Distribute Power Cells Objective Config -->
                                            <Border BorderBrush="#2D2D2D"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10"
                                                    IsVisible="{Binding IsDistributePowerCellsObjective}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Distribute Power Cells Settings"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="#FFA200"/>

                                                    <!-- Generator Count & Placements Header & Toolbar -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="10">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <TextBlock Text="Generators to Power:"
                                                                               ToolTip.Tip="The number of generators to power with cells."
                                                                               VerticalAlignment="Center"
                                                                               Foreground="#CCCCCC"/>
                                                                    <TextBox Text="{Binding DistributeGeneratorCount, Mode=TwoWay}"
                                                                             Width="60"
                                                                             VerticalAlignment="Center"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                                    <Button Content="+ Add Generator"
                                                                            Command="{Binding AddDistributeGeneratorPlacement}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                    <Button Content="- Remove"
                                                                            Command="{Binding RemoveDistributeGeneratorPlacement}"
                                                                            IsEnabled="{Binding HasSelectedDistributeGeneratorPlacement}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Generator Placements List -->
                                                            <ListBox ItemsSource="{Binding ActiveEditingObjective.DistributeGeneratorPlacements}"
                                                                     SelectedItem="{Binding SelectedDistributeGeneratorPlacement, Mode=TwoWay}"
                                                                     Height="100"
                                                                     Background="#181818"
                                                                     BorderBrush="#333333"
                                                                     BorderThickness="1"
                                                                     CornerRadius="4">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:DistributeGeneratorPlacement">
                                                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>

                                                            <!-- Selected Generator Details -->
                                                            <StackPanel Spacing="10" IsVisible="{Binding HasSelectedDistributeGeneratorPlacement}">
                                                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                                    <StackPanel Spacing="10">
                                                                        <TextBlock Text="Generator Configuration" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="Generator Zone:"
                                                                                       ToolTip.Tip="The zone where this generator is placed."
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="0,0,12,0"
                                                                                       Foreground="#CCCCCC"/>
                                                                            <ComboBox Grid.Column="1"
                                                                                      ItemsSource="{Binding AvailableObjectiveZones}"
                                                                                      SelectedItem="{Binding SelectedDistributeGeneratorPlacementZoneOption, Mode=TwoWay}"
                                                                                      HorizontalAlignment="Stretch"
                                                                                      VerticalAlignment="Center">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:ZoneOption">
                                                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Terminal Uplink Objective Config -->
                                            <Border BorderBrush="#2D2D2D"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10"
                                                    IsVisible="{Binding IsTerminalUplinkObjective}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Terminal Uplink Settings"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="#FFA200"/>

                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="Number of Terminals:"
                                                                       ToolTip.Tip="The number of uplink terminals that need to be completed."
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"
                                                                       Foreground="#CCCCCC"/>
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding UplinkNumberOfTerminals, Mode=TwoWay}"
                                                                     Margin="0,0,14,0"/>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="Verification Rounds:"
                                                                       ToolTip.Tip="Single verification rounds value for all uplink terminals."
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"
                                                                       Foreground="#CCCCCC"/>
                                                            <TextBox Grid.Column="3"
                                                                     Text="{Binding UplinkNumberOfVerificationRounds, Mode=TwoWay}"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Terminal Placements Toolbar & List -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="10">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="Terminal Placements" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                    <Button Content="+ Add Terminal"
                                                                            Command="{Binding AddTerminalUplinkPlacement}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                    <Button Content="- Remove"
                                                                            Command="{Binding RemoveTerminalUplinkPlacement}"
                                                                            IsEnabled="{Binding HasSelectedTerminalUplinkPlacement}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <ListBox ItemsSource="{Binding ActiveEditingObjective.TerminalUplinkPlacements}"
                                                                     SelectedItem="{Binding SelectedTerminalUplinkPlacement, Mode=TwoWay}"
                                                                     Height="100"
                                                                     Background="#181818"
                                                                     BorderBrush="#333333"
                                                                     BorderThickness="1"
                                                                     CornerRadius="4">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:GatherItemPlacement">
                                                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>

                                                            <!-- Selected Terminal Candidate Zones -->
                                                            <StackPanel Spacing="10" IsVisible="{Binding HasSelectedTerminalUplinkPlacement}">
                                                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                                    <StackPanel Spacing="10">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock Grid.Column="0" Text="Candidate Zones (Terminal will spawn in a random zone from this list)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                                <Button Content="+ Add Candidate Zone"
                                                                                        Command="{Binding AddTerminalUplinkCandidateZone}"
                                                                                        Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                                <Button Content="- Remove"
                                                                                        Command="{Binding RemoveTerminalUplinkCandidateZone}"
                                                                                        IsEnabled="{Binding HasSelectedTerminalUplinkCandidateZonePlacement}"
                                                                                        Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <ListBox ItemsSource="{Binding SelectedTerminalUplinkPlacement.CandidateZones}"
                                                                                 SelectedItem="{Binding SelectedTerminalUplinkCandidateZonePlacement, Mode=TwoWay}"
                                                                                 Height="80"
                                                                                 Background="#181818"
                                                                                 BorderBrush="#333333"
                                                                                 BorderThickness="1"
                                                                                 CornerRadius="4">
                                                                            <ListBox.ItemTemplate>
                                                                                <DataTemplate x:DataType="models:CandidateZonePlacement">
                                                                                    <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                                                </DataTemplate>
                                                                            </ListBox.ItemTemplate>
                                                                        </ListBox>

                                                                        <StackPanel Spacing="8" IsVisible="{Binding HasSelectedTerminalUplinkCandidateZonePlacement}">
                                                                            <!-- Candidate Dimension & Zone Selection -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="Dimension:"
                                                                                           ToolTip.Tip="The dimension for this candidate zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0"
                                                                                           Foreground="#CCCCCC"/>
                                                                                <ComboBox Grid.Column="1"
                                                                                          ItemsSource="{Binding AvailableDimensions}"
                                                                                          SelectedItem="{Binding SelectedTerminalUplinkCandidateDimensionOption, Mode=TwoWay}"
                                                                                          HorizontalAlignment="Stretch"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="0,0,14,0">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:DimensionOption">
                                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>

                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="Zone:"
                                                                                           ToolTip.Tip="The zone where the terminal can spawn."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0"
                                                                                           Foreground="#CCCCCC"/>
                                                                                <ComboBox Grid.Column="3"
                                                                                          ItemsSource="{Binding AvailableObjectiveZones}"
                                                                                          SelectedItem="{Binding SelectedTerminalUplinkCandidateZoneOption, Mode=TwoWay}"
                                                                                          HorizontalAlignment="Stretch"
                                                                                          VerticalAlignment="Center">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:ZoneOption">
                                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                            </Grid>

                                                                            <!-- Placement Weights -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto">
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="Start:"
                                                                                           ToolTip.Tip="Placement weight for the start of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="1"
                                                                                         Text="{Binding SelectedTerminalUplinkCandidateZonePlacement.PlacementStartWeight, Mode=TwoWay}"
                                                                                         Margin="0,0,10,0"/>

                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="Middle:"
                                                                                           ToolTip.Tip="Placement weight for the middle of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="3"
                                                                                         Text="{Binding SelectedTerminalUplinkCandidateZonePlacement.PlacementMiddleWeight, Mode=TwoWay}"
                                                                                         Margin="0,0,10,0"/>

                                                                                <TextBlock Grid.Column="4"
                                                                                           Text="End:"
                                                                                           ToolTip.Tip="Placement weight for the end of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="5"
                                                                                         Text="{Binding SelectedTerminalUplinkCandidateZonePlacement.PlacementEndWeight, Mode=TwoWay}"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Central Generator Cluster Objective Config -->
                                            <Border BorderBrush="#2D2D2D"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10"
                                                    IsVisible="{Binding IsCentralGeneratorClusterObjective}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Central Generator Cluster Settings"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="#FFA200"/>

                                                    <!-- Generator Cluster Zone & Generator Count -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="Cluster Zone:"
                                                                       ToolTip.Tip="The zone where the central generator cluster is located."
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"
                                                                       Foreground="#CCCCCC"/>
                                                            <ComboBox Grid.Column="1"
                                                                      ItemsSource="{Binding AvailableObjectiveZones}"
                                                                      SelectedItem="{Binding SelectedCentralGeneratorClusterZoneOption, Mode=TwoWay}"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,14,0">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:ZoneOption">
                                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="Generator Count:"
                                                                       ToolTip.Tip="How many generators are in the central cluster (determines required fog stages)."
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"
                                                                       Foreground="#CCCCCC"/>
                                                            <TextBox Grid.Column="3"
                                                                     Text="{Binding CentralGeneratorClusterGeneratorCount, Mode=TwoWay}"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Fog Transition Stages List & Editor -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock Text="Fog Transition Stages" ToolTip.Tip="Fog settings to transition into after each cell is used." FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                            <ListBox ItemsSource="{Binding ActiveEditingObjective.CentralGeneratorClusterFogTransitions}"
                                                                     SelectedItem="{Binding SelectedCentralGeneratorFogTransitionStage, Mode=TwoWay}"
                                                                     Height="100"
                                                                     Background="#181818"
                                                                     BorderBrush="#333333"
                                                                     BorderThickness="1"
                                                                     CornerRadius="4">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:CentralGeneratorFogTransitionStage">
                                                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>

                                                            <!-- Selected Fog Transition Stage Details -->
                                                            <StackPanel Spacing="8" IsVisible="{Binding HasSelectedCentralGeneratorFogTransitionStage}">
                                                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="Fog Setting:"
                                                                               ToolTip.Tip="Fog setting for this transition stage."
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,8,0"
                                                                               Foreground="#CCCCCC"/>
                                                                    <ComboBox Grid.Column="1"
                                                                              ItemsSource="{Binding AvailableFogTransitionOptions}"
                                                                              SelectedItem="{Binding SelectedCentralGeneratorFogTransitionOption, Mode=TwoWay}"
                                                                              HorizontalAlignment="Stretch"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,0,14,0">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:FogTransitionOption">
                                                                                <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>

                                                                    <TextBlock Grid.Column="2"
                                                                               Text="Duration (s):"
                                                                               ToolTip.Tip="Transition duration in seconds to transition into this fog setting."
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,8,0"
                                                                               Foreground="#CCCCCC"/>
                                                                    <TextBox Grid.Column="3"
                                                                             Text="{Binding SelectedCentralGeneratorFogTransitionStage.TransitionDuration, Mode=TwoWay}"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Power Cells & Placements Header & Toolbar -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="10">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <TextBlock Text="Power Cells to Spawn:"
                                                                               ToolTip.Tip="Number of power cells to spawn for the cluster."
                                                                               VerticalAlignment="Center"
                                                                               Foreground="#CCCCCC"/>
                                                                    <TextBox Text="{Binding CentralGeneratorClusterPowerCellCount, Mode=TwoWay}"
                                                                             Width="60"
                                                                             VerticalAlignment="Center"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                                    <Button Content="+ Add Power Cell"
                                                                            Command="{Binding AddCentralGeneratorPowerCellPlacement}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                    <Button Content="- Remove"
                                                                            Command="{Binding RemoveCentralGeneratorPowerCellPlacement}"
                                                                            IsEnabled="{Binding HasSelectedCentralGeneratorPowerCellPlacement}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Power Cell Placements List -->
                                                            <ListBox ItemsSource="{Binding ActiveEditingObjective.CentralGeneratorClusterPowerCellPlacements}"
                                                                     SelectedItem="{Binding SelectedCentralGeneratorPowerCellPlacement, Mode=TwoWay}"
                                                                     Height="100"
                                                                     Background="#181818"
                                                                     BorderBrush="#333333"
                                                                     BorderThickness="1"
                                                                     CornerRadius="4">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:GatherItemPlacement">
                                                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>

                                                            <!-- Selected Power Cell Candidate Zones -->
                                                            <StackPanel Spacing="10" IsVisible="{Binding HasSelectedCentralGeneratorPowerCellPlacement}">
                                                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                                    <StackPanel Spacing="10">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock Grid.Column="0" Text="Candidate Zones (Cell will spawn in a random zone from this list)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                                <Button Content="+ Add Candidate Zone"
                                                                                        Command="{Binding AddCentralGeneratorCandidateZone}"
                                                                                        Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                                <Button Content="- Remove"
                                                                                        Command="{Binding RemoveCentralGeneratorCandidateZone}"
                                                                                        IsEnabled="{Binding HasSelectedCentralGeneratorCandidateZonePlacement}"
                                                                                        Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <ListBox ItemsSource="{Binding SelectedCentralGeneratorPowerCellPlacement.CandidateZones}"
                                                                                 SelectedItem="{Binding SelectedCentralGeneratorCandidateZonePlacement, Mode=TwoWay}"
                                                                                 Height="80"
                                                                                 Background="#181818"
                                                                                 BorderBrush="#333333"
                                                                                 BorderThickness="1"
                                                                                 CornerRadius="4">
                                                                            <ListBox.ItemTemplate>
                                                                                <DataTemplate x:DataType="models:CandidateZonePlacement">
                                                                                    <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                                                </DataTemplate>
                                                                            </ListBox.ItemTemplate>
                                                                        </ListBox>

                                                                        <StackPanel Spacing="8" IsVisible="{Binding HasSelectedCentralGeneratorCandidateZonePlacement}">
                                                                            <!-- Candidate Dimension & Zone Selection -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="Dimension:"
                                                                                           ToolTip.Tip="The dimension for this candidate zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0"
                                                                                           Foreground="#CCCCCC"/>
                                                                                <ComboBox Grid.Column="1"
                                                                                          ItemsSource="{Binding AvailableDimensions}"
                                                                                          SelectedItem="{Binding SelectedCentralGeneratorCandidateDimensionOption, Mode=TwoWay}"
                                                                                          HorizontalAlignment="Stretch"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="0,0,14,0">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:DimensionOption">
                                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>

                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="Zone:"
                                                                                           ToolTip.Tip="The zone where this power cell can spawn."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0"
                                                                                           Foreground="#CCCCCC"/>
                                                                                <ComboBox Grid.Column="3"
                                                                                          ItemsSource="{Binding AvailableObjectiveZones}"
                                                                                          SelectedItem="{Binding SelectedCentralGeneratorCandidateZoneOption, Mode=TwoWay}"
                                                                                          HorizontalAlignment="Stretch"
                                                                                          VerticalAlignment="Center">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:ZoneOption">
                                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                            </Grid>

                                                                            <!-- Placement Weights -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto">
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="Start:"
                                                                                           ToolTip.Tip="Placement weight for the start of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="1"
                                                                                         Text="{Binding SelectedCentralGeneratorCandidateZonePlacement.PlacementStartWeight, Mode=TwoWay}"
                                                                                         Margin="0,0,10,0"/>

                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="Middle:"
                                                                                           ToolTip.Tip="Placement weight for the middle of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="3"
                                                                                         Text="{Binding SelectedCentralGeneratorCandidateZonePlacement.PlacementMiddleWeight, Mode=TwoWay}"
                                                                                         Margin="0,0,10,0"/>

                                                                                <TextBlock Grid.Column="4"
                                                                                           Text="End:"
                                                                                           ToolTip.Tip="Placement weight for the end of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="5"
                                                                                         Text="{Binding SelectedCentralGeneratorCandidateZonePlacement.PlacementEndWeight, Mode=TwoWay}"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Activate Small HSU Objective Config -->
                                            <Border BorderBrush="#2D2D2D"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10"
                                                    IsVisible="{Binding IsActivateSmallHsuObjective}">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="Activate Small HSU Settings"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="#FFA200"/>

                                                    <!-- Activation Zone Selection -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Activation Zone:"
                                                                   ToolTip.Tip="The zone where the item must be activated. It is up to you to make sure this zone has a compatible tile for activation."
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding AvailableObjectiveZones}"
                                                                  SelectedItem="{Binding SelectedActivateSmallHsuZoneOption, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:ZoneOption">
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>

                                                    <!-- Item From Start Selection -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Item From Start:"
                                                                   ToolTip.Tip="The item that needs to be activated"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding AvailableRetrieveBigItemOptions}"
                                                                  SelectedItem="{Binding SelectedItemFromStartOption, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:RetrieveBigItemOption">
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>

                                                    <!-- Item After Activation Selection -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Item After Activation:"
                                                                   ToolTip.Tip="The item that this will turn into after activation"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding AvailableRetrieveBigItemOptions}"
                                                                  SelectedItem="{Binding SelectedItemAfterActivationOption, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:RetrieveBigItemOption">
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>

                                                    <!-- Boolean Options -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="8">
                                                            <CheckBox Content="Bring Item In Elevator"
                                                                      ToolTip.Tip="True if the item that needs to be activated should be given to the players at the start of the level."
                                                                      IsChecked="{Binding ActiveEditingObjective.BringItemInElevator, Mode=TwoWay}"
                                                                      Foreground="#E0E0E0"/>
                                                            <CheckBox Content="Stop Enemy Waves On Activation"
                                                                      ToolTip.Tip="True if all waves should be stopped when the item is activated (as in R3D1)"
                                                                      IsChecked="{Binding ActiveEditingObjective.StopEnemyWavesOnActivation, Mode=TwoWay}"
                                                                      Foreground="#E0E0E0"/>
                                                            <CheckBox Content="Objective Complete After Insertion"
                                                                      ToolTip.Tip="True if the objective should be marked as complete after the item has been activated"
                                                                      IsChecked="{Binding ActiveEditingObjective.ObjectiveCompleteAfterInsertion, Mode=TwoWay}"
                                                                      Foreground="#E0E0E0"/>
                                                            <CheckBox Content="Require Item After Activation In Exit Scan"
                                                                      ToolTip.Tip="True if the activated item must be brought to the extraction scan"
                                                                      IsChecked="{Binding ActiveEditingObjective.RequireItemAfterActivationInExitScan, Mode=TwoWay}"
                                                                      Foreground="#E0E0E0"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- EventsOnActivation -->
                                                    <Expander Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch">
                                                        <Expander.Header>
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="Events On Activation" FontWeight="SemiBold" FontSize="13" ToolTip.Tip="Events to trigger when the objective is 'activated'. This means different things based on the objective type" Foreground="#03C700" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="1" Content="+ Add Event" Command="{Binding AddEventOnActivation}" Background="#2D5A27" Foreground="White" Padding="10,4" Margin="0,0,10,0"/>
                                                            </Grid>
                                                        </Expander.Header>
                                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                                            <ItemsControl ItemsSource="{Binding ActiveEditingObjective.EventsOnActivation}"
                                                                          ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>

                                            <!-- Survival Objective Config -->
                                            <Border BorderBrush="#2D2D2D"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10"
                                                    IsVisible="{Binding IsSurvivalObjective}">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="Survival Settings"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="#FFA200"/>

                                                    <!-- Time To Activate & Time To Survive -->
                                                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Time To Activate:"
                                                                   ToolTip.Tip="How long the 'warmup' phase should last"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding ActiveEditingObjective.TimeToActivate, Mode=TwoWay}"
                                                                 Margin="0,0,14,0"/>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="Time To Survive:"
                                                                   ToolTip.Tip="How long the 'surival' phase should last"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <TextBox Grid.Column="3"
                                                                 Text="{Binding ActiveEditingObjective.TimeToSurvive, Mode=TwoWay}"/>
                                                    </Grid>

                                                    <!-- Timer Title & Timer To Activate Title -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                                   Text="Timer Title:"
                                                                   ToolTip.Tip="The title of the timer"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,8"
                                                                   Foreground="#CCCCCC"/>
                                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                                 Text="{Binding ActiveEditingObjective.TimerTitle, Mode=TwoWay}"
                                                                 Margin="0,0,0,8"/>

                                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                                   Text="Timer To Activate Title:"
                                                                   ToolTip.Tip="The title of the timer for the 'warmup' phase"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0"
                                                                   Foreground="#CCCCCC"/>
                                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                                 Text="{Binding ActiveEditingObjective.TimerToActivateTitle, Mode=TwoWay}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Gather Terminal Objective Config -->
                                            <Border BorderBrush="#2D2D2D"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10"
                                                    IsVisible="{Binding IsGatherTerminalObjective}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Gather Terminal Settings"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="#FFA200"/>

                                                    <!-- Spawn Count, Required Count, Download Time -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="Spawn Count:"
                                                                       ToolTip.Tip="How many terminals to spawn"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"
                                                                       Foreground="#CCCCCC"/>
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding GatherTerminalSpawnCount, Mode=TwoWay}"
                                                                     Margin="0,0,14,0"/>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="Required Count:"
                                                                       ToolTip.Tip="How many terminals the players are required to complete for the objective to be completed"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"
                                                                       Foreground="#CCCCCC"/>
                                                            <TextBox Grid.Column="3"
                                                                     Text="{Binding ActiveEditingObjective.GatherTerminalRequiredCount, Mode=TwoWay}"
                                                                     Margin="0,0,14,0"/>

                                                            <TextBlock Grid.Column="4"
                                                                       Text="Download Time (s):"
                                                                       ToolTip.Tip="The time to wait for the command to complete"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"
                                                                       Foreground="#CCCCCC"/>
                                                            <TextBox Grid.Column="5"
                                                                     Text="{Binding ActiveEditingObjective.GatherTerminalDownloadTime, Mode=TwoWay}"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Command, Command Help, Downloading Text, Download Complete Text -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                                       Text="Command:"
                                                                       ToolTip.Tip="The command to run on each terminal"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,8"
                                                                       Foreground="#CCCCCC"/>
                                                            <TextBox Grid.Row="0" Grid.Column="1"
                                                                     Text="{Binding ActiveEditingObjective.GatherTerminalCommand, Mode=TwoWay}"
                                                                     Margin="0,0,14,8"/>

                                                            <TextBlock Grid.Row="0" Grid.Column="2"
                                                                       Text="Command Help:"
                                                                       ToolTip.Tip="The description of the command as shown in the 'commands' list"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,8"
                                                                       Foreground="#CCCCCC"/>
                                                            <TextBox Grid.Row="0" Grid.Column="3"
                                                                     Text="{Binding ActiveEditingObjective.GatherTerminalCommandHelp, Mode=TwoWay}"
                                                                     Margin="0,0,0,8"/>

                                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                                       Text="Downloading Text:"
                                                                       ToolTip.Tip="The text to display when the command is executing"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"
                                                                       Foreground="#CCCCCC"/>
                                                            <TextBox Grid.Row="1" Grid.Column="1"
                                                                     Text="{Binding ActiveEditingObjective.GatherTerminalDownloadingText, Mode=TwoWay}"
                                                                     Margin="0,0,14,0"/>

                                                            <TextBlock Grid.Row="1" Grid.Column="2"
                                                                       Text="Download Complete Text:"
                                                                       ToolTip.Tip="The text to display when the command has finished executing"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"
                                                                       Foreground="#CCCCCC"/>
                                                            <TextBox Grid.Row="1" Grid.Column="3"
                                                                     Text="{Binding ActiveEditingObjective.GatherTerminalDownloadCompleteText, Mode=TwoWay}"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Terminal Placements Toolbar & List -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="10">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="Terminal Placements" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                    <Button Content="+ Add Terminal"
                                                                            Command="{Binding AddGatherTerminalPlacement}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                    <Button Content="- Remove"
                                                                            Command="{Binding RemoveGatherTerminalPlacement}"
                                                                            IsEnabled="{Binding HasSelectedGatherTerminalPlacement}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <ListBox ItemsSource="{Binding ActiveEditingObjective.GatherTerminalPlacements}"
                                                                     SelectedItem="{Binding SelectedGatherTerminalPlacement, Mode=TwoWay}"
                                                                     Height="100"
                                                                     Background="#181818"
                                                                     BorderBrush="#333333"
                                                                     BorderThickness="1"
                                                                     CornerRadius="4">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:GatherItemPlacement">
                                                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>

                                                            <!-- Selected Terminal Candidate Zones -->
                                                            <StackPanel Spacing="10" IsVisible="{Binding HasSelectedGatherTerminalPlacement}">
                                                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                                    <StackPanel Spacing="10">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock Grid.Column="0" Text="Candidate Zones (Terminal will spawn in a random zone from this list)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                                <Button Content="+ Add Candidate Zone"
                                                                                        Command="{Binding AddGatherTerminalCandidateZone}"
                                                                                        Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                                <Button Content="- Remove"
                                                                                        Command="{Binding RemoveGatherTerminalCandidateZone}"
                                                                                        IsEnabled="{Binding HasSelectedGatherTerminalCandidateZonePlacement}"
                                                                                        Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <ListBox ItemsSource="{Binding SelectedGatherTerminalPlacement.CandidateZones}"
                                                                                 SelectedItem="{Binding SelectedGatherTerminalCandidateZonePlacement, Mode=TwoWay}"
                                                                                 Height="80"
                                                                                 Background="#181818"
                                                                                 BorderBrush="#333333"
                                                                                 BorderThickness="1"
                                                                                 CornerRadius="4">
                                                                            <ListBox.ItemTemplate>
                                                                                <DataTemplate x:DataType="models:CandidateZonePlacement">
                                                                                    <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                                                </DataTemplate>
                                                                            </ListBox.ItemTemplate>
                                                                        </ListBox>

                                                                        <StackPanel Spacing="8" IsVisible="{Binding HasSelectedGatherTerminalCandidateZonePlacement}">
                                                                            <!-- Candidate Dimension & Zone Selection -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="Dimension:"
                                                                                           ToolTip.Tip="The dimension for this candidate"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0"
                                                                                           Foreground="#CCCCCC"/>
                                                                                <ComboBox Grid.Column="1"
                                                                                          ItemsSource="{Binding AvailableDimensions}"
                                                                                          SelectedItem="{Binding SelectedGatherTerminalCandidateDimensionOption, Mode=TwoWay}"
                                                                                          HorizontalAlignment="Stretch"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="0,0,14,0">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:DimensionOption">
                                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>

                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="Zone:"
                                                                                           ToolTip.Tip="The zone for this candidate"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0"
                                                                                           Foreground="#CCCCCC"/>
                                                                                <ComboBox Grid.Column="3"
                                                                                          ItemsSource="{Binding AvailableObjectiveZones}"
                                                                                          SelectedItem="{Binding SelectedGatherTerminalCandidateZoneOption, Mode=TwoWay}"
                                                                                          HorizontalAlignment="Stretch"
                                                                                          VerticalAlignment="Center">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:ZoneOption">
                                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                            </Grid>

                                                                            <!-- Placement Weights -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto">
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="Start:"
                                                                                           ToolTip.Tip="Weight for the start of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="1"
                                                                                         Text="{Binding SelectedGatherTerminalCandidateZonePlacement.PlacementStartWeight, Mode=TwoWay}"
                                                                                         Margin="0,0,10,0"/>

                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="Middle:"
                                                                                           ToolTip.Tip="Weight for the middle of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="3"
                                                                                         Text="{Binding SelectedGatherTerminalCandidateZonePlacement.PlacementMiddleWeight, Mode=TwoWay}"
                                                                                         Margin="0,0,10,0"/>

                                                                                <TextBlock Grid.Column="4"
                                                                                           Text="End:"
                                                                                           ToolTip.Tip="Weight for the end of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="5"
                                                                                         Text="{Binding SelectedGatherTerminalCandidateZonePlacement.PlacementEndWeight, Mode=TwoWay}"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Timed Terminal Sequence Objective Config -->
                                            <Border BorderBrush="#2D2D2D"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10"
                                                    IsVisible="{Binding IsTimedTerminalSequenceObjective}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Timed Terminal Sequence Settings"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="#FFA200"/>

                                                    <!-- Main Terminal Location -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="Main Terminal Location" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="Dimension:"
                                                                           ToolTip.Tip="The dimension the terminal should be in"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,8,0"
                                                                           Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Column="1"
                                                                          ItemsSource="{Binding AvailableDimensions}"
                                                                          SelectedItem="{Binding SelectedTimedTerminalSequenceMainDimensionOption, Mode=TwoWay}"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,14,0">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:DimensionOption">
                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="Zone:"
                                                                           ToolTip.Tip="The zone the terminal should be in"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,8,0"
                                                                           Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Column="3"
                                                                          ItemsSource="{Binding AvailableObjectiveZones}"
                                                                          SelectedItem="{Binding SelectedTimedTerminalSequenceMainZoneOption, Mode=TwoWay}"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:ZoneOption">
                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </Grid>

                                                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="Start:"
                                                                           ToolTip.Tip="Weight for the start of the zone."
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"
                                                                           Foreground="#AAAAAA"/>
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding ActiveEditingObjective.TimedTerminalSequenceMainLocation.PlacementStartWeight, Mode=TwoWay}"
                                                                         Margin="0,0,10,0"/>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="Middle:"
                                                                           ToolTip.Tip="Weight for the middle of the zone."
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"
                                                                           Foreground="#AAAAAA"/>
                                                                <TextBox Grid.Column="3"
                                                                         Text="{Binding ActiveEditingObjective.TimedTerminalSequenceMainLocation.PlacementMiddleWeight, Mode=TwoWay}"
                                                                         Margin="0,0,10,0"/>

                                                                <TextBlock Grid.Column="4"
                                                                           Text="End:"
                                                                           ToolTip.Tip="Weight for the end of the zone."
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"
                                                                           Foreground="#AAAAAA"/>
                                                                <TextBox Grid.Column="5"
                                                                         Text="{Binding ActiveEditingObjective.TimedTerminalSequenceMainLocation.PlacementEndWeight, Mode=TwoWay}"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Sequence Configuration -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                                       Text="Number of Rounds:"
                                                                       ToolTip.Tip="The number of rounds in the timed sequence"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,8"
                                                                       Foreground="#CCCCCC"/>
                                                            <TextBox Grid.Row="0" Grid.Column="1"
                                                                     Text="{Binding ActiveEditingObjective.TimedTerminalSequenceNumberOfRounds, Mode=TwoWay}"
                                                                     Margin="0,0,14,8"/>

                                                            <TextBlock Grid.Row="0" Grid.Column="2"
                                                                       Text="Time Per Round (s):"
                                                                       ToolTip.Tip="How long the players have to get to the terminal and run the command"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,8"
                                                                       Foreground="#CCCCCC"/>
                                                            <TextBox Grid.Row="0" Grid.Column="3"
                                                                     Text="{Binding ActiveEditingObjective.TimedTerminalSequenceTimePerRound, Mode=TwoWay}"
                                                                     Margin="0,0,0,8"/>

                                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                                       Text="Time For Confirmation (s):"
                                                                       ToolTip.Tip="How long the players have to confirm at the main terminal"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,8"
                                                                       Foreground="#CCCCCC"/>
                                                            <TextBox Grid.Row="1" Grid.Column="1"
                                                                     Text="{Binding ActiveEditingObjective.TimedTerminalSequenceTimeForConfirmation, Mode=TwoWay}"
                                                                     Margin="0,0,14,8"/>

                                                            <TextBlock Grid.Row="1" Grid.Column="2"
                                                                       Text="Number of Terminals:"
                                                                       ToolTip.Tip="The number of terminals for the timed sequence to use"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,8"
                                                                       Foreground="#CCCCCC"/>
                                                            <TextBox Grid.Row="1" Grid.Column="3"
                                                                     Text="{Binding TimedTerminalSequenceNumberOfTerminals, Mode=TwoWay}"
                                                                     Margin="0,0,0,8"/>

                                                            <TextBlock Grid.Row="2" Grid.Column="0"
                                                                       Text="Source Terminal Event Filter:"
                                                                       ToolTip.Tip="Vanilla uses this to choose which terminal placement should be the main. You may want to look at the vanilla datablocks for specific uses."
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"
                                                                       Foreground="#CCCCCC"/>
                                                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                                                     Text="{Binding ActiveEditingObjective.TimedTerminalSequenceSourceTerminalWorldEventObjectFilter, Mode=TwoWay}"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Terminal Placements Toolbar & List -->
                                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                        <StackPanel Spacing="10">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="Terminal Placements" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                    <Button Content="+ Add Terminal"
                                                                            Command="{Binding AddTimedTerminalSequencePlacement}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                    <Button Content="- Remove"
                                                                            Command="{Binding RemoveTimedTerminalSequencePlacement}"
                                                                            IsEnabled="{Binding HasSelectedTimedTerminalSequencePlacement}"
                                                                            Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <ListBox ItemsSource="{Binding ActiveEditingObjective.TimedTerminalSequencePlacements}"
                                                                     SelectedItem="{Binding SelectedTimedTerminalSequencePlacement, Mode=TwoWay}"
                                                                     Height="100"
                                                                     Background="#181818"
                                                                     BorderBrush="#333333"
                                                                     BorderThickness="1"
                                                                     CornerRadius="4">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:GatherItemPlacement">
                                                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>

                                                            <!-- Selected Terminal Candidate Zones -->
                                                            <StackPanel Spacing="10" IsVisible="{Binding HasSelectedTimedTerminalSequencePlacement}">
                                                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                                                    <StackPanel Spacing="10">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock Grid.Column="0" Text="Candidate Zones (Terminal will spawn in a random zone from this list)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                                <Button Content="+ Add Candidate Zone"
                                                                                        Command="{Binding AddTimedTerminalSequenceCandidateZone}"
                                                                                        Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                                <Button Content="- Remove"
                                                                                        Command="{Binding RemoveTimedTerminalSequenceCandidateZone}"
                                                                                        IsEnabled="{Binding HasSelectedTimedTerminalSequenceCandidateZonePlacement}"
                                                                                        Background="#3E3E42" Foreground="White" Padding="8,4" FontSize="12"/>
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <ListBox ItemsSource="{Binding SelectedTimedTerminalSequencePlacement.CandidateZones}"
                                                                                 SelectedItem="{Binding SelectedTimedTerminalSequenceCandidateZonePlacement, Mode=TwoWay}"
                                                                                 Height="80"
                                                                                 Background="#181818"
                                                                                 BorderBrush="#333333"
                                                                                 BorderThickness="1"
                                                                                 CornerRadius="4">
                                                                            <ListBox.ItemTemplate>
                                                                                <DataTemplate x:DataType="models:CandidateZonePlacement">
                                                                                    <TextBlock Text="{Binding DisplayTitle}" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                                                </DataTemplate>
                                                                            </ListBox.ItemTemplate>
                                                                        </ListBox>

                                                                        <StackPanel Spacing="8" IsVisible="{Binding HasSelectedTimedTerminalSequenceCandidateZonePlacement}">
                                                                            <!-- Candidate Dimension & Zone Selection -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="Dimension:"
                                                                                           ToolTip.Tip="The dimension for this candidate"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0"
                                                                                           Foreground="#CCCCCC"/>
                                                                                <ComboBox Grid.Column="1"
                                                                                          ItemsSource="{Binding AvailableDimensions}"
                                                                                          SelectedItem="{Binding SelectedTimedTerminalSequenceCandidateDimensionOption, Mode=TwoWay}"
                                                                                          HorizontalAlignment="Stretch"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="0,0,14,0">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:DimensionOption">
                                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>

                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="Zone:"
                                                                                           ToolTip.Tip="The zone for this candidate"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0"
                                                                                           Foreground="#CCCCCC"/>
                                                                                <ComboBox Grid.Column="3"
                                                                                          ItemsSource="{Binding AvailableObjectiveZones}"
                                                                                          SelectedItem="{Binding SelectedTimedTerminalSequenceCandidateZoneOption, Mode=TwoWay}"
                                                                                          HorizontalAlignment="Stretch"
                                                                                          VerticalAlignment="Center">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:ZoneOption">
                                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E0E0E0"/>
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                            </Grid>

                                                                            <!-- Placement Weights -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto">
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="Start:"
                                                                                           ToolTip.Tip="Weight for the start of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="1"
                                                                                         Text="{Binding SelectedTimedTerminalSequenceCandidateZonePlacement.PlacementStartWeight, Mode=TwoWay}"
                                                                                         Margin="0,0,10,0"/>

                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="Middle:"
                                                                                           ToolTip.Tip="Weight for the middle of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="3"
                                                                                         Text="{Binding SelectedTimedTerminalSequenceCandidateZonePlacement.PlacementMiddleWeight, Mode=TwoWay}"
                                                                                         Margin="0,0,10,0"/>

                                                                                <TextBlock Grid.Column="4"
                                                                                           Text="End:"
                                                                                           ToolTip.Tip="Weight for the end of the zone."
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,6,0"
                                                                                           Foreground="#AAAAAA"/>
                                                                                <TextBox Grid.Column="5"
                                                                                         Text="{Binding SelectedTimedTerminalSequenceCandidateZonePlacement.PlacementEndWeight, Mode=TwoWay}"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- EventsOnSequenceStart -->
                                                    <Expander Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch">
                                                        <Expander.Header>
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="Events On Sequence Start" FontWeight="SemiBold" FontSize="13" ToolTip.Tip="Events to trigger at the start of a sequence" Foreground="#03C700" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="1" Content="+ Add Event" Command="{Binding AddEventOnSequenceStart}" Background="#2D5A27" Foreground="White" Padding="10,4" Margin="0,0,10,0"/>
                                                            </Grid>
                                                        </Expander.Header>
                                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                                            <ItemsControl ItemsSource="{Binding ActiveEditingObjective.EventsOnSequenceStart}"
                                                                          ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                                        </StackPanel>
                                                    </Expander>

                                                    <!-- EventsOnSequenceDone -->
                                                    <Expander Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch">
                                                        <Expander.Header>
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="Events On Sequence Done" FontWeight="SemiBold" FontSize="13" ToolTip.Tip="Events to trigger when a sequence is successfully completed" Foreground="#03C700" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="1" Content="+ Add Event" Command="{Binding AddEventOnSequenceDone}" Background="#2D5A27" Foreground="White" Padding="10,4" Margin="0,0,10,0"/>
                                                            </Grid>
                                                        </Expander.Header>
                                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                                            <ItemsControl ItemsSource="{Binding ActiveEditingObjective.EventsOnSequenceDone}"
                                                                          ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                                        </StackPanel>
                                                    </Expander>

                                                    <!-- EventsOnSequenceFail -->
                                                    <Expander Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch">
                                                        <Expander.Header>
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="Events On Sequence Fail" FontWeight="SemiBold" FontSize="13" ToolTip.Tip="Events to trigger when a sequence is failed" Foreground="#03C700" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="1" Content="+ Add Event" Command="{Binding AddEventOnSequenceFail}" Background="#2D5A27" Foreground="White" Padding="10,4" Margin="0,0,10,0"/>
                                                            </Grid>
                                                        </Expander.Header>
                                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                                            <ItemsControl ItemsSource="{Binding ActiveEditingObjective.EventsOnSequenceFail}"
                                                                          ItemTemplate="{StaticResource WardenEventTemplate}"/>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Objective Text Section -->
                                    <Border Background="#1E1E1E"
                                            BorderBrush="#3E3E42"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="14"
                                            Margin="0,0,0,14">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Objective Text"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="#FFA200"/>

                                            <!-- Header -->
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Header:"
                                                           ToolTip.Tip="The objective header text."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding ActiveEditingObjective.Header, Mode=TwoWay}"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Main Objective -->
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Main Objective:"
                                                           ToolTip.Tip="The main objective description text."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding ActiveEditingObjective.MainObjective, Mode=TwoWay}"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Find Location Info -->
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Find Location Info:"
                                                           ToolTip.Tip="Information about the location of the objective."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding ActiveEditingObjective.FindLocationInfo, Mode=TwoWay}"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Find Location Info Help -->
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Find Location Info Help:"
                                                           ToolTip.Tip="Additional text. For small pickup item search objectives, this is used to display how many have been found."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding ActiveEditingObjective.FindLocationInfoHelp, Mode=TwoWay}"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Go To Zone -->
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Go To Zone:"
                                                           ToolTip.Tip="Instructions for navigating to the objective zone."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding ActiveEditingObjective.GoToZone, Mode=TwoWay}"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- In Zone Find Item -->
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="In Zone Find Item:"
                                                           ToolTip.Tip="Instructions for finding the item in the zone."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding ActiveEditingObjective.InZoneFindItem, Mode=TwoWay}"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Solve Item -->
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Solve Item:"
                                                           ToolTip.Tip="Instructions for solving or interacting with the item."
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Foreground="#CCCCCC"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding ActiveEditingObjective.SolveItem, Mode=TwoWay}"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                                        <Button Content="Close"
                                                Command="{Binding CloseSectorSettings}"
                                                Background="#007ACC"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                Padding="20,8"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Border>
                </Grid>
            </Panel>
        </Border>

        <!-- Middle Margin Separator -->
        <GridSplitter Grid.Column="1" Width="4" Background="#333333" ResizeDirection="Columns"/>

        <!-- Right Half -->
        <TabControl Grid.Column="2" SelectedIndex="0" Margin="5">
            <TabItem Header="Home">
                <Panel DataContext="{Binding Documentation}" x:DataType="vm:DocumentationViewModel">
                    <Grid>
                        <!-- Top-level TabControl for H1 sections -->
                        <TabControl ItemsSource="{Binding Sections}"
                                    SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                                    Margin="0">
                            <TabControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DocSection">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate x:DataType="models:DocSection">
                                    <Grid Margin="4,8,8,4">
                                        <!-- If this H1 has H2 subtabs -->
                                        <TabControl ItemsSource="{Binding SubSections}"
                                                    SelectedItem="{Binding SelectedSubSection, Mode=TwoWay}"
                                                    IsVisible="{Binding HasSubSections}"
                                                    Margin="0">
                                            <TabControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:DocSection">
                                                    <TextBlock Text="{Binding Title}" FontSize="13"/>
                                                </DataTemplate>
                                            </TabControl.ItemTemplate>
                                            <TabControl.ContentTemplate>
                                                <DataTemplate x:DataType="models:DocSection">
                                                    <Grid Margin="2,6,4,2">
                                                        <!-- If this H2 has H3 sub-subtabs -->
                                                        <TabControl ItemsSource="{Binding SubSections}"
                                                                    SelectedItem="{Binding SelectedSubSection, Mode=TwoWay}"
                                                                    IsVisible="{Binding HasSubSections}"
                                                                    Margin="0">
                                                            <TabControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:DocSection">
                                                                    <TextBlock Text="{Binding Title}" FontSize="12"/>
                                                                </DataTemplate>
                                                            </TabControl.ItemTemplate>
                                                            <TabControl.ContentTemplate>
                                                                <DataTemplate x:DataType="models:DocSection">
                                                                    <ScrollViewer Padding="12,10,12,14"
                                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                                  VerticalScrollBarVisibility="Auto">
                                                                        <ContentControl Content="{Binding RenderedContent}"/>
                                                                    </ScrollViewer>
                                                                </DataTemplate>
                                                            </TabControl.ContentTemplate>
                                                        </TabControl>

                                                        <!-- If no H3 subtabs, show H2 content directly -->
                                                        <ScrollViewer Padding="12,10,12,14"
                                                                      HorizontalScrollBarVisibility="Disabled"
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      IsVisible="{Binding !HasSubSections}">
                                                            <ContentControl Content="{Binding RenderedContent}"/>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </DataTemplate>
                                            </TabControl.ContentTemplate>
                                        </TabControl>

                                        <!-- If no H2 subtabs, show H1 content directly -->
                                        <ScrollViewer Padding="12,10,24,14"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto"
                                                      IsVisible="{Binding !HasSubSections}">
                                            <ContentControl Content="{Binding RenderedContent}"/>
                                        </ScrollViewer>
                                    </Grid>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Grid>
                </Panel>
            </TabItem>
            <TabItem Header="Alarms">
                <Panel x:Name="AlarmsTabRoot" DataContext="{Binding Alarms}" x:DataType="vm:AlarmsViewModel">
                    <Grid RowDefinitions="Auto,*" Margin="10">
                        <!-- Top Bar: Alarm Selection and Creation -->
                        <Border Grid.Row="0" Background="#252526" Padding="10" Margin="0,0,0,10" CornerRadius="4">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="Alarm:" ToolTip.Tip="Select the alarm to modify" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#E0E0E0"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Alarms}"
                                          SelectedItem="{Binding SelectedAlarm, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AlarmBlock">
                                            <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                
                                <Button Grid.Column="2"
                                        Content="+ Create New Alarm"
                                        Command="{Binding OpenCreateAlarmDialog}"
                                        Margin="10,0,0,0"
                                        Padding="12,6"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>

                                <Button Grid.Column="3"
                                        Content="- Delete Alarm"
                                        Command="{Binding RequestDeleteSelectedAlarm}"
                                        IsEnabled="{Binding HasSelectedAlarm}"
                                        Margin="8,0,0,0"
                                        Padding="12,6"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>
                                        
                                <TextBlock Grid.Column="4"
                                           Text="{Binding StatusText}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Foreground="#AAAAAA"
                                           FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Main Editor Area (when an alarm is selected) -->
                        <Grid Grid.Row="1" IsVisible="{Binding HasSelectedAlarm}">
                            <ScrollViewer Margin="0">
                                <StackPanel Spacing="14">
                                    <!-- Duplicate ID Warning Banner -->
                                    <Border Background="#3A1C1C"
                                            BorderBrush="#FF6B6B"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,8"
                                            IsVisible="{Binding HasDuplicatePersistentId}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="⚠" Foreground="#FF6B6B" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DuplicatePersistentIdWarning}"
                                                       Foreground="#FF6B6B"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 1: General & Identification -->
                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="General Identification" FontWeight="Bold" FontSize="14"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" Margin="0,5,0,0">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" ToolTip.Tip="Internal name for the alarm. This is not visible to the player, but is used for identifying the alarm within the editor." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedAlarm.Name, Mode=TwoWay}" Margin="0,0,16,8"/>

                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Persistent ID:" ToolTip.Tip="Internal unique identifier for this alarm. You will want to leave this as a random integer." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SelectedAlarm.PersistentId, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Public Alarm Name:" ToolTip.Tip="Public name for this alarm. This is what the player will see when they look at a door with this alarm attached." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAlarm.PublicAlarmName, Mode=TwoWay}" Margin="0,0,16,0"/>

                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Spawns Enemies:" ToolTip.Tip="True if this alarm should spawn enemies." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <CheckBox Grid.Row="1" Grid.Column="3" IsChecked="{Binding SelectedAlarm.SpawnsEnemies, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Chained Puzzles List -->
                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Scans" ToolTip.Tip="A list of the scans this alarm will contain. This is in-order, top-to-bottom." FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Content="+ Add Scan"
                                                        Command="{Binding AddChainedPuzzleItemCommand}"
                                                        Background="#2D5A27"
                                                        Foreground="White"
                                                        Padding="10,4"
                                                        FontWeight="SemiBold"/>
                                            </Grid>

                                            <!-- Scan Settings -->
                                            <Grid ColumnDefinitions="Auto,*,Auto,*" Margin="0,5,0,0">
                                                <TextBlock Grid.Column="0" Text="Wanted Distance From Start Pos:" ToolTip.Tip="The desired distance for the first scan from the door. A value of 0 means the first scan will be in front of the door, a non-zero value means it will move." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding SelectedAlarm.WantedDistanceFromStartPos, Mode=TwoWay}" Margin="0,0,16,0"/>

                                                <TextBlock Grid.Column="2" Text="Wanted Distance Between Puzzle Components:" ToolTip.Tip="The desired distance between each of the scans. If this is 0, then every scan will be in the same spot (this is useful for things like the R8E2 exit scan or the R8C2 MRI scan)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="3" Text="{Binding SelectedAlarm.WantedDistanceBetweenPuzzleComponents, Mode=TwoWay}"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding SelectedAlarm.ChainedPuzzle}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ChainedPuzzleItem" x:CompileBindings="False">
                                                        <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="Scan Type:"
                                                                           ToolTip.Tip="The type of scan to spawn"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,8,0"
                                                                           Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Column="1"
                                                                          ItemsSource="{Binding #AlarmsTabRoot.DataContext.ChainedPuzzleTypes}"
                                                                          SelectedValue="{Binding PuzzleType, Mode=TwoWay}"
                                                                          SelectedValueBinding="{Binding PersistentId}"
                                                                          HorizontalAlignment="Stretch"
                                                                          Margin="0,0,12,0">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:ChainedPuzzleTypeEntry">
                                                                            <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                                <Button Grid.Column="2"
                                                                        Content="✕ Remove"
                                                                        Command="{Binding #AlarmsTabRoot.DataContext.RemoveChainedPuzzleItemCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="#4A1C1C"
                                                                        Foreground="#FF6B6B"
                                                                        Padding="10,4"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Enemy Wave Settings (Toggled by Spawns Enemies) -->
                                    <StackPanel Spacing="14" IsVisible="{Binding SelectedAlarm.SpawnsEnemies}">
                                        <!-- Group 2: Wave Roles (Enemy Selection) -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Wave Roles (Enemy Selection)" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Select which enemies will spawn for each wave role." Foreground="Gray" FontSize="12"/>

                                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,5,0,0">
                                                    <!-- Row 0: Weakling & Standard -->
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Weakling:" ToolTip.Tip="The 'weakling' type enemy for this alarm. This enemy will cost 0.75 points to spawn, with a total points soft cap of 25. Many vanilla alarms opt to filter this out by excluding it in the population filter, instead using the standard and special slots for their small enemies as they cost 1 point instead of 0.75." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <ComboBox Grid.Row="0" Grid.Column="1"
                                                              ItemsSource="{Binding Enemies}"
                                                              SelectedValue="{Binding SelectedAlarm.WaveRoleWeakling, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding PersistentId}"
                                                              HorizontalAlignment="Stretch"
                                                              Margin="0,0,16,8">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:EnemyEntry">
                                                                <TextBlock Text="{Binding DisplayText}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Standard:" ToolTip.Tip="The 'standard' type enemy for this alarm. This enemy will cost 1 point to spawn, with a total points soft cap of 25. Generally, this is going to be your strikers/shooters." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <ComboBox Grid.Row="0" Grid.Column="3"
                                                              ItemsSource="{Binding Enemies}"
                                                              SelectedValue="{Binding SelectedAlarm.WaveRoleStandard, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding PersistentId}"
                                                              HorizontalAlignment="Stretch"
                                                              Margin="0,0,0,8">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:EnemyEntry">
                                                                <TextBlock Text="{Binding DisplayText}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <!-- Row 1: Special & MiniBoss -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Special:" ToolTip.Tip="The 'special' type enemy for this alarm. This enemy will cost 1 point to spawn, with a total points soft cap of 25. Generally, this is going to be your strikers/shooters." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                                              ItemsSource="{Binding Enemies}"
                                                              SelectedValue="{Binding SelectedAlarm.WaveRoleSpecial, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding PersistentId}"
                                                              HorizontalAlignment="Stretch"
                                                              Margin="0,0,16,8">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:EnemyEntry">
                                                                <TextBlock Text="{Binding DisplayText}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="MiniBoss:" ToolTip.Tip="The 'miniboss' type enemy for this alarm. This enemy will cost 2 points to spawn, with a total points soft cap of 25. Generally, this is going to be your hybrids/giants. Do not put something like a Tank in here; lest you fight an army." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <ComboBox Grid.Row="1" Grid.Column="3"
                                                              ItemsSource="{Binding Enemies}"
                                                              SelectedValue="{Binding SelectedAlarm.WaveRoleMiniBoss, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding PersistentId}"
                                                              HorizontalAlignment="Stretch"
                                                              Margin="0,0,0,8">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:EnemyEntry">
                                                                <TextBlock Text="{Binding DisplayText}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <!-- Row 2: Boss -->
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Boss:" ToolTip.Tip="The 'boss' type enemy for this alarm. This enemy will cost 2 points to spawn, with a total points soft cap of 25. Generally, this is going to be your hybrids/giants. Do not put something like a Tank in here; lest you fight an army. NOTE: THIS ENEMY TYPE IS BROKEN IN VANILLA." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <ComboBox Grid.Row="2" Grid.Column="1"
                                                              ItemsSource="{Binding Enemies}"
                                                              SelectedValue="{Binding SelectedAlarm.WaveRoleBoss, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding PersistentId}"
                                                              HorizontalAlignment="Stretch"
                                                              Margin="0,0,16,0">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:EnemyEntry">
                                                                <TextBlock Text="{Binding DisplayText}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Group 3: Survival Wave Settings - Timing & Group Pauses -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Wave Timing &amp; Pauses" FontWeight="Bold" FontSize="14"/>
                                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,5,0,0">
                                                    <!-- Row 0: Pause Before Start & Pause Between Groups -->
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Pause Before Start (s):" ToolTip.Tip="How many seconds to wait between the alarm starting and the first wave spawning." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedAlarm.PauseBeforeStart, Mode=TwoWay}" Margin="0,0,16,8"/>

                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Pause Between Groups (s):" ToolTip.Tip="Delay between spawning enemy groups." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SelectedAlarm.PauseBetweenGroups, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                    <!-- Row 1: Wave Pause Min & Max -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Wave Pause Min (s):" ToolTip.Tip="Delay between waves at or below the minimum score boundary." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAlarm.WavePauseMin, Mode=TwoWay}" Margin="0,0,16,8"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Wave Pause Max (s):" ToolTip.Tip="Delay between waves at the maximum score boundary." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedAlarm.WavePauseMax, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                    <!-- Row 2: Wave Pause Min at Cost & Wave Pause Max at Cost -->
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Wave Pause Min at Cost:" ToolTip.Tip="Minimum score boundary for pauses between waves. Below this threshold, the timer for a new wave will decrease at its maximum speed." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAlarm.WavePauseMin_AtCost, Mode=TwoWay}" Margin="0,0,16,0"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Wave Pause Max at Cost:" ToolTip.Tip="Maximum score boundary for pauses between waves. Above this threshold, the timer for a new wave does not move. Anywhere in-between min and max, the timer is lerped." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding SelectedAlarm.WavePauseMax_AtCost, Mode=TwoWay}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Group 4: Population Filter -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Population Filter" FontWeight="Bold" FontSize="14"/>
                                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto" Margin="0,5,0,0">
                                                    <TextBlock Grid.Column="0" Text="Filter Type:" ToolTip.Tip="The selected types below will be either the only enemies spawned, or will be excluded entirely, based on this value." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{x:Static vm:AlarmsViewModel.AvailableFilterTypes}"
                                                              SelectedItem="{Binding SelectedAlarm.FilterType, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch"
                                                              Margin="0,0,16,0"/>
                                                </Grid>

                                                <!-- Filter Modes text directly above its buttons -->
                                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                                    <TextBlock Text="Filter Modes:" ToolTip.Tip="Select the types to include/exclude from spawning." VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                                        <CheckBox Content="Weakling" ToolTip.Tip="True if the weakling type should be included in the filter." IsChecked="{Binding SelectedAlarm.FilterWeakling, Mode=TwoWay}"/>
                                                        <CheckBox Content="Standard" ToolTip.Tip="True if the standard type should be included in the filter." IsChecked="{Binding SelectedAlarm.FilterStandard, Mode=TwoWay}"/>
                                                        <CheckBox Content="Special" ToolTip.Tip="True if the special type should be included in the filter." IsChecked="{Binding SelectedAlarm.FilterSpecial, Mode=TwoWay}"/>
                                                        <CheckBox Content="MiniBoss" ToolTip.Tip="True if the miniboss type should be included in the filter." IsChecked="{Binding SelectedAlarm.FilterMiniBoss, Mode=TwoWay}"/>
                                                        <CheckBox Content="Boss" ToolTip.Tip="True if the boss type should be included in the filter." IsChecked="{Binding SelectedAlarm.FilterBoss, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Group 5: Spawn Direction & Spawn Type -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Spawn Direction &amp; Type" FontWeight="Bold" FontSize="14"/>
                                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" Margin="0,5,0,0">
                                                    <!-- Row 0: Direction Randomization -->
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Randomize Direction / Wave:" ToolTip.Tip="0-1 chance for the spawn direction to change between waves." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedAlarm.ChanceToRandomizeSpawnDirectionPerWave, Mode=TwoWay}" Margin="0,0,16,8"/>

                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Randomize Direction / Group:" ToolTip.Tip="0-1 chance for the spawn direction to change between groups." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SelectedAlarm.ChanceToRandomizeSpawnDirectionPerGroup, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                    <!-- Row 1: Override Spawn Type & Survival Wave Spawn Type -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Override Spawn Type:" ToolTip.Tip="True if the spawn type should be overriden. This must be true for the Wave Spawn Type value to be functional." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding SelectedAlarm.OverrideWaveSpawnType, Mode=TwoWay}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Wave Spawn Type:" ToolTip.Tip="Affects how the enemies spawn. Note that FromElevatorDirection only refers to the host in vanilla; use the hostType6SpawnEnemyFix mod to fix it." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <ComboBox Grid.Row="1" Grid.Column="3"
                                                              ItemsSource="{x:Static vm:AlarmsViewModel.AvailableWaveSpawnTypes}"
                                                              SelectedItem="{Binding SelectedAlarm.SurvivalWaveSpawnType, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Group 6: Population Points & Ramp -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Population Points &amp; Ramp" FontWeight="Bold" FontSize="14"/>
                                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,5,0,0">
                                                    <!-- Row 0: Total Points & Ramp Time -->
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Population Points Total:" ToolTip.Tip="The total population points for waves. The alarm automatically stops if this runs out. -1 is infinite." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedAlarm.PopulationPointsTotal, Mode=TwoWay}" Margin="0,0,16,8"/>

                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Population Ramp Over Time (s):" ToolTip.Tip="Lerp over time for start-end population point settings." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SelectedAlarm.PopulationRampOverTime, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                    <!-- Row 1: Wave Points Start & End -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Points Per Wave (Start):" ToolTip.Tip="Population points for a wave at start ramp." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAlarm.PopulationPointsPerWaveStart, Mode=TwoWay}" Margin="0,0,16,8"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Points Per Wave (End):" ToolTip.Tip="Population points for a wave at end ramp." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedAlarm.PopulationPointsPerWaveEnd, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                    <!-- Row 2: Group Points Start & End -->
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Points Per Group (Start):" ToolTip.Tip="Population points for a group at start ramp." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAlarm.PopulationPointsPerGroupStart, Mode=TwoWay}" Margin="0,0,16,8"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Points Per Group (End):" ToolTip.Tip="Population points for a group at end ramp." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding SelectedAlarm.PopulationPointsPerGroupEnd, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                    <!-- Row 3: Min Points Per Group -->
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Min Points Per Group:" ToolTip.Tip="Minimum required cost for a group to spawn. This setting is related to the soft cap of enemies." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedAlarm.PopulationPointsMinPerGroup, Mode=TwoWay}" Margin="0,0,16,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- When no alarm is selected -->
                        <Panel Grid.Row="1" IsVisible="{Binding !HasSelectedAlarm}" Background="#1E1E1E">
                            <TextBlock Text="No alarm selected. Create a new alarm to begin."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"/>
                        </Panel>

                        <!-- Create Alarm Modal Dialog Overlay -->
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                Background="#80000000"
                                IsVisible="{Binding IsCreatingAlarm}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border Background="#1E1E1E"
                                    BorderBrush="#444444"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="20"
                                    Width="480"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BoxShadow="0 4 16 0 #000000">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Create New Alarm"
                                               FontWeight="Bold"
                                               FontSize="16"/>

                                    <TextBlock Text="Choose how you want to create the new alarm:"
                                               Foreground="LightGray"
                                               FontSize="12"/>

                                    <!-- Option: Blank, Existing Alarm, or Vanilla Import -->
                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                        <StackPanel Spacing="10">
                                            <RadioButton Content="Create a new fresh (blank) alarm" IsChecked="{Binding IsCreatingFresh, Mode=TwoWay}"/>

                                            <RadioButton Content="Use an existing alarm as a template" IsChecked="{Binding IsCreatingFromExisting, Mode=TwoWay}" IsEnabled="{Binding HasExistingAlarms}"/>

                                            <!-- Existing Alarm Selector -->
                                            <StackPanel Spacing="6" IsVisible="{Binding IsCreatingFromExisting}" Margin="20,4,0,0">
                                                <TextBlock Text="Select Existing Alarm:" ToolTip.Tip="Select an existing alarm from this project to copy properties from." FontSize="12" Foreground="LightGray"/>
                                                <ComboBox ItemsSource="{Binding Alarms}"
                                                          SelectedItem="{Binding SelectedExistingAlarm, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:AlarmBlock">
                                                            <TextBlock Text="{Binding DisplayText}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <RadioButton Content="Import an alarm from vanilla" IsChecked="{Binding IsCreatingFromVanilla, Mode=TwoWay}"/>

                                            <!-- Vanilla Template Selector -->
                                            <StackPanel Spacing="6" IsVisible="{Binding IsCreatingFromVanilla}" Margin="20,4,0,0">
                                                <TextBlock Text="Select Vanilla Alarm:" ToolTip.Tip="Select a vanilla alarm to import properties from." FontSize="12" Foreground="LightGray"/>
                                                <ComboBox ItemsSource="{Binding AvailableTemplates}"
                                                          SelectedItem="{Binding SelectedVanillaTemplate, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:AlarmBlock">
                                                            <TextBlock Text="{Binding DisplayText}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Name, PersistentID, and Public Alarm Name -->
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" ToolTip.Tip="Internal name for the alarm. This is not visible to the player, but is used for identifying the alarm within the editor." VerticalAlignment="Center" Margin="0,0,10,8"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewAlarmName, Mode=TwoWay}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Persistent ID:" ToolTip.Tip="Internal unique identifier for this alarm. You will want to leave this as a random integer." VerticalAlignment="Center" Margin="0,0,10,8"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewAlarmPersistentId, Mode=TwoWay}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Public Alarm Name:" ToolTip.Tip="Public name for this alarm. This is what the player will see when they look at a door with this alarm attached." VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NewAlarmPublicAlarmName, Mode=TwoWay}"/>
                                    </Grid>

                                    <!-- Error Message Banner -->
                                    <TextBlock Text="{Binding CreationErrorMessage}"
                                               Foreground="#FF6B6B"
                                               IsVisible="{Binding HasCreationErrorMessage}"
                                               FontSize="12"/>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
                                        <Button Content="Cancel"
                                                Command="{Binding CancelCreateAlarm}"
                                                Padding="14,6"/>
                                        <Button Content="Create Alarm"
                                                Command="{Binding ConfirmCreateAlarm}"
                                                Classes="accent"
                                                Padding="14,6"
                                                FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- Delete Alarm Modal Confirmation Overlay -->
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                Background="#80000000"
                                IsVisible="{Binding IsConfirmingDelete}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border Background="#1E1E1E"
                                    BorderBrush="#444444"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="20"
                                    Width="440"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BoxShadow="0 4 16 0 #000000">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Confirm Delete Alarm"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Foreground="#FF6B6B"/>

                                    <TextBlock Text="{Binding DeleteConfirmationMessage}"
                                               TextWrapping="Wrap"
                                               FontSize="13"/>

                                    <TextBlock Text="This action will remove the alarm from the configuration. This cannot be undone."
                                               Foreground="Gray"
                                               TextWrapping="Wrap"
                                               FontSize="12"/>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                                        <Button Content="Cancel"
                                                Command="{Binding CancelDeleteAlarm}"
                                                Padding="14,6"/>
                                        <Button Content="Delete"
                                                Command="{Binding ConfirmDeleteAlarm}"
                                                Background="#D32F2F"
                                                Foreground="White"
                                                Padding="14,6"
                                                FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Panel>
            </TabItem>
            <TabItem Header="Consumables">
                <Panel x:Name="ConsumablesTabRoot" DataContext="{Binding Consumables}" x:DataType="vm:ConsumablesViewModel">
                    <Grid RowDefinitions="Auto,*" Margin="10">
                        <!-- Top Bar: Distribution Selection and Creation -->
                        <Border Grid.Row="0" Background="#252526" Padding="10" Margin="0,0,0,10" CornerRadius="4">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="Distribution:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#E0E0E0"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Blocks}"
                                          SelectedItem="{Binding SelectedBlock, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ConsumableDistributionBlock">
                                            <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                
                                <Button Grid.Column="2"
                                        Content="+ Create New Distribution"
                                        Command="{Binding OpenCreateBlockDialog}"
                                        Margin="10,0,0,0"
                                        Padding="12,6"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>

                                <Button Grid.Column="3"
                                        Content="- Delete Distribution"
                                        Command="{Binding RequestDeleteSelectedBlock}"
                                        IsEnabled="{Binding HasSelectedBlock}"
                                        Margin="8,0,0,0"
                                        Padding="12,6"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>
                                        
                                <TextBlock Grid.Column="4"
                                           Text="{Binding StatusText}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Foreground="#AAAAAA"
                                           FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Main Editor Area (when a distribution is selected) -->
                        <Grid Grid.Row="1" IsVisible="{Binding HasSelectedBlock}">
                            <ScrollViewer Margin="0">
                                <StackPanel Spacing="14">
                                    <!-- Duplicate ID Warning Banner -->
                                    <Border Background="#3A1C1C"
                                            BorderBrush="#FF6B6B"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,8"
                                            IsVisible="{Binding HasDuplicatePersistentId}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="⚠" Foreground="#FF6B6B" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DuplicatePersistentIdWarning}"
                                                       Foreground="#FF6B6B"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 1: General Identification -->
                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="General Identification" FontWeight="Bold" FontSize="14"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto" Margin="0,5,0,0">
                                                <TextBlock Grid.Column="0" Text="Name:" ToolTip.Tip="Internal name for the consumable distribution. This is not visible to the player, but is used for identifying the distribution within the editor." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding SelectedBlock.Name, Mode=TwoWay}" Margin="0,0,16,0"/>

                                                <TextBlock Grid.Column="2" Text="Persistent ID:" ToolTip.Tip="Internal unique identifier for this consumable distribution. You will want to leave this as a random integer." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="3" Text="{Binding SelectedBlock.PersistentId, Mode=TwoWay}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 2: Distribution Settings -->
                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Distribution Settings" FontWeight="Bold" FontSize="14"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto" Margin="0,5,0,0">
                                                <TextBlock Grid.Column="0" Text="Spawns Per Zone:" ToolTip.Tip="The number of items to spawn in total from the pool of items." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding SelectedBlock.SpawnsPerZone, Mode=TwoWay}" Margin="0,0,16,0"/>

                                                <TextBlock Grid.Column="2" Text="Chance To Spawn In Resource Container:" ToolTip.Tip="The chance for the item to spawn inside a resource container." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="3" Text="{Binding SelectedBlock.ChanceToSpawnInResourceContainer, Mode=TwoWay}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 3: Consumable Items & Weights -->
                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Consumable Items &amp; Weights" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Content="+ Add Item"
                                                        Command="{Binding AddSpawnDataItemCommand}"
                                                        Background="#2D5A27"
                                                        Foreground="White"
                                                        Padding="10,4"
                                                        FontWeight="SemiBold"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding SelectedBlock.SpawnData}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ConsumableDistributionItem" x:CompileBindings="False">
                                                        <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="Item:"
                                                                           ToolTip.Tip="The item to be spawned"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,8,0"
                                                                           Foreground="#CCCCCC"/>
                                                                <ComboBox Grid.Column="1"
                                                                          ItemsSource="{x:Static vm:ConsumablesViewModel.AvailableConsumables}"
                                                                          SelectedItem="{Binding Item, Mode=TwoWay}"
                                                                          HorizontalAlignment="Stretch"
                                                                          Margin="0,0,16,0"/>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="Weight:"
                                                                           ToolTip.Tip="The weighted probability of this item being chosen"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,8,0"
                                                                           Foreground="#CCCCCC"/>
                                                                <TextBox Grid.Column="3"
                                                                         Text="{Binding Weight, Mode=TwoWay}"
                                                                         HorizontalAlignment="Stretch"
                                                                         Margin="0,0,16,0"/>

                                                                <Button Grid.Column="4"
                                                                        Content="- Remove"
                                                                        Command="{Binding #ConsumablesTabRoot.DataContext.RemoveSpawnDataItemCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="#4A1C1C"
                                                                        Foreground="#FF6B6B"
                                                                        Padding="10,4"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- When no distribution is selected -->
                        <Panel Grid.Row="1" IsVisible="{Binding !HasSelectedBlock}" Background="#1E1E1E">
                            <TextBlock Text="No consumable distribution selected. Create a new distribution to begin."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"/>
                        </Panel>

                        <!-- Create Distribution Modal Dialog Overlay -->
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                Background="#80000000"
                                IsVisible="{Binding IsCreatingBlock}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border Background="#1E1E1E"
                                    BorderBrush="#444444"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="20"
                                    Width="480"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BoxShadow="0 4 16 0 #000000">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Create New Consumable Distribution"
                                               FontWeight="Bold"
                                               FontSize="16"/>

                                    <TextBlock Text="Choose how you want to create the new distribution:"
                                               Foreground="LightGray"
                                               FontSize="12"/>

                                    <!-- Option: Blank or Template -->
                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                        <StackPanel Spacing="10">
                                            <RadioButton Content="Create a new fresh distribution" IsChecked="{Binding IsCreatingFresh, Mode=TwoWay}"/>
                                            <RadioButton Content="Use an existing distribution as a template" IsChecked="{Binding IsCreatingFromTemplate, Mode=TwoWay}"/>

                                            <!-- Template Selector -->
                                            <StackPanel Spacing="6" IsVisible="{Binding IsCreatingFromTemplate}" Margin="20,4,0,0">
                                                <TextBlock Text="Select Distribution Template:" FontSize="12" Foreground="LightGray"/>
                                                <ComboBox ItemsSource="{Binding AvailableTemplates}"
                                                          SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ConsumableDistributionBlock">
                                                            <TextBlock Text="{Binding DisplayText}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Name and PersistentID -->
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" ToolTip.Tip="Internal name for the consumable distribution. This is not visible to the player, but is used for identifying the distribution within the editor." VerticalAlignment="Center" Margin="0,0,10,8"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewBlockName, Mode=TwoWay}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Persistent ID:" ToolTip.Tip="Internal unique identifier for this consumable distribution. You will want to leave this as a random integer." VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewBlockPersistentId, Mode=TwoWay}"/>
                                    </Grid>

                                    <!-- Error message banner -->
                                    <Border Background="#3A1C1C"
                                            BorderBrush="#FF6B6B"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,8"
                                            IsVisible="{Binding HasCreationErrorMessage}">
                                        <TextBlock Text="{Binding CreationErrorMessage}"
                                                   Foreground="#FF6B6B"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <Grid ColumnDefinitions="*,8,*">
                                        <Button Grid.Column="0"
                                                Content="Cancel"
                                                Command="{Binding CancelCreateBlock}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Padding="0,8"/>
                                        <Button Grid.Column="2"
                                                Content="Create"
                                                Command="{Binding ConfirmCreateBlock}"
                                                Background="#2D5A27"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Padding="0,8"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- Delete Distribution Confirmation Modal Overlay -->
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                Background="#80000000"
                                IsVisible="{Binding IsConfirmingDelete}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border Background="#1E1E1E"
                                    BorderBrush="#444444"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="20"
                                    Width="440"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BoxShadow="0 4 16 0 #000000">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Delete Consumable Distribution"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Foreground="#FF6B6B"/>

                                    <TextBlock Text="{Binding DeleteConfirmationMessage}"
                                               Foreground="LightGray"
                                               FontSize="13"
                                               TextWrapping="Wrap"/>

                                    <!-- Action Buttons -->
                                    <Grid ColumnDefinitions="*,8,*">
                                        <Button Grid.Column="0"
                                                Content="Cancel"
                                                Command="{Binding CancelDeleteBlock}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Padding="0,8"/>
                                        <Button Grid.Column="2"
                                                Content="Delete"
                                                Command="{Binding ConfirmDeleteBlock}"
                                                Background="#5A1C1C"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Padding="0,8"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Panel>
            </TabItem>
            <TabItem Header="Lighting">
                <Panel DataContext="{Binding Lighting}" x:DataType="vm:LightingViewModel">
                    <Grid RowDefinitions="Auto,*" Margin="10">
                        <!-- Top Bar: Config Selection and Creation -->
                        <Border Grid.Row="0" Background="#252526" Padding="10" Margin="0,0,0,10" CornerRadius="4">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="Lighting:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#E0E0E0"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Blocks}"
                                          SelectedItem="{Binding SelectedBlock, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:LightSettingsBlock">
                                            <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                
                                <Button Grid.Column="2"
                                        Content="+ Create New Config"
                                        Command="{Binding OpenCreateBlockDialog}"
                                        Margin="10,0,0,0"
                                        Padding="12,6"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>

                                <Button Grid.Column="3"
                                        Content="- Delete Config"
                                        Command="{Binding RequestDeleteSelectedBlock}"
                                        IsEnabled="{Binding HasSelectedBlock}"
                                        Margin="8,0,0,0"
                                        Padding="12,6"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>
                                        
                                <TextBlock Grid.Column="4"
                                           Text="{Binding StatusText}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Foreground="#AAAAAA"
                                           FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Main Editor Area (when a config is selected) -->
                        <Grid Grid.Row="1" IsVisible="{Binding HasSelectedBlock}">
                            <ScrollViewer Margin="0">
                                <StackPanel Spacing="14">
                                    <!-- Duplicate ID Warning Banner -->
                                    <Border Background="#3A1C1C"
                                            BorderBrush="#FF6B6B"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,8"
                                            IsVisible="{Binding HasDuplicatePersistentId}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="⚠" Foreground="#FF6B6B" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DuplicatePersistentIdWarning}"
                                                       Foreground="#FF6B6B"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Missing Categories Warning Banner -->
                                    <Border Background="#3A281C"
                                            BorderBrush="#FFA726"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,8"
                                            IsVisible="{Binding HasMissingCategories}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="⚠" Foreground="#FFA726" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding MissingCategoriesWarning}"
                                                       Foreground="#FFA726"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 1: General Identification -->
                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="General Identification" FontWeight="Bold" FontSize="14"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto" Margin="0,5,0,0">
                                                <TextBlock Grid.Column="0" Text="Name:" ToolTip.Tip="Internal name for the lighting setting. This is not visible to the player, but is used for identifying the lighting setting within the editor." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding SelectedBlock.Name, Mode=TwoWay}" Margin="0,0,16,0"/>

                                                <TextBlock Grid.Column="2" Text="Persistent ID:" ToolTip.Tip="Internal unique identifier for this lighting setting. You will want to leave this as a random integer." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="3" Text="{Binding SelectedBlock.PersistentId, Mode=TwoWay}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 2: Light Category Settings (Options) -->
                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                        <StackPanel Spacing="12">
                                            <!-- Category Selector & Add Option -->
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                                                <TextBlock Grid.Column="0" Text="Category:" ToolTip.Tip="The category to edit config settings for." VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#E0E0E0"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding Categories}"
                                                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"/>
                                                <Button Grid.Column="2"
                                                        Content="+ Add Option"
                                                        Command="{Binding AddOption}"
                                                        Margin="10,0,0,0"
                                                        Padding="12,6"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Options List for Selected Category -->
                                            <ItemsControl ItemsSource="{Binding CurrentCategorySettings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:LightCategorySettingItem" x:CompileBindings="False">
                                                        <Border BorderBrush="#333333"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="12"
                                                                Margin="0,0,0,10">
                                                            <StackPanel Spacing="10">
                                                                <!-- Option Header Row -->
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                        <TextBlock Text="Lighting Option" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Category, StringFormat='({0})'}" FontWeight="SemiBold" Foreground="#4EC9B0" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1"
                                                                            Content="- Remove Option"
                                                                            Command="{Binding $parent[Window].DataContext.Lighting.RemoveOption}"
                                                                            CommandParameter="{Binding}"
                                                                            Background="#3A1C1C"
                                                                            Foreground="#FF6B6B"
                                                                            Padding="8,4"
                                                                            FontSize="12"
                                                                            FontWeight="SemiBold"/>
                                                                </Grid>

                                                                <!-- Option Settings Grid -->
                                                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                                                    <!-- Row 0: On, Intensity Mul, Weight -->
                                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="On:" ToolTip.Tip="Whether the lights in this setting are on." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                                    <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding On, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,16,8"/>

                                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Intensity Multiplier:" ToolTip.Tip="Multiplier for the lighting intensity." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding IntensityMul, Mode=TwoWay}" Margin="0,0,16,8"/>

                                                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Weight:" ToolTip.Tip="Probability weight of this setting being chosen for this category." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                                    <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding Weight, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                                    <!-- Row 1: Chance, Chance Broken -->
                                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Chance:" ToolTip.Tip="The 0-1 chance of each light being on. 1 for always on." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Chance, Mode=TwoWay}" Margin="0,0,16,0"/>

                                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Chance Broken:" ToolTip.Tip="The 0-1 chance of this light being broken. 0 for never broken." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ChanceBroken, Mode=TwoWay}" Margin="0,0,16,0"/>
                                                                </Grid>

                                                                <!-- Color Section (RGBA Sliders and Hex) -->
                                                                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,0">
                                                                    <StackPanel Spacing="8">
                                                                        <TextBlock Text="Color (RGBA)" ToolTip.Tip="Color of the lights in this category." FontWeight="SemiBold" FontSize="13" Foreground="#E0E0E0"/>

                                                                        <!-- Swatch and Hex -->
                                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                                            <Border Grid.Column="0"
                                                                                    Background="{Binding Color.HexColor}"
                                                                                    Width="50"
                                                                                    Height="28"
                                                                                    CornerRadius="3"
                                                                                    BorderBrush="#555555"
                                                                                    BorderThickness="1"
                                                                                    Margin="0,0,10,0"/>
                                                                            <TextBox Grid.Column="1"
                                                                                     Text="{Binding Color.HexCode, Mode=TwoWay}"
                                                                                     Watermark="#AARRGGBB"
                                                                                     VerticalAlignment="Center"
                                                                                     Margin="0,0,8,0"/>
                                                                        </Grid>

                                                                        <!-- RGBA Sliders -->
                                                                        <Grid ColumnDefinitions="30,*,50" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,2,0,0">
                                                                            <!-- Red -->
                                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="R:" ToolTip.Tip="The red lighting colour for this category." VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                            <Slider Grid.Row="0" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding Color.R, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Color.R, StringFormat='{}{0:F2}'}" VerticalAlignment="Center"/>

                                                                            <!-- Green -->
                                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="G:" ToolTip.Tip="The green lighting colour for this category." VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding Color.G, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Color.G, StringFormat='{}{0:F2}'}" VerticalAlignment="Center"/>

                                                                            <!-- Blue -->
                                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="B:" ToolTip.Tip="The blue lighting colour for this category." VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                            <Slider Grid.Row="2" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding Color.B, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Color.B, StringFormat='{}{0:F2}'}" VerticalAlignment="Center"/>
                                                                            
                                                                            <!-- Alpha -->
                                                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="A:" ToolTip.Tip="The alpha lighting colour for this category." VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                            <Slider Grid.Row="3" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding Color.A, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Color.A, StringFormat='{}{0:F2}'}" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- When no options defined for this category -->
                                            <Border IsVisible="{Binding !HasCurrentCategorySettings}"
                                                    BorderBrush="#333333"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="16"
                                                    HorizontalAlignment="Stretch">
                                                <TextBlock Text="No lighting settings defined for this category. Click '+ Add Option' to add one."
                                                           Foreground="Gray"
                                                           FontStyle="Italic"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- When no config is selected -->
                        <Panel Grid.Row="1" IsVisible="{Binding !HasSelectedBlock}" Background="#1E1E1E">
                            <TextBlock Text="No lighting config selected. Create a new config to begin."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"/>
                        </Panel>

                        <!-- Create Config Modal Dialog Overlay -->
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                Background="#80000000"
                                IsVisible="{Binding IsCreatingBlock}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border Background="#1E1E1E"
                                    BorderBrush="#444444"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="20"
                                    Width="480"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BoxShadow="0 4 16 0 #000000">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Create New Lighting Config"
                                               FontWeight="Bold"
                                               FontSize="16"/>

                                    <TextBlock Text="Choose how you want to create the new lighting config:"
                                               Foreground="LightGray"
                                               FontSize="12"/>

                                    <!-- Option: Blank or Template -->
                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                                        <StackPanel Spacing="10">
                                            <RadioButton Content="Create a new fresh (default) config" IsChecked="{Binding IsCreatingFresh, Mode=TwoWay}"/>
                                            <RadioButton Content="Use an existing config as a template" IsChecked="{Binding IsCreatingFromTemplate, Mode=TwoWay}"/>

                                            <!-- Template Selector -->
                                            <StackPanel Spacing="6" IsVisible="{Binding IsCreatingFromTemplate}" Margin="20,4,0,0">
                                                <TextBlock Text="Select Config Template:" FontSize="12" Foreground="LightGray"/>
                                                <ComboBox ItemsSource="{Binding AvailableTemplates}"
                                                          SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:LightSettingsBlock">
                                                            <TextBlock Text="{Binding DisplayText}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Name and PersistentID -->
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewBlockName, Mode=TwoWay}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Persistent ID:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewBlockPersistentId, Mode=TwoWay}"/>
                                    </Grid>

                                    <!-- Error Message Banner -->
                                    <TextBlock Text="{Binding CreationErrorMessage}"
                                               Foreground="#FF6B6B"
                                               IsVisible="{Binding HasCreationErrorMessage}"
                                               FontSize="12"/>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
                                        <Button Content="Cancel"
                                                Command="{Binding CancelCreateBlock}"
                                                Padding="14,6"/>
                                        <Button Content="Create Config"
                                                Command="{Binding ConfirmCreateBlock}"
                                                Classes="accent"
                                                Padding="14,6"
                                                FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- Delete Config Modal Confirmation Overlay -->
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                Background="#80000000"
                                IsVisible="{Binding IsConfirmingDelete}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border Background="#1E1E1E"
                                    BorderBrush="#444444"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="20"
                                    Width="440"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BoxShadow="0 4 16 0 #000000">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Confirm Delete Lighting Config"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Foreground="#FF6B6B"/>

                                    <TextBlock Text="{Binding DeleteConfirmationMessage}"
                                               TextWrapping="Wrap"
                                               FontSize="13"/>

                                    <TextBlock Text="This action will remove the lighting config from the configuration. This cannot be undone."
                                               Foreground="Gray"
                                               TextWrapping="Wrap"
                                               FontSize="12"/>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                                        <Button Content="Cancel"
                                                Command="{Binding CancelDeleteBlock}"
                                                Padding="14,6"/>
                                        <Button Content="Delete"
                                                Command="{Binding ConfirmDeleteBlock}"
                                                Background="#D32F2F"
                                                Foreground="White"
                                                Padding="14,6"
                                                FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Panel>
            </TabItem>
            <TabItem Header="Fog">
                <Panel DataContext="{Binding FogSettings}" x:DataType="vm:FogSettingsViewModel">
                    <Grid RowDefinitions="Auto,*" Margin="10">
                        <!-- Top Bar: Config Selection and Creation -->
                        <Border Grid.Row="0" Background="#252526" Padding="10" Margin="0,0,0,10" CornerRadius="4">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="Fog:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#E0E0E0"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Blocks}"
                                          SelectedItem="{Binding SelectedBlock, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:FogSettingsBlock">
                                            <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                
                                <Button Grid.Column="2"
                                        Content="+ Create New Config"
                                        Command="{Binding OpenCreateBlockDialog}"
                                        Margin="10,0,0,0"
                                        Padding="12,6"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>

                                <Button Grid.Column="3"
                                        Content="- Delete Config"
                                        Command="{Binding RequestDeleteSelectedBlock}"
                                        IsEnabled="{Binding HasSelectedBlock}"
                                        Margin="8,0,0,0"
                                        Padding="12,6"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>
                                        
                                <TextBlock Grid.Column="4"
                                           Text="{Binding StatusText}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Foreground="#AAAAAA"
                                           FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Main Editor Area (when a config is selected) -->
                        <Grid Grid.Row="1" IsVisible="{Binding HasSelectedBlock}">
                            <ScrollViewer Margin="0">
                                <StackPanel Spacing="14">
                                    <!-- Duplicate ID Warning Banner -->
                                    <Border Background="#3A1C1C"
                                            BorderBrush="#FF6B6B"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,8"
                                            IsVisible="{Binding HasDuplicatePersistentId}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="⚠" Foreground="#FF6B6B" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DuplicatePersistentIdWarning}"
                                                       Foreground="#FF6B6B"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 1: General Identification -->
                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="General Identification" FontWeight="Bold" FontSize="14"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto" Margin="0,5,0,0">
                                                <TextBlock Grid.Column="0" Text="Name:" ToolTip.Tip="Internal name for the fog setting. This is not visible to the player, but is used for identifying the fog setting within the editor." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding SelectedBlock.Name, Mode=TwoWay}" Margin="0,0,16,0"/>

                                                <TextBlock Grid.Column="2" Text="Persistent ID:" ToolTip.Tip="#Internal unique identifier for this fog setting. You will want to leave this as a random integer." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="3" Text="{Binding SelectedBlock.PersistentId, Mode=TwoWay}" Margin="0,0,16,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 2: Fog Properties -->
                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Fog Properties" FontWeight="Bold" FontSize="14"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto" Margin="0,5,0,0">
                                                <TextBlock Grid.Column="0" Text="Fog Density:" ToolTip.Tip="The base fog density in the entire level. To create inversed fog as in R5E1, you have to set FogDensity and DensityHeightMaxBoost such that FogDensity &lt; DensityHeightMaxBoost. This value is normally very low - most vanilla settings have less than 0.001." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding SelectedBlock.FogDensity, Mode=TwoWay}" Margin="0,0,16,0"/>

                                                <TextBlock Grid.Column="2" Text="Infection:" ToolTip.Tip="The maximum value for how fast infection accumulates in fog. For example, 0.1 would make you 10% infected per second. 0.03 is a common value this is set to. Note that the infection speed is based on how deep you are in the fog with linear scaling. The lowest infection gain rate is at DensityHeightAltitude + DensityHeightRange, and the lowest point is at DensityHeightRange." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="3" Text="{Binding SelectedBlock.Infection, Mode=TwoWay}"/>
                                            </Grid>

                                            <!-- Color Section (RGBA Sliders and Hex) -->
                                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,0">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Fog Color (RGBA)" ToolTip.Tip="RGBA colour of the fog. Non-white fog may not block sight very well, and colours may be affected by other factors in the environment." FontWeight="SemiBold" FontSize="13" Foreground="#E0E0E0"/>

                                                    <!-- Swatch and Hex -->
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Border Grid.Column="0"
                                                                Background="{Binding SelectedBlock.FogColor.HexColor}"
                                                                Width="50"
                                                                Height="28"
                                                                CornerRadius="3"
                                                                BorderBrush="#555555"
                                                                BorderThickness="1"
                                                                Margin="0,0,10,0"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding SelectedBlock.FogColor.HexCode, Mode=TwoWay}"
                                                                 Watermark="#AARRGGBB"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,8,0"/>
                                                    </Grid>

                                                    <!-- RGBA Sliders -->
                                                    <Grid ColumnDefinitions="30,*,50" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,2,0,0">
                                                        <!-- Red -->
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="R:" ToolTip.Tip="Red for the fog color." VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding SelectedBlock.FogColor.R, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SelectedBlock.FogColor.R, StringFormat='{}{0:F2}'}" VerticalAlignment="Center"/>

                                                        <!-- Green -->
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="G:" ToolTip.Tip="Green for the fog color." VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding SelectedBlock.FogColor.G, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedBlock.FogColor.G, StringFormat='{}{0:F2}'}" VerticalAlignment="Center"/>

                                                        <!-- Blue -->
                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="B:" ToolTip.Tip="Blue for the fog color." VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding SelectedBlock.FogColor.B, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedBlock.FogColor.B, StringFormat='{}{0:F2}'}" VerticalAlignment="Center"/>
                                                        
                                                        <!-- Alpha -->
                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="A:" ToolTip.Tip="Alpha for the fog color." VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding SelectedBlock.FogColor.A, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SelectedBlock.FogColor.A, StringFormat='{}{0:F2}'}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 3: Density Noise Settings -->
                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Noise Settings" FontWeight="Bold" FontSize="14"/>
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,5,0,0">
                                                <!-- Row 0: Merged Noise Direction (X, Y, Z) -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Direction (X, Y, Z):" ToolTip.Tip="Noise are the floating particles right above the fog plane. This field is a vector that controls the floating direction of those particles." VerticalAlignment="Center" Margin="0,0,12,8"/>
                                                <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,*,*" Margin="0,0,0,8">
                                                    <TextBox Grid.Column="0" Text="{Binding SelectedBlock.DensityNoiseDirection.X, Mode=TwoWay}" Watermark="X" ToolTip.Tip="X direction" Margin="0,0,8,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SelectedBlock.DensityNoiseDirection.Y, Mode=TwoWay}" Watermark="Y" ToolTip.Tip="Y direction" Margin="0,0,8,0"/>
                                                    <TextBox Grid.Column="2" Text="{Binding SelectedBlock.DensityNoiseDirection.Z, Mode=TwoWay}" Watermark="Z" ToolTip.Tip="Z direction"/>
                                                </Grid>

                                                <!-- Row 1: Speed, Scale -->
                                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,*">
                                                    <TextBlock Grid.Column="0" Text="Noise Speed:" ToolTip.Tip="Speed of the fog particles" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SelectedBlock.DensityNoiseSpeed, Mode=TwoWay}" Margin="0,0,16,0"/>

                                                    <TextBlock Grid.Column="2" Text="Noise Scale:" ToolTip.Tip="Size of the noise particles. Most vanilla settings use a value around 0.1." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox Grid.Column="3" Text="{Binding SelectedBlock.DensityNoiseScale, Mode=TwoWay}"/>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 4: Height Gradient Settings -->
                                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Density Height Settings" FontWeight="Bold" FontSize="14"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto" Margin="0,5,0,0">
                                                <TextBlock Grid.Column="0" Text="Altitude:" ToolTip.Tip="The lowest point for the fog height. For non-inversed fog (R5E1), everything with altitude lower than this value will be fully submerged by the fog. Normal zone altitudes - Low: -4.0, Mid: 0.0, High: 4.0." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding SelectedBlock.DensityHeightAltitude, Mode=TwoWay}" Margin="0,0,16,0"/>

                                                <TextBlock Grid.Column="2" Text="Range:" ToolTip.Tip="Distance above the lowest point for fog height. The surface of the fog is at the Altitude + Range." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="3" Text="{Binding SelectedBlock.DensityHeightRange, Mode=TwoWay}" Margin="0,0,16,0"/>

                                                <TextBlock Grid.Column="4" Text="Max Boost:" ToolTip.Tip="Actual field for controlling the density of non-inversed fog (R5E1). The larger, the more occluding. R5D2, a level with very dense fog, uses a value of 0.2." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="5" Text="{Binding SelectedBlock.DensityHeightMaxBoost, Mode=TwoWay}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- When no config is selected -->
                        <Panel Grid.Row="1" IsVisible="{Binding !HasSelectedBlock}" Background="#1E1E1E">
                            <TextBlock Text="No fog config selected. Create a new config to begin."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"/>
                        </Panel>

                        <!-- Create Config Modal Dialog Overlay -->
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                Background="#80000000"
                                IsVisible="{Binding IsCreatingBlock}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border Background="#1E1E1E"
                                    BorderBrush="#444444"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="20"
                                    Width="480"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BoxShadow="0 4 16 0 #000000">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Create New Fog Config"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Foreground="#E0E0E0"/>

                                    <!-- Mode: Fresh vs Copy -->
                                    <StackPanel Spacing="6">
                                        <RadioButton Content="Create fresh config (defaults)"
                                                     IsChecked="{Binding IsCreatingFresh, Mode=TwoWay}"/>
                                        <RadioButton Content="Copy from existing template"
                                                     IsChecked="{Binding IsCreatingFromTemplate, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <!-- Template Picker (visible when copying) -->
                                    <StackPanel Spacing="4" IsVisible="{Binding IsCreatingFromTemplate}">
                                        <TextBlock Text="Template:" FontWeight="SemiBold" FontSize="12" Foreground="#AAAAAA"/>
                                        <ComboBox ItemsSource="{Binding AvailableTemplates}"
                                                  SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:FogSettingsBlock">
                                                    <TextBlock Text="{Binding DisplayText}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Name Field -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Config Name:" FontWeight="SemiBold" FontSize="12" Foreground="#AAAAAA"/>
                                        <TextBox Text="{Binding NewBlockName, Mode=TwoWay}"
                                                 Watermark="Enter config name..."/>
                                    </StackPanel>

                                    <!-- Persistent ID Field -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Persistent ID:" FontWeight="SemiBold" FontSize="12" Foreground="#AAAAAA"/>
                                        <TextBox Text="{Binding NewBlockPersistentId, Mode=TwoWay}"
                                                 Watermark="Enter integer ID..."/>
                                    </StackPanel>

                                    <!-- Error Banner -->
                                    <Border Background="#3A1C1C"
                                            BorderBrush="#FF6B6B"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,8"
                                            IsVisible="{Binding HasCreationErrorMessage}">
                                        <TextBlock Text="{Binding CreationErrorMessage}"
                                                   Foreground="#FF6B6B"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                                        <Button Content="Cancel"
                                                Command="{Binding CancelCreateBlock}"
                                                Padding="14,6"/>
                                        <Button Content="Create Config"
                                                Command="{Binding ConfirmCreateBlock}"
                                                Classes="accent"
                                                Padding="14,6"
                                                FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- Delete Config Modal Confirmation Overlay -->
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                Background="#80000000"
                                IsVisible="{Binding IsConfirmingDelete}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border Background="#1E1E1E"
                                    BorderBrush="#444444"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="20"
                                    Width="440"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BoxShadow="0 4 16 0 #000000">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Confirm Delete Fog Config"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Foreground="#FF6B6B"/>

                                    <TextBlock Text="{Binding DeleteConfirmationMessage}"
                                               TextWrapping="Wrap"
                                               FontSize="13"/>

                                    <TextBlock Text="This action will remove the fog config from the configuration. This cannot be undone."
                                               Foreground="Gray"
                                               TextWrapping="Wrap"
                                               FontSize="12"/>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                                        <Button Content="Cancel"
                                                Command="{Binding CancelDeleteBlock}"
                                                Padding="14,6"/>
                                        <Button Content="Delete"
                                                Command="{Binding ConfirmDeleteBlock}"
                                                Background="#D32F2F"
                                                Foreground="White"
                                                Padding="14,6"
                                                FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Panel>
            </TabItem>
            <TabItem Header="Geomorphs">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="10" DataContext="{Binding Geomorphs}" x:DataType="vm:GeomorphsViewModel">
                    <TextBlock Grid.Row="0" Text="Geomorphs" FontWeight="Bold" FontSize="16" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Text="Browse vanilla Geomorphs. Click a prefab path to copy it to clipboard. Hover over image previews to view a screenshot of the geomorph." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="2" Text="The content on this page is taken from the 'All Geomorphs' document, with permission from its creator and maintainers ProjectZaero and GhostlyMire." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                        <TextBlock Grid.Column="0" Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" 
                                 Text="{Binding SearchText, Mode=TwoWay}" 
                                 Watermark="Search by name, prefab, description, complex, sub-complex..."
                                 VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding StatusText}" 
                                   VerticalAlignment="Center" 
                                   Margin="10,0,0,0" 
                                   Foreground="Gray" 
                                   FontSize="12"/>
                    </Grid>

                    <TabControl Grid.Row="4" ItemsSource="{Binding Complexes}">
                        <TabControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GeomorphComplexViewModel">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:GeomorphComplexViewModel">
                                <TabControl ItemsSource="{Binding SubComplexes}" Margin="0,4,0,0">
                                    <TabControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GeomorphSubComplexViewModel">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </TabControl.ItemTemplate>
                                    <TabControl.ContentTemplate>
                                        <DataTemplate x:DataType="vm:GeomorphSubComplexViewModel">
                                            <TabControl ItemsSource="{Binding Categories}" Margin="0,4,0,0">
                                                <TabControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:GeomorphCategoryViewModel">
                                                        <TextBlock Text="{Binding Name}"/>
                                                    </DataTemplate>
                                                </TabControl.ItemTemplate>
                                                <TabControl.ContentTemplate>
                                                    <DataTemplate x:DataType="vm:GeomorphCategoryViewModel">
                                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Margin="0,4,0,0">
                                                            <DataGrid ItemsSource="{Binding FilteredGeomorphs}"
                                                                      SelectedItem="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Geomorphs.SelectedGeomorph, Mode=TwoWay}"
                                                                      AutoGenerateColumns="False"
                                                                      IsReadOnly="True"
                                                                      GridLinesVisibility="All"
                                                                      CanUserResizeColumns="True"
                                                                      CanUserReorderColumns="True"
                                                                      CanUserSortColumns="True"
                                                                      CellPointerPressed="GeomorphsDataGrid_CellPointerPressed">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="1.5*"/>
                                                                    <DataGridTextColumn Header="Prefab Path" Binding="{Binding PrefabPath}" Width="3.5*"/>
                                                                    <DataGridTemplateColumn Header="Description" Width="5*">
                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                            <DataTemplate x:DataType="models:GeomorphEntry">
                                                                                <TextBlock Classes="desc-text"
                                                                                           Text="{Binding Description}"
                                                                                           TextWrapping="NoWrap"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="8,4">
                                                                                    <ToolTip.Tip>
                                                                                        <Border Background="#1E1E1E" BorderBrush="#555555" BorderThickness="1" CornerRadius="4" Padding="8" MaxWidth="500">
                                                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="12"/>
                                                                                        </Border>
                                                                                    </ToolTip.Tip>
                                                                                </TextBlock>
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                    </DataGridTemplateColumn>
                                                                    <DataGridTemplateColumn Header="Image" Width="90">
                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                            <DataTemplate x:DataType="models:GeomorphEntry">
                                                                                <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                    <Border IsVisible="{Binding HasImage}"
                                                                                            Background="#2D2D30"
                                                                                            BorderBrush="#444444"
                                                                                            BorderThickness="1"
                                                                                            CornerRadius="3"
                                                                                            Padding="6,2"
                                                                                            Cursor="Hand">
                                                                                        <ToolTip.Tip>
                                                                                            <Border Background="#1E1E1E" BorderBrush="#555555" BorderThickness="1" CornerRadius="4" Padding="6">
                                                                                                <Panel>
                                                                                                    <Image Source="{Binding ImageBitmap}"
                                                                                                           MaxWidth="1100"
                                                                                                           MaxHeight="620"
                                                                                                           Stretch="Uniform"
                                                                                                           IsVisible="{Binding HasImageBitmap}"/>
                                                                                                    <TextBlock Text="Image preview not found on disk"
                                                                                                               Foreground="#888888"
                                                                                                               FontStyle="Italic"
                                                                                                               FontSize="12"
                                                                                                               Margin="10"
                                                                                                               IsVisible="{Binding !HasImageBitmap}"/>
                                                                                                </Panel>
                                                                                            </Border>
                                                                                        </ToolTip.Tip>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                             <TextBlock Text="Hover" FontSize="11" Foreground="#9CDCFE" VerticalAlignment="Center"/>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                    <TextBlock Text="—" Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasImage}"/>
                                                                                </Panel>
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                    </DataGridTemplateColumn>
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </Border>
                                                    </DataTemplate>
                                                </TabControl.ContentTemplate>
                                            </TabControl>
                                        </DataTemplate>
                                    </TabControl.ContentTemplate>
                                </TabControl>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem Header="Sounds">
                <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="10" DataContext="{Binding Sounds}" x:DataType="vm:SoundsViewModel">
                    <TextBlock Grid.Row="0" Text="Sounds" FontWeight="Bold" FontSize="16" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Text="Search the list of all sounds in GTFO. Click an ID to copy it to clipboard." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                        <TextBlock Grid.Column="0" Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" 
                                 Text="{Binding SearchText, Mode=TwoWay}" 
                                 Watermark="Search by ID, name, path, or keyword..."
                                 VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding StatusText}" 
                                   VerticalAlignment="Center" 
                                   Margin="10,0,0,0" 
                                   Foreground="Gray"
                                   FontSize="12"/>
                    </Grid>

                    <Border Grid.Row="3" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                        <DataGrid x:Name="SoundsDataGrid"
                                  ItemsSource="{Binding FilteredSounds}"
                                  SelectedItem="{Binding SelectedSound, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  CanUserResizeColumns="True"
                                  CanUserReorderColumns="True"
                                  CanUserSortColumns="True"
                                  CellPointerPressed="SoundsDataGrid_CellPointerPressed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="120"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Wwise Object Path" Binding="{Binding WwisePath}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Rundown Tab -->
            <TabItem Header="Rundown">
                <Panel DataContext="{Binding Rundown}" x:DataType="vm:RundownViewModel">
                    <Grid RowDefinitions="Auto,*" Margin="10">
                        <!-- Top Bar: Rundown Display and Settings -->
                        <Border Grid.Row="0" Background="#252526" Padding="10" Margin="0,0,0,10" CornerRadius="4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="Rundown:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#E0E0E0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedRundown.DisplayText}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="#FFFFFF"/>

                                <Button Grid.Column="2"
                                        Content="Rundown Settings"
                                        Command="{Binding OpenRundownSettings}"
                                        IsEnabled="{Binding HasSelectedRundown}"
                                        Margin="8,0,0,0"
                                        Padding="12,6"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Main Visual Rundown Viewport (when a rundown is selected) -->
                        <Grid Grid.Row="1" IsVisible="{Binding HasSelectedRundown}">
                            <!-- Visual Rundown Screen Canvas mimicking GTFO selection screen -->
                            <Border Background="{Binding BackgroundColorHex}"
                                    BorderBrush="#252A30"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    ClipToBounds="True">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <Grid Margin="20,20,20,80">
                                            <!-- Central Vertical Spine Line passing through all tiers -->
                                            <Border Width="2"
                                                    Background="#223344"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Stretch"
                                                    Margin="0,60,0,40"
                                                    Opacity="0.7"/>

                                            <StackPanel Spacing="0">
                                                <!-- Screen Title Header (GTFO Terminal Style) -->
                                                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                                                    <!-- Non-editable Rundown Title text from StorytellingData (e.g. "RUNDOWN #7.0\nTITLE: RISE") -->
                                                    <TextBlock Text="{Binding SelectedRundown.StorytellingData.Title}"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Foreground="#E5A93C"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,10"/>
                                                    
                                                    <!-- Edit Title & Intel Button -->
                                                    <Button Content="[ EDIT TITLE &amp; INTEL ]"
                                                            Command="{Binding OpenIntelDialog}"
                                                            HorizontalAlignment="Center"
                                                            Background="#0E1318"
                                                            Foreground="#E5A93C"
                                                            BorderBrush="#E5A93C"
                                                            BorderThickness="1"
                                                            CornerRadius="2"
                                                            Padding="16,4"
                                                            FontSize="11"
                                                            FontWeight="Bold"/>
                                                </StackPanel>

                                                <!-- Tiers Tree Going Downward -->
                                                <ItemsControl ItemsSource="{Binding Tiers}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RundownTierViewModel">
                                                            <StackPanel Margin="{Binding TierMargin}" HorizontalAlignment="Center">
                                                                <!-- Tier Header Marker on the Central Spine -->
                                                                <Border Background="#0C1015"
                                                                        BorderBrush="{Binding ColorHex}"
                                                                        BorderThickness="1.5"
                                                                        CornerRadius="3"
                                                                        Padding="10,4"
                                                                        HorizontalAlignment="Center"
                                                                        Margin="0,0,0,12">
                                                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                                        <!-- Tier Badge -->
                                                                        <Border Background="{Binding ColorHex}"
                                                                                CornerRadius="2"
                                                                                Padding="6,2"
                                                                                VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding TierName}"
                                                                                       FontWeight="Bold"
                                                                                       FontSize="12"
                                                                                       Foreground="#000000"/>
                                                                        </Border>

                                                                        <!-- Tier Info & Requirements -->
                                                                        <TextBlock Text="{Binding RequirementsSummary}"
                                                                                   FontSize="11"
                                                                                   Foreground="#888888"
                                                                                   VerticalAlignment="Center"/>

                                                                        <TextBlock FontSize="10" Foreground="#666666" VerticalAlignment="Center">
                                                                            <Run Text="Scale: "/>
                                                                            <Run Text="{Binding Scale, StringFormat='{}{0:F2}'}" Foreground="{Binding ColorHex}" FontWeight="SemiBold"/>
                                                                        </TextBlock>

                                                                        <!-- Tier Settings Button -->
                                                                        <Button Content="Visuals &amp; Reqs"
                                                                                Command="{Binding OpenSettings}"
                                                                                Padding="8,3"
                                                                                FontSize="11"
                                                                                VerticalAlignment="Center"/>

                                                                        <!-- Add Expedition Button -->
                                                                        <Button Content="+ Add Expedition"
                                                                                Command="{Binding AddExpedition}"
                                                                                Padding="8,3"
                                                                                FontSize="11"
                                                                                VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Expeditions Row centered along the tier -->
                                                                <Grid HorizontalAlignment="Center">
                                                                    <!-- When expeditions exist in tier -->
                                                                    <ItemsControl ItemsSource="{Binding Expeditions}"
                                                                                 IsVisible="{Binding HasVisibleExpeditions}"
                                                                                 HorizontalAlignment="Center">
                                                                        <ItemsControl.ItemContainerTheme>
                                                                            <ControlTheme TargetType="ContentPresenter" x:DataType="models:ExpeditionBlock">
                                                                                <Setter Property="IsVisible" Value="{Binding Enabled}"/>
                                                                            </ControlTheme>
                                                                        </ItemsControl.ItemContainerTheme>
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal"
                                                                                            HorizontalAlignment="Center"
                                                                                            Spacing="{Binding $parent[ItemsControl].((vm:RundownTierViewModel)DataContext).ExpeditionSpacing}"/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:ExpeditionBlock">
                                                                                <Border Width="180"
                                                                                        MinHeight="100"
                                                                                        IsVisible="{Binding Enabled}"
                                                                                        Background="#0E1318"
                                                                                        BorderBrush="{Binding BorderBrushHex}"
                                                                                        BorderThickness="1.5"
                                                                                        CornerRadius="3"
                                                                                        Padding="10">
                                                                                    <Grid RowDefinitions="Auto,*,Auto">
                                                                                        <!-- Top: Prefix in Box & Public Name -->
                                                                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                                                                            <!-- Prefix in Box -->
                                                                                            <Border Grid.Column="0"
                                                                                                    BorderBrush="{Binding BorderBrushHex}"
                                                                                                    BorderThickness="1"
                                                                                                    Background="#182028"
                                                                                                    CornerRadius="2"
                                                                                                    Padding="4,1"
                                                                                                    Margin="0,0,6,0">
                                                                                                <TextBlock Text="{Binding DisplayPrefix}"
                                                                                                           FontWeight="Bold"
                                                                                                           FontSize="12"
                                                                                                           Foreground="#FFFFFF"/>
                                                                                            </Border>

                                                                                            <!-- Public Name -->
                                                                                            <TextBlock Grid.Column="1"
                                                                                                       Text="{Binding Descriptive.PublicName, StringFormat='&quot;{0}&quot;'}"
                                                                                                       FontWeight="Bold"
                                                                                                       FontSize="12"
                                                                                                       Foreground="#E0E0E0"
                                                                                                       VerticalAlignment="Center"
                                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                                        </Grid>

                                                                                        <!-- Middle: Depth & Layer Sector Icons -->
                                                                                        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,8">
                                                                                            <TextBlock Text="{Binding Descriptive.ExpeditionDepth, StringFormat='{}DEPTH: {0}m'}"
                                                                                                       FontSize="10"
                                                                                                       Foreground="#AAAAAA"/>

                                                                                            <!-- Sector Icons (Main, Secondary, Overload) -->
                                                                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                                                                                <Image Source="avares://GTFO_GUIEditor/Assets/Sector_Main.png"
                                                                                                       Width="20" Height="20"
                                                                                                       ToolTip.Tip="Main Sector"/>
                                                                                                <Image Source="avares://GTFO_GUIEditor/Assets/Sector_Secondary.png"
                                                                                                       Width="20" Height="20"
                                                                                                       ToolTip.Tip="Secondary Sector"
                                                                                                       IsVisible="{Binding SecondaryLayerEnabled}"/>
                                                                                                <Image Source="avares://GTFO_GUIEditor/Assets/Sector_Overload.png"
                                                                                                       Width="20" Height="20"
                                                                                                       ToolTip.Tip="Overload Sector"
                                                                                                       IsVisible="{Binding ThirdLayerEnabled}"/>
                                                                                            </StackPanel>
                                                                                        </StackPanel>

                                                                                        <!-- Bottom: Action Buttons -->
                                                                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                                                                            <Button Grid.Column="0"
                                                                                                    Content="Edit"
                                                                                                    Command="{Binding $parent[ItemsControl].((vm:RundownTierViewModel)DataContext).OpenExpedition}"
                                                                                                    CommandParameter="{Binding}"
                                                                                                    Padding="6,3"
                                                                                                    FontSize="11"
                                                                                                    HorizontalAlignment="Stretch"
                                                                                                    HorizontalContentAlignment="Center"
                                                                                                    Margin="0,0,4,0"/>
                                                                                            <Button Grid.Column="1"
                                                                                                    Content="🗑"
                                                                                                    ToolTip.Tip="Delete Expedition"
                                                                                                    Command="{Binding $parent[ItemsControl].((vm:RundownTierViewModel)DataContext).RequestDeleteExpedition}"
                                                                                                    CommandParameter="{Binding}"
                                                                                                    Padding="6,3"
                                                                                                    FontSize="11"/>
                                                                                        </Grid>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <!-- When no expeditions in tier -->
                                                                    <Border IsVisible="{Binding !HasVisibleExpeditions}"
                                                                            Background="#0E1318"
                                                                            BorderBrush="#252A30"
                                                                            BorderThickness="1"
                                                                            CornerRadius="3"
                                                                            Padding="14,8"
                                                                            HorizontalAlignment="Center">
                                                                        <TextBlock Text="No active expeditions in this tier."
                                                                                   Foreground="#555555"
                                                                                   FontStyle="Italic"
                                                                                   FontSize="11"
                                                                                   HorizontalAlignment="Center"/>
                                                                    </Border>
                                                                </Grid>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                        </Grid>

                        <!-- When no rundown is selected -->
                        <Panel Grid.Row="1" IsVisible="{Binding !HasSelectedRundown}" Background="#1E1E1E">
                            <TextBlock Text="No rundown selected. Create a new rundown to begin."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"/>
                        </Panel>

                        <!-- TIER SETTINGS POPUP MODAL OVERLAY -->
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                Background="#80000000"
                                IsVisible="{Binding IsEditingTierSettings}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border Background="#252526"
                                    BorderBrush="#444444"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="24"
                                    Width="540"
                                    MaxHeight="620"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BoxShadow="0 4 20 #80000000">
                                <ScrollViewer>
                                    <StackPanel Spacing="16">
                                        <!-- Header -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ActiveEditingTier.TierName, StringFormat='{}{0} Visuals &amp; Settings'}"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding ActiveEditingTier.ColorHex}"/>
                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Command="{Binding CloseTierSettings}"
                                                    Padding="8,4"
                                                    Background="Transparent"/>
                                        </Grid>

                                        <!-- Section 1: Color (ARGB) -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Tier Color (ARGB)" FontWeight="Bold" FontSize="14" Foreground="#E0E0E0"/>
                                                
                                                <!-- Swatch and Hex -->
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0"
                                                            Background="{Binding ActiveEditingTier.ColorHex}"
                                                            Width="60"
                                                            Height="30"
                                                            CornerRadius="4"
                                                            BorderBrush="#555555"
                                                            BorderThickness="1"
                                                            Margin="0,0,12,0"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding ActiveEditingTier.TierColor.HexCode, Mode=TwoWay}"
                                                             Watermark="#AARRGGBB"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                                </Grid>

                                                <!-- ARGB Sliders -->
                                                <Grid ColumnDefinitions="30,*,50" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                                                    <!-- Red -->
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="R:" ToolTip.Tip="Red for this category. Affects the background colour of this tier of expeditions." VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding ActiveEditingTier.TierColor.R, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ActiveEditingTier.TierColor.R, StringFormat='{}{0:F2}'}" VerticalAlignment="Center"/>

                                                    <!-- Green -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="G:" ToolTip.Tip="Green for this category. Affects the background colour of this tier of expeditions." VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding ActiveEditingTier.TierColor.G, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ActiveEditingTier.TierColor.G, StringFormat='{}{0:F2}'}" VerticalAlignment="Center"/>

                                                    <!-- Blue -->
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="B:" ToolTip.Tip="Blue for this category. Affects the background colour of this tier of expeditions." VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding ActiveEditingTier.TierColor.B, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ActiveEditingTier.TierColor.B, StringFormat='{}{0:F2}'}" VerticalAlignment="Center"/>
                                                    
                                                    <!-- Alpha -->
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="A:" ToolTip.Tip="Alpha for this category. Affects the background colour of this tier of expeditions." VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    <Slider Grid.Row="3" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding ActiveEditingTier.TierColor.A, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ActiveEditingTier.TierColor.A, StringFormat='{}{0:F2}'}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Section 2: Visual Scale & ScaleYModifier -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Visual Scale &amp; Modifiers" FontWeight="Bold" FontSize="14" Foreground="#E0E0E0"/>
                                                
                                                <Grid ColumnDefinitions="110,*,50" RowDefinitions="Auto,Auto">
                                                    <!-- Scale -->
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Scale:" ToolTip.Tip="Affects how far apart the expeditions on this tier sit from one another. Note the in-editor view is not 1:1 accurate, rather just a visual representation." VerticalAlignment="Center"/>
                                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0.2" Maximum="2.0" Value="{Binding ActiveEditingTier.Scale, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ActiveEditingTier.Scale, StringFormat='{}{0:F2}'}" VerticalAlignment="Center"/>

                                                    <!-- ScaleYModifier -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ScaleYModifier:" ToolTip.Tip="Affects how close the expeditions on this tier sit towards the screen." VerticalAlignment="Center"/>
                                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0.0" Maximum="2.0" Value="{Binding ActiveEditingTier.ScaleYModifier, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ActiveEditingTier.ScaleYModifier, StringFormat='{}{0:F2}'}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Section 3: Sector Unlock Requirements -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Sector Unlock Requirements" FontWeight="Bold" FontSize="14" Foreground="#E0E0E0"/>
                                                
                                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Main Sectors:" ToolTip.Tip="How many main sectors need to be completed in this rundown to unlock this tier." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ActiveEditingTier.Requirements.MainSectors, Mode=TwoWay}" Margin="0,0,16,8"/>

                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Secondary:" ToolTip.Tip="How many secondary sectors need to be completed in this rundown to unlock this tier." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ActiveEditingTier.Requirements.SecondarySectors, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Third / Overload:" ToolTip.Tip="How many overload sectors need to be completed in this rundown to unlock this tier." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ActiveEditingTier.Requirements.ThirdSectors, Mode=TwoWay}" Margin="0,0,16,0"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="All Cleared:" ToolTip.Tip="How many 'all clears' need to be completed in this rundown to unlock this tier." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ActiveEditingTier.Requirements.AllClearedSectors, Mode=TwoWay}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Section 4: Expeditions in Tier (Active & Inactive) -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Expeditions in Tier" FontWeight="Bold" FontSize="14" Foreground="#E0E0E0"/>
                                                        <TextBlock Text="Uncheck to hide an expedition from the visual rundown screen entirely." FontSize="11" Foreground="#888888"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="+ Add Expedition"
                                                            Command="{Binding ActiveEditingTier.AddExpedition}"
                                                            Padding="8,4"
                                                            FontSize="11"
                                                            VerticalAlignment="Center"/>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding ActiveEditingTier.Expeditions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ExpeditionBlock">
                                                            <Border Background="#141C24" BorderBrush="#253545" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                                                    <!-- Enabled Toggle CheckBox -->
                                                                    <CheckBox Grid.Column="0"
                                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                              Margin="0,0,8,0"
                                                                              ToolTip.Tip="Visible on Rundown Screen"/>
                                                                    <!-- Prefix -->
                                                                    <Border Grid.Column="1"
                                                                            Background="#223344"
                                                                            CornerRadius="2"
                                                                            Padding="4,1"
                                                                            Margin="0,0,8,0"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayPrefix}"
                                                                                   FontWeight="Bold"
                                                                                   FontSize="11"
                                                                                   Foreground="#FFFFFF"/>
                                                                    </Border>
                                                                    <!-- Public Name -->
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding Descriptive.PublicName}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="12"
                                                                               Foreground="{Binding Enabled, Converter={x:Null}}"
                                                                               Opacity="{Binding Enabled, Converter={x:Null}}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <!-- Edit Button -->
                                                                    <Button Grid.Column="3"
                                                                            Content="Edit"
                                                                            Command="{Binding $parent[Border].((vm:RundownViewModel)DataContext).OpenExpeditionEditor}"
                                                                            CommandParameter="{Binding}"
                                                                            Padding="6,3"
                                                                            FontSize="11"
                                                                            Margin="0,0,4,0"/>
                                                                    <!-- Delete Button -->
                                                                    <Button Grid.Column="4"
                                                                            Content="🗑"
                                                                            Command="{Binding $parent[Border].((vm:RundownViewModel)DataContext).ActiveEditingTier.RequestDeleteExpedition}"
                                                                            CommandParameter="{Binding}"
                                                                            Padding="6,3"
                                                                            FontSize="11"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Done Button -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
                                            <Button Content="Done"
                                                    Command="{Binding CloseTierSettings}"
                                                    Background="#007ACC"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    Padding="20,8"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Border>

                        <!-- EXPEDITION EDITOR MODAL OVERLAY -->
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                Background="#80000000"
                                IsVisible="{Binding IsEditingExpedition}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border Background="#252526"
                                    BorderBrush="#444444"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="24"
                                    Width="580"
                                    MaxHeight="700"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BoxShadow="0 4 20 #80000000">
                                <ScrollViewer>
                                    <StackPanel Spacing="16">
                                        <!-- Header -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ActiveEditingExpedition.Descriptive.FullDisplayName, StringFormat='{}Edit Expedition: {0}'}"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF"/>
                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Command="{Binding CloseExpeditionEditor}"
                                                    Padding="8,4"
                                                    Background="Transparent"/>
                                        </Grid>

                                        <!-- General Expedition Info -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="General &amp; Descriptive" FontWeight="Bold" FontSize="14" Foreground="#E0E0E0"/>

                                                <!-- Level Selection -->
                                                <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,4">
                                                    <TextBlock Grid.Column="0" Text="Level:" ToolTip.Tip="The level that this expedition is attached to." VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#E0E0E0"/>
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding AvailableLevelLayouts}"
                                                              SelectedItem="{Binding SelectedEditingExpeditionLevel, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:LevelLayoutBlock">
                                                                <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                                
                                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                                                    <!-- Enabled & Accessibility -->
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Enabled:" ToolTip.Tip="Uncheck to hide this expedition from the visual rundown screen entirely." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding ActiveEditingExpedition.Enabled, Mode=TwoWay}" Margin="0,0,16,8"/>

                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Accessibility:" ToolTip.Tip="Accessibility of this expedition." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <ComboBox Grid.Row="0" Grid.Column="3"
                                                              ItemsSource="{x:Static vm:RundownViewModel.AvailableAccessibilities}"
                                                              SelectedItem="{Binding ActiveEditingExpedition.Accessibility, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch"
                                                              Margin="0,0,0,8"/>

                                                    <!-- Prefix & Public Name -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Prefix:" ToolTip.Tip="The shorthand prefix of the level. For example, R1A1 has the prefix 'R1A' and then the 1 is applied automatically." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ActiveEditingExpedition.Descriptive.Prefix, Mode=TwoWay}" Margin="0,0,16,8"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Public Name:" ToolTip.Tip="The public name of the level. For example, R1A1 has the public name 'The Admin'." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ActiveEditingExpedition.Descriptive.PublicName, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                    <!-- Depth & Duration -->
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Depth (m):" ToolTip.Tip="Purely cosmetic. The value shown to the user for the depth of the expedition." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ActiveEditingExpedition.Descriptive.ExpeditionDepth, Mode=TwoWay}" Margin="0,0,16,8"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Duration (s):" ToolTip.Tip="Purely cosmetic. The value shown to the user for the expected duration of the level." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ActiveEditingExpedition.Descriptive.EstimatedDuration, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                    <!-- Visual Style & Skip Number -->
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Visual Style:" ToolTip.Tip="Story levels have a yellow outline on the rundown screen, normal levels do not." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <ComboBox Grid.Row="3" Grid.Column="1"
                                                              ItemsSource="{x:Static vm:RundownViewModel.AvailableProgressionStyles}"
                                                              SelectedItem="{Binding ActiveEditingExpedition.Descriptive.ProgressionVisualStyle, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch"
                                                              Margin="0,0,16,0"/>

                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Skip Number:" ToolTip.Tip="Whether to skip the number after the prefix. For example, R1A1 would be called R1A if this is false." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <CheckBox Grid.Row="3" Grid.Column="3"
                                                              IsChecked="{Binding ActiveEditingExpedition.Descriptive.SkipExpNumberInName, Mode=TwoWay}"
                                                              VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Unlocked By Expedition Requirement -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12"
                                                IsVisible="{Binding ActiveEditingExpedition.IsUnlockedByExpedition}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Unlock Prerequisite Level" FontWeight="Bold" FontSize="14" Foreground="#4EC9B0"/>
                                                <TextBlock Text="Select which level in the rundown unlocks this expedition:" FontSize="11" Foreground="#888888"/>

                                                <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                                                    <TextBlock Grid.Column="0" Text="Prerequisite Level:" ToolTip.Tip="If Accessibility is 'UnlockedByExpedition', this decides which expedition unlocks it." VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding AvailableOtherExpeditions}"
                                                              SelectedItem="{Binding SelectedOtherExpedition, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ExpeditionLookupItem">
                                                                <TextBlock Text="{Binding DisplayText}" Foreground="#E0E0E0"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Expedition Options -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Expedition Options" FontWeight="Bold" FontSize="14" Foreground="#E0E0E0"/>

                                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                                                    <CheckBox Grid.Row="0" Grid.Column="0" Content="Is Single Player" ToolTip.Tip="True if this level should be locked to singleplayer."
                                                              IsChecked="{Binding ActiveEditingExpedition.IsSinglePlayer, Mode=TwoWay}" Margin="0,0,8,6"/>
                                                    <CheckBox Grid.Row="0" Grid.Column="1" Content="Skip Lobby" ToolTip.Tip="If true, the player will skip the lobby entirely and will load straight into the elevator when this expedition is selected."
                                                              IsChecked="{Binding ActiveEditingExpedition.SkipLobby, Mode=TwoWay}" Margin="0,0,0,6"/>

                                                    <CheckBox Grid.Row="1" Grid.Column="0" Content="Put Icon Above Tier" ToolTip.Tip="If true, the button for this expedition on the menu will be above the rest of its tier."
                                                              IsChecked="{Binding ActiveEditingExpedition.PutIconAboveTier, Mode=TwoWay}" Margin="0,0,8,6"/>
                                                    <CheckBox Grid.Row="1" Grid.Column="1" Content="Disable Player Voicelines" ToolTip.Tip="If true, player voicelines will be disabled in the level."
                                                              IsChecked="{Binding ActiveEditingExpedition.DisablePlayerVoicelines, Mode=TwoWay}" Margin="0,0,0,6"/>

                                                    <CheckBox Grid.Row="2" Grid.Column="0" Content="Exclude From Progression" ToolTip.Tip="If true, completions of this expedition will not count towards progression requirements of other expeditions."
                                                              IsChecked="{Binding ActiveEditingExpedition.ExcludeFromProgression, Mode=TwoWay}" Margin="0,0,8,6"/>
                                                    <CheckBox Grid.Row="2" Grid.Column="1" Content="Hide On Locked" ToolTip.Tip="If true, this level is hidden until it is unlocked. R8 uses this to hide the second half."
                                                              IsChecked="{Binding ActiveEditingExpedition.HideOnLocked, Mode=TwoWay}" Margin="0,0,0,6"/>

                                                    <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="Hide Roleplay Data On Locked" ToolTip.Tip="If true, the roleplay data (the 'interrupted comms' text) is hidden until the level is unlocked."
                                                              IsChecked="{Binding ActiveEditingExpedition.HideRolePlayDataOnLocked, Mode=TwoWay}" Margin="0,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Description & Warden Intel -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Description &amp; Warden Intel" FontWeight="Bold" FontSize="14" Foreground="#E0E0E0"/>

                                                <TextBlock Text="Expedition Description:" ToolTip.Tip="Description of the expedition. This is what is shown to the user in the rundown menu." Margin="0,4,0,2" Foreground="#CCCCCC"/>
                                                <TextBox Text="{Binding ActiveEditingExpedition.Descriptive.ExpeditionDescription, Mode=TwoWay}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Height="65"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         FontFamily="Consolas, Menlo, Monaco, monospace"
                                                         FontSize="12"/>

                                                <TextBlock Text="Roleplayed Warden Intel:" ToolTip.Tip="Roleplayed warden intel of the description. Also known as the 'interrupted comms'.&#x0a;If you want colored text, use `&lt;color=red>text&lt;/color>`, and for size, `&lt;size=200%>text&lt;/size>`" Margin="0,4,0,2" Foreground="#CCCCCC"/>
                                                <TextBox Text="{Binding ActiveEditingExpedition.Descriptive.RoleplayedWardenIntel, Mode=TwoWay}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Height="65"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         FontFamily="Consolas, Menlo, Monaco, monospace"
                                                         FontSize="12"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Sectors -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Sectors" FontWeight="Bold" FontSize="14" Foreground="#E0E0E0"/>
                                                <TextBlock Text="Main sector is always enabled. Secondary and Overload sectors are automatically enabled when a secondary or overload door is present in the level layout." FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>

                                                <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,4,0,0">
                                                    <CheckBox Content="Secondary Sector" ToolTip.Tip="Enabled when a Secondary Door is present in the level layout."
                                                              IsChecked="{Binding ActiveEditingExpedition.SecondaryLayerEnabled, Mode=OneWay}"
                                                              IsEnabled="False"
                                                              FontWeight="SemiBold"
                                                              Foreground="#FFA200"/>
                                                    <CheckBox Content="Overload Sector" ToolTip.Tip="Enabled when an Overload Door is present in the level layout."
                                                              IsChecked="{Binding ActiveEditingExpedition.ThirdLayerEnabled, Mode=OneWay}"
                                                              IsEnabled="False"
                                                              FontWeight="SemiBold"
                                                              Foreground="#00F2FF"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Done Button -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
                                            <Button Content="Done"
                                                    Command="{Binding CloseExpeditionEditor}"
                                                    Background="#007ACC"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    Padding="20,8"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Border>

                        <!-- GLOBAL RUNDOWN SETTINGS MODAL OVERLAY -->
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                Background="#80000000"
                                IsVisible="{Binding IsEditingRundownSettings}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border Background="#252526"
                                    BorderBrush="#444444"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="24"
                                    Width="540"
                                    MaxHeight="620"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BoxShadow="0 4 20 #80000000">
                                <ScrollViewer>
                                    <StackPanel Spacing="16">
                                        <!-- Header -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="Overall Rundown Settings"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF"/>
                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Command="{Binding CloseRundownSettings}"
                                                    Padding="8,4"
                                                    Background="Transparent"/>
                                        </Grid>

                                        <!-- General Identification -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="General" FontWeight="Bold" FontSize="14" Foreground="#E0E0E0"/>
                                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" ToolTip.Tip="Internal name for the rundown. This is not visible to the player, but is used for identifying the rundown within the editor." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRundown.Name, Mode=TwoWay}" Margin="0,0,16,8"/>

                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Persistent ID:" ToolTip.Tip="Internal unique identifier for this rundown. You will want to leave this as a random integer." VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SelectedRundown.PersistentId, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Enabled:" ToolTip.Tip="Whether this rundown is loaded. You'll likely want to leave this checked." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding SelectedRundown.InternalEnabled, Mode=TwoWay}" Margin="0,0,16,0"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Vanity Drop ID:" ToolTip.Tip="If you want your rundown to drop vanity items, put its ID here." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedRundown.VanityItemLayerDropDataBlock, Mode=TwoWay}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Progression Options -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Progression Rules" FontWeight="Bold" FontSize="14" Foreground="#E0E0E0"/>
                                                <CheckBox Content="Use Tier Unlock Requirements" ToolTip.Tip="Whether the custom tier unlock requirements should be used." IsChecked="{Binding SelectedRundown.UseTierUnlockRequirements, Mode=TwoWay}"/>
                                                <CheckBox Content="Never Show Rundown Tree" ToolTip.Tip="Whether to show the rundown tree. You'll likely want to leave this unchecked. The base game uses this for the &quot;rundown&quot; that contains the tutorial." IsChecked="{Binding SelectedRundown.NeverShowRundownTree, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Story & Intel -->
                                        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Story &amp; Intel" FontWeight="Bold" FontSize="14" Foreground="#E0E0E0"/>
                                                
                                                <TextBlock Text="Title (Header Text):" ToolTip.Tip="The text that displays at the top of the rundown. Normally, this is set to the rundown number (&quot;Rundown 7.0&quot;), and then on a new line, &quot;TITLE: &lt;title>&quot;" Margin="0,4,0,2"/>
                                                <TextBox Text="{Binding SelectedRundown.StorytellingData.Title, Mode=TwoWay}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Height="55"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         FontFamily="Consolas, Menlo, Monaco, monospace"
                                                         FontSize="12"/>

                                                <TextBlock Text="Surface Description (Intel):" ToolTip.Tip="The text displayed to the player when they click the 'Intel' button at the top of a rundown." Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedRundown.StorytellingData.SurfaceDescription, Mode=TwoWay}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Height="100"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         FontFamily="Consolas, Menlo, Monaco, monospace"
                                                         FontSize="12"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Done Button -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
                                            <Button Content="Done"
                                                    Command="{Binding CloseRundownSettings}"
                                                    Background="#007ACC"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    Padding="20,8"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Border>

                        <!-- DELETE EXPEDITION CONFIRMATION MODAL OVERLAY -->
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                Background="#80000000"
                                IsVisible="{Binding IsConfirmingDeleteExpedition}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border Background="#252526"
                                    BorderBrush="#444444"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="24"
                                    Width="440"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BoxShadow="0 4 20 #80000000">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Confirm Deletion"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#FF6B6B"/>

                                    <TextBlock Text="{Binding DeleteExpeditionConfirmationMessage}"
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               Foreground="#E0E0E0"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                                        <Button Content="Cancel"
                                                Command="{Binding CancelDeleteExpedition}"
                                                Padding="16,8"/>
                                        <Button Content="Delete"
                                                Command="{Binding ConfirmDeleteExpedition}"
                                                Background="#D9534F"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                Padding="16,8"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- INTEL MODAL OVERLAY -->
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                Background="#80000000"
                                IsVisible="{Binding IsShowingIntel}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border Background="#1A2026"
                                    BorderBrush="#E5A93C"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Padding="24"
                                    Width="650"
                                    MaxHeight="600"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BoxShadow="0 6 24 #80000000">
                                <StackPanel Spacing="16">
                                    <!-- Modal Header -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="[ INTEL TRANSMISSION ]"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#E5A93C"/>
                                            <TextBlock Text="Surface Description &amp; Mission Briefing Intel"
                                                       FontSize="11"
                                                       Foreground="#888888"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="✕"
                                                Command="{Binding CloseIntelDialog}"
                                                Padding="8,4"
                                                Background="Transparent"/>
                                    </Grid>

                                    <!-- Rundown Title Quick Edit -->
                                    <Border BorderBrush="#334455" BorderThickness="1" CornerRadius="4" Padding="10" Background="#12161C">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Rundown Title (Header Text):" ToolTip.Tip="The text that displays at the top of the rundown. Normally, this is set to the rundown number (&quot;Rundown 7.0&quot;), and then on a new line, &quot;TITLE: &lt;title>&quot;" FontWeight="SemiBold" FontSize="13" Foreground="#E0E0E0"/>
                                            <TextBox Text="{Binding SelectedRundown.StorytellingData.Title, Mode=TwoWay}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     Height="55"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     Watermark="e.g. RUNDOWN #7.0&#x0a;TITLE: RISE"
                                                     FontFamily="Consolas, Menlo, Monaco, monospace"
                                                     FontSize="12"
                                                     Background="#0C1014"
                                                     Foreground="#D0D0D0"
                                                     Padding="8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Surface Description (Intel) Text Editor -->
                                    <Border BorderBrush="#334455" BorderThickness="1" CornerRadius="4" Padding="10" Background="#12161C">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Surface Description (Intel Text):" ToolTip.Tip="The text displayed to the player when they click the 'Intel' button at the top of a rundown." FontWeight="SemiBold" FontSize="13" Foreground="#E0E0E0"/>
                                            <TextBox Text="{Binding SelectedRundown.StorytellingData.SurfaceDescription, Mode=TwoWay}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     Height="240"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     Watermark="Enter Intel / Surface Description..."
                                                     FontFamily="Consolas, Menlo, Monaco, monospace"
                                                     FontSize="12"
                                                     Background="#0C1014"
                                                     Foreground="#D0D0D0"
                                                     Padding="8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Done Button -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,4,0,0">
                                        <Button Content="Done"
                                                Command="{Binding CloseIntelDialog}"
                                                Background="#E5A93C"
                                                Foreground="#000000"
                                                FontWeight="Bold"
                                                Padding="20,8"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Panel>
            </TabItem>
        </TabControl>
    </Grid>
    </Grid>
</Window>
